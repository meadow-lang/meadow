data Kinds.Stepper : Type -> Effect -> Type
  -- accepted
con Kinds.Stepper.Stepper : {a : [] Type} -> {b : [] Effect} -> (a -> a ! b) -> Kinds.Stepper a b
  -- accepted
effect Kinds.Log : Effect
  -- accepted
op Kinds.Log.log : {a : [] Effect} -> String -> () ! {Kinds.Log | a}
  -- accepted
def stepper : {a : [] Type} -> {b : [] Effect} -> (a -> a ! b) -> Kinds.Stepper a b
  = \a -> \b -> \step -> Stepper a b step
  -- accepted
def counted : {a : [] Effect} -> Kinds.Stepper Int a -> Kinds.Stepper Int a
