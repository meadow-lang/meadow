def greet : String -> () ! Effects.Log
  = \name -> log {} (concatStrings Effects.Log (#array String (Cons String "hello " (Cons String (display String (#impl.Std.Display.Display String) name) (Nil String)))))
  -- accepted
def quiet : {a : [] Effect} -> (() -> () ! {Effects.Log | a}) -> () ! a
  = \a -> \f -> (\it -> it) (handle f () with { return (\x -> x); log (\line -> \k -> k ()) })
