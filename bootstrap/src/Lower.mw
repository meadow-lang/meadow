-- Lower: a module's grouped tree (`Fixity`) as its abstract syntax (`Ast`).
--
-- Read as `Parse` reads a tree for the parse test -- the same forms, the same
-- spans, each rule of it here again -- but written into `Ast`'s tables rather
-- than out as text, and from the fixity pass's tree, whose chains of operators
-- are grouped: `a + b * c` is `(+) a ((*) b c)`, each call spanning what it
-- applies the operator to, and `x :: xs` the constructor `Cons`, as
-- `meadow-rename` makes them.

use MeadowBoot.Ast
use MeadowBoot.Fixity
use MeadowBoot.Fixity.Grouped.*
use MeadowBoot.Fixity.Assoc.*
use MeadowBoot.Lex (lex, Lexed, Token)
use MeadowBoot.Lex.Token.*
use Lingua (pass!)
use Lingua.Red as R
use Lingua.Red (Syntax)
use Lingua.Red.Syntax.*
use Lingua.Green as G
use Lingua.Green (Green)
use Lingua.Lang (Meta, spanMeta, metaStart, metaEnd)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Std.St (St, runSt)
use Std.Json as J
use Std.Json (Json)
use MeadowBoot.Syntax (parseSurfaceTokens)
use MeadowBoot.Rules as Ru
use MeadowBoot.Rules (Macro, Tok, Tree)
use Std.Char as Ch
use MeadowBoot.Hygiene as Hy
use MeadowBoot.Derive as D
use MeadowBoot.Derive (Shape, Ctor)
use MeadowBoot.Macros as Mc

-- `input`'s grouped tree, a module of package `pkg`, as abstract syntax:
-- each call of one of its `macro`s expanded here, and each other macro call
-- the expansion `exps` has for it, by position and where it starts
-- (`expr@120`), and each `@derive` what it wrote -- an operator chain in one
-- grouped by the unit's fixities `fx`.
@pub fun lowered
    (cfg : Cfg)
    (file : String)
    (pkg : String)
    (input : String)
    (tree : Green Grouped)
    (exps : HashMap String Json)
    (fx : HashMap String Fixity)
    : AstProgram =
  match loweredWith cfg file pkg input tree exps fx H.empty with
  | (program, _, _) -> program

-- The same, with what the procedural macros called in it `answered` -- each
-- call's tokens, under its key -- and, beside the syntax, every call it has
-- no answer for: what a round of expansion is asked to run (`Compiler`).
--
-- What a `@cfg` switches off under `cfg` is left out here, before anything
-- else sees the module, as `meadow_compiler::cfg::strip` takes it out: a
-- declaration, a record's field, a constructor's named field, an effect's
-- operation. It is not expanded, not resolved and not typed. A condition
-- that cannot be read is the third thing answered: what is wrong, and the
-- bytes it is at.
@pub fun loweredWith
    (cfg : Cfg)
    (file : String)
    (pkg : String)
    (input : String)
    (tree : Green Grouped)
    (exps : HashMap String Json)
    (fx : HashMap String Fixity)
    (answered : HashMap String [Tok])
    : (AstProgram, [Request], [(String, Int, Int)]) =
  runSt (\() ->
    let count = stNewRef 0 in
    let asked = stNewRef [] in
    let wrongs = stNewRef [] in
    let program =
      counting count asked wrongs (\() ->
        let b = newAstBuilder () in
        let bare =
          Lc {
            tokens = H.fromVec (V.map (\(l : Lexed) -> (l.from, l.token)) (lex input).tokens),
            exps,
            fx,
            macros = H.empty,
            answered,
            under = "",
            cfg,
            input,
            file
          }
        in
        let top = R.root tree in
        let c = { bare | macros = macrosOf bare pkg top } in
        let decls = V.concatMap (decl c b) (childrenOf NodeDecl top) in
        let root = newAstModule b (spanOf top) decls in
        AstProgram (freezeAst b) root)
    in (program, stGetRef asked, stGetRef wrongs))

-- A call of a macro that is not the module's own, or a `@derive` of a
-- trait: what would run it needs. Its key, which its answer comes back
-- under; where it is -- `decls`, `expr`, `pat`, or `derived` for a derive;
-- the name it is called by; its argument, as a `Wire` of token trees written
-- out (`Macros`) -- a derive's is the declaration it is on; the bytes a
-- token the macro makes up stands at; and what `@pub` on the call says of
-- how far what it defines is seen -- `None` if it has none.
@derive(Debug, PartialEq)
@pub record Request = {
  key : String,
  kind : String,
  name : String,
  argument : String,
  from : Int,
  to : Int,
  seen : Maybe [String]
}

-- Each token as the lexer read it, by where it is in the tree's text: what a
-- literal is worth; what the module's other macro calls expanded to; the
-- unit's fixities; and the module's `macro`s, by name.
-- And what the procedural macros called here answered, by key, and what a
-- key here starts with: nothing in the module itself, and inside what a
-- macro wrote the key of the call that wrote it.
record Lc = {
  tokens : HashMap Int Token,
  exps : HashMap String Json,
  fx : HashMap String Fixity,
  macros : HashMap String Macro,
  answered : HashMap String [Tok],
  under : String,
  cfg : Cfg,
  -- The module's text, and what its file is called: what `line!` and
  -- `file!` answer from.
  input : String,
  file : String
}

-- What a `@cfg` is decided by, as `meadow_compiler::Cfg` holds it: the system
-- and the processor the program is for, whether the build is a `debug` or a
-- `release` one, what runs the program, how hard it is optimised (`0` to
-- `3`), whether its tests are being built, and the flags the build was given
-- -- each a name, or `name=value`.
@derive(Debug, PartialEq)
@pub record Cfg = {
  os : String,
  arch : String,
  profile : String,
  backend : String,
  opt : String,
  test : Bool,
  flags : [String]
}

-- The one build the commands that show a unit renamed or inferred answer
-- for, wherever they run: the differential tests build the Rust compiler's
-- side for it.
@pub def shownCfg : Cfg =
  Cfg {
    os = "windows",
    arch = "x86_64",
    profile = "debug",
    backend = "jit",
    opt = "0",
    test = False,
    flags = []
  }

fun familyOf (c : Cfg) : String = if c.os == "windows" then "windows" else "unix"

-- Each call of a `macro` expanded is numbered, in the order the Rust expander
-- meets them -- a call, then what it wrote, then the next -- which is what
-- the names its template writes are marked with.
-- And a call nothing here can expand is asked for.
effect Expanding {
  nextExpansion : () -> Int,
  ask : Request -> (),
  -- And something wrong said: what, and the bytes it is at.
  wrong : (String, Int, Int) -> (),
}

fun counting
    (count : StRef s Int)
    (asked : StRef s [Request])
    (wrongs : StRef s [(String, Int, Int)])
    (act : () -> a ! { Expanding, St s | e })
    : a ! { St s | e } =
  handle act () with {
    nextExpansion u k ->
      (let n = stGetRef count + 1 in
       let v = stSetRef count n in
       k n),
    ask r k -> (let v = stSetRef asked (V.pushBack (stGetRef asked) r) in k ()),
    wrong w k -> (let v = stSetRef wrongs (V.pushBack (stGetRef wrongs) w) in k ()),
    return x -> x
  }

-- The key of the call, or the derive, at `s`: its place, and where its
-- first token is in the text it was parsed from.
fun keyOf (c : Lc) (kind : String) (s : GTree) : String =
  "${c.under}${kind}@${show (fst (R.textRange s))}"

-- What the call in position `kind` starting at `m` expanded to, if it did.
fun expansion (c : Lc) (kind : String) (m : Meta) : Maybe Json =
  H.lookup "${kind}@${show (metaStart m)}" c.exps

-- --- the tree ----------------------------------------------------------------

type GTree = Syntax Grouped

-- A node's children are found by stepping from slot to slot (`Lingua.Red`):
-- every form asks for a child or two of each node it reads, and a list of all
-- of them made and filtered for each question was most of what lowering did.
fun kids (s : GTree) : [GTree] = R.childrenWhere (\g c -> G.kindAt g c != Unknown) s

fun nodeKids (s : GTree) : [GTree] =
  R.childrenWhere (\g c -> not (G.isTokenAt g c) and G.kindAt g c != Unknown) s

fun tokenKids (s : GTree) : [GTree] =
  R.childrenWhere (\g c -> G.isTokenAt g c and G.kindAt g c != Unknown) s

fun childOf (k : Grouped) (s : GTree) : Maybe GTree = R.childWhere (\g c -> G.kindAt g c == k) s

fun childrenOf (k : Grouped) (s : GTree) : [GTree] = R.childrenWhere (\g c -> G.kindAt g c == k) s

fun has (k : Grouped) (s : GTree) : Bool = M.isSome (childOf k s)

fun firstNode (s : GTree) : Maybe GTree =
  R.childWhere (\g c -> not (G.isTokenAt g c) and G.kindAt g c != Unknown) s

fun must (k : Grouped) (s : GTree) : GTree = M.unwrapOr s (childOf k s)

fun tokenIs (k : Grouped) (s : GTree) : Bool =
  M.isSome (R.childWhere (\g c -> G.isTokenAt g c and G.kindAt g c == k) s)

-- The bytes `s` spans: its first token's start to its last's end -- where
-- they stand, for a tree a macro wrote (`Lingua.Green`).
fun spanOf (s : GTree) : Meta =
  match s with
  | Syntax g i ->
      -- Looked for from each end: a tree is as many entries as everything
      -- under it, and a span is asked of every one.
      let last = G.after g i in
      (match (tokenFrom g i last, tokenBefore g (last - 1) i) with
       | (Just f, Just l) -> spanMeta (G.fromAt g f) (G.toAt g l)
       | _ -> spanMeta (G.fromAt g i) (G.fromAt g i))

-- The first token at `j` or after it, before `limit`.
fun tokenFrom g (j : Int) (limit : Int) : Maybe Int =
  if j >= limit then None
  else if G.isTokenAt g j and G.kindAt g j != Unknown then Just j
  else tokenFrom g (j + 1) limit

-- The last token at `j` or before it, not before `least`.
fun tokenBefore g (j : Int) (least : Int) : Maybe Int =
  if j < least then None
  else if G.isTokenAt g j and G.kindAt g j != Unknown then Just j
  else tokenBefore g (j - 1) least

fun join (a : Meta) (z : Meta) : Meta =
  spanMeta (min (metaStart a) (metaStart z)) (max (metaEnd a) (metaEnd z))

fun from (a : Meta) (z : Meta) : Meta = spanMeta (metaStart a) (metaEnd z)

fun tokenOf (c : Lc) (t : GTree) : Maybe Token = H.lookup (fst (R.textRange t)) c.tokens

-- A name as it is written: its text and its bytes.
record Nm = {
  text : String,
  at : Meta
}

fun nameOf (t : GTree) : Nm = Nm { text = R.text t, at = spanOf t }

fun named (text : String) (at : Meta) : Nm = Nm { text, at }

-- A type's name under `s`: its first token, and each `.Name` after it --
-- `M.Ty` -- as one name, dots and all, as `meadow-parser` keeps one.
fun typeName (s : GTree) : Nm =
  let first = firstName s in
  let quals = childrenOf NodeTQual s in
  if V.isEmpty quals then first
  else
    (let names = V.map (\q -> lastName q) quals in
     let last = V.getOr first names (V.len names - 1) in
     named
       (V.foldl (\acc (n : Nm) -> "${acc}.${n.text}") first.text names)
       (spanMeta (metaStart first.at) (metaEnd last.at)))

-- A qualified name's parts, as `meadow-parser`'s `qualifier` takes them
-- apart: what qualifies it -- `A`, or `A.Term` -- and its last part, the name.
fun qualParts (s : GTree) : (Nm, Nm) =
  let words = \x -> V.filter (\t -> R.kindOf t != TokenPeriod) (tokenKids x) in
  let ns = V.map nameOf (V.append (words s) (V.concatMap words (childrenOf NodeQualTail s))) in
  let last = V.getOr (named "" (spanOf s)) ns (V.len ns - 1) in
  let quals = V.take ns (V.len ns - 1) in
  let first = V.getOr last quals 0 in
  let stop = V.getOr last quals (V.len quals - 1) in
  (
    named
      (S.join "." (V.map (\(n : Nm) -> n.text) quals))
      (spanMeta (metaStart first.at) (metaEnd stop.at)),
    last
  )

fun firstName (s : GTree) : Nm =
  match s with
  | Syntax g i ->
      (match V.find
         (\j -> G.isTokenAt g j and G.kindAt g j != Unknown)
         (V.range i (G.after g i)) with
       | Just j -> named (G.textAt g j) (spanMeta (G.fromAt g j) (G.toAt g j))
       | None -> named "" (spanOf s))

fun lastName (s : GTree) : Nm =
  let tokens = tokenKids s in
  match V.get tokens (V.len tokens - 1) with
  | Just t -> nameOf t
  | None -> firstName s

-- A name, written.
fun nm b (n : Nm) = newAstName b n.at n.text

-- --- declarations ------------------------------------------------------------
--
-- A pass, `lowerDecl`, from a declaration of the grammar's to the tree's.
-- What a declaration answers is not one node: a signature with clauses is
-- two, a synonym several, and a macro call whatever it expanded to -- each
-- under the attributes written on it, a signature keeping only `@cfg`. So
-- the form under the attributes answers its nodes, each with whether it is
-- a signature, and the declaration puts the attributes on them.

fun decl (c : Lc) b (s : GTree) = lowerDeclDecl () b c s

pass! {
  lowerDecl : Grouped -> Ast with c from Decl
    | Decl _ -> []
    | Item _ -> []
    | Fixity _ -> []
    | ModDecl _ -> []
    | UseDecl _ -> []
    | DataDecl _ -> []
    | RecordDecl _ -> []
    | EffectDecl _ -> []
    | TypeDecl _ -> []
    | TraitDecl _ -> []
    | ImplDecl _ -> []
    | MacroDecl _ -> []
    | MacCall _ -> []
    | FunItem _ -> []
    | DefItem _ -> []
    | PatternDecl _ -> []
    -- A macro call is what it expanded to, in its place: a call of one of
    -- the module's `macro`s expanded here, and left a call if it cannot be.
    -- Anything else is what was written, and what a `@derive` on it wrote.
    | Decl { raw attrs, later item } ->
        if not (cfgHolds c attrs) then []
        else
          (let call =
             only (\i -> R.kindOf i == NodeMacCall) (M.andThen firstNode (childOf NodeItem node))
           in
           let written = \u -> attributed c out node attrs (item c) in
           match M.andThen (\i -> M.map (\m -> (i, m)) (rulesOf c i)) call with
           | Just (i, m) -> M.unwrapOr (written ()) (expandedDecls c out m i)
           | None ->
               (match M.andThen (\i -> H.lookup (keyOf c "decls" node) c.answered) call with
                | Just toks -> splicedDecls c out (keyOf c "decls" node) toks
                | None ->
                    (match M.andThen (\i -> expansion c "decls" (spanOf node)) call with
                     | Just made -> V.map (jDecl c out) (jarr made)
                     | None ->
                         let u =
                           (match call with
                            | Just i -> asking c "decls" (keyOf c "decls" node) i (seenBy attrs)
                            | None -> ())
                         in V.append
                              (written ())
                              (match expansion c "derived" (spanOf node) with
                               | Just made -> V.map (jDecl c out) (jarr made)
                               | None -> derivedDecls c out node attrs))))
    | Item {
      fixity, modDecl, useDecl, dataDecl, recordDecl, effectDecl, typeDecl, traitDecl, implDecl,
      macroDecl, macCall, funItem, defItem, patternDecl
    } ->
        V.concat
          (V.concatMap asList [
             fixity, modDecl, useDecl, dataDecl, recordDecl, effectDecl, typeDecl, traitDecl,
             implDecl, macroDecl, macCall, funItem, defItem, patternDecl
           ])
    | Fixity { raw ops } ->
        [(
          False,
          newAstDeclFixity
            out
            (spanOf node)
            (V.map (\f -> nm out (firstName (must NodeOpName f))) ops)
        )]
    | ModDecl { raw name } -> [(False, newAstDeclMod out (spanOf node) (nm out (firstName name)))]
    | UseDecl { raw path, raw glob, raw alias, raw names } ->
        [(False, useDecl out (spanOf node) path glob alias names)]
    | DataDecl { variants } ->
        [(False, newAstDeclData out (spanOf node) (declared out node) (taking out node) variants)]
    -- A variant's fields: named, when the first thing after its name is a
    -- brace list of at least one field and no `| r`, and otherwise its types
    -- in order.
    | Variant { attrs, raw args } ->
        (let fieldList =
           M.andThen
             (\a ->
               only
                 (\r -> V.len (childrenOf NodeFieldTy r) > 0 and not (has NodeRowTail r))
                 (childOf NodeRecTy a))
             (V.get args 0)
         in
         let name = nm out (nameOf (must TokenUpperIdent node)) in
         match fieldList with
         | Just r ->
             newAstVariant
               out
               (spanOf node)
               attrs
               name
               True
               []
               (V.map (field c out) (fieldsThere c r))
         | None -> newAstVariant out (spanOf node) attrs name False (V.map (tatom c out) args) [])
    | Attr {} -> attr c out node
    | RecordDecl { raw fields } ->
        [(
          False,
          newAstDeclRecord
            out
            (spanOf node)
            (declared out node)
            (taking out node)
            (V.map (field c out) (fieldsThere c fields))
        )]
    | EffectDecl { raw body } ->
        (match childOf NodeEffectAlias body with
         | Just alias ->
             [(
               False,
               newAstDeclEffectAlias
                 out
                 (spanOf node)
                 (declared out node)
                 (taking out node)
                 (row c out (must NodeEffRow alias))
             )]
         | None ->
             [(
               False,
               newAstDeclEffect
                 out
                 (spanOf node)
                 (declared out node)
                 (taking out node)
                 (V.map (field c out) (fieldsThere c (must NodeRecTy body)))
             )])
    | TypeDecl { raw ty } ->
        [(
          False,
          newAstDeclAlias out (spanOf node) (declared out node) (taking out node) (tyOf c out ty)
        )]
    | TraitDecl { raw supers, raw items } ->
        [(
          False,
          traitDecl
            c
            out
            (spanOf node)
            (must TokenUpperIdent node)
            (childrenOf TokenLowerIdent node)
            supers
            items
        )]
    | ImplDecl { raw tys, raw context, raw items } ->
        [(False, implDecl c out (spanOf node) (must TokenUpperIdent node) tys context items)]
    | MacroDecl {} ->
        [(False, newAstDeclMacro out (spanOf node) (nm out (nameOf (must TokenLowerIdent node))))]
    | MacCall {} -> [(False, newAstDeclMacCall out (spanOf node) (macCall out node))]
    -- With a body, a binding; without, a signature, and its clauses the
    -- binding.
    | FunItem { raw name, raw annot, raw body, raw clauses } ->
        (match body with
         | Just _ -> [(False, newAstDeclBind out (spanOf node) (bindOf c out node))]
         | None -> sigDecl c out node True (vid name) (M.unwrapOr node annot) clauses)
    | DefItem { raw pat, raw annot, raw body, raw clauses } ->
        (match body with
         | Just _ -> [(False, newAstDeclBind out (spanOf node) (bindOf c out node))]
         | None -> sigDecl c out node False (patName pat) (M.unwrapOr node annot) clauses)
    | PatternDecl { raw form } -> patternDecl c out node (nameOf (must TokenUpperIdent node)) form
}

-- `x`, if it is one `keep` keeps.
fun only keep (x : Maybe a) : Maybe a =
  match x with
  | Just v -> if keep v then Just v else None
  | None -> None

-- A type, as the rest of this file writes one: the pass's cases name a
-- field `ty`, which this is not.
fun tyOf (c : Lc) b (s : GTree) = ty c b s

-- The name a `data`, a `record`, an `effect` or a `type` declares, and the
-- parameters it takes.
fun declared b (s : GTree) = nm b (nameOf (must TokenUpperIdent s))

fun taking b (s : GTree) = V.map (\p -> nm b (nameOf p)) (childrenOf TokenLowerIdent s)

-- A declaration's nodes, each under the attributes written on it: a
-- signature's only its `@cfg`.
fun attributed (c : Lc) b (s : GTree) (attrs : [GTree]) bare =
  if V.isEmpty attrs then V.map snd bare
  else
    V.map
      (\x ->
        let kept =
          (if fst x then V.filter (\a -> (firstName (must NodeAttrName a)).text == "cfg") attrs
           else attrs)
        in if V.isEmpty kept then snd x
           else newAstDeclAttributed b (spanOf s) (V.map (attr c b) kept) (snd x))
      bare

fun attr (c : Lc) b (s : GTree) =
  let metas =
    (match childOf NodeAttrArgs s with
     | Just a -> childrenOf NodeMeta a
     | None -> [])
  in
  let words =
    V.concatMap
      (\m -> if has NodeMetaRest m or has TokenStr m then [] else [nm b (firstName m)])
      metas
  in newAstAttr
       b
       (spanOf s)
       (nm b (firstName (must NodeAttrName s)))
       words
       (V.concatMap (metaItem c b) metas)

fun metaItem (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match s with
  | GroupedMeta (Just text) _ _ -> [newAstAttrMetaText b m (nm b (stringName c text))]
  | GroupedMeta _ (Just n) None -> [newAstAttrMetaWord b m (nm b (firstName n))]
  | GroupedMeta _ (Just n) (Just rest) ->
      (match rest with
       | GroupedMetaRest (Just v) _ ->
           [newAstAttrMetaValue
              b
              m
              (nm b (firstName n))
              (nm b (named (stringName c (must TokenStr v)).text (spanOf v)))]
       | GroupedMetaRest _ (Just args) ->
           [newAstAttrMetaList
              b
              m
              (nm b (firstName n))
              (V.concatMap (metaItem c b) (childrenOf NodeMeta args))]
       | _ -> [])
  | _ -> []

-- A string literal's text as a name: what it says, where it was written.
fun stringName (c : Lc) (t : GTree) : Nm =
  match tokenOf c t with
  | Just (Str s) -> named s (spanOf t)
  | _ -> nameOf t

fun useDecl
    b
    (m : Meta)
    (path : GTree)
    (glob : Maybe GTree)
    (alias : Maybe GTree)
    (names : Maybe GTree) =
  let items =
    (match names with
     | Just ns -> childrenOf NodeUseItem ns
     | None -> [])
  in
  let bang = \i -> tokenIs TokenBang i or tokenIs TokenDeclBang i in
  newAstDeclUse
    b
    m
    (V.map (\x -> nm b (firstName x)) (childrenOf NodeSeg path))
    (V.map (\i -> nm b (useName i)) (V.filter (\i -> not (bang i)) items))
    (V.map (\i -> nm b (useName i)) (V.filter bang items))
    (M.isSome glob)
    (M.map (\a -> nm b (lastName a)) alias)

fun useName (i : GTree) : Nm =
  let n = must NodeUseName i in
  match firstNode n with
  | Just x -> (if R.kindOf x == NodeParenOp then firstName (must NodeOpName x) else firstName x)
  | None -> firstName n

fun field (c : Lc) b (s : GTree) =
  newAstField
    b
    (spanOf s)
    (V.map (attr c b) (childrenOf NodeAttr s))
    (nm b (nameOf (must TokenLowerIdent s)))
    (ty c b (must NodeType s))

fun traitDecl
    (c : Lc)
    b
    (m : Meta)
    (name : GTree)
    (params : [GTree])
    (supers : Maybe GTree)
    (items : [GTree]) =
  let members = V.concatMap (\x -> match firstNode x with | Just y -> [y] | None -> []) items in
  let assocs = V.filter (\x -> R.kindOf x == NodeAssocDecl) members in
  let effects = V.filter (\x -> R.kindOf x == NodeAssocEff) members in
  let rest = V.filter (\x -> R.kindOf x != NodeAssocDecl and R.kindOf x != NodeAssocEff) members in
  let sigs = V.filter (\x -> not (has NodeBody x)) rest in
  -- The defaults: each binding written as one, and each signature's clauses,
  -- in the order they were written.
  let defaults =
    V.concatMap
      (\x ->
        if has NodeBody x then [bindOf c b x]
        else
          (match definedBy
             c
             b
             (R.kindOf x == NodeFunItem)
             (sigName x)
             (childrenOf NodeClause x)
             (spanOf x) with
           | Just d -> [d]
           | None -> []))
      rest
  in newAstDeclTrait
       b
       m
       (nm b (nameOf name))
       (V.map (\p -> nm b (nameOf p)) params)
       (V.map
          (bound c b)
          (match supers with
           | Just sp -> childrenOf NodeBound sp
           | None -> []))
       (V.map
          (\a ->
            newAstAssoc
              b
              (spanOf a)
              (nm b (nameOf (must TokenUpperIdent a)))
              (V.concatMap
                 (\t ->
                   match childOf TokenLowerIdent t with
                   | Just x -> [nm b (nameOf x)]
                   | None -> [])
                 (childrenOf NodeTAtom a)))
          assocs)
       (V.map
          (\a ->
            newAstAssoc
              b
              (spanOf a)
              (nm b (nameOf (must TokenUpperIdent a)))
              (V.concatMap
                 (\t ->
                   match childOf TokenLowerIdent t with
                   | Just x -> [nm b (nameOf x)]
                   | None -> [])
                 (childrenOf NodeTAtom a)))
          effects)
       (V.map
          (\x ->
            newAstMethodSig
              b
              (spanOf x)
              (nm b (sigName x))
              (ty c b (must NodeType (must NodeAnnot x))))
          sigs)
       defaults

-- The name a signature is for.
fun sigName (s : GTree) : Nm =
  if R.kindOf s == NodeFunItem then vid (must NodeVid s) else patName (must NodePat s)

fun implDecl
    (c : Lc)
    b
    (m : Meta)
    (tr : GTree)
    (tys : [GTree])
    (context : Maybe GTree)
    (items : [GTree]) =
  let members = V.concatMap (\x -> match firstNode x with | Just y -> [y] | None -> []) items in
  let assocs = V.filter (\x -> R.kindOf x == NodeAssocDecl) members in
  newAstDeclImpl
    b
    m
    (nm b (nameOf tr))
    (V.map (tatom c b) tys)
    (V.map
       (bound c b)
       (match context with
        | Just w -> childrenOf NodeBound w
        | None -> []))
    (V.map
       (\a ->
         newAstAssocDef
           b
           (spanOf a)
           (nm b (nameOf (must TokenUpperIdent a)))
           (V.map (tatom c b) (childrenOf NodeTAtom a))
           (ty c b (must NodeType (must NodeAssocValue a))))
       assocs)
    (V.map
       (\a ->
         newAstAssocEffDef
           b
           (spanOf a)
           (nm b (nameOf (must TokenUpperIdent a)))
           (V.map (tatom c b) (childrenOf NodeTAtom a))
           (row c b (must NodeEffRow (must NodeAssocEffValue a))))
       (V.filter (\x -> R.kindOf x == NodeAssocEff) members))
    (V.map
       (bindOf c b)
       (V.filter (\x -> R.kindOf x != NodeAssocDecl and R.kindOf x != NodeAssocEff) members))

fun bound (c : Lc) b (s : GTree) =
  newAstBound
    b
    (spanOf s)
    (nm b (nameOf (must TokenUpperIdent s)))
    (V.map (tatom c b) (childrenOf NodeHeadTy s))

fun isGroup (s : GTree) : Bool =
  R.kindOf s == NodeParenGroup or R.kindOf s == NodeBrackGroup or R.kindOf s == NodeBraceGroup

-- A macro call, by its path; where its argument is, its span says.
fun macCall b (s : GTree) =
  let pathNode =
    M.unwrapOr
      s
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids s))
  in
  let path =
    V.map
      (\x -> nm b (firstName x))
      (V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode))
  in newAstMacCall b (macSpan s) path

-- Where a macro call is: its path to its argument's close.
fun macSpan (s : GTree) : Meta =
  match V.find isGroup (nodeKids s) with
  | Just g -> from (spanOf s) (spanOf g)
  | None -> spanOf s

-- --- bindings ----------------------------------------------------------------

-- `fun f : C a => T` and its clauses: the signature, spanning up to its type,
-- and the binding its clauses make, spanning all of it.
fun sigDecl (c : Lc) b (s : GTree) (isFun : Bool) (n : Nm) (annot : GTree) (clauses : [GTree]) =
  let first = must NodeType annot in
  let implied = childOf NodeImplies annot in
  let t =
    (match implied with
     | Just i -> must NodeType i
     | None -> first)
  in
  let bounds = (match implied with | Just _ -> boundsOf first | None -> []) in
  let sig =
    (
      True,
      newAstDeclSig
        b
        (from (spanOf s) (spanOf t))
        (nm b n)
        (ty c b t)
        (V.map (\x -> sigBound c b (fst x) (snd x)) bounds)
    )
  in match definedBy c b isFun n clauses (spanOf s) with
     | Just d -> [sig, (False, newAstDeclBind b (spanOf s) d)]
     | None -> [sig]

fun sigBound (c : Lc) b (n : Nm) (ts : [GTree]) = newAstBound b n.at (nm b n) (V.map (tatom c b) ts)

-- What a type written before `=>` says: the bounds it is.
fun boundsOf (t : GTree) : [(Nm, [GTree])] =
  match (childOf NodeArrow t, firstNode (must NodeTHead t)) with
  | (None, Just h) ->
      if R.kindOf h == NodeTCon then [(firstName h, childrenOf NodeTAtom h)]
      else if R.kindOf h == NodeTParen then V.concatMap boundsOf (childrenOf NodeType h)
      else []
  | _ -> []

-- The name a `def` signature's pattern is.
fun patName (p : GTree) : Nm =
  match M.andThen (childOf NodeArg) (childOf NodePAtom p) with
  | Just a ->
      (match childOf NodeVid a with
       | Just v -> vid v
       | None -> firstName p)
  | None -> firstName p

fun vid (s : GTree) : Nm =
  match childOf NodeOpName s with
  | Just op -> firstName op
  | None -> firstName s

-- A `fun` or `def` with a body, as a binding.
fun bindOf (c : Lc) b (s : GTree) =
  let body = must NodeExpr (must NodeBody s) in
  let ret = M.map (resultTy c b) (childOf NodeAnnot s) in
  if R.kindOf s == NodeFunItem then
    let n = vid (must NodeVid s) in
    let params = childrenOf NodeParam s in
    let clauses = childrenOf NodeClause s in
    if V.isEmpty params and V.isEmpty clauses then
      newAstBindFun b (spanOf s) (nm b n) [] ret (expr c b body)
    else equations c b n params ret body clauses (spanOf s)
  else
    let p = must NodePat s in
    let value = expr c b body in
    match ret with
    | Just t -> newAstBindPat b (spanOf s) (newAstPatAnn b (spanOf p) (pat c b p) t) value
    | None -> newAstBindPat b (spanOf s) (pat c b p) value

-- A binding's `: T`, and its effects: `: T ! e` is a function of nothing
-- performing `e`, spanning from the colon.
fun resultTy (c : Lc) b (annot : GTree) =
  let t = must NodeType annot in
  match childOf NodeEffAnnot annot with
  | Just e -> newAstTypeFun b (spanOf annot) [] (ty c b t) (Just (row c b (must NodeEffRow e)))
  | None -> ty c b t

-- Several equations as one: a `match` on the arguments, `_arg0` …, each
-- named where the function is, an arm an equation, its patterns spanning its
-- body.
fun equations
    (c : Lc)
    b
    (n : Nm)
    (params : [GTree])
    ret
    (body : GTree)
    (clauses : [GTree])
    (m : Meta) =
  if V.isEmpty clauses or V.isEmpty params then
    bindOfName c b n (V.map (param c b) params) ret (expr c b body) m
  else
    let count = V.len params in
    let vars =
      V.map (\i -> newAstExprVar b n.at (nm b (named "_arg${show i}" n.at))) (V.range 0 count)
    in
    let scrutinee = (if count == 1 then V.getOr 0 vars 0 else newAstExprTuple b n.at vars) in
    let arm =
      \ps e ->
        newAstArm
          b
          (exprSpan c e)
          (patTuple b (V.map (param c b) ps) (exprSpan c e))
          None
          (expr c b e)
    in
    let arms =
      V.pushFront
        (V.map (\cl -> arm (childrenOf NodeParam cl) (must NodeExpr cl)) clauses)
        (arm params body)
    in
    let pvars =
      V.map (\i -> newAstPatVar b n.at (nm b (named "_arg${show i}" n.at))) (V.range 0 count)
    in newAstBindFun b m (nm b n) pvars ret (newAstExprMatch b m scrutinee arms)

fun patTuple b (pats : [Int]) (m : Meta) =
  if V.len pats == 1 then V.getOr 0 pats 0 else newAstPatTuple b m pats

-- `f x = e` with arguments is a function; with none, the name bound, its
-- type annotated where the name is.
fun bindOfName (c : Lc) b (n : Nm) (params : [Int]) ret body (m : Meta) =
  if not (V.isEmpty params) then newAstBindFun b m (nm b n) params ret body
  else
    let var = newAstPatVar b n.at (nm b n) in
    match ret with
    | Just t -> newAstBindPat b m (newAstPatAnn b n.at var t) body
    | None -> newAstBindPat b m var body

-- The binding a signature's clauses make, if it has any.
fun definedBy (c : Lc) b (isFun : Bool) (n : Nm) (clauses : [GTree]) (m : Meta) =
  match V.get clauses 0 with
  | None -> None
  | Just head ->
      let params = childrenOf NodeParam head in
      let body = must NodeExpr head in
      let rest = V.drop clauses 1 in
      if isFun and V.isEmpty params and V.isEmpty rest then
        Just (newAstBindFun b m (nm b n) [] None (expr c b body))
      else Just (equations c b n params None body rest m)

-- --- pattern synonyms --------------------------------------------------------

fun patternDecl (c : Lc) b (s : GTree) (n : Nm) (form : Maybe GTree) =
  let whole = spanOf s in
  match form with
  | Just syn ->
      (if R.kindOf syn == NodeSynonym then
         synonym c b n syn (spanMeta (metaStart n.at) (metaEnd whole))
       else
         let names =
           V.pushFront
             (V.map (\x -> nameOf (must TokenUpperIdent x)) (childrenOf NodeCompleteName syn))
             n
         in [complete
               b
               names
               (spanMeta (metaStart n.at) (metaEnd (V.getOr n names (V.len names - 1)).at))])
  | None -> [complete b [n] n.at]

-- A synonym's matcher -- `$m2P`, answering what its pattern binds in a list
-- -- and, where it can be built, its builder `$bP`.
fun synonym (c : Lc) b (n : Nm) (s : GTree) (m : Meta) =
  let ps = V.map vid (childrenOf NodeVid s) in
  let both = tokenIs TokenEq s in
  let rhs = must NodePat s in
  let at = \t -> named t n.at in
  let vars = \u -> V.map (\(p : Nm) -> newAstExprVar b p.at (nm b p)) ps in
  let noArgs = \t -> newAstExprCons b m (nm b (at t)) [] in
  let yes =
    (match V.len ps with
     | 0 -> noArgs "True"
     | 1 -> newAstExprList b m (vars ())
     | _ -> newAstExprList b m [newAstExprTuple b m (vars ())])
  in
  let no = (if V.len ps == 0 then noArgs "False" else newAstExprList b m []) in
  let arms = [newAstArm b m (pat c b rhs) None yes, newAstArm b m (newAstPatWild b m) None no] in
  let scrutinee = at "$scrutinee" in
  let matcher =
    newAstDeclBind
      b
      m
      (newAstBindFun
         b
         m
         (nm b (at "$m${show (V.len ps)}${n.text}"))
         [newAstPatVar b n.at (nm b scrutinee)]
         None
         (newAstExprMatch b m (newAstExprVar b m (nm b scrutinee)) arms))
  in
  let builder =
    (match childOf NodeSynBuilder s with
     | Just bl -> Just (V.map (param c b) (childrenOf NodeParam bl), expr c b (must NodeExpr bl))
     | None ->
         if both and builds rhs then
           Just (V.map (\(p : Nm) -> newAstPatVar b p.at (nm b p)) ps, patExpr c b rhs)
         else None)
  in match builder with
     | Just (params, body) ->
         [
           (False, matcher),
           (
             False,
             newAstDeclBind b m (newAstBindFun b m (nm b (at "$b${n.text}")) params None body)
           )
         ]
     | None -> [(False, matcher)]

-- `pattern A | B`: the matchers that together match every value.
fun complete b (names : [Nm]) (m : Meta) =
  let ms = V.map (\(x : Nm) -> newAstExprVar b x.at (nm b (named "$m?${x.text}" x.at))) names in
  let value = (if V.len ms == 1 then V.getOr 0 ms 0 else newAstExprTuple b m ms) in
  let label = named "$complete:${S.join "|" (V.map (\(x : Nm) -> x.text) names)}" m in
  (False, newAstDeclBind b m (newAstBindPat b m (newAstPatVar b m (nm b label)) value))

-- --- types -------------------------------------------------------------------

-- --- types -------------------------------------------------------------------
--
-- A pass, from the tree's rules for types to `Ast`'s: a case for each rule,
-- its children lowered before it sees them. It starts at the rules the rest
-- of this file comes to a type by -- a type, an atom of one, a row and a
-- label -- since the rest is not a pass yet, and calls these.

pass! {
  lowerTy : Grouped -> Ast from Type, TAtom, HeadTy, EffRow, RowLabel
    | Type { head, raw arrow } ->
        (match arrow with
         | None -> head
         | Just a ->
             newAstTypeFun
               out
               (spanOf node)
               [head]
               (lowerTyType () out (must NodeType a))
               (M.map (\e -> lowerTyEffRow () out (must NodeEffRow e)) (childOf NodeEffAnnot a)))
    | THead { con, paren, array, brack, recTy } ->
        (match V.get (V.concatMap asList [con, paren, array, brack, recTy]) 0 with
         | Just t -> t
         | _ -> newAstTypeVar out (spanOf node) (nm out (firstName node)))
    | TCon { args } -> newAstTypeCon out (spanOf node) (nm out (typeName node)) args
    | TAtom { paren, array, brack, recTy } ->
        (match V.get (V.concatMap asList [paren, array, brack, recTy]) 0 with
         | Just t -> t
         | _ -> named_ out node)
    | HeadTy { paren, array, brack, raw row } ->
        (match (row, V.get (V.concatMap asList [paren, array, brack]) 0) with
         | (Just br, _) ->
             newAstTypeRow
               out
               (spanOf br)
               (newAstRow
                  out
                  (spanOf br)
                  (V.map (\l -> lowerTyRowLabel () out l) (childrenOf NodeRowLabel br))
                  (M.map (\r -> nm out (lastName r)) (childOf NodeRowTail br)))
         | (_, Just t) -> t
         | _ -> named_ out node)
    | TParen { tys } ->
        (match V.len tys with
         | 0 -> newAstTypeCon out (spanOf node) (nm out (named "Unit" (spanOf node))) []
         | 1 -> V.getOr (0 - 1) tys 0
         | _ -> newAstTypeTuple out (spanOf node) tys)
    | TArray { ty } -> newAstTypeCon out (spanOf node) (nm out (named "Array" (spanOf node))) [ty]
    | TBrack { ty } ->
        (if tokenIs TokenSemiColon node then newAstTypeList out (spanOf node) ty
         else newAstTypeVector out (spanOf node) ty)
    | RecTy { fields, tail } -> newAstTypeRecord out (spanOf node) fields tail
    | FieldTy { ty } ->
        newAstTypeField out (spanOf node) (nm out (nameOf (must TokenLowerIdent node))) ty
    | RowTail {} -> nm out (lastName node)
    | EffRow { raw braces, label } ->
        (match (braces, label) with
         | (Just br, _) ->
             newAstRow
               out
               (spanOf node)
               (V.map (\l -> lowerTyRowLabel () out l) (childrenOf NodeRowLabel br))
               (M.map (\r -> nm out (lastName r)) (childOf NodeRowTail br))
         | (None, Just l) -> newAstRow out (spanOf node) [l] None
         | _ -> newAstRow out (spanOf node) [] (Just (nm out (firstName node))))
    | RowLabel { args } -> newAstLabel out (spanOf node) (nm out (firstName node)) args
}

fun asList (x : Maybe a) : [a] = match x with | Just v -> [v] | None -> []

-- An atom that is one name: a constructor with nothing given it, or a
-- variable; and with no name at all, the empty tuple.
fun named_ out (s : GTree) =
  match V.get (tokenKids s) 0 with
  | Just t ->
      -- `M.Ty`: a constructor, qualified.
      if not (V.isEmpty (childrenOf NodeTQual s)) then
        newAstTypeCon out (spanOf s) (nm out (typeName s)) []
      else if R.kindOf t == TokenUpperIdent or R.kindOf t == TokenMacUpper then
        newAstTypeCon out (spanOf s) (nm out (nameOf t)) []
      else newAstTypeVar out (spanOf s) (nm out (nameOf t))
  | None -> newAstTypeTuple out (spanOf s) []

-- The pass's functions, as the rest of this file calls them.
fun ty (c : Lc) b (s : GTree) = lowerTyType () b s

-- A type atom: a `TAtom`, a `THead` but for a constructor with arguments, or
-- a `HeadTy`.
fun tatom (c : Lc) b (s : GTree) =
  if R.kindOf s == NodeHeadTy then lowerTyHeadTy () b s else lowerTyTAtom () b s

fun row (c : Lc) b (s : GTree) = lowerTyEffRow () b s

-- --- patterns ----------------------------------------------------------------
--
-- A pass, `lowerPat`, from the grammar's patterns and parameters to the
-- tree's. What it carries says where a pattern is told to span, if not where
-- it was written -- one pattern in parentheses, as an argument, spans the
-- parentheses -- and whether parentheses round one pattern are part of it
-- (`spans`): of an argument they are, of a parameter not.

-- What a pattern carries where nothing tells it to span anywhere else.
fun px (c : Lc) =
  let nowhere : Maybe Meta = None in
  { c, over = nowhere, spans = True }

fun pat (c : Lc) b (s : GTree) = lowerPatPat () b (px c) s

fun param (c : Lc) b (s : GTree) = lowerPatParam () b (px c) s

-- Parentheses in a pattern: `()`, `(p : T)`, `(f -> p)`, a tuple -- or one
-- pattern, which as an argument (`spans`) takes the parentheses' span and as
-- a parameter keeps its own. A pattern's own, or an expression's read as
-- one: the two are written alike.
fun parenPat (c : Lc) b (s : GTree) (spans : Bool) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let elems = childrenOf NodeElem s in
  let elem = \e o -> lowerPatElem () b { (px c) | over = o } e in
  match childOf NodeParenAnnot s with
  | Just a -> newAstPatAnn b m (elem (V.getOr s elems 0) None) (ty c b (must NodeType a))
  | None ->
      (match V.len elems with
       | 0 -> newAstPatUnit b m
       | 1 -> elem (V.getOr s elems 0) (if spans then Just m else None)
       | _ -> newAstPatTuple b m (V.map (\e -> elem e None) elems))

pass! {
  lowerPat : Grouped -> Ast with cx from Pat, Param, Elem
    | Pat { later first, later conses, raw ases } ->
        asesAt
          out
          (V.zip
             (V.map (\f -> \o -> f { cx | over = o }) (V.pushFront conses first))
             (V.pushFront
                (V.map (\t -> patomSpan (must NodePAtom t)) (childrenOf NodeConsTail node))
                (patomSpan (must NodePAtom node))))
          ases
          (spanOf node)
          cx.over
    | ConsTail { atom } -> atom
    | PAtom { con, arg } -> M.unwrapOr (M.unwrapOr (0 - 1) arg) con
    -- `A x y`, `A.B x y`, or either with nothing after it.
    | ConPat { later args } ->
        conOf out node (V.map (\a -> a (px cx.c)) args) (M.unwrapOr (spanOf node) cx.over)
    | NullCon {} -> conOf out node [] (M.unwrapOr (spanOf node) cx.over)
    | Parg { later con, later arg } ->
        (match (con, arg) with
         | (Just f, _) -> f (px cx.c)
         | (_, Just f) -> f (px cx.c)
         | _ -> 0 - 1)
    -- A pattern's argument, spanning all it was written with.
    | Arg { later paren, recPat, array, brack, raw var, raw mac } ->
        (let m = M.unwrapOr (spanOf node) cx.over in
         match (paren, V.get (V.concatMap asList [recPat, array, brack]) 0, var, mac) with
         | (Just f, _, _, _) -> f { cx | spans = True }
         | (_, Just p, _, _) -> p
         | (_, _, Just v, _) -> newAstPatVar out m (nm out (vid v))
         | (_, _, _, Just call) -> patCall cx.c out m call
         | _ -> litOrWild cx.c out node m)
    -- A parameter: as a pattern's argument, but for parentheses round one
    -- pattern, which are not part of it, and a bracket, which starts a whole
    -- pattern.
    | Param { later con, later paren, later recPat, later brack, later array, raw var } ->
        (let plain = px cx.c in
         let m = spanOf node in
         match V.get (V.concatMap asList [con, recPat, brack, array]) 0 with
         | Just f -> f plain
         | None ->
             (match (paren, var) with
              | (Just f, _) -> f { plain | spans = False }
              | (_, Just v) -> newAstPatVar out m (nm out (vid v))
              | _ -> litOrWild cx.c out node m))
    | BrackParam { later first, later conses, raw ases } ->
        asesAt out (headed cx node NodeBrackPat first conses) ases (spanOf node) None
    | ArrParam { later first, later conses, raw ases } ->
        asesAt out (headed cx node NodeArrPat first conses) ases (spanOf node) None
    | RecPat { later fields, raw open } ->
        newAstPatRecord
          out
          (M.unwrapOr (spanOf node) cx.over)
          (V.map (\f -> f (px cx.c)) fields)
          (M.isSome open)
    | PField { later value } ->
        (let n = nameOf (must TokenLowerIdent node) in
         newAstPatField
           out
           (spanOf node)
           (nm out n)
           (match value with
            | Just f -> f (px cx.c)
            | None -> newAstPatVar out n.at (nm out n)))
    | PFieldValue { pat } -> pat
    | ArrPat { later items } ->
        newAstPatArray out (M.unwrapOr (spanOf node) cx.over) (V.map (\f -> f (px cx.c)) items)
    -- `[p; q]`, `[;]`, `[p, q]`, `[]`.
    | BrackPat { raw body } ->
        (let m = M.unwrapOr (spanOf node) cx.over in
         let each =
           \k t -> V.map (pat cx.c out) (V.concatMap (childrenOf NodePat) (childrenOf k t))
         in match body with
            | None -> newAstPatVector out m []
            | Just inside ->
                (match childOf NodePat inside with
                 | None -> newAstPatList out m []
                 | Just first ->
                     (let p = pat cx.c out first in
                      match (childOf NodeListPatTail inside, childOf NodeVecPatTail inside) with
                      | (Just t, _) -> newAstPatList out m (V.pushFront (each NodeSemiPat t) p)
                      | (_, Just t) -> newAstPatVector out m (V.pushFront (each NodeCommaPat t) p)
                      | _ -> newAstPatVector out m [p])))
    | PatParen {} -> parenPat cx.c out node cx.spans cx.over
    -- An element of a pattern's parentheses: `f -> p`, or a pattern.
    | Elem { raw expr, raw ases, raw view } ->
        (match view with
         | Just v ->
             (let p = must NodePat v in
              newAstPatView
                out
                (M.unwrapOr
                   (spanMeta (metaStart (exprSpan cx.c expr)) (metaEnd (spanOf p)))
                   cx.over)
                (exprOf cx.c out expr)
                (pat cx.c out p))
         | None -> asesAt out (exprPatParts cx.c out expr) ases (spanOf node) cx.over)
}

-- A parameter that starts with a bracket's pattern: that, at the span it is
-- told to take, and what is consed after it.
fun headed cx (s : GTree) (k : Grouped) first conses =
  V.zip
    (V.map (\f -> \o -> f { (px cx.c) | over = o }) (V.pushFront conses first))
    (V.pushFront
       (V.map (\t -> patomSpan (must NodePAtom t)) (childrenOf NodeConsTail s))
       (spanOf (must k s)))

-- A constructor's pattern, qualified by its type or not.
fun conOf b (s : GTree) written (m : Meta) =
  if has NodeQualTail s then
    (match qualParts s with
     | (q, x) -> newAstPatQualCons b m (nm b q) (nm b x) written)
  else newAstPatCons b m (nm b (nameOf (must TokenUpperIdent s))) written

-- A pattern's parts, each written at a span it may be told to take, and the
-- span it has of its own: joined by `::`, then by `as`.
fun asesAt b parts (names : [GTree]) (whole : Meta) (over : Maybe Meta) =
  if V.isEmpty names then consTagged True b parts over
  else
    let inner =
      V.foldl
        (\f a -> \o -> newAstPatAs b (M.unwrapOr whole o) (nm b (vid (must NodeVid a))) (f None))
        (\o -> consTagged True b parts o)
        names
    in inner over

-- `a :: b :: c` as `Cons(a, Cons(b, c))`, a pattern's or an expression's.
fun consTagged (isPat : Bool) b parts (over : Maybe Meta) =
  match V.get parts 0 with
  | None -> 0 - 1
  | Just (f, hm) ->
      let rest = V.drop parts 1 in
      if V.isEmpty rest then f over
      else
        let tailEnd =
          (match V.get rest (V.len rest - 1) with
           | Just (_, tm) -> metaEnd tm
           | None -> metaEnd hm)
        in
        let whole = spanMeta (metaStart hm) tailEnd in
        let m = M.unwrapOr whole over in
        let name = nm b (named "Cons" whole) in
        let args = [f None, consTagged isPat b rest None] in
        if isPat then newAstPatCons b m name args else newAstExprCons b m name args

fun patomSpan (s : GTree) : Meta =
  match childOf NodeConPat s with
  | Just con -> spanOf con
  | None -> spanOf s

fun litOrWild (c : Lc) b (s : GTree) (m : Meta) =
  match V.get (tokenKids s) 0 with
  | Just t ->
      (if R.kindOf t == TokenWildcard then newAstPatWild b m else newAstPatLit b m (lit c b t))
  | None -> newAstPatWild b m

-- An expression, as the rest of this file writes one: the pass's cases name
-- a field `expr`, which this is not.
fun exprOf (c : Lc) b (s : GTree) = expr c b s

-- --- a pattern written as an expression --------------------------------------
--
-- What parentheses in a pattern hold is read as an expression, and, where no
-- `->` follows, as the pattern it is.

fun exprPatParts (c : Lc) b (s : GTree) =
  V.map
    (\o -> (let bs = must NodeBase o in (\over -> basePat c b bs over, spanOf bs)))
    (operandsOf s)

fun basePat (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let head = must NodeHead s in
  let args = childrenOf NodeAtom s in
  let m = M.unwrapOr (spanOf s) over in
  match firstNode head with
  | Just h ->
      let k = R.kindOf h in
      if k == NodeMacCall then patCall c b m h
      else if k == NodeQualHead then
        (match qualParts h with
         | (q, x) -> newAstPatQualCons b m (nm b q) (nm b x) (V.map (atomPat c b) args))
      else lowPat c b h over
  | None -> newAstPatCons b m (nm b (firstName head)) (V.map (atomPat c b) args)

fun atomPat (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeMacAtom then patCall c b m n
      else if k == NodeQualAtom then
        (match qualParts n with
         | (q, x) -> newAstPatQualCons b m (nm b q) (nm b x) [])
      else lowPat c b n None
  | None -> newAstPatCons b m (nm b (firstName s)) []

fun lowPat (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let prim =
    (match childOf NodeClosedAtom s with
     | Just ca -> M.unwrapOr ca (firstNode ca)
     | None -> M.unwrapOr s (firstNode s))
  in
  let m = M.unwrapOr (spanOf prim) over in
  let k = R.kindOf prim in
  if k == NodeParen then parenPat c b prim True over
  else if k == NodeOpRef then newAstPatVar b m (nm b (firstName (must NodeOpName prim)))
  else if k == NodeLitE then newAstPatLit b m (lit c b (V.getOr prim (tokenKids prim) 0))
  else if k == NodeVarE then newAstPatVar b m (nm b (firstName prim))
  else if k == NodeHoleE then newAstPatWild b m
  else if k == NodeBraceE then bracePat c b prim m
  else if k == NodeBrackE then brackExprPat c b prim m
  else if k == NodeArrE then newAstPatArray b m (V.map (asExprPat c b) (childrenOf NodeAsExpr prim))
  else newAstPatWild b m

fun asExprPat (c : Lc) b (s : GTree) =
  asesAt b (exprPatParts c b (must NodeExpr s)) (childrenOf NodeAsTail s) (spanOf s) None

fun bracePat (c : Lc) b (s : GTree) (m : Meta) =
  let fs =
    V.map
      (\item ->
        let n = firstName (must NodeAsExpr item) in
        newAstPatField
          b
          (spanOf item)
          (nm b n)
          (match childOf NodeFieldValue item with
           | Just v -> asExprPat c b (must NodeAsExpr v)
           | None -> newAstPatVar b n.at (nm b n)))
      (childrenOf NodeBraceItem s)
  in newAstPatRecord b m fs (has NodeBraceTail s)

fun brackExprPat (c : Lc) b (s : GTree) (m : Meta) =
  match childOf NodeBrackBody s with
  | None -> newAstPatVector b m []
  | Just body ->
      (match childOf NodeAsExpr body with
       | None -> newAstPatList b m []
       | Just first ->
           let p = asExprPat c b first in
           (match childOf NodeListTail body with
            | Just t ->
                newAstPatList
                  b
                  m
                  (V.pushFront
                     (V.map
                        (asExprPat c b)
                        (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                     p)
            | None ->
                (match childOf NodeVecTail body with
                 | Just t ->
                     newAstPatVector
                       b
                       m
                       (V.pushFront
                          (V.map
                             (asExprPat c b)
                             (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeCommaItem t)))
                          p)
                 | None -> newAstPatVector b m [p])))

-- --- a pattern as the expression that builds what it matches -----------------

-- Whether pattern `s` can be read as an expression -- `meadow-parser`'s
-- `pat_expr`.
fun builds (s : GTree) : Bool =
  not (has NodeAsTail s)
    and V.all
      patomBuilds
      (V.pushFront (V.map (\t -> must NodePAtom t) (childrenOf NodeConsTail s)) (must NodePAtom s))

fun patomBuilds (s : GTree) : Bool =
  match childOf NodeConPat s with
  | Just con -> not (has NodeQualTail con) and V.all pargBuilds (childrenOf NodeParg con)
  | None -> argBuilds (must NodeArg s)

fun pargBuilds (s : GTree) : Bool =
  match childOf NodeNullCon s with
  | Just con -> not (has NodeQualTail con)
  | None -> argBuilds (must NodeArg s)

fun argBuilds (s : GTree) : Bool =
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeVid then True
      else if k == NodeRecPat then
        not (has NodeOpenTail n)
          and V.all
            (\f ->
              match childOf NodePFieldValue f with
              | Just v -> builds (must NodePat v)
              | None -> True)
            (childrenOf NodePField n)
      else if k == NodeArrPat then V.all builds (childrenOf NodePat n)
      else if k == NodeBrackPat then
        (match childOf NodeBrackPatBody n with
         | None -> False
         | Just body ->
             (match childOf NodeListPatTail body with
              | Just t ->
                  V.all
                    builds
                    (V.append
                       (childrenOf NodePat body)
                       (V.concatMap (childrenOf NodePat) (childrenOf NodeSemiPat t)))
              | None -> not (has NodePat body)))
      else if k == NodePatParen then V.all elemBuilds (childrenOf NodeElem n)
      else False
  | None -> not (tokenIs TokenWildcard s)

fun elemBuilds (s : GTree) : Bool =
  not (has NodeAsTail s)
    and not (has NodeViewTail s)
    and V.all
      (\o -> V.isEmpty (childrenOf TokenMinus o) and baseBuilds (must NodeBase o))
      (operandsOf (must NodeExpr s))

-- The operands of an expression read as a pattern: what `::` joins, left to
-- right, however the fixity pass grouped them.
fun operandsOf (e : GTree) : [GTree] =
  let andE = must NodeAndE (must NodeOrE (must NodePipeL e)) in
  match firstNode andE with
  | Just ops -> leavesOf ops
  | None -> []

fun leavesOf (s : GTree) : [GTree] =
  match s with
  | GroupedInfix l _ r -> V.append (leavesOf l) (leavesOf r)
  | GroupedLeaf operand -> [operand]
  | _ -> []

fun baseBuilds (s : GTree) : Bool =
  match firstNode (must NodeHead s) with
  | Just h -> R.kindOf h == NodeLowAtom and V.isEmpty (childrenOf NodeAtom s) and lowBuilds h
  | None ->
      V.all
        (\a ->
          match firstNode a with
          | Just n -> R.kindOf n == NodeLowAtom and lowBuilds n
          | None -> True)
        (childrenOf NodeAtom s)

fun lowBuilds (s : GTree) : Bool =
  match childOf NodeClosedAtom s with
  | Just ca ->
      let prim = M.unwrapOr ca (firstNode ca) in
      let k = R.kindOf prim in
      not (has NodeFieldTail ca)
        and (if k == NodeParen then V.all elemBuilds (childrenOf NodeElem prim)
         else if k == NodeOpRef or k == NodeLitE or k == NodeVarE then True
         else if k == NodeBraceE then
           not (has NodeBraceTail prim)
             and V.all
               (\i ->
                 match childOf NodeFieldValue i with
                 | Just v -> elemBuilds (must NodeAsExpr v)
                 | None -> True)
               (childrenOf NodeBraceItem prim)
         else if k == NodeBrackE then
           (match childOf NodeBrackBody prim with
            | None -> False
            | Just body ->
                (match childOf NodeListTail body with
                 | Just t ->
                     V.all
                       elemBuilds
                       (V.append
                          (childrenOf NodeAsExpr body)
                          (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                 | None -> not (has NodeAsExpr body)))
         else if k == NodeArrE then V.all elemBuilds (childrenOf NodeAsExpr prim)
         else False)
  | None -> False

-- Pattern `s` written as the expression that builds it: each part at the
-- pattern's own span.
fun patExpr (c : Lc) b (s : GTree) =
  let atoms =
    V.pushFront (V.map (\t -> must NodePAtom t) (childrenOf NodeConsTail s)) (must NodePAtom s)
  in consExpr c b atoms

fun consExpr (c : Lc) b (atoms : [GTree]) =
  match V.get atoms 0 with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just h ->
      let rest = V.drop atoms 1 in
      if V.isEmpty rest then patomExpr c b h
      else
        let m =
          spanMeta (metaStart (patomSpan h)) (metaEnd (patomSpan (V.getOr h rest (V.len rest - 1))))
        in newAstExprCons b m (nm b (named "Cons" m)) [patomExpr c b h, consExpr c b rest]

fun patomExpr (c : Lc) b (s : GTree) =
  match childOf NodeConPat s with
  | Just con ->
      newAstExprCons
        b
        (spanOf con)
        (nm b (nameOf (must TokenUpperIdent con)))
        (V.map (pargExpr c b) (childrenOf NodeParg con))
  | None -> argExpr c b (must NodeArg s)

fun pargExpr (c : Lc) b (s : GTree) =
  match childOf NodeNullCon s with
  | Just con -> newAstExprCons b (spanOf con) (nm b (nameOf (must TokenUpperIdent con))) []
  | None -> argExpr c b (must NodeArg s)

fun argExpr (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeVid then newAstExprVar b m (nm b (vid n))
      else if k == NodeRecPat then
        newAstExprRecord
          b
          m
          (V.map
             (\f ->
               (let fn = nameOf (must TokenLowerIdent f) in
                newAstExprField
                  b
                  (spanOf f)
                  (nm b fn)
                  (match childOf NodePFieldValue f with
                   | Just v -> patExpr c b (must NodePat v)
                   | None -> newAstExprVar b fn.at (nm b fn))))
             (childrenOf NodePField n))
          None
      else if k == NodeArrPat then newAstExprArray b m (V.map (patExpr c b) (childrenOf NodePat n))
      else if k == NodeBrackPat then
        (match childOf NodeBrackPatBody n with
         | Just body ->
             newAstExprList
               b
               m
               (V.map
                  (patExpr c b)
                  (V.append
                     (childrenOf NodePat body)
                     (V.concatMap
                        (childrenOf NodePat)
                        (V.concatMap (childrenOf NodeSemiPat) (childrenOf NodeListPatTail body)))))
         | None -> newAstExprList b m [])
      else if k == NodePatParen then parenExpr c b n (Just m)
      else newAstExprUnit b m
  | None ->
      (match V.get (tokenKids s) 0 with
       | Just t -> newAstExprLit b m (lit c b t)
       | None -> newAstExprUnit b m)

-- The same, for parentheses in a pattern, whose elements are read as
-- expressions and then as patterns.
fun parenExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let elems = childrenOf NodeElem s in
  match (childOf NodeParenAnnot s, V.get elems 0) with
  | (Just _, Just e) -> elemExpr c b e None
  | (_, None) -> newAstExprUnit b m
  | (None, Just e) ->
      if V.len elems == 1 then elemExpr c b e (Just m)
      else newAstExprTuple b m (V.map (\x -> elemExpr c b x None) elems)

fun elemExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  consTagged
    False
    b
    (V.map
       (\o -> (let bs = must NodeBase o in (\ov -> baseExpr c b bs ov, spanOf bs)))
       (operandsOf (must NodeExpr s)))
    over

fun baseExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let head = must NodeHead s in
  match firstNode head with
  | Just h -> lowExpr c b h over
  | None ->
      newAstExprCons
        b
        (M.unwrapOr (spanOf s) over)
        (nm b (firstName head))
        (V.map
           (\a ->
             match firstNode a with
             | Just n -> lowExpr c b n None
             | None -> newAstExprCons b (spanOf a) (nm b (firstName a)) [])
           (childrenOf NodeAtom s))

fun lowExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let prim =
    (match childOf NodeClosedAtom s with
     | Just ca -> M.unwrapOr ca (firstNode ca)
     | None -> s)
  in
  let m = M.unwrapOr (spanOf prim) over in
  let k = R.kindOf prim in
  if k == NodeParen then parenExpr c b prim over
  else if k == NodeOpRef then newAstExprVar b m (nm b (firstName (must NodeOpName prim)))
  else if k == NodeLitE then newAstExprLit b m (lit c b (V.getOr prim (tokenKids prim) 0))
  else if k == NodeVarE then newAstExprVar b m (nm b (firstName prim))
  else if k == NodeBraceE then
    newAstExprRecord
      b
      m
      (V.map
         (\i ->
           let n = firstName (must NodeAsExpr i) in
           newAstExprField
             b
             (spanOf i)
             (nm b n)
             (match childOf NodeFieldValue i with
              | Just v -> elemExpr c b (must NodeAsExpr v) None
              | None -> newAstExprVar b n.at (nm b n)))
         (childrenOf NodeBraceItem prim))
      None
  else if k == NodeBrackE then
    (match childOf NodeBrackBody prim with
     | Just body ->
         newAstExprList
           b
           m
           (V.map
              (\x -> elemExpr c b x None)
              (V.append
                 (childrenOf NodeAsExpr body)
                 (V.concatMap
                    (childrenOf NodeAsExpr)
                    (V.concatMap (childrenOf NodeSemiItem) (childrenOf NodeListTail body)))))
     | None -> newAstExprList b m [])
  else if k == NodeArrE then
    newAstExprArray b m (V.map (\x -> elemExpr c b x None) (childrenOf NodeAsExpr prim))
  else newAstExprUnit b m

-- --- literals ----------------------------------------------------------------

fun lit (c : Lc) b (t : GTree) =
  let m = spanOf t in
  match tokenOf c t with
  | Just (Int n) -> newAstLitInt b m (show n)
  | Just (Real s) -> newAstLitFloat b m s
  | Just (Str s) -> newAstLitString b m s
  | Just (Char n) -> newAstLitChar b m (show n)
  | _ -> newAstLitString b m (R.text t)

-- --- expressions -------------------------------------------------------------
--
-- A pass, `lowerExpr`, from the grammar's expressions to the tree's: a case
-- to each rule. What it carries is the holes of the section an expression is
-- in, if any -- the start of each `_` it owns, in the order `meadow-parser`
-- numbers them -- and where the expression is told to span, if not where it
-- was written: `(e)` spans `e`.

-- What an expression carries, of a section's holes `hs`, told to span `over`.
fun ex (c : Lc) (hs : [Int]) (over : Maybe Meta) = { c, hs, over }

fun expr (c : Lc) b (s : GTree) = exprIn c b [] s None

fun exprIn (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  lowerExprExpr () b (ex c hs over) s

-- Each of `fs`, which writes a part where it is told to span, with the span
-- the part has of its own.
fun spanning cx fs (spans : [Meta]) = V.zip (V.map (\f -> \o -> f { cx | over = o }) fs) spans

pass! {
  lowerExpr : Grouped -> Ast with cx from Expr, LowAtom
    -- `f <| g <| x` is `f (g x)`: applications, each spanning what it joins.
    | Expr { later first, later backs } ->
        applied
          out
          False
          (spanning
             cx
             (V.pushFront backs first)
             (V.map
                (\p -> pipeSpan cx.c (must NodePipeL p))
                (V.pushFront (childrenOf NodeBackPipe node) node)))
          cx.over
    | BackPipe { operand } -> operand
    -- `x |> f |> g` is `g (f x)`: a left fold, the last applied to the rest.
    | PipeL { later first, later pipes } ->
        applied
          out
          True
          (spanning
             cx
             (V.pushFront pipes first)
             (V.map
                (\p -> orSpan cx.c (must NodeOrE p))
                (V.pushFront (childrenOf NodePipe node) node)))
          cx.over
    | Pipe { operand } -> operand
    | OrE { later first, later ors } ->
        binFold
          out
          False
          (spanning
             cx
             (V.pushFront ors first)
             (V.map
                (\t -> andSpan cx.c (must NodeAndE t))
                (V.pushFront (childrenOf NodeOrTail node) node)))
          cx.over
    | OrTail { operand } -> operand
    | AndE { later first, later ands } ->
        binFold
          out
          True
          (spanning
             cx
             (V.pushFront ands first)
             (V.map
                (\t -> opsSpan cx.c (M.unwrapOr t (firstNode t)))
                (V.pushFront (childrenOf NodeAndTail node) node)))
          cx.over
    | AndTail { operand } -> operand
    -- A chain of operators, grouped: `(+) a b` for each operator applied to
    -- two, spanning its operands, and `Cons a b` for `::`. A chain's span is
    -- its operands'; the parentheses round one are not part of it.
    | Infix { later lhs, raw op, later rhs } ->
        (let plain = { cx | over = None } in
         let m =
           (match node with
            | GroupedInfix l _ r -> join (opsSpan cx.c l) (opsSpan cx.c r)
            | _ -> spanOf node)
         in
         let name = S.trim (R.text op) in
         let l = lhs plain in
         let r = rhs plain in
         if name == "::" then newAstExprCons out m (nm out (named "Cons" (spanOf op))) [l, r]
         else
           newAstExprApp out m (newAstExprVar out (spanOf op) (nm out (named name (spanOf op)))) [
             l,
             r
           ])
    | Leaf { operand } -> operand
    | Operand { later base } ->
        (let minuses = childrenOf TokenMinus node in
         if V.isEmpty minuses then base cx
         else negated cx.c out cx.hs minuses (must NodeBase node) cx.over)
    -- What is applied, and to what: a macro call, a qualified name -- which
    -- spans its arguments too -- a constructor, or an atom.
    | Base { raw head, later args } ->
        (let m = M.unwrapOr (spanOf node) cx.over in
         let plain = { cx | over = None } in
         let written = \u -> V.map (\a -> a plain) args in
         let applied =
           \f -> if V.isEmpty args then f cx.over else newAstExprApp out m (f None) (written ())
         in match firstNode head with
            | Just h ->
                (let k = R.kindOf h in
                 if k == NodeMacCall then
                   applied (\o -> exprCall cx.c out (M.unwrapOr (macSpan h) o) h)
                 else if k == NodeQualHead then
                   applied (\o ->
                     match qualParts h with
                     | (q, x) -> newAstExprQual out (spanOf node) (nm out q) (nm out x))
                 else applied (\o -> lowerExprLowAtom () out { cx | over = o } h))
            | None -> newAstExprCons out m (nm out (firstName head)) (written ()))
    | Atom {} ->
        (let m = spanOf node in
         match firstNode node with
         | Just n ->
             (let k = R.kindOf n in
              if k == NodeMacAtom then fieldsOf out n (exprCall cx.c out (macSpan n) n)
              else if k == NodeQualAtom then
                (match qualParts n with
                 | (q, x) ->
                     fieldsOf out n (newAstExprQual out (from q.at x.at) (nm out q) (nm out x)))
              else lowerExprLowAtom () out { cx | over = None } n)
         | None -> newAstExprCons out m (nm out (firstName node)) [])
    | LowAtom { closed, open } ->
        M.unwrapOr (M.unwrapOr (newAstExprUnit out (spanOf node)) open) closed
    -- An atom and its `.field`s: with any, the atom spans itself.
    | ClosedAtom { later prim, raw fields } ->
        (if V.isEmpty fields then prim cx else fieldsOf out node (prim { cx | over = None }))
    | Paren {} -> parenE cx.c out cx.hs node cx.over
    | OpRef {} ->
        newAstExprVar
          out
          (M.unwrapOr (spanOf node) cx.over)
          (nm out (firstName (must NodeOpName node)))
    | LitE {} ->
        newAstExprLit
          out
          (M.unwrapOr (spanOf node) cx.over)
          (lit cx.c out (V.getOr node (tokenKids node) 0))
    | InterpE {} -> interp cx.c out cx.hs node (M.unwrapOr (spanOf node) cx.over)
    | VarE {} -> newAstExprVar out (M.unwrapOr (spanOf node) cx.over) (nm out (firstName node))
    -- `_`: the parameter of the section that owns it, or a hole.
    | HoleE {} ->
        (let m = M.unwrapOr (spanOf node) cx.over in
         let at = metaStart (spanOf node) in
         match V.find (\i -> V.getOr (0 - 1) cx.hs i == at) (V.range 0 (V.len cx.hs)) with
         | Just i -> newAstExprVar out m (nm out (named "_hole${show i}" (spanOf node)))
         | None -> newAstExprHole out m)
    | BraceE {} -> braceE cx.c out cx.hs node (M.unwrapOr (spanOf node) cx.over)
    | BrackE {} -> brackE cx.c out cx.hs node (M.unwrapOr (spanOf node) cx.over)
    | ArrE { later items } ->
        newAstExprArray
          out
          (M.unwrapOr (spanOf node) cx.over)
          (V.map (\x -> x { cx | over = None }) items)
    | AsExpr { expr } -> expr
    | IfE { later cond, later yes, later no } ->
        (let plain = { cx | over = None } in
         newAstExprIf out (M.unwrapOr (spanOf node) cx.over) (cond plain) (yes plain) (no plain))
    -- A lambda's body is in no section: its holes are its own.
    | LamE { raw params, raw body } ->
        newAstExprLam
          out
          (M.unwrapOr (spanOf node) cx.over)
          (V.map (pat cx.c out) params)
          (expr cx.c out body)
    | MatchE { later scrutinee, later arms } ->
        (let plain = { cx | over = None } in
         newAstExprMatch
           out
           (M.unwrapOr (spanOf node) cx.over)
           (scrutinee plain)
           (V.map (\a -> a plain) arms))
    | Arm { raw pat, guard, body } -> newAstArm out (spanOf node) (patOf cx.c out pat) guard body
    | Guard { cond } -> cond
    | LetE { raw binds, later body } ->
        newAstExprLet
          out
          (M.unwrapOr (spanOf node) cx.over)
          (V.concatMap (letBind cx.c out cx.hs) binds)
          (body { cx | over = None })
    | HandleE { raw expr, raw arms } ->
        handleE cx.c out cx.hs (M.unwrapOr (spanOf node) cx.over) expr arms
}

-- A pattern, as the rest of this file writes one: the pass's cases name a
-- field `pat`, which this is not.
fun patOf (c : Lc) b (s : GTree) = pat c b s

-- Parts applied one to the next, each application spanning what it joins:
-- the first to the rest (`f <| g <| x`), or, `last`, the last to the rest
-- (`x |> f |> g`).
fun applied b (last : Bool) parts (over : Maybe Meta) =
  let n = V.len parts in
  match V.get parts (if last then n - 1 else 0) with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just (f, own) ->
      if n == 1 then f over
      else
        let rest = if last then V.take parts (n - 1) else V.drop parts 1 in
        let m = M.unwrapOr (V.foldl (\acc p -> join acc (snd p)) own rest) over in
        newAstExprApp b m (f None) [applied b last rest None]

-- `a or b or c` is `(a or b) or c`: each spanning what it joins, and so is
-- its operator.
fun binFold b (isAnd : Bool) parts (over : Maybe Meta) =
  let n = V.len parts in
  match V.get parts (n - 1) with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just (write, own) ->
      if n == 1 then write over
      else
        let rest = V.take parts (n - 1) in
        let m = V.foldl (\acc x -> join acc (snd x)) own rest in
        let op = nm b (named (if isAnd then "and" else "or") m) in
        let lhs = binFold b isAnd rest None in
        let rhs = write None in
        if isAnd then newAstExprAnd b (M.unwrapOr m over) op lhs rhs
        else newAstExprOr b (M.unwrapOr m over) op lhs rhs

-- `-e`: a literal's own value negated, and anything else under `neg` -- the
-- minus nearest the operand first, each spanning from itself to the end.
fun negated (c : Lc) b (hs : [Int]) (minuses : [GTree]) (base : GTree) (over : Maybe Meta) =
  let n = V.len minuses in
  let inner = V.drop minuses 1 in
  let first = V.getOr base minuses 0 in
  let m = M.unwrapOr (join (spanOf first) (negSpan c inner base)) over in
  match literalOf c base with
  | Just (text, isFloat) ->
      let sign = n % 2 == 1 in
      let value = if sign then flipped text else text in
      newAstExprLit b m (if isFloat then newAstLitFloat b m value else newAstLitInt b m value)
  | None ->
      newAstExprNeg
        b
        m
        (nm b (named "neg" m))
        (if V.isEmpty inner then lowerExprBase () b (ex c hs None) base
         else negated c b hs inner base None)

fun negSpan (c : Lc) (minuses : [GTree]) (base : GTree) : Meta =
  match V.get minuses 0 with
  | Just m -> join (spanOf m) (baseSpan c base)
  | None -> baseSpan c base

fun flipped (t : String) : String =
  if S.startsWith "-" t then stringSlice t 1 (stringByteLength t) else "-" ++ t

-- The literal a base is alone, as its text and whether it is a float.
fun literalOf (c : Lc) (s : GTree) : Maybe (String, Bool) =
  if not (V.isEmpty (childrenOf NodeAtom s)) then None
  else
    match M.andThen (childOf NodeLowAtom) (childOf NodeHead s) with
    | Just low ->
        (match childOf NodeClosedAtom low with
         | Just ca ->
             if has NodeFieldTail ca then None
             else
               (match childOf NodeLitE ca with
                | Just l ->
                    (match M.andThen (tokenOf c) (V.get (tokenKids l) 0) with
                     | Just (Int n) -> Just (show n, False)
                     | Just (Real t) -> Just (t, True)
                     | _ -> None)
                | None -> None)
         | None -> None)
    | None -> None

-- An atom's `.field`s, each spanning the atom and every field: the
-- outermost last.
fun fieldsOf b (s : GTree) (inner : Int) =
  let m = spanOf s in
  V.foldl
    (\e f -> newAstExprProj b m e (nm b (nameOf (must TokenLowerIdent f))))
    inner
    (childrenOf NodeFieldTail s)

-- A `let`'s binding: `fun f x = …`, `f x = …` (a name, maybe `rec`), or any
-- other pattern `= …` -- whose value a section's holes are in; a function's
-- are not.
fun letBind (c : Lc) b (hs : [Int]) (s : GTree) =
  let value = must NodeExpr s in
  let ret = M.map (resultTy c b) (childOf NodeAnnot s) in
  let params = V.map (param c b) (childrenOf NodeParam s) in
  match s with
  | GroupedFunBind name _ _ _ ->
      [bindOfName c b (nameOf name) params ret (expr c b value) (spanOf s)]
  | GroupedPatBind _ p _ _ _ ->
      (match plainName p with
       | Just n ->
           [bindOfName
              c
              b
              n
              params
              ret
              (if V.isEmpty params then exprIn c b hs value None else expr c b value)
              (spanOf s)]
       | None -> [newAstBindPat b (spanOf s) (pat c b p) (exprIn c b hs value None)])
  | _ -> []

-- A pattern that is one lower-case name as it was written.
fun plainName (p : GTree) : Maybe Nm =
  if has NodeConsTail p or has NodeAsTail p then None
  else
    match M.andThen (childOf NodeArg) (childOf NodePAtom p) with
    | Just a ->
        (match childOf NodeVid a with
         | Just v -> M.map nameOf (childOf TokenLowerIdent v)
         | None -> None)
    | None -> None

fun handleE (c : Lc) b (hs : [Int]) (m : Meta) (target : GTree) (arms : [GTree]) =
  let isReturn =
    \a -> V.len (childrenOf TokenLowerIdent a) == 1 and R.text (must TokenLowerIdent a) == "return"
  in
  let opArms = V.filter (\a -> not (isReturn a)) arms in
  let rets = V.filter isReturn arms in
  let ret = V.get rets (V.len rets - 1) in
  let e = \x -> exprIn c b hs x None in
  newAstExprHandle
    b
    m
    (e target)
    (V.map
       (\a ->
         let ls = childrenOf TokenLowerIdent a in
         newAstHArm
           b
           (spanOf a)
           (nm b (nameOf (V.getOr a ls 0)))
           (pat c b (must NodePat a))
           (nm b (nameOf (V.getOr a ls 1)))
           (e (must NodeExpr a)))
       opArms)
    (M.map (\r -> newAstRet b (spanOf r) (pat c b (must NodePat r)) (e (must NodeExpr r))) ret)

-- `(…)`: `()`, `(e)` -- a section if it has a `_` in it -- or a tuple.
fun parenE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let elems = V.map (\x -> must NodeExpr x) (childrenOf NodeElem s) in
  match V.len elems with
  | 0 -> newAstExprUnit b (M.unwrapOr (spanOf s) over)
  | 1 ->
      let inner = V.getOr s elems 0 in
      let own = holesIn inner in
      if V.isEmpty own then exprIn c b hs inner over
      else
        let m = M.unwrapOr (exprSpan c inner) over in
        let params =
          V.map
            (\i ->
              newAstPatVar b (exprSpan c inner) (nm b (named "_hole${show i}" (exprSpan c inner))))
            (V.range 0 (V.len own))
        in newAstExprLam b m params (exprIn c b own inner None)
  | _ -> newAstExprTuple b (M.unwrapOr (spanOf s) over) (V.map (\x -> exprIn c b hs x None) elems)

fun interp (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let text =
    \t ->
      (match tokenOf c t with
       | Just (InterpStart x) -> x
       | Just (InterpMid x) -> x
       | Just (InterpEnd x) -> x
       | _ -> "")
  in
  let texts =
    V.concat [
      V.map text (childrenOf TokenInterpStart s),
      V.map (\mid -> text (must TokenInterpMid mid)) (childrenOf NodeInterpMid s),
      V.map text (childrenOf TokenInterpEnd s)
    ]
  in
  let hole =
    \h -> newAstHole b (spanOf h) (exprIn c b hs (must NodeExpr h) None) (tokenIs TokenDebugFmt h)
  in
  let holes =
    V.pushFront
      (V.map (\mid -> hole (must NodeHole mid)) (childrenOf NodeInterpMid s))
      (hole (must NodeHole s))
  in newAstExprInterp b m texts holes

-- `{ r | x = e }` updates `r`; anything else is a record, `{ x }` short for
-- `{ x = x }`, and `| r` what it extends.
fun braceE (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let items = childrenOf NodeBraceItem s in
  let e = \x -> exprIn c b hs x None in
  match M.andThen updated (childOf NodeBraceTail s) with
  | Just fields ->
      let target =
        (match V.get items 0 with
         | Just i -> e (must NodeExpr (must NodeAsExpr i))
         | None -> newAstExprUnit b m)
      in newAstExprUpdate
           b
           m
           target
           (V.map
              (\f ->
                (let n = nameOf (must TokenLowerIdent f) in
                 newAstExprField
                   b
                   (spanOf f)
                   (nm b n)
                   (match (childOf NodeExpr f, childOf NodeUpdValue f) with
                    | (Just x, _) -> e x
                    | (_, Just v) -> e (must NodeExpr v)
                    | _ -> newAstExprVar b n.at (nm b n))))
              fields)
  | None ->
      let fs =
        V.map
          (\i ->
            let n = firstName (must NodeAsExpr i) in
            newAstExprField
              b
              (spanOf i)
              (nm b n)
              (match childOf NodeFieldValue i with
               | Just fv -> e (must NodeExpr (must NodeAsExpr fv))
               | None -> newAstExprVar b n.at (nm b n)))
          items
      in
      let base =
        M.andThen
          (\t -> M.map (\te -> e (must NodeExpr te)) (childOf NodeTailExpr t))
          (childOf NodeBraceTail s)
      in newAstExprRecord b m fs base

-- The fields of an update, in order, if what follows a record's `|` is
-- one: the first -- given a value, or a name alone with more after it --
-- and the rest.
fun updated (t : GTree) : Maybe [GTree] =
  match (childOf NodeUpdFields t, childOf NodeUpdBares t) with
  | (Just u, _) -> Just (V.pushFront (childrenOf NodeUpdField u) (must NodeUpdSet u))
  | (_, Just u) -> Just (V.pushFront (childrenOf NodeUpdField u) (must NodeUpdBare u))
  | _ -> None

-- `[lo .. hi]`, `[a; b]`, `[;]`, `[a, b]`, `[]`.
fun brackE (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let item = \x -> exprIn c b hs (must NodeExpr x) None in
  let vector =
    \es ->
      newAstExprApp b m (newAstExprVar b m (nm b (named "vecFromArray" m))) [newAstExprArray b m es]
  in match childOf NodeBrackBody s with
     | None -> vector []
     | Just body ->
         (match childOf NodeAsExpr body with
          | None -> newAstExprList b m []
          | Just first ->
              let lo = item first in
              (match childOf NodeRangeTail body with
               | Just r ->
                   let hi = must NodeExpr r in
                   let hm = exprSpan c hi in
                   let hiE = exprIn c b hs hi None in
                   -- `[a .. b]` stops before `b`, `range a b`; `[a ..= b]`
                   -- includes it, `range a (b + 1)`.
                   let hi1 =
                     if tokenIs TokenDoublePeriodEq r then
                       newAstExprApp b hm (newAstExprVar b hm (nm b (named "+" hm))) [
                         hiE,
                         newAstExprLit b hm (newAstLitInt b hm "1")
                       ]
                     else hiE
                   in newAstExprApp b m (newAstExprVar b m (nm b (named "range" m))) [lo, hi1]
               | None ->
                   (match childOf NodeListTail body with
                    | Just t ->
                        newAstExprList
                          b
                          m
                          (V.pushFront
                             (V.map
                                item
                                (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                             lo)
                    | None ->
                        (match childOf NodeVecTail body with
                         | Just t ->
                             vector
                               (V.pushFront
                                  (V.map
                                     item
                                     (V.concatMap
                                        (childrenOf NodeAsExpr)
                                        (childrenOf NodeCommaItem t)))
                                  lo)
                         | None -> vector [lo]))))

-- --- spans -------------------------------------------------------------------
--
-- The span `meadow-parser` gives what it makes of an expression: where it was
-- written, but that `(e)` spans `e`, and what joins two spans the span of
-- both.

fun exprSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc p -> join acc (pipeSpan c (must NodePipeL p)))
    (pipeSpan c (must NodePipeL s))
    (childrenOf NodeBackPipe s)

fun pipeSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc p -> join acc (orSpan c (must NodeOrE p)))
    (orSpan c (must NodeOrE s))
    (childrenOf NodePipe s)

fun orSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc t -> join acc (andSpan c (must NodeAndE t)))
    (andSpan c (must NodeAndE s))
    (childrenOf NodeOrTail s)

fun andSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc t -> join acc (opsSpan c (M.unwrapOr t (firstNode t))))
    (opsSpan c (M.unwrapOr s (firstNode s)))
    (childrenOf NodeAndTail s)

-- A chain's span is its operands'.
fun opsSpan (c : Lc) (s : GTree) : Meta =
  match s with
  | GroupedInfix l _ r -> join (opsSpan c l) (opsSpan c r)
  | GroupedLeaf operand -> operandSpan c operand
  | _ -> spanOf s

fun operandSpan (c : Lc) (s : GTree) : Meta = negSpan c (childrenOf TokenMinus s) (must NodeBase s)

fun baseSpan (c : Lc) (s : GTree) : Meta =
  if has NodeAtom s then spanOf s
  else
    match M.andThen (childOf NodeLowAtom) (childOf NodeHead s) with
    | Just low ->
        (match childOf NodeClosedAtom low with
         | Just ca ->
             (if has NodeFieldTail ca then spanOf ca else primSpan c (M.unwrapOr ca (firstNode ca)))
         | None -> spanOf low)
    | None ->
        (match M.andThen (childOf NodeMacCall) (childOf NodeHead s) with
         | Just mc -> macSpan mc
         | None -> spanOf s)

fun primSpan (c : Lc) (s : GTree) : Meta =
  if R.kindOf s == NodeParen and V.len (childrenOf NodeElem s) == 1 then
    exprSpan c (must NodeExpr (must NodeElem s))
  else spanOf s

-- --- sections ----------------------------------------------------------------

-- The `_`s a section `(e)` makes parameters of: the start of each, in the
-- order `meadow-parser`'s `fill_holes` meets them.
fun holesIn (s : GTree) : [Int] =
  let k = R.kindOf s in
  if k == NodeExpr then
    V.concatMap
      holesIn
      (V.pushFront (V.map (\p -> must NodePipeL p) (childrenOf NodeBackPipe s)) (must NodePipeL s))
  else if k == NodePipeL then
    V.concatMap
      holesIn
      (V.reverse
         (V.pushFront (V.map (\p -> must NodeOrE p) (childrenOf NodePipe s)) (must NodeOrE s)))
  else if k == NodeLamE
    or k == NodeMacCall
    or k == NodeMacAtom
    or k == NodeQualAtom
    or k == NodeQualHead
    or k == NodeVarE
    or k == NodeLitE
    or k == NodeOpRef then []
  else if k == NodeHoleE then [metaStart (spanOf s)]
  else if k == NodeParen then
    -- `(e)` is a section of its own: a `_` in it is its parameter, and none
    -- of whoever is around it.
    (let elems = childrenOf NodeElem s in
     if V.len elems == 1 then [] else V.concatMap (\e -> holesIn (must NodeExpr e)) elems)
  else if k == NodeMatchE then
    V.concatMap
      (\x ->
        if R.kindOf x == NodeArm then
          V.concatMap holesIn (V.filter (\y -> R.kindOf y != NodePat) (nodeKids x))
        else holesIn x)
      (nodeKids s)
  else if k == NodeLetE then
    V.concatMap
      (\x ->
        if R.kindOf x == NodeFunBind then []
        else if R.kindOf x == NodePatBind then
          (if V.isEmpty (childrenOf NodeParam x) then holesIn (must NodeExpr x) else [])
        else holesIn x)
      (nodeKids s)
  else if k == NodeHandleE then
    let arms = childrenOf NodeHArm s in
    let isReturn =
      \a ->
        V.len (childrenOf TokenLowerIdent a) == 1 and R.text (must TokenLowerIdent a) == "return"
    in
    let rets = V.filter isReturn arms in
    V.concat [
      holesIn (must NodeExpr s),
      V.concatMap (\a -> holesIn (must NodeExpr a)) (V.filter (\a -> not (isReturn a)) arms),
      (match V.get rets (V.len rets - 1) with
       | Just r -> holesIn (must NodeExpr r)
       | None -> [])
    ]
  else
    V.concatMap
      holesIn
      (V.filter
         (\x -> R.kindOf x != NodePat and R.kindOf x != NodeAnnot and R.kindOf x != NodeParam)
         (nodeKids s))

-- --- `@cfg` -------------------------------------------------------------------

-- Whether every `@cfg` among `attrs` holds for the build. One that cannot
-- be read is said and taken to hold, so that it is the only thing wrong.
fun cfgHolds (c : Lc) (attrs : [GTree]) : Bool ! { Expanding | e } =
  V.all
    (\a ->
      if (firstName (must NodeAttrName a)).text != "cfg" then True
      else
        let metas =
          (match childOf NodeAttrArgs a with
           | Just args -> childrenOf NodeMeta args
           | None -> [])
        in match (V.len metas, V.get metas 0) with
           | (1, Just m) ->
               (match conditionHolds c m with
                | Ok yes -> yes
                | Err (why, at) -> (let u = wrong (why, metaStart at, metaEnd at) in True))
           | _ ->
               (let at = spanOf (must NodeAttrName a) in
                let u =
                  wrong (
                    "`@cfg` takes one condition, as `@cfg(unix)` or `@cfg(all(unix, not(test)))`",
                    metaStart at,
                    metaEnd at
                  )
                in True))
    attrs

-- The fields of `r` that are there: a record's, a constructor's, or an
-- effect's operations, each under its own `@cfg`s.
fun fieldsThere (c : Lc) (r : GTree) : [GTree] ! { Expanding | e } =
  V.filter (\f -> cfgHolds c (childrenOf NodeAttr f)) (childrenOf NodeFieldTy r)

-- Whether one condition holds, as `meadow_compiler::cfg::holds` decides it:
-- a name the build knows is asked of the build -- and can only be compared
-- with what it could be -- and any other is a flag.
fun conditionHolds (c : Lc) (m : GTree) : Result (String, Meta) Bool =
  let cfg = c.cfg in
  match m with
  | GroupedMeta (Just text) _ _ ->
      Err ("`\"${(stringName c text).text}\"` is not a condition", spanOf text)
  | GroupedMeta _ (Just n) None ->
      (let w = (firstName n).text in
       Ok
         (if w == "unix" or w == "windows" then familyOf cfg == w
          else if w == "debug" or w == "release" then cfg.profile == w
          else if w == "test" then cfg.test
          else V.elem w cfg.flags))
  | GroupedMeta _ (Just n) (Just rest) ->
      (match rest with
       | GroupedMetaRest (Just v) _ ->
           (let key = (firstName n).text in
            let value = (stringName c (must TokenStr v)).text in
            let among =
              \actual allowed ->
                if V.elem value allowed then Ok (actual == value)
                else
                  Err (
                    S.join "" [
                      "`${key}` is never `\"${value}\"`; it is one of ",
                      S.join ", " (V.map (\x -> "`\"${x}\"`") allowed)
                    ],
                    spanOf v
                  )
            in if key == "os" then among cfg.os ["windows", "linux", "macos", "android"]
               else if key == "arch" then among cfg.arch ["x86_64", "aarch64"]
               else if key == "family" then among (familyOf cfg) ["unix", "windows"]
               else if key == "profile" then among cfg.profile ["debug", "release"]
               else if key == "backend" then among cfg.backend ["vm", "jit", "aot", "silo", "cek"]
               else if key == "opt_level" then among cfg.opt ["0", "1", "2"]
               else Ok (V.elem "${key}=${value}" cfg.flags))
       | GroupedMetaRest _ (Just args) ->
           (let name = (firstName n).text in
            let each =
              V.foldl
                (\acc x ->
                  match (acc, conditionHolds c x) with
                  | (Err e, _) -> Err e
                  | (_, Err e) -> Err e
                  | (Ok ys, Ok y) -> Ok (V.pushBack ys y))
                (Ok [])
                (childrenOf NodeMeta args)
            in match each with
               | Err e -> Err e
               | Ok ys ->
                   if name == "all" then Ok (V.all (\y -> y) ys)
                   else if name == "any" then Ok (V.any (\y -> y) ys)
                   else if name == "not" then
                     (if V.len ys == 1 then Ok (not (V.getOr True ys 0))
                      else Err ("`not` takes exactly one condition", spanOf n))
                   else
                     Err (
                       "there is no `${name}(…)`; conditions combine with `all`, `any` and `not`",
                       spanOf n
                     ))
       | _ -> Ok True)
  | _ -> Ok True

-- --- derives -----------------------------------------------------------------
--
-- What the compiler's own derives write (`Derive`) is read here, where the
-- `@derive` is: source, lexed, every token standing at the derive's name and
-- taking up none of it, and every lowercase name -- and `Datum` -- under the
-- prelude's mark, so that what it binds it binds apart and what it mentions
-- is the prelude's. Parsed and lowered as a template's tokens are, the marks
-- then taken off what is not a local.

-- What each built-in derive written on declaration `s` wrote, in order.
fun derivedDecls (c : Lc) b (s : GTree) (attrs : [GTree]) =
  match M.andThen (shapeOf c) (M.andThen firstNode (childOf NodeItem s)) with
  | None -> []
  | Just shape ->
      let wants =
        V.concatMap
          wanted
          (V.filter (\a -> (firstName (must NodeAttrName a)).text == "derive") attrs)
      in V.concatMap
           (\k ->
             match V.get wants k with
             | None -> []
             | Just (want : Nm) ->
                 -- A procedural macro of the name is found first; the
                 -- compiler's own derive is what there is until one answers.
                 let key = "${keyOf c "derived" s}#${show k}" in
                 (match H.lookup key c.answered with
                  | Just toks -> splicedDecls c b key toks
                  | None ->
                      let u = askingDerive c key want.text s in
                      (match D.builtin want.text shape with
                       | Just text -> derivedText c b (metaStart want.at) text
                       | None -> [])))
           (V.range 0 (V.len wants))

-- The names a `@derive(…)` asks for.
fun wanted (a : GTree) : [Nm] =
  match childOf NodeAttrArgs a with
  | Just args ->
      V.concatMap
        (\m -> if has NodeMetaRest m or has TokenStr m then [] else [firstName m])
        (childrenOf NodeMeta args)
  | None -> []

fun derivedText (c : Lc) b (at : Int) (text : String) =
  let toks =
    V.map
      (\(l : Lexed) ->
        let written = S.slice text l.from l.to in
        match l.token with
        | Token.LowerIdent n ->
            Tok { token = Token.LowerIdent "${n}#0", text = "${written}#0", from = at, to = at }
        | Token.UpperIdent "Datum" ->
            Tok { token = Token.UpperIdent "Datum#0", text = "Datum#0", from = at, to = at }
        | t -> Tok { token = t, text = written, from = at, to = at })
      (lex text).tokens
  in match reparsed c [] toks [] with
     | (inner, root) ->
         let ds = V.concatMap (decl inner b) (childrenOf NodeDecl root) in
         let u = Hy.stripItems b ds in
         ds

-- What a derive needs of a `data` or a `record`, and nothing of anything
-- else.
fun shapeOf (c : Lc) (item : GTree) =
  let name = (nameOf (must TokenUpperIdent item)).text in
  let params = V.map (\p -> (nameOf p).text) (childrenOf TokenLowerIdent item) in
  let names = \r -> V.map (\f -> (nameOf (must TokenLowerIdent f)).text) (fieldsThere c r) in
  if R.kindOf item == NodeDataDecl then
    Just
      (Shape {
         name,
         params,
         isRecord = False,
         ctors =
           V.map
             (\v ->
               let args = childrenOf NodeTAtom v in
               -- Named as lowering has it: a brace list of at least one
               -- field, and no `| r`, first after the name.
               let fieldList =
                 M.andThen
                   (\a ->
                     only
                       (\r -> V.len (childrenOf NodeFieldTy r) > 0 and not (has NodeRowTail r))
                       (childOf NodeRecTy a))
                   (V.get args 0)
               in
               let ctor = (nameOf (must TokenUpperIdent v)).text in
               match fieldList with
               | Just r ->
                   (let fields = names r in
                    Ctor { name = ctor, named = True, fields, count = V.len fields })
               | None -> Ctor { name = ctor, named = False, fields = [], count = V.len args })
             (childrenOf NodeVariant item)
       })
  else if R.kindOf item == NodeRecordDecl then
    (let fields = names (must NodeRecTy item) in
     Just
       (Shape {
          name,
          params,
          isRecord = True,
          ctors = [Ctor { name, named = True, fields, count = V.len fields }]
        }))
  else None

-- --- expansions --------------------------------------------------------------
--
-- What the Rust compiler's macros expanded to (`meadow_compiler::expand::record`):
-- JSON, a node an array -- its production, where it came from, its fields, named
-- and ordered as `Ast` has them -- read here into `Ast`'s tables. A chain of
-- operators comes as it was parsed, and is grouped here by the unit's
-- fixities, as the fixity pass groups one in a tree.

fun exprCall (c : Lc) b (m : Meta) (call : GTree) =
  match (builtIn c call, rulesOf c call) with
  | (Just toks, _) ->
      M.unwrapOr
        (newAstExprMacCall b m (macCall b call))
        (exprFrom c b "${keyOf c "expr" call}/" toks)
  | (_, Just r) -> M.unwrapOr (newAstExprMacCall b m (macCall b call)) (expandedExpr c b r call)
  | (None, None) ->
      let key = keyOf c "expr" call in
      (match M.andThen (\toks -> exprFrom c b "${key}/" toks) (H.lookup key c.answered) with
       | Just e -> e
       | None ->
           (match expansion c "expr" m with
            | Just made -> jExpr c b made
            | None ->
                (let u = asking c "expr" key call None in newAstExprMacCall b m (macCall b call))))

fun patCall (c : Lc) b (m : Meta) (call : GTree) =
  match (builtIn c call, rulesOf c call) with
  | (Just toks, _) ->
      M.unwrapOr (newAstPatMacCall b m (macCall b call)) (patFrom c b "${keyOf c "pat" call}/" toks)
  | (_, Just r) -> M.unwrapOr (newAstPatMacCall b m (macCall b call)) (expandedPat c b r call)
  | (None, None) ->
      let key = keyOf c "pat" call in
      (match M.andThen (\toks -> patFrom c b "${key}/" toks) (H.lookup key c.answered) with
       | Just p -> p
       | None ->
           (match expansion c "pat" m with
            | Just made -> jPat c b made
            | None ->
                (let u = asking c "pat" key call None in newAstPatMacCall b m (macCall b call))))

-- --- `macro`s ----------------------------------------------------------------
--
-- A call of one of the module's own `macro`s is expanded here (`Rules`): its
-- template written out as tokens, each standing where it came from, parsed
-- from them where the call is -- inside `def x = …` for an expression, a
-- match's arm for a pattern -- grouped by the unit's fixities, lowered, and
-- the marks taken off every name but the locals (`Hygiene`).

-- The module's `macro`s, by name, each rule's matcher read.
fun macrosOf (c : Lc) (pkg : String) (top : GTree) : HashMap String Macro =
  V.foldl
    (\h d ->
      match M.andThen firstNode (childOf NodeItem d) with
      | Just (GroupedMacroDecl name rules) ->
          (match macroOf c pkg rules with
           | Just m -> H.insert (nameOf name).text m h
           | None -> h)
      | _ -> h)
    H.empty
    (childrenOf NodeDecl top)

fun macroOf (c : Lc) (pkg : String) (rules : [GTree]) : Maybe Macro =
  let read = V.map (ruleOf c) rules in
  if V.all M.isSome read then
    Just (Macro { rules = V.concatMap (\x -> match x with | Just y -> [y] | None -> []) read, pkg })
  else None

-- A rule: its matcher, read, and its template.
fun ruleOf (c : Lc) (r : GTree) =
  match r with
  | GroupedMacroRule mt tp ->
      (match Ru.readMatcher (Ru.treeOf (tokenOf c) mt) with
       | Ok m -> Just (m, Ru.treeOf (tokenOf c) tp)
       | Err _ -> None)
  | _ -> None

-- The module's `macro` a call is of, if it is of one. A call a template
-- wrote is named without the mark it was written with.
fun rulesOf (c : Lc) (call : GTree) : Maybe Macro =
  let pathNode =
    M.unwrapOr
      call
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids call))
  in
  let segs =
    V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode)
  in if V.len segs == 1 then
       M.andThen (\x -> H.lookup (Hy.stripOnce (firstName x).text) c.macros) (V.get segs 0)
     else None

-- What a call of `macro` `m` wrote, if a rule matches it, and the
-- expansion it is.
fun expandCall (c : Lc) (m : Macro) (call : GTree) =
  let n = nextExpansion () in
  match V.find isGroup (nodeKids call) with
  | Just g ->
      (match Ru.expand m (Ru.treeOf (tokenOf c) g) n with
       | Ok toks -> Just (n, toks)
       | Err _ -> None)
  | None -> None

-- `toks`, after `before` and before `after` -- tokens that stand nowhere --
-- parsed and grouped by the unit's fixities: the tree, and the context to
-- lower it in, its tokens by where each is in the tree's text.
fun reparsed (c : Lc) (before : [(Token, String)]) (toks : [Tok]) (after : [(Token, String)])
    : (Lc, GTree) =
  let made = \p -> (fst p, 0 - 1, 0 - 1, snd p) in
  let given =
    V.concat [
      V.map made before,
      V.map (\(t : Tok) -> (t.token, t.from, t.to, t.text)) toks,
      V.map made after
    ]
  in
  let starts =
    V.foldl
      (\acc x ->
        match x with
        | (_, _, _, text) ->
            V.pushBack
              acc
              (M.unwrapOr 0 (M.map (\l -> l + 1) (V.last acc)) + stringByteLength text))
      []
      given
  in
  let at = \i -> if i == 0 then 0 else V.getOr 0 starts (i - 1) + 1 in
  let tokens =
    H.fromVec
      (V.map
         (\i ->
           (
             at i,
             match V.getOr (Token.Wildcard, 0, 0, "") given i with
             | (t, _, _, _) -> t
           ))
         (V.range 0 (V.len given)))
  in match parseSurfaceTokens given with
     | (g, _) ->
         (match grouped c.fx (R.root g) with
          | (gg, _) -> ({ c | tokens = tokens }, R.root gg))

-- What a call of the module's own `macro` wrote is keyed apart from the
-- module's own text, by the expansion it is.
fun inside (c : Lc) (n : Int) : String = "${c.under}m${show n}/"

fun expandedDecls (c : Lc) b (m : Macro) (call : GTree) =
  M.map (\x -> declsFrom c b (inside c (fst x)) (snd x)) (expandCall c m call)

fun expandedExpr (c : Lc) b (m : Macro) (call : GTree) =
  M.andThen (\x -> exprFrom c b (inside c (fst x)) (snd x)) (expandCall c m call)

fun expandedPat (c : Lc) b (m : Macro) (call : GTree) =
  M.andThen (\x -> patFrom c b (inside c (fst x)) (snd x)) (expandCall c m call)

-- What a procedural macro answered where declarations go.
fun splicedDecls (c : Lc) b (key : String) (toks : [Tok]) = declsFrom c b "${key}/" toks

-- Tokens a macro wrote, parsed as declarations and lowered: a call in them
-- is keyed `under` the one that wrote them.
fun declsFrom (c : Lc) b (under : String) (toks : [Tok]) =
  match reparsed c [] toks [] with
  | (inner, root) ->
      let ds = V.concatMap (decl { inner | under = under } b) (childrenOf NodeDecl root) in
      let u = Hy.stripItems b ds in
      ds

-- The same as an expression: parsed inside `def x = …`.
fun exprFrom (c : Lc) b (under : String) (toks : [Tok]) =
  match reparsed c [(Token.Def, "def"), (Token.LowerIdent "x", "x"), (Token.Eq, "=")] toks [] with
  | (inner, root) ->
      M.map
        (\body ->
          let e = expr { inner | under = under } b (must NodeExpr body) in
          let u = Hy.stripInExpr b e in
          e)
        (M.andThen
           (childOf NodeBody)
           (M.andThen firstNode (M.andThen (childOf NodeItem) (childOf NodeDecl root))))

-- And as a pattern: parsed as a match's arm.
fun patFrom (c : Lc) b (under : String) (toks : [Tok]) =
  match reparsed
    c
    [
      (Token.Def, "def"),
      (Token.LowerIdent "x", "x"),
      (Token.Eq, "="),
      (Token.Match, "match"),
      (Token.LParen, "("),
      (Token.RParen, ")"),
      (Token.With, "with"),
      (Token.Bar, "|")
    ]
    toks
    [(Token.RArrow, "->"), (Token.LParen, "("), (Token.RParen, ")")] with
  | (inner, root) ->
      M.map
        (\arm ->
          let p = pat { inner | under = under } b (must NodePat arm) in
          let u = Hy.stripInPat b p in
          p)
        (firstOfKind NodeArm root)

-- --- the built-in macros ------------------------------------------------------
--
-- Always there, and found before a `macro` of the name: `line!()` is the
-- line the call is written on, `file!()` the name of the file it is in,
-- `stringify!(…)` its argument written back as text, and `concat!(a, b, …)`
-- its literal arguments joined into one string. Each answers one literal,
-- standing where the call's argument is.

-- What the call wrote, if it is of a built-in macro and is one it takes.
fun builtIn (c : Lc) (call : GTree) : Maybe [Tok] =
  let pathNode =
    M.unwrapOr
      call
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids call))
  in
  let segs =
    V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode)
  in match (V.len segs, V.get segs 0, V.find isGroup (nodeKids call)) with
     | (1, Just seg, Just g) ->
         let name = Hy.stripOnce (firstName seg).text in
         let arg = Ru.treeOf (tokenOf c) g in
         let trees = Ru.treesIn arg in
         let one =
           \token text ->
             (match Ru.spanOfTree arg with
              | (from, to) -> Just [Tok { token, text, from, to }])
         in if name == "line" then
              (if V.isEmpty trees then
                 (let n = lineOf c.input (metaStart (firstName seg).at) in
                  one (Token.Int n) (show n))
               else None)
            else if name == "file" then
              (if V.isEmpty trees then one (Token.Str c.file) "\"\"" else None)
            else if name == "stringify" then
              (let text = S.join "" (rendered (Ru.flatten trees) 0 []) in
               one (Token.Str text) "\"\"")
            else if name == "concat" then
              M.andThen (\text -> one (Token.Str text) "\"\"") (concatenated trees)
            else None
     | _ -> None

-- The line byte `at` of `text` is on, the first being 1.
fun lineOf (text : String) (at : Int) : Int =
  V.len (S.split "\n" (S.take text (min at (stringByteLength text))))

-- Tokens written back as text, each a piece: a space before one unless it
-- closes something or follows what opens something (`meadow_lexer::tt`'s
-- `render`).
fun rendered (toks : [Tok]) (i : Int) (acc : [String]) : [String] =
  match V.get toks i with
  | None -> acc
  | Just (t : Tok) ->
      let last = M.unwrapOr "" (V.last acc) in
      let tightBefore =
        (match t.token with
         | Token.Comma -> True
         | Token.SemiColon -> True
         | Token.Period -> True
         | Token.RParen -> True
         | Token.RBrack -> True
         | Token.RBrace -> True
         | Token.InterpMid _ -> True
         | Token.InterpEnd _ -> True
         | _ -> False)
      in
      let tightAfter = last == "(" or last == "[" or last == "{" or last == "." in
      if V.isEmpty acc or tightBefore or tightAfter then
        rendered toks (i + 1) (V.pushBack acc t.text)
      else rendered toks (i + 1) (V.pushBack (V.pushBack acc " ") t.text)

-- The text of each literal among `trees`, commas between them, joined --
-- or `None` if one of them is not a literal.
fun concatenated (trees : [Tree]) : Maybe String =
  V.foldl
    (\acc piece ->
      match (acc, piece) with
      | (None, _) -> None
      | (Just text, []) -> Just text
      | (Just text, _) ->
          (match (V.len piece, V.get piece 0) with
           | (1, Just (Tree.Leaf (k : Tok))) ->
               (match k.token with
                | Token.Str s -> Just (text ++ s)
                | Token.Char code -> Just (text ++ S.fromChars [Ch.fromCode code])
                | Token.Int _ -> Just (text ++ k.text)
                | Token.Real _ -> Just (text ++ k.text)
                | _ -> None)
           | _ -> None))
    (Just "")
    (V.foldl
       (\pieces t ->
         match t with
         | Tree.Leaf (k : Tok) ->
             (match k.token with
              | Token.Comma -> V.pushBack pieces []
              | _ -> onLast pieces t)
         | _ -> onLast pieces t)
       [[]]
       trees)

fun onLast (pieces : [[Tree]]) (t : Tree) : [[Tree]] =
  match V.last pieces with
  | Just p -> V.pushBack (V.take pieces (V.len pieces - 1)) (V.pushBack p t)
  | None -> [[t]]

-- --- procedural macros ---------------------------------------------------------
--
-- A call that is not of one of the module's `macro`s is not expanded here:
-- it is asked for (`Request`), and whoever lowers the module runs what can
-- be run and lowers it again with the answers (`Compiler`).

-- Ask for the call `call`, which is in a `kind`'s place.
fun asking (c : Lc) (kind : String) (key : String) (call : GTree) (seen : Maybe [String])
    : () ! { Expanding | e } =
  let pathNode =
    M.unwrapOr
      call
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids call))
  in
  let segs =
    V.map
      (\x -> Hy.stripOnce (firstName x).text)
      (V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode))
  in match V.find isGroup (nodeKids call) with
     | None -> ()
     | Just g ->
         let arg = Ru.treeOf (tokenOf c) g in
         (match Ru.spanOfTree arg with
          | (from, to) ->
              ask
                (Request {
                   key,
                   kind,
                   name = S.join "." segs,
                   argument = Mc.writeWire (Mc.treesWire True (Ru.treesIn arg)),
                   from,
                   to,
                   seen
                 }))

-- Ask for the derive of `name` on the declaration `s`: its argument is the
-- declaration, attributes and all, and what it makes up stands at the
-- declaration under them.
fun askingDerive (c : Lc) (key : String) (name : String) (s : GTree) : () ! { Expanding | e } =
  match Mc.treesOf (tokensIn c s) with
  | None -> ()
  | Just trees ->
      let at = spanOf (must NodeItem s) in
      ask
        (Request {
           key,
           kind = "derived",
           name,
           argument = Mc.writeWire (Mc.treesWire True trees),
           from = metaStart at,
           to = metaEnd at,
           seen = None
         })

-- Every token of `s`, in order.
fun tokensIn (c : Lc) (s : GTree) : [Tok] =
  V.concatMap
    (\x ->
      if R.isTokenOf x then
        [Tok {
           token = M.unwrapOr (Token.OpIdent (R.text x)) (tokenOf c x),
           text = R.text x,
           from = R.offset x,
           to = R.endOffset x
         }]
      else tokensIn c x)
    (R.childrenWhere (\g k -> G.kindAt g k != Unknown) s)

-- What a `@pub` among `attrs` says: its arguments, or `None` with none.
fun seenBy (attrs : [GTree]) : Maybe [String] =
  M.map
    (\a ->
      match childOf NodeAttrArgs a with
      | Just args -> V.map (\m -> (firstName m).text) (childrenOf NodeMeta args)
      | None -> [])
    (V.find (\a -> (firstName (must NodeAttrName a)).text == "pub") attrs)

-- The first node of kind `k` in `s`, reading down and left to right.
fun firstOfKind (k : Grouped) (s : GTree) : Maybe GTree =
  if R.kindOf s == k then Just s
  else
    V.foldl
      (\found x ->
        match found with
        | Just f -> Just f
        | None -> firstOfKind k x)
      None
      (nodeKids s)

fun jarr (j : Json) : [Json] = M.unwrapOr [] (J.asArray j)

fun jat (j : Json) (i : Int) : Json = V.getOr (J.jNull ()) (jarr j) i

fun jint (j : Json) (i : Int) : Int = M.unwrapOr 0 (J.asInt (jat j i))

fun jstr (j : Json) (i : Int) : String = M.unwrapOr "" (J.asString (jat j i))

fun jbool (j : Json) (i : Int) : Bool = M.unwrapOr False (J.asBool (jat j i))

fun jtag (j : Json) : String = jstr j 0

fun jmeta (j : Json) : Meta = spanMeta (jint j 1) (jint j 2)

-- Field `i` of node `j`, by its place among the fields.
fun jf (j : Json) (i : Int) : Json = jat j (i + 3)

fun jn b (j : Json) = newAstName b (jmeta j) (jstr j 3)

fun jns b (j : Json) = V.map (jn b) (jarr j)

fun jopt (f : Json -> a ! e) (j : Json) : Maybe a ! e = if J.isNull j then None else Just (f j)

fun jDecl (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  if t == "Bind" then newAstDeclBind b m (jBind c b (f 0))
  else if t == "ModDecl" then newAstDeclMod b m (jn b (f 0))
  else if t == "UseDecl" then
    newAstDeclUse
      b
      m
      (jns b (f 0))
      (jns b (f 1))
      (jns b (f 2))
      (M.unwrapOr False (J.asBool (f 3)))
      (jopt (jn b) (f 4))
  else if t == "DataDecl" then
    newAstDeclData b m (jn b (f 0)) (jns b (f 1)) (V.map (jVariant c b) (jarr (f 2)))
  else if t == "RecordDecl" then
    newAstDeclRecord b m (jn b (f 0)) (jns b (f 1)) (V.map (jField c b) (jarr (f 2)))
  else if t == "EffectDecl" then
    newAstDeclEffect b m (jn b (f 0)) (jns b (f 1)) (V.map (jField c b) (jarr (f 2)))
  else if t == "AliasDecl" then newAstDeclAlias b m (jn b (f 0)) (jns b (f 1)) (jType c b (f 2))
  else if t == "EffectAliasDecl" then
    newAstDeclEffectAlias b m (jn b (f 0)) (jns b (f 1)) (jRow c b (f 2))
  else if t == "SigDecl" then
    newAstDeclSig b m (jn b (f 0)) (jType c b (f 1)) (V.map (jBound c b) (jarr (f 2)))
  else if t == "TraitDecl" then
    newAstDeclTrait
      b
      m
      (jn b (f 0))
      (jns b (f 1))
      (V.map (jBound c b) (jarr (f 2)))
      (V.map (\x -> newAstAssoc b (jmeta x) (jn b (jf x 0)) (jns b (jf x 1))) (jarr (f 3)))
      (V.map (\x -> newAstAssoc b (jmeta x) (jn b (jf x 0)) (jns b (jf x 1))) (jarr (f 4)))
      (V.map (\x -> newAstMethodSig b (jmeta x) (jn b (jf x 0)) (jType c b (jf x 1))) (jarr (f 5)))
      (V.map (jBind c b) (jarr (f 6)))
  else if t == "ImplDecl" then
    newAstDeclImpl
      b
      m
      (jn b (f 0))
      (V.map (jType c b) (jarr (f 1)))
      (V.map (jBound c b) (jarr (f 2)))
      (V.map
         (\x ->
           newAstAssocDef
             b
             (jmeta x)
             (jn b (jf x 0))
             (V.map (jType c b) (jarr (jf x 1)))
             (jType c b (jf x 2)))
         (jarr (f 3)))
      (V.map
         (\x ->
           newAstAssocEffDef
             b
             (jmeta x)
             (jn b (jf x 0))
             (V.map (jType c b) (jarr (jf x 1)))
             (jRow c b (jf x 2)))
         (jarr (f 4)))
      (V.map (jBind c b) (jarr (f 5)))
  else if t == "FixityDecl" then newAstDeclFixity b m (jns b (f 0))
  else if t == "Attributed" then
    newAstDeclAttributed b m (V.map (jAttr b) (jarr (f 0))) (jDecl c b (f 1))
  else if t == "MacCallDecl" then newAstDeclMacCall b m (jMac b (f 0))
  else newAstDeclMacro b m (jn b (f 0))

fun jAttr b (j : Json) =
  newAstAttr b (jmeta j) (jn b (jf j 0)) (jns b (jf j 1)) (V.map (jMeta b) (jarr (jf j 2)))

fun jMeta b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  if t == "MetaWord" then newAstAttrMetaWord b m (jn b (jf j 0))
  else if t == "MetaText" then newAstAttrMetaText b m (jn b (jf j 0))
  else if t == "MetaValue" then newAstAttrMetaValue b m (jn b (jf j 0)) (jn b (jf j 1))
  else newAstAttrMetaList b m (jn b (jf j 0)) (V.map (jMeta b) (jarr (jf j 1)))

fun jMac b (j : Json) = newAstMacCall b (jmeta j) (jns b (jf j 0))

fun jVariant (c : Lc) b (j : Json) =
  newAstVariant
    b
    (jmeta j)
    (V.map (jAttr b) (jarr (jf j 0)))
    (jn b (jf j 1))
    (M.unwrapOr False (J.asBool (jf j 2)))
    (V.map (jType c b) (jarr (jf j 3)))
    (V.map (jField c b) (jarr (jf j 4)))

fun jField (c : Lc) b (j : Json) =
  newAstField b (jmeta j) (V.map (jAttr b) (jarr (jf j 0))) (jn b (jf j 1)) (jType c b (jf j 2))

fun jBound (c : Lc) b (j : Json) =
  newAstBound b (jmeta j) (jn b (jf j 0)) (V.map (jType c b) (jarr (jf j 1)))

fun jType (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let ts = \x -> V.map (jType c b) (jarr x) in
  if t == "TVar" then newAstTypeVar b m (jn b (f 0))
  else if t == "TCon" then newAstTypeCon b m (jn b (f 0)) (ts (f 1))
  else if t == "TFun" then newAstTypeFun b m (ts (f 0)) (jType c b (f 1)) (jopt (jRow c b) (f 2))
  else if t == "TTuple" then newAstTypeTuple b m (ts (f 0))
  else if t == "TVector" then newAstTypeVector b m (jType c b (f 0))
  else if t == "TList" then newAstTypeList b m (jType c b (f 0))
  else if t == "TRow" then newAstTypeRow b m (jRow c b (f 0))
  else
    newAstTypeRecord
      b
      m
      (V.map (\x -> newAstTypeField b (jmeta x) (jn b (jf x 0)) (jType c b (jf x 1))) (jarr (f 0)))
      (jopt (jn b) (f 1))

fun jRow (c : Lc) b (j : Json) =
  newAstRow
    b
    (jmeta j)
    (V.map
       (\x -> newAstLabel b (jmeta x) (jn b (jf x 0)) (V.map (jType c b) (jarr (jf x 1))))
       (jarr (jf j 0)))
    (jopt (jn b) (jf j 1))

fun jBind (c : Lc) b (j : Json) =
  let m = jmeta j in
  if jtag j == "PatBind" then newAstBindPat b m (jPat c b (jf j 0)) (jExpr c b (jf j 1))
  else
    newAstBindFun
      b
      m
      (jn b (jf j 0))
      (V.map (jPat c b) (jarr (jf j 1)))
      (jopt (jType c b) (jf j 2))
      (jExpr c b (jf j 3))

fun jLit b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let text = jstr j 3 in
  if t == "LitInt" then newAstLitInt b m text
  else if t == "LitFloat" then newAstLitFloat b m text
  else if t == "LitChar" then newAstLitChar b m text
  else newAstLitString b m text

fun jPat (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let ps = \x -> V.map (jPat c b) (jarr x) in
  if t == "PWild" then newAstPatWild b m
  else if t == "PVar" then newAstPatVar b m (jn b (f 0))
  else if t == "PAnn" then newAstPatAnn b m (jPat c b (f 0)) (jType c b (f 1))
  else if t == "PLit" then newAstPatLit b m (jLit b (f 0))
  else if t == "PAs" then newAstPatAs b m (jn b (f 0)) (jPat c b (f 1))
  else if t == "PCons" then newAstPatCons b m (jn b (f 0)) (ps (f 1))
  else if t == "PQualCons" then newAstPatQualCons b m (jn b (f 0)) (jn b (f 1)) (ps (f 2))
  else if t == "PTuple" then newAstPatTuple b m (ps (f 0))
  else if t == "PArray" then newAstPatArray b m (ps (f 0))
  else if t == "PVector" then newAstPatVector b m (ps (f 0))
  else if t == "PList" then newAstPatList b m (ps (f 0))
  else if t == "PRecord" then
    newAstPatRecord
      b
      m
      (V.map (\x -> newAstPatField b (jmeta x) (jn b (jf x 0)) (jPat c b (jf x 1))) (jarr (f 0)))
      (M.unwrapOr False (J.asBool (f 1)))
  else if t == "PUnit" then newAstPatUnit b m
  else if t == "PView" then newAstPatView b m (jExpr c b (f 0)) (jPat c b (f 1))
  else newAstPatMacCall b m (jMac b (f 0))

fun jExpr (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let es = \x -> V.map (jExpr c b) (jarr x) in
  let fieldsOf =
    \x -> V.map (\y -> newAstExprField b (jmeta y) (jn b (jf y 0)) (jExpr c b (jf y 1))) (jarr x)
  in if t == "Var" then newAstExprVar b m (jn b (f 0))
     else if t == "LitE" then newAstExprLit b m (jLit b (f 0))
     else if t == "Interp" then
       newAstExprInterp
         b
         m
         (V.map (\x -> M.unwrapOr "" (J.asString x)) (jarr (f 0)))
         (V.map
            (\h ->
              newAstHole b (jmeta h) (jExpr c b (jf h 0)) (M.unwrapOr False (J.asBool (jf h 1))))
            (jarr (f 1)))
     else if t == "Lam" then newAstExprLam b m (V.map (jPat c b) (jarr (f 0))) (jExpr c b (f 1))
     else if t == "App" then newAstExprApp b m (jExpr c b (f 0)) (es (f 1))
     else if t == "Let" then newAstExprLet b m (V.map (jBind c b) (jarr (f 0))) (jExpr c b (f 1))
     else if t == "If" then newAstExprIf b m (jExpr c b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
     else if t == "Match" then
       newAstExprMatch
         b
         m
         (jExpr c b (f 0))
         (V.map
            (\a ->
              newAstArm
                b
                (jmeta a)
                (jPat c b (jf a 0))
                (jopt (jExpr c b) (jf a 1))
                (jExpr c b (jf a 2)))
            (jarr (f 1)))
     else if t == "Neg" then newAstExprNeg b m (jn b (f 0)) (jExpr c b (f 1))
     else if t == "AndE" then newAstExprAnd b m (jn b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
     else if t == "OrE" then newAstExprOr b m (jn b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
     else if t == "Chain" then chainOf c b (jExpr c b (f 0)) (V.zip (jarr (f 1)) (es (f 2)))
     else if t == "Tuple" then newAstExprTuple b m (es (f 0))
     else if t == "ArrayE" then newAstExprArray b m (es (f 0))
     else if t == "ListE" then newAstExprList b m (es (f 0))
     else if t == "Cons" then newAstExprCons b m (jn b (f 0)) (es (f 1))
     else if t == "Qual" then newAstExprQual b m (jn b (f 0)) (jn b (f 1))
     else if t == "RecordE" then newAstExprRecord b m (fieldsOf (f 0)) (jopt (jExpr c b) (f 1))
     else if t == "Update" then newAstExprUpdate b m (jExpr c b (f 0)) (fieldsOf (f 1))
     else if t == "Proj" then newAstExprProj b m (jExpr c b (f 0)) (jn b (f 1))
     else if t == "Handle" then
       newAstExprHandle
         b
         m
         (jExpr c b (f 0))
         (V.map
            (\a ->
              newAstHArm
                b
                (jmeta a)
                (jn b (jf a 0))
                (jPat c b (jf a 1))
                (jn b (jf a 2))
                (jExpr c b (jf a 3)))
            (jarr (f 1)))
         (jopt (\r -> newAstRet b (jmeta r) (jPat c b (jf r 0)) (jExpr c b (jf r 1))) (f 2))
     else if t == "UnitE" then newAstExprUnit b m
     else if t == "HoleE" then newAstExprHole b m
     else newAstExprMacCall b m (jMac b (f 0))

-- A chain of operators grouped by the unit's fixities, as `meadow-rename`
-- groups one: each operator applied to its two operands, spanning them.
fun chainOf (c : Lc) b (first : Int) (steps : [(Json, Int)]) =
  let done =
    V.foldl
      (\st step ->
        match (st, step) with
        | ((outs, ops), (op, x)) ->
            let name = jstr op 3 in
            let here = fixityOf c.fx name in
            let reduced = reduceOps c b outs ops here in
            (V.pushBack (fst reduced) x, V.pushBack (snd reduced) (op, here)))
      ([first], [])
      steps
  in
  let outs = V.foldr (\o acc -> applyOp b acc o) (fst done) (snd done) in
  V.getOr first outs (V.len outs - 1)

-- Apply every operator on the stack that goes before one that binds as `here`.
fun reduceOps (c : Lc) b (outs : [Int]) ops (here : Fixity) =
  match V.get ops (V.len ops - 1) with
  | None -> (outs, ops)
  | Just (top, there) ->
      if goesBefore there here then
        reduceOps c b (applyOp b outs (top, there)) (V.take ops (V.len ops - 1)) here
      else (outs, ops)

-- Whether an operator binding as `there`, on the stack, is applied before one
-- binding as `here` is pushed: it binds tighter, or as tightly and they do
-- not both group right. Two that group neither way are an error the fixity
-- pass reports; they are read as if the first went first.
fun goesBefore (there : Fixity) (here : Fixity) : Bool =
  if there.level > here.level then True
  else if there.level < here.level then False
  else not (there.assoc == Right and here.assoc == Right)

-- The top two operands, operator `o` applied to them: `(+) l r`, or `Cons l r`.
fun applyOp b (outs : [Int]) o =
  match (o, V.get outs (V.len outs - 2), V.get outs (V.len outs - 1)) with
  | ((op, _), Just l, Just r) ->
      let lm = metaAstExpr b l in
      let rm = metaAstExpr b r in
      let m = spanMeta (min (metaStart lm) (metaStart rm)) (max (metaEnd lm) (metaEnd rm)) in
      let rest = V.take outs (V.len outs - 2) in
      if jstr op 3 == "::" then
        V.pushBack rest (newAstExprCons b m (newAstName b (jmeta op) "Cons") [l, r])
      else V.pushBack rest (newAstExprApp b m (newAstExprVar b (jmeta op) (jn b op)) [l, r])
  | _ -> outs
