-- `test`: a package's `@test` functions, compiled into a program of the
-- package's own, which `Testing` runs as `meadow test` runs them
-- (`buildtools/meadow/src/test.rs`).
--
-- A build with `test` set -- which only the package being tested is, never
-- what it depends on -- reads each of its modules with a little more at the
-- end than the file says: the module's tests, by name, in a list another
-- module may ask for, and in the root module every test of the package in
-- one list, numbered, and what runs one of them. Nothing is written to disk,
-- and nothing a test is or names changes: a test may be private to its
-- module, since the list is the module's own; and it is compiled as
-- everything else is, by this compiler.
--
-- A test is `@test fun name () = …`, run with `()`. It fails by performing
-- `Std.Test.fail` -- which `assert` and `assertEq` do -- or by stopping
-- where the program would stop, at a runtime error. The program runs one
-- test, the one its arguments number, and writes how it went to the file
-- they name: `ok`, or `FAILED` and why on the lines after, the message
-- shown as the runtime shows an unhandled `fail`. That each test is a run of
-- its own is what keeps one that stops from stopping the others, and what
-- it prints apart from what they print, as the Rust runner's tests are runs
-- of their own. The CEK machine, which answers no file, asks the root
-- module's `meadowTestsOneQ` and `meadowTestsKeptQ` instead, which answer
-- the message as it was failed with, as the Rust CEK machine says it.
--
-- What is written is written with names the module itself is given -- every
-- one through a `use` of its own, nothing of the prelude's -- so that the
-- standard library's root, which has no prelude, runs its tests the same
-- way: `meadow test --std`.

use Std.Collections.Vector as V
use Std.String as S
use Std.Path as Path
use Std.Maybe as M
use Std.Maybe.Maybe.*

-- What the root module is entered at in a build that tests.
@pub def runner : String = "meadowTestsMainQ"

-- The names of the functions `text` says are tests: each `fun` an `@test` is
-- written on, on its line or the one before.
@pub fun testsIn (text : String) : [String] =
  let lines = S.lines text in
  V.concatMap
    (\i ->
      (let line = S.trimStart (V.getOr "" lines i) in
       if not (S.startsWith "@test" line) then []
       else
         (let here = funAfter line in
          match here with
          | Just name -> [name]
          | None ->
              M.unwrapOr
                []
                (M.map (\n -> [n]) (funAfter (S.trimStart (V.getOr "" lines (i + 1))))))))
    (V.range 0 (V.len lines))

-- The name a `fun` on `line` defines, if one is there after its attributes.
fun funAfter (line : String) : Maybe String =
  let words = V.filter (\w -> not (S.isEmpty w)) (S.split " " line) in
  let at =
    V.foldl
      (\found i ->
        if M.isSome found then found else if V.getOr "" words i == "fun" then Just i else None)
      None
      (V.range 0 (V.len words))
  in match at with
     | Just i -> (let name = V.getOr "" words (i + 1) in if S.isEmpty name then None else Just name)
     | None -> None

-- The module a file under `src` of the package at `dir` is: its path, `[]`
-- for the root.
fun moduleOf (dir : String) (file : String) : Maybe [String] =
  let src = Path.normalize (Path.join dir "src") in
  let f = Path.normalize file in
  if not (S.startsWith src f) or not (S.endsWith ".mw" f) then None
  else
    (let rel = S.drop f (stringByteLength src + 1) in
     let bare = S.take rel (stringByteLength rel - 3) in
     let path = V.filter (\p -> not (S.isEmpty p)) (S.split "/" (S.join "/" (S.split "\\" bare))) in
     if path == ["Main"] or path == ["Lib"] then Just [] else Just path)

-- The list of a module's tests, as it is written at its end.
fun listed (path : [String]) (names : [String]) : String =
  let qualified = \n -> if V.isEmpty path then n else "${S.join "." path}.${n}" in
  -- Each is run for what it does, not what it answers: a test that answers
  -- something is a test all the same, and a list holds one type.
  let entry = \n -> "(\"${qualified n}\", \\() -> (let r = ${n} () in ()))" in
  -- Each in front of the next, `::`, which needs nothing in scope: a list of
  -- one in brackets would be a `Vector`.
  let listed = S.join "" (V.map (\n -> "${entry n} :: ") names) in
  "\n\n@pub def ${listName path} = ${listed}Nil\n"

-- What the list of the module at `path`'s tests is called: a name of its own,
-- since a module another declares `@pub mod` passes what it exports on to
-- that one, and a list it holds goes too. It is a `List`, which needs
-- nothing in scope to be written, as a `Vector` does.
fun listName (path : [String]) : String = "meadowTestsHere${S.join "" path}Q"

-- The package's sources, `pkg`'s at `dir`, each module with its tests listed
-- at its end and the root with what runs them.
@pub fun withTests (pkg : String) (dir : String) (sources : [(String, String)])
    : [(String, String)] =
  let modules =
    V.concatMap
      (\s ->
        match moduleOf dir (fst s) with
        | Just path -> [(fst s, path, testsIn (snd s))]
        | None -> [])
      sources
  in
  let others =
    V.concatMap
      (\m ->
        match m with
        | (_, path, names) -> if V.isEmpty path or V.isEmpty names then [] else [path])
      modules
  in V.map
       (\s ->
         match V.find (\m -> match m with | (f, _, _) -> f == fst s) modules with
         | Just (_, path, names) ->
             (let mine = if V.isEmpty names then "" else listed path names in
              if V.isEmpty path then (fst s, snd s ++ listed [] names ++ runs pkg others)
              else (fst s, snd s ++ mine))
         | None -> s)
       sources

-- The names of the package's tests, as `meadow test` says them, numbered as
-- the root module numbers them: the root module's first, then each other
-- module's, in the order of `sources`.
@pub fun testNames (dir : String) (sources : [(String, String)]) : [String] =
  let modules =
    V.concatMap
      (\s ->
        match moduleOf dir (fst s) with
        | Just path -> [(path, testsIn (snd s))]
        | None -> [])
      sources
  in
  let named = \path -> \n -> if V.isEmpty path then n else "${S.join "." path}.${n}" in
  let roots = V.filter (\m -> V.isEmpty (fst m)) modules in
  let others = V.filter (\m -> not (V.isEmpty (fst m))) modules in
  V.concatMap (\m -> V.map (named (fst m)) (snd m)) (V.append roots others)

-- What the CEK machine asks of the root module: test `i` run, whether it
-- failed and why; and the same with what it wrote kept, the pair and the
-- text.
@pub def oneTest : String = "meadowTestsOneQ"

@pub def keptTest : String = "meadowTestsKeptQ"

-- What the root module runs its tests and the other modules' with.
fun runs (pkg : String) (others : [[String]]) : String =
  let uses =
    V.map
      (\i -> "use ${pkg}.${S.join "." (V.getOr [] others i)} as MeadowTests${show i}Q\n")
      (V.range 0 (V.len others))
  in
  let lists =
    V.append
      ["MeadowTestsVQ.fromList meadowTestsHereQ"]
      (V.map
         (\i -> "MeadowTestsVQ.fromList MeadowTests${show i}Q.${listName (V.getOr [] others i)}")
         (V.range 0 (V.len others)))
  in S.join "" [
       "\nuse Std.Test as MeadowTestsTQ\n",
       "use Std.Collections.Vector as MeadowTestsVQ\n",
       "use Std.String as MeadowTestsSQ\n",
       "use Std.Process as MeadowTestsPQ\n",
       "use Std.Fs as MeadowTestsFQ\n",
       "use Std.Console as MeadowTestsCQ\n",
       "use Std.Maybe as MeadowTestsMQ\n",
       S.join "" uses,
       "\n@pub def meadowTestsAllQ = MeadowTestsVQ.concat (MeadowTestsVQ.fromList (",
       S.join "" (V.map (\l -> "(${l}) :: ") lists),
       "Nil))\n",
       "\n@pub fun meadowTestsOneQ (i : Int) =\n",
       "  match MeadowTestsVQ.getOr (\"\", \\() -> ()) meadowTestsAllQ i with\n",
       "  | (_, t) ->\n",
       "      (match MeadowTestsTQ.failure t with\n",
       "       | (failed, why) -> (failed, why))\n",
       "\n@pub fun meadowTestsKeptQ (i : Int) = MeadowTestsCQ.withOutput (\\() -> meadowTestsOneQ i)\n",
       "\n@pub fun meadowTestsMainQ () =\n",
       "  let asked = MeadowTestsPQ.argv () in\n",
       "  let i = MeadowTestsMQ.unwrapOr (0 - 1) (MeadowTestsSQ.toInt (MeadowTestsVQ.getOr \"\" asked 1)) in\n",
       "  match meadowTestsOneQ i with\n",
       "  | (failed, why) ->\n",
       "      (let told = if failed then MeadowTestsSQ.concat \"FAILED\\n\" (show why) else \"ok\" in\n",
       "       let w = MeadowTestsFQ.writeString (MeadowTestsVQ.getOr \"\" asked 0, told) in\n",
       "       ())\n"
     ]
