-- Fixity: how chains of operators group.
--
-- The parser reads `a + b * c :: d` as a chain, flat: how it groups depends on
-- the fixities of its operators, and a fixity may be declared anywhere in the
-- unit -- after its use, in another module -- or in a dependency. So after
-- parsing, with every declaration read, this pass rewrites the parser's tree
-- as one of `Grouped`, a language whose chains are gone: each is the `Infix`
-- nodes its fixities make of it, `a + (b * c)`, its operands `Leaf`s. It
-- groups as `meadow-rename` does: an operator on the stack is applied before
-- the next is pushed when it binds tighter, or as tightly and both group
-- left; two of one level that do not group the same way -- or group neither
-- way, `a == b == c` -- are an error, and read as if the first went first.
--
-- A fixity is not scoped: the language's own operators bind as they always
-- do, a declared one as it is declared anywhere the unit sees, and anything
-- else as `infixl 9`.
--
-- A pattern's parentheses hold what the grammar reads as expressions, and a
-- chain there is grouped too: parsing let only `::` into one, which is
-- `infixr 5`, so it groups to the right, as `meadow-parser`'s patterns cons.

use Lingua (lang!, pass!)
use Lingua.Rewrite (Origin, Part)
use Lingua.Rewrite as W
use Lingua.Red as R
use Lingua.Red (Syntax)
use Lingua.Green (Green)
use Lingua.Lang (spanMeta)
use Lingua.Diagnostic (Diagnostic, Report, say, errorAt, collect)
use MeadowBoot.Syntax
use MeadowBoot.Syntax.Surface.*
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Sort (sortOn)
use Std.Macro (Reflect)
use Std.Result.Result.*

-- Which way an operator groups: `a - b - c` is `(a - b) - c`, `a ^ b ^ c` is
-- `a ^ (b ^ c)`, and `a == b == c` is neither.
@derive(Debug, PartialEq, Reflect)
@pub data Assoc = Left | Right | Neither

use Assoc.*

-- How an operator binds: `infixl 6` groups left at level 6. Levels run 0 to
-- 9, tighter as they go up.
@derive(Debug, PartialEq, Reflect)
@pub record Fixity = {
  assoc : Assoc,
  level : Int
}

fun fx (a : Assoc) (l : Int) : Fixity = Fixity { assoc = a, level = l }

-- What an operator nobody declared binds as.
def undeclared : Fixity = fx Left 9

-- The operators the language itself knows (`meadow_hir::OPERATORS`).
def builtin : [(String, Fixity)] =
  [
    ("^", fx Right 8),
    ("*", fx Left 7),
    ("/", fx Left 7),
    ("%", fx Left 7),
    ("+", fx Left 6),
    ("-", fx Left 6),
    ("<<", fx Left 6),
    (">>", fx Left 6),
    (">>>", fx Left 6),
    ("::", fx Right 5),
    ("++", fx Right 5),
    ("==", fx Neither 4),
    ("!=", fx Neither 4),
    ("<", fx Neither 4),
    (">", fx Neither 4),
    ("<=", fx Neither 4),
    (">=", fx Neither 4)
  ]

fun builtinOf (op : String) : Maybe Fixity = M.map snd (V.find (\b -> fst b == op) builtin)

-- The keyword a fixity is declared with.
fun keyword (f : Fixity) : String =
  match f.assoc with
  | Left -> "infixl"
  | Right -> "infixr"
  | Neither -> "infix"

-- How `op` binds, with the unit's declarations `declared`.
@pub fun fixityOf (declared : HashMap String Fixity) (op : String) : Fixity =
  match builtinOf op with
  | Just f -> f
  | None -> M.unwrapOr undeclared (H.lookup op declared)

-- --- declarations ------------------------------------------------------------

-- Every fixity the modules `trees` declare, on top of `known` -- a
-- dependency's, say -- the first declaration of an operator the one that
-- stands. A level out of range, a language operator declared otherwise than
-- it is, and one declared two ways are errors, reported where they are.
@pub fun declare (known : HashMap String Fixity) (trees : [Syntax Surface])
    : HashMap String Fixity ! { Report | e } =
  V.foldl (\acc t -> V.foldl declareOne acc (R.nodes t)) known trees

fun declareOne (acc : HashMap String Fixity) (d : Syntax Surface)
    : HashMap String Fixity ! { Report | e } =
  match M.andThen
    (\i -> V.find (\x -> R.kindOf x == NodeFixity) (R.nodes i))
    (V.find (\x -> R.kindOf x == NodeItem) (R.nodes d)) with
  | Just (SurfaceFixity assoc prec ops) ->
      let level = M.unwrapOr 0 (S.toInt (R.text prec)) in
      let f =
        fx
          (if R.kindOf assoc == TokenInfixl then Left
           else if R.kindOf assoc == TokenInfixr then Right
           else Neither)
          level
      in if level > 9 then
           (let u = say (errorAt (metaOf prec) "fixity level ${show level} is out of range") in acc)
         else V.foldl (\a o -> declareOp a f o) acc ops
  | _ -> acc

fun declareOp (acc : HashMap String Fixity) (f : Fixity) (o : Syntax Surface)
    : HashMap String Fixity ! { Report | e } =
  match V.find (\x -> R.kindOf x == NodeOpName) (R.nodes o) with
  | None -> acc
  | Just n ->
      let name = S.trim (R.text n) in
      match builtinOf name with
      | Just b ->
          (if b == f then acc
           else
             (let u =
                say
                  (errorAt
                     (metaOf n)
                     "`${name}` is `${keyword b} ${show b.level}` in the language itself")
              in acc))
      | None ->
          (match H.lookup name acc with
           | Just before ->
               (if before == f then acc
                else
                  (let u =
                     say
                       (errorAt
                          (metaOf n)
                          "`${name}` was already declared `${keyword before} ${show before.level}`")
                   in acc))
           | None -> H.insert name f acc)

fun metaOf (s : Syntax Surface) = spanMeta (R.offset s) (R.endOffset s)

-- --- the pass ----------------------------------------------------------------

-- The parser's language with its chains grouped: where the parser has a chain
-- of operators, `Ops`, an operator applied to two, or an operand alone.
@pub(pkg) lang! {
  pub Grouped extends Surface
  Ops - Ops
  Ops + Infix { lhs : Ops, op : InfixOp, rhs : Ops }
  Ops + Leaf { operand : Operand }
}

pass! {
  regroup : Surface -> Grouped with table
    | Ops { first, rest } -> chain out table first rest
}

-- The chain `first`, then each operator and operand in `rest`, grouped.
fun chain
    (out : Origin Surface Grouped)
    (table : HashMap String Fixity)
    (first : Part Grouped)
    (rest : [Part Grouped])
    : Part Grouped ! { Report | e } =
  let leaf = \p -> W.node out Grouped.NodeLeaf [p] in
  let steps =
    V.concatMap
      (\t ->
        let cs = W.childrenOf out t in
        match (
          V.find (\c -> W.kindOf out c == Grouped.NodeInfixOp) cs,
          V.find (\c -> W.kindOf out c == Grouped.NodeOperand) cs
        ) with
        | (Just op, Just operand) -> [(op, operand)]
        | _ -> [])
      rest
  in
  let applied =
    V.foldl
      (\st s ->
        match (st, s) with
        | ((outs, ops), (op, operand)) ->
            let name = S.trim (W.textOf out op) in
            let here = fixityOf table name in
            let reduced = reduce out outs ops name here op in
            (V.pushBack (fst reduced) (leaf operand), V.pushBack (snd reduced) (op, here, name)))
      ([leaf first], [])
      steps
  in
  let outs = V.foldr (\o acc -> apply out acc o) (fst applied) (snd applied) in
  M.unwrapOr (leaf first) (V.get outs (V.len outs - 1))

-- Apply every operator on the stack that goes before operator `name`, which
-- binds as `here`.
fun reduce
    (out : Origin Surface Grouped)
    (outs : [Part Grouped])
    (ops : [(Part Grouped, Fixity, String)])
    (name : String)
    (here : Fixity)
    (at : Part Grouped)
    : ([Part Grouped], [(Part Grouped, Fixity, String)]) ! { Report | e } =
  match V.get ops (V.len ops - 1) with
  | None -> (outs, ops)
  | Just (top, there, topName) ->
      let goes =
        if there.level > here.level then True
        else if there.level < here.level then False
        else if there.assoc == Left and here.assoc == Left then True
        else if there.assoc == Right and here.assoc == Right then False
        else
          let why =
            if topName == name and there.assoc == Neither then
              "`${topName}` is `${keyword there} ${show there.level}`, which does not group: `x ${topName} y ${topName} z` means nothing"
            else
              "`${topName}` (`${keyword there} ${show there.level}`) and `${name}` (`${keyword here} ${show here.level}`) cannot be mixed without parentheses"
          in
          let u = say (errorAt (spanMeta (W.from at) (W.to at)) why) in
          True
      in if goes then
           reduce
             out
             (apply out outs (top, there, topName))
             (V.take ops (V.len ops - 1))
             name
             here
             at
         else (outs, ops)

-- The top two operands, the operator applied to them.
fun apply
    (out : Origin Surface Grouped)
    (outs : [Part Grouped])
    (o : (Part Grouped, Fixity, String))
    : [Part Grouped] =
  match (o, V.get outs (V.len outs - 2), V.get outs (V.len outs - 1)) with
  | ((op, _, _), Just l, Just r) ->
      V.pushBack (V.take outs (V.len outs - 2)) (W.node out Grouped.NodeInfix [l, op, r])
  | _ -> outs

-- `tree` with every chain grouped by `table`'s fixities, and what was wrong.
@pub fun grouped (table : HashMap String Fixity) (tree : Syntax Surface)
    : (Green Grouped, [Diagnostic]) =
  collect (\() -> regroup table tree)

-- --- what the grouping is ----------------------------------------------------
--
-- What the fixity test compares: each chain of operators outside a pattern,
-- by where its first operator is, bracketed as it grouped -- each operator
-- with where it is, each operand `_` -- as `meadow-rename` groups the same
-- chain. A pattern's `::` is not an operator there: `meadow-parser` reads it
-- as a pattern, not a chain.

-- Every chain of `tree` outside a pattern, a line each, first operator first.
@pub fun chainsOf (tree : Syntax Grouped) : [String] = V.map snd (sortOn fst (chainsIn tree False))

-- The chains under `s`, each with where its first operator is. `pattern` is
-- whether `s` is inside a pattern's parentheses.
fun chainsIn (s : Syntax Grouped) (pattern : Bool) : [(Int, String)] =
  let k = R.kindOf s in
  if k == Grouped.NodeInfix then
    V.append
      (if pattern then [] else [(firstOp s, bracketed s)])
      (V.concatMap (\c -> chainsIn c pattern) (leaves s))
  else if k == Grouped.NodePatParen then
    V.concatMap
      (\c -> if R.kindOf c == Grouped.NodeElem then elemChains c True else chainsIn c pattern)
      (R.nodes s)
  else if k == Grouped.NodeElem then elemChains s pattern
  else V.concatMap (\c -> chainsIn c pattern) (R.nodes s)

-- An element of parentheses: in a pattern's, a view's function is an
-- expression, and anything else a pattern.
fun elemChains (e : Syntax Grouped) (pattern : Bool) : [(Int, String)] =
  let view = V.any (\c -> R.kindOf c == Grouped.NodeViewTail) (R.nodes e) in
  V.concatMap
    (\c -> chainsIn c (pattern and not (view and R.kindOf c == Grouped.NodeExpr)))
    (R.nodes e)

-- The operands of a chain, however deep: where the chains inside it are.
fun leaves (s : Syntax Grouped) : [Syntax Grouped] =
  match s with
  | GroupedInfix l _ r -> V.append (leaves l) (leaves r)
  | _ -> [s]

fun firstOp (s : Syntax Grouped) : Int =
  match s with
  | GroupedInfix l op _ ->
      (if R.kindOf l == Grouped.NodeInfix then min (firstOp l) (startOf op) else startOf op)
  | _ -> 0

fun bracketed (s : Syntax Grouped) : String =
  match s with
  | GroupedInfix l op r ->
      "(${bracketed l} ${S.trim (R.text op)}@${show (startOf op)}..${show (endOf op)} ${bracketed r})"
  | _ -> "_"

-- Where a node's first and last tokens are, the text between them not
-- counted.
fun startOf (s : Syntax Grouped) : Int =
  M.unwrapOr
    (R.offset s)
    (M.map R.offset (V.find (\t -> not (groupedIsTrivia (R.kindOf t))) (tokensUnder s)))

fun endOf (s : Syntax Grouped) : Int =
  let ts = V.filter (\t -> not (groupedIsTrivia (R.kindOf t))) (tokensUnder s) in
  M.unwrapOr (R.endOffset s) (M.map R.endOffset (V.get ts (V.len ts - 1)))

fun tokensUnder (s : Syntax Grouped) : [Syntax Grouped] =
  if R.isTokenOf s then [s] else V.concatMap tokensUnder (R.children s)
