-- --- effects -----------------------------------------------------------------

-- A named function's type as a use sees it: the effect of each arrow it
-- answers with left open at its end.
fun openArrows (i : Inf s) (t : Type) : Type ! { St s | e } =
  -- Only what the type is at its top is asked, of it and of its effect: the
  -- whole of each was written out again for the asking, at every mention of
  -- a name.
  match prune i.ar t with
  | Fun ps ret eff ->
      let eff2 =
        (match prune i.ar eff with
         | RowEmpty -> freshEffect i.ar
         | closed -> openRowEnd i closed)
      in
      let ret2 = openArrows i ret in
      Fun ps ret2 eff2
  | _ -> t

-- `row` with a fresh variable for its end, if it is a closed row of at least
-- one effect.
fun openRowEnd (i : Inf s) (row : Type) : Type ! { St s | e } =
  let z = zonk i.ar row in
  match (z, rowEnd z) with
  | (RowExtend _ _ _, RowEmpty) -> (let tail = freshEffect i.ar in rebuildRow z tail)
  | _ -> row

fun rowEnd (t : Type) : Type =
  match t with
  | RowExtend _ _ rest -> rowEnd rest
  | other -> other

fun rebuildRow (row : Type) (tail : Type) : Type =
  match row with
  | RowExtend l f rest -> RowExtend l f (rebuildRow rest tail)
  | _ -> tail

-- A called function's latent effect folded into the current region.
fun joinEffect (i : Inf s) (phi : Type) : () ! { St s | e } =
  match prune i.ar phi with
  | RowEmpty -> ()
  | _ -> joinEffectInto i (stGetRef i.curEffect) phi

-- `phi` made part of `region`: equal, but for the `St` labels of the
-- `runSt`s `phi` is older than, and waiting, as a subsumption, while a region
-- inside a newer `runSt` has not taken shape.
fun joinEffectInto (i : Inf s) (region : Type) (phi0 : Type) : () ! { St s | e } =
  let settling = stGetRef i.settlingJoins in
  let assoc = waitsOnImpl i phi0 in
  -- A trait's associated effect, of types whose `impl` has not been found:
  -- what it is, that `impl` will say. Unified with the region now it would
  -- *be* the region -- everything else performed here -- and the `impl`
  -- would then be refused for saying less. So the join waits until the
  -- binding's wanted are answered.
  if assoc and not settling then
    stSetRef i.subsumptions (V.pushBack (stGetRef i.subsumptions) (phi0, region))
  else if assoc then
    -- One that is still a variable when its binding is done is generic
    -- there: the function performs it, whatever it is, *and* what else its
    -- region names. So it is the region's end -- `{ St s | Reading r }` --
    -- and not the whole of it, which would have every `impl` say it
    -- performs the `St s` too.
    (match splitRow (zonk i.ar phi0) with
     | (named, last) ->
         -- What it names before its end is joined as any row is, with an
         -- end of its own; then the end.
         let u =
           if V.isEmpty named then ()
           else
             joinEffectInto
               i
               region
               (V.foldl
                  (\rest (lab : (String, Type)) -> RowExtend (fst lab) (snd lab) rest)
                  (freshEffect i.ar)
                  (V.reverse named))
         in match rowEnd (zonk i.ar region) with
            | Var open -> unifyAt i (Var open) last
            | _ -> unifyAt i region last)
  else joinSettled i region (onceEach i phi0)

-- A row's labels each once: an effect named twice is performed once -- `{ St
-- s, St s }`, what a function that writes a state and reads rows of that
-- same state comes to once the rows' `impl` is known.
fun onceEach (i : Inf s) (phi : Type) : Type ! { St s | e } =
  match splitRow (zonk i.ar phi) with
  | (labels, last) ->
      let seen =
        V.foldl
          (\acc (lab : (String, Type)) ->
            (let f = zonk i.ar (snd lab) in
             if V.any (\(x : (String, Type)) -> fst x == fst lab and snd x == f) acc then acc
             else V.pushBack acc (fst lab, f)))
          []
          labels
      in V.foldl
           (\rest (lab : (String, Type)) -> RowExtend (fst lab) (snd lab) rest)
           last
           (V.reverse seen)

-- Whether `phi` is, for now, a variable standing for a trait's associated
-- effect -- alone, or at the end of a row that names effects before it: the
-- one remembered, or one it was unified with.
fun waitsOnImpl (i : Inf s) (phi : Type) : Bool ! { St s | e } =
  match rowEnd (zonk i.ar phi) with
  | Var id -> awaited i id
  | _ -> False

fun joinSettled (i : Inf s) (region : Type) (phi0 : Type) : () ! { St s | e } =
  -- Performing nothing asks nothing of the region: what an associated
  -- effect turned out to be, where its `impl` is pure.
  if zonk i.ar phi0 == RowEmpty then ()
  else
    let phi = openRowEnd i phi0 in
    if joinsWithin i region phi then ()
    else
      match zonk i.ar phi with
      | Var id ->
          let level = slotLevel i.ar id in
          let levels = stGetRef i.stLevels in
          let newer = V.any (\l -> l > level) levels in
          let waits =
            (match zonk i.ar region with
             | Var rid -> newer and rid != id and slotLevel i.ar rid >= M.unwrapOr 0 (V.last levels)
             | _ -> False)
          in if waits then
               stSetRef i.subsumptions (V.pushBack (stGetRef i.subsumptions) (phi, region))
             else unifyAt i (withoutInnerState i.ar region level) phi
      | _ -> unifyAt i region phi

-- Whether `phi` is part of `region` already: the two end in one variable and
-- every effect `phi` names is in `region`, whose arguments are then unified.
fun joinsWithin (i : Inf s) (region : Type) (phi : Type) : Bool ! { St s | e } =
  match (splitRow (zonk i.ar phi), splitRow (zonk i.ar region)) with
  | ((wantLabels, phiEnd), (have, regionEnd)) ->
      (match phiEnd with
       | Var _ ->
           if phiEnd != regionEnd then False
           else
             (match pairLabels wantLabels have [] with
              | Just pairs -> (let u = V.foldl (\w p -> unifyAt i (fst p) (snd p)) () pairs in True)
              | None -> False)
       | _ -> False)

fun splitRow (row : Type) : ([(String, Type)], Type) =
  match row with
  | RowExtend l f rest ->
      (match splitRow rest with
       | (ls, e) -> (V.pushFront ls (l, f), e))
  | other -> ([], other)

-- Each of `wantLabels` with the first of `have` of its name, first come first
-- served; `None` if one is missing.
fun pairLabels (wantLabels : [(String, Type)]) (have : [(String, Type)]) (acc : [(Type, Type)])
    : Maybe [(Type, Type)] =
  match V.get wantLabels 0 with
  | None -> Just acc
  | Just (label, field) ->
      (match V.find (\k -> fst (V.getOr ("", Error) have k) == label) (V.range 0 (V.len have)) with
       | Just k ->
           pairLabels
             (V.drop wantLabels 1)
             (V.concat [V.take have k, V.drop have (k + 1)])
             (V.pushBack acc (field, snd (V.getOr ("", Error) have k)))
       | None -> None)

-- Whether a join into `region` recorded since `mark` is still waiting.
fun hasPendingJoin (i : Inf s) (mark : Int) (region : Type) : Bool ! { St s | e } =
  match zonk i.ar region with
  | Var rid ->
      V.any
        (\p ->
          (match zonk i.ar (snd p) with
           | Var id -> id == rid
           | _ -> False))
        (V.drop (stGetRef i.subsumptions) mark)
  | _ -> False

-- A function-typed parameter with each latent effect a fresh one for the
-- argument to fill in, to be tied into what the parameter allowed.
fun loosenParameter (i : Inf s) (t : Type) : Type ! { St s | e } =
  match zonk i.ar t with
  | Fun params ret eff ->
      let ret2 = loosenParameter i ret in
      let actual = freshEffect i.ar in
      let u = stSetRef i.subsumptions (V.pushBack (stGetRef i.subsumptions) (actual, eff)) in
      Fun params ret2 actual
  | other -> other

-- Tie each argument effect recorded since `mark` into what its parameter
-- allowed.
fun solveSubsumptions (i : Inf s) (mark : Int) : () ! { St s | e } =
  -- What waits on an `impl` is joined once that is found, which is asked
  -- for first; one still a variable after that is generic here, and is the
  -- region's own.
  let waits = V.any (\p -> waitsOnImpl i (fst p)) (V.drop (stGetRef i.subsumptions) mark) in
  let t = if waits then solveWanted i else () in
  let all = stGetRef i.subsumptions in
  let u = stSetRef i.subsumptions (V.take all mark) in
  let was = stGetRef i.settlingJoins in
  let v = stSetRef i.settlingJoins True in
  let w = V.foldl (\x p -> joinEffectInto i (snd p) (fst p)) () (V.drop all mark) in
  stSetRef i.settlingJoins was

-- --- overloaded names --------------------------------------------------------

-- A placeholder for an overloaded name, whose meaning waits until the context
-- has constrained it.
fun defer (i : Inf s) (node : String) (candidates : [Meaning]) : Type ! { St s | e } =
  let t = fresh i.ar in
  let u =
    stSetRef
      i.pending
      (V.pushBack (stGetRef i.pending) (Pending { node, candidates, ty = t, level = levelOf i.ar }))
  in t

-- Choose what can be chosen; at the end of the unit (`last`) report what
-- still cannot.
fun solveOverloads (i : Inf s) (last : Bool) : () ! { St s | e } =
  if V.isEmpty (stGetRef i.pending) then ()
  else
    let u = overloadRounds i in
    if last then
      (let ps = stGetRef i.pending in
       let v = stSetRef i.pending [] in
       V.foldl (\w (p : Pending) -> reportOverload i p) () ps)
    else ()

fun overloadRounds (i : Inf s) : () ! { St s | e } =
  let progress = overloadPass i 0 False in
  let more = if progress then True else solveJointly i in
  if more then overloadRounds i else ()

fun overloadPass (i : Inf s) (k : Int) (progress : Bool) : Bool ! { St s | e } =
  match V.get (stGetRef i.pending) k with
  | None -> progress
  | Just p ->
      let fits = fitting i p in
      if V.isEmpty fits then
        (let u = removePending i k in
         let v = reportOverload i p in
         overloadPass i k True)
      else if V.len fits == 1 then
        (let u = removePending i k in
         let v = choose i p (V.getOr 0 fits 0) in
         overloadPass i k True)
      else overloadPass i (k + 1) progress

fun removePending (i : Inf s) (k : Int) : () ! { St s | e } =
  let ps = stGetRef i.pending in
  stSetRef i.pending (V.concat [V.take ps k, V.drop ps (k + 1)])

-- The candidates of `p` whose type unifies with the one wanted, each tried
-- and taken back.
fun fitting (i : Inf s) (p : Pending) : [Int] ! { St s | e } =
  V.filter
    (\k ->
      let snap = snapshot i.ar in
      let outer = levelOf i.ar in
      let u = setLevel i.ar p.level in
      let fits =
        (match candidateType i (V.getOr (Value 0) p.candidates k) with
         | Just t -> isOk (unify i.ar p.ty t)
         | None -> True)
      in
      let v = setLevel i.ar outer in
      let w = rollback i.ar snap in
      fits)
    (V.range 0 (V.len p.candidates))

fun isOk (r : Result UnifyError ()) : Bool = match r with | Ok _ -> True | Err _ -> False

-- A candidate's type, instantiated: `None` for a value not typed yet.
fun candidateType (i : Inf s) (alt : Meaning) : Maybe Type ! { St s | e } =
  match alt with
  | Ctor c -> ctorType i c
  | Value v -> M.map (\sc -> openLatent i (instantiate i sc)) (schemeOf i v)

-- `t` with the effect of every arrow it returns through left open, as
-- `meadow_infer`'s `open_latent`: a function that does less than a use of it
-- allows fits that use. Not a parameter's.
fun openLatent (i : Inf s) (t : Type) : Type ! { St s | e } =
  match zonk i.ar t with
  | Fun params ret eff -> Fun params (openLatent i ret) (openTail i eff)
  | other -> other

fun openTail (i : Inf s) (row : Type) : Type ! { St s | e } =
  match row with
  | RowExtend l f rest -> RowExtend l f (openTail i rest)
  | RowEmpty -> freshEffect i.ar
  | other -> other

-- Commit to candidate `k`.
fun choose (i : Inf s) (p : Pending) (k : Int) : () ! { St s | e } =
  let alt = V.getOr (Value 0) p.candidates k in
  let outer = levelOf i.ar in
  let u = setLevel i.ar p.level in
  let chosen =
    (match alt with
     | Value v -> M.map (\sc -> instantiateAt i p.node sc) (schemeOf i v)
     | Ctor _ -> candidateType i alt)
  in
  let t =
    (match chosen with
     | Just x -> openLatent i x
     | None ->
         (match alt with
          | Value v ->
              (let g = freshGlobal i.ar in
               let w = setScheme i v (mono g) in
               g)
          | Ctor _ -> Error))
  in
  let v = setLevel i.ar outer in
  let w = stSetRef i.chosenAt (H.insert p.node k (stGetRef i.chosenAt)) in
  unifyAt i p.ty t

fun reportOverload (i : Inf s) (p : Pending) : () ! { St s | e } =
  let u = report i "an overloaded name did not settle (${show (V.len p.candidates)} candidates)" in
  let r = unify i.ar p.ty Error in
  ()

-- Names tied together by their types, read together: each component of the
-- pending names that share a variable searched for every combination of
-- candidates that unifies at once.
fun solveJointly (i : Inf s) : Bool ! { St s | e } =
  let ps = stGetRef i.pending in
  let n = V.len ps in
  if n < 2 then False
  else
    let vars = V.map (\(p : Pending) -> freeVars i.ar p.ty []) ps in
    let groups = components n vars in
    match V.foldl
      (\acc members -> jointGroup i ps members acc)
      ([], [])
      (V.filter (\g -> V.len g >= 2) groups) with
    | (decided, hopeless) ->
        let u =
          V.foldl
            (\w d ->
              (match V.find
                 (\k -> (V.getOr (emptyPending ()) (stGetRef i.pending) k).node == fst d)
                 (V.range 0 (V.len (stGetRef i.pending))) with
               | Just k ->
                   (let p = V.getOr (emptyPending ()) (stGetRef i.pending) k in
                    let x = removePending i k in
                    choose i p (snd d))
               | None -> ()))
            ()
            decided
        in
        let v =
          V.foldl
            (\w nodes ->
              V.foldl
                (\x node ->
                  (match V.find
                     (\k -> (V.getOr (emptyPending ()) (stGetRef i.pending) k).node == node)
                     (V.range 0 (V.len (stGetRef i.pending))) with
                   | Just k ->
                       (let p = V.getOr (emptyPending ()) (stGetRef i.pending) k in
                        let y = removePending i k in
                        let z = unify i.ar p.ty Error in
                        ())
                   | None -> ()))
                ()
                nodes)
            ()
            hopeless
        in not (V.isEmpty decided) or not (V.isEmpty hopeless)

fun emptyPending () : Pending = Pending { node = "", candidates = [], ty = Error, level = 0 }

-- The pending names, by index, grouped by shared variables.
fun components (n : Int) (vars : [[Int]]) : [[Int]] =
  let root =
    V.foldl
      (\r a ->
        V.foldl
          (\r2 b ->
            if V.any (\v -> V.elem v (V.getOr [] vars b)) (V.getOr [] vars a) then union r2 a b
            else r2)
          r
          (V.range (a + 1) n))
      (V.range 0 n)
      (V.range 0 n)
  in
  let roots = V.map (\k -> findRoot root k) (V.range 0 n) in
  let order = V.foldl (\acc r -> if V.elem r acc then acc else V.pushBack acc r) [] roots in
  V.map (\r -> V.filter (\k -> V.getOr 0 roots k == r) (V.range 0 n)) order

fun findRoot (root : [Int]) (k : Int) : Int =
  if V.getOr k root k == k then k else findRoot root (V.getOr k root k)

fun union (root : [Int]) (a : Int) (b : Int) : [Int] =
  let ra = findRoot root a in
  let rb = findRoot root b in
  V.set root ra rb

-- One component searched: the names every solution agrees on, or the
-- component if there is none.
fun jointGroup (i : Inf s) (ps : [Pending]) (members : [Int]) (acc : ([(String, Int)], [[String]]))
    : ([(String, Int)], [[String]]) ! { St s | e } =
  let group = V.map (\k -> V.getOr (emptyPending ()) ps k) members in
  let st =
    SearchState { solutions = stNewRef [], budget = stNewRef 512, truncated = stNewRef False }
  in
  let u = search i group [] st in
  if stGetRef st.truncated then acc
  else
    let sols = stGetRef st.solutions in
    match V.get sols 0 with
    | None -> (fst acc, V.pushBack (snd acc) (V.map (\(p : Pending) -> p.node) group))
    | Just first ->
        let agreed =
          V.concatMap
            (\j ->
              (let k = V.getOr 0 first j in
               if V.all (\sol -> V.getOr 0 sol j == k) sols then
                 [((V.getOr (emptyPending ()) group j).node, k)]
               else []))
            (V.range 0 (V.len group))
        in (V.append (fst acc) agreed, snd acc)

record SearchState s = {
  solutions : StRef s [[Int]],
  budget : StRef s Int,
  truncated : StRef s Bool
}

fun search (i : Inf s) (group : [Pending]) (chosen : [Int]) (st : SearchState s)
    : () ! { St s | e } =
  if stGetRef st.truncated then ()
  else if V.len chosen == V.len group then
    let sols = V.pushBack (stGetRef st.solutions) chosen in
    let u = stSetRef st.solutions sols in
    if V.len sols > 64 then stSetRef st.truncated True else ()
  else
    let p = V.getOr (emptyPending ()) group (V.len chosen) in
    V.foldl
      (\w k ->
        if stGetRef st.truncated then ()
        else if stGetRef st.budget == 0 then stSetRef st.truncated True
        else
          let x = stSetRef st.budget (stGetRef st.budget - 1) in
          let snap = snapshot i.ar in
          let outer = levelOf i.ar in
          let y = setLevel i.ar p.level in
          let fits =
            (match candidateType i (V.getOr (Value 0) p.candidates k) with
             | Just t -> isOk (unify i.ar p.ty t)
             | None -> True)
          in
          let z = setLevel i.ar outer in
          let q = (if fits then search i group (V.pushBack chosen k) st else ()) in
          rollback i.ar snap)
      ()
      (V.range 0 (V.len p.candidates))

-- --- constructors ------------------------------------------------------------

-- A constructor's type, instantiated, its arrows opened.
fun ctorType (i : Inf s) (name : String) : Maybe Type ! { St s | e } =
  let t =
    (match H.lookup name (stGetRef i.ctors) with
     | Just sc -> Just (instantiate i sc)
     | None ->
         if name == "List.Nil" then Just (listT (fresh i.ar))
         else if name == "List.Cons" then (let a = fresh i.ar in Just (func [a, listT a] (listT a)))
         else if name == "Bool.True" or name == "Bool.False" then Just (boolT ())
         else None)
  in M.map (\x -> openArrows i x) t

-- The labels of constructor `name`'s fields, if they have them.
fun ctorLabels (i : Inf s) (name : String) : Maybe [String] ! { St s | e } =
  let owner =
    (let k = lastDot name (stringByteLength name - 1) in
     if k < 0 then name else stringSlice name 0 k)
  in M.andThen
       (\(v : VariantSig) -> v.labels)
       (M.andThen
          (\vs -> V.find (\(v : VariantSig) -> v.name == name) vs)
          (H.lookup owner (stGetRef i.variants)))

-- Where the last `.` of `s` at or before byte `k` is, or -1.
fun lastDot (s : String) (k : Int) : Int =
  if k < 0 then 0 - 1 else if toInt (stringByteAt s k) == 46 then k else lastDot s (k - 1)

-- The canonical name of the constructor a reference is to.
fun ctorName (i : Inf s) (a : HirArena) (ref : HirRef) : String = canonOf i (hirRefId a ref) ""

-- --- annotations -------------------------------------------------------------

fun scopedKey (here : Here) (name : String) : String = here.scope ++ "|" ++ name

-- The meta each of an annotation's variables stands for: made the first time
-- its declaration mentions it, the same one after.
fun metasFor (i : Inf s) (here : Here) (names : [String]) (kinds : [VarKind])
    : [Type] ! { St s | e } =
  V.map
    (\k ->
      let key = scopedKey here (V.getOr "" names k) in
      match H.lookup key (stGetRef i.annTyvars) with
      | Just t -> t
      | None ->
          (let t = freshIn i.ar (V.getOr Plain kinds k) in
           let u = stSetRef i.annTyvars (H.insert key t (stGetRef i.annTyvars)) in
           t))
    (V.range 0 (V.len names))

-- A written annotation as a type, its variables the declaration's.
fun annotation (i : Inf s) (here : Here) (t : HirType) : Type ! { St s | e } =
  let names = collectTyvars here.a t [] in
  let ty = tyOf i here.a t (indexed names) in
  let kinds = markEffectVars ty (V.replicate (V.len names) Plain) in
  let fresh = metasFor i here names kinds in
  liftAssocsWanted i (substBound ty fresh)

-- A declared effect row, in the annotation `whole`.
fun effectAnnotation (i : Inf s) (here : Here) (whole : HirType) (row : HirRow)
    : Type ! { St s | e } =
  let names = collectTyvars here.a whole [] in
  let eff = effOf i here.a row (indexed names) in
  let kinds = markEffectVars (Fun [unitT ()] (unitT ()) eff) (V.replicate (V.len names) Plain) in
  substBound eff (metasFor i here names kinds)

-- A function's declared result, and what its body performs when that is
-- said: `: R ! e`, or `: R`, a body that performs nothing.
fun declaredResult (i : Inf s) (here : Here) (declared : Maybe HirType)
    : (Type, Maybe Type) ! { St s | e } =
  match declared with
  | None -> (fresh i.ar, None)
  | Just t ->
      (match viewHirType here.a t with
       | HirTypeView.Fun r ->
           (match r.row with
            | Just row ->
                (if V.isEmpty r.params then
                   (let ret = annotation i here r.result in
                    (ret, Just (effectAnnotation i here t row)))
                 else (annotation i here t, Just RowEmpty))
            | None -> (annotation i here t, Just RowEmpty))
       | _ -> (annotation i here t, Just RowEmpty))

-- --- signatures --------------------------------------------------------------

fun sigOf (i : Inf s) (vid : Int) : Maybe Scheme ! { St s | e } =
  match H.lookup vid (stGetRef i.methodSigs) with
  | Just sc -> Just sc
  | None ->
      M.map
        (\(sg : SigOf) -> boundedScheme i sg.here.a sg.ty sg.bounds)
        (H.lookup vid (stGetRef i.sigs))

-- Tie a binding about to be inferred to its signature, if it has one.
fun seedSig (i : Inf s) (vid : Int) (t : Type) : () ! { St s | e } =
  match sigOf i vid with
  | None -> ()
  | Just sc ->
      (match instantiateWithPreds i sc with
       | (inst, given) ->
           let u = stSetRef i.givens (V.append (stGetRef i.givens) given) in
           (match unify i.ar t inst with
            | Ok _ -> ()
            | Err _ ->
                (let v = stSetRef i.sigFailed (H.insert vid True (stGetRef i.sigFailed)) in
                 report i "a definition does not have the type its signature gives")))

-- `vid` bound to `t` alone, tied first to whatever a mention before its
-- definition left for it.
fun bindMono (i : Inf s) (vid : Int) (t : Type) : () ! { St s | e } =
  let u =
    (match schemeOf i vid with
     | Just prev -> (if V.isEmpty prev.quant then unifyAt i prev.ty t else ())
     | None -> ())
  in setScheme i vid (mono t)

-- --- the languages -----------------------------------------------------------

-- A type of inference's, as a field of a node: `Type` there would be the
-- language's own sort of written types.
type Ty = Type

-- The dictionaries a mention of a name with a `where` is applied to, as a
-- node's field: none for any other name.
type Evs = [Evidence]

-- `Hir`, each expression and pattern holding its type as inference has it
-- so far: the arena's, whose variables later unification may yet write. Its
-- tables are written in the `runSt` inference runs in, which `s` says.
@pub(pkg) lang! { pub Inferring s extends Hir Expr * { typ : Ty } Pat * { typ : Ty } }

-- `Hir`, each expression and pattern holding its type, settled.
@pub(pkg) lang! {
  pub Typed extends Hir
  Expr - Var
  Expr + Var { ref : Ref, ev : Evs, inst : [Ty] }
  Expr * { typ : Ty }
  Pat * { typ : Ty }
}

-- --- the context -------------------------------------------------------------

-- How a binding is inferred: inside an expression; alone at the top of a
-- module, generalized when it is done; or one of a group whose members
-- mention one another, each seeded with a type the rest see, the group
-- generalized together once all are done.
data Mode = Local | Top | Member [(Int, Type)]

-- A handler clause's: what its operation takes and answers, what the whole
-- `handle` answers, and what escapes it.
record ClauseTys = {
  arg : Type,
  ret : Type,
  result : Type,
  outside : Type
}

-- What `infer` carries down the tree. `i` is inference's state and `here`
-- where it is, as the functions of the solver take them. The rest is for one
-- node only, which its parent sets and its own case reads -- `plain` clears
-- it for the children after: how a binding is inferred; what the pattern
-- being inferred binds; a match arm's scrutinee and result; a handler
-- clause's types; a `return` clause's body type and result; the state of the
-- `runSt` a lambda is the body of; and whether a group member stayed pure.
@pub record Cx s = {
  i : Inf s,
  here : Here,
  mode : Mode,
  bound : StRef s [(Int, Type)],
  arm : Maybe (Type, Type),
  clause : Maybe ClauseTys,
  back : Maybe (Type, Type),
  seed : Maybe Type,
  pure : StRef s Bool,
}

fun newCx (i : Inf s) (here : Here) (mode : Mode) : Cx s ! { St s | e } =
  Cx {
    i,
    here,
    mode,
    bound = stNewRef [],
    arm = None,
    clause = None,
    back = None,
    seed = None,
    pure = stNewRef True
  }

-- `cx` for a child: nothing of the node's own passed on.
fun plain (cx : Cx s) : Cx s =
  { cx | mode = Mode.Local, arm = None, clause = None, back = None, seed = None }

-- `cx` for a pattern: what it binds collected afresh.
fun binding (cx : Cx s) : Cx s ! { St s | e } = { (plain cx) | bound = stNewRef [] }

-- --- the pass ----------------------------------------------------------------

-- Inference as the cases of a pass: each node's type worked out from its
-- children's, which it already holds -- a child a case has to infer in a
-- context of its own taken `later`, and one a case has to look at before it
-- can say how, `raw`, translated when the case is ready. The order children
-- are inferred in is `meadow_infer`'s, since what unification knows when a
-- field is selected or a name chosen depends on it.
-- What a node of the walk does, with inference marked as at the node while
-- it does it, and where it was before once it is done: what an error found
-- on the way is said to be about.
fun placed (cx : Cx s) (m : Meta) (f : () -> a ! { St s | e }) : a ! { St s | e } =
  let before = stGetRef cx.i.at in
  let u = stSetRef cx.i.at (cx.here.m, metaStart m) in
  let x = f () in
  let v = stSetRef cx.i.at before in
  x

pass! {
  pub infer : Hir -> Inferring with cx
    | Expr.Lit { lit } -> placed cx here (\() -> Expr.Lit { lit, typ = litTypeIn cx.i out lit })
    | Expr.Unit {} -> placed cx here (\() -> Expr.Unit { typ = unitT () })
    | Expr.Hole {} -> placed cx here (\() -> Expr.Hole { typ = Error })
    | Expr.MacCall { call } -> placed cx here (\() -> Expr.MacCall { call, typ = Error })
    | Expr.Var { ref } -> placed cx here (\() -> Expr.Var { ref, typ = varType cx out ref })
    | Lam { later params, later body } ->
        placed cx here (\() ->
          (match lamParts cx out params body with
           | (ps, b, t) -> Lam { params = ps, body = b, typ = t }))
    | App { raw func, raw args } ->
        placed cx here (\() ->
          (match appParts cx src out func args with
           | (f, xs, t) -> App { func = f, args = xs, typ = t }))
    | Let { later binds, later body } ->
        placed cx here (\() ->
          (let bs = V.map (\b -> b (plain cx)) binds in
           let b = body (plain cx) in
           Let { binds = bs, body = b, typ = typInferringExpr b }))
    | If { later cond, later yes, later no } ->
        placed cx here (\() ->
          (let c = cond (plain cx) in
           let u = unifyAt cx.i (typInferringExpr c) (boolT ()) in
           let y = yes (plain cx) in
           let n = no (plain cx) in
           let v = unifyAt cx.i (typInferringExpr y) (typInferringExpr n) in
           If { cond = c, yes = y, no = n, typ = typInferringExpr y }))
    | Match { later scrutinee, later arms } ->
        placed cx here (\() ->
          (let s = scrutinee (plain cx) in
           let result = fresh cx.i.ar in
           let pl = plain cx in
           let ars = V.map (\arm -> arm { pl | arm = Just (typInferringExpr s, result) }) arms in
           Match { scrutinee = s, arms = ars, typ = result }))
    | Arm { later pat, later guard, later body } ->
        placed cx here (\() ->
          (let p = pat (binding cx) in
           let u =
             (match cx.arm with
              | Just (st, _) -> unifyAt cx.i (typInferringPat p) st
              | None -> ())
           in
           let g =
             M.map
               (\gt ->
                 (let gx = gt (plain cx) in
                  let v = unifyAt cx.i (typInferringExpr gx) (boolT ()) in
                  gx))
               guard
           in
           let b = body (plain cx) in
           let w =
             (match cx.arm with
              | Just (_, result) -> unifyAt cx.i (typInferringExpr b) result
              | None -> ())
           in Arm { pat = p, guard = g, body = b }))
    | Expr.Tuple { items } ->
        placed cx here (\() ->
          Tuple { items, typ = Tuple (V.map (\x -> typInferringExpr x) items) })
    | Expr.Array { later items } ->
        placed cx here (\() ->
          (let elem = fresh cx.i.ar in
           let xs =
             V.map
               (\it ->
                 (let x = it (plain cx) in
                  let u = unifyAt cx.i (typInferringExpr x) elem in
                  x))
               items
           in Expr.Array { items = xs, typ = arrayT elem }))
    | Expr.List { later items } ->
        placed cx here (\() ->
          (let elem = fresh cx.i.ar in
           let xs =
             V.map
               (\it ->
                 (let x = it (plain cx) in
                  let u = unifyAt cx.i (typInferringExpr x) elem in
                  x))
               items
           in Expr.List { items = xs, typ = listT elem }))
    | Expr.Cons { ref, raw args } ->
        placed cx here (\() ->
          (match consParts cx src out ref args with
           | (xs, t) -> Expr.Cons { ref, args = xs, typ = t }))
    | Expr.Record { raw fields, later base } ->
        placed cx here (\() ->
          (match recordParts cx src out fields base with
           | (fs, b, t) -> Expr.Record { fields = fs, base = b, typ = t }))
    | Update { later base, raw fields } ->
        placed cx here (\() ->
          (match updateParts cx src out base fields with
           | (b, fs, t) -> Update { base = b, fields = fs, typ = t }))
    | Proj { target, label } ->
        placed cx here (\() -> Proj { target, label, typ = projType cx out target label })
    | Handle { later body, raw arms, raw ret } ->
        placed cx here (\() ->
          (match handleParts cx src out body arms ret with
           | (b, hs, r, t) -> Handle { body = b, arms = hs, ret = r, typ = t }))
    | HArm { op, opRef, later param, resume, later body } ->
        placed cx here (\() ->
          (let tys =
             M.unwrapOr
               (ClauseTys {
                  arg = fresh cx.i.ar,
                  ret = fresh cx.i.ar,
                  result = fresh cx.i.ar,
                  outside = freshEffect cx.i.ar
                })
               cx.clause
           in
           let p = param (binding cx) in
           let u = unifyAt cx.i (typInferringPat p) tys.arg in
           let v = setScheme cx.i resume (mono (Fun [tys.ret] tys.result tys.outside)) in
           let b = body (plain cx) in
           let w = unifyAt cx.i (typInferringExpr b) tys.result in
           HArm { op, opRef, param = p, resume, body = b }))
    | Ret { later pat, later body } ->
        placed cx here (\() ->
          (let p = pat (binding cx) in
           let u =
             (match cx.back with
              | Just (bodyTy, _) -> unifyAt cx.i (typInferringPat p) bodyTy
              | None -> ())
           in
           let b = body (plain cx) in
           let v =
             (match cx.back with
              | Just (_, result) -> unifyAt cx.i (typInferringExpr b) result
              | None -> ())
           in Ret { pat = p, body = b }))
    | Pat.Wild {} -> placed cx here (\() -> Pat.Wild { typ = fresh cx.i.ar })
    | Pat.Unit {} -> placed cx here (\() -> Pat.Unit { typ = unitT () })
    | Pat.MacCall { call } -> placed cx here (\() -> Pat.MacCall { call, typ = Error })
    | Pat.Lit { lit } -> placed cx here (\() -> Pat.Lit { lit, typ = litTypeIn cx.i out lit })
    | Pat.Var { id } ->
        placed cx here (\() -> Pat.Var { id, typ = bindPatVar cx id (fresh cx.i.ar) })
    | Pat.As { id, pat } ->
        placed cx here (\() -> Pat.As { id, pat, typ = bindPatVar cx id (typInferringPat pat) })
    | Pat.Ann { pat, raw ty } ->
        placed cx here (\() ->
          (let declared = annotation cx.i cx.here ty in
           let u = unifyAt cx.i (typInferringPat pat) declared in
           Pat.Ann { pat, ty = inferType src out cx ty, typ = typInferringPat pat }))
    | Pat.Cons { ref, raw args } ->
        placed cx here (\() ->
          (match patConsParts cx src out ref args with
           | (ps, t) -> Pat.Cons { ref, args = ps, typ = t }))
    | Pat.Tuple { items } ->
        placed cx here (\() ->
          Pat.Tuple { items, typ = Tuple (V.map (\p -> typInferringPat p) items) })
    | Pat.Array { later items } ->
        placed cx here (\() ->
          (let elem = fresh cx.i.ar in
           let ps =
             V.map
               (\it ->
                 (let p = it cx in
                  let u = unifyAt cx.i (typInferringPat p) elem in
                  p))
               items
           in Pat.Array { items = ps, typ = arrayT elem }))
    | Pat.List { later items } ->
        placed cx here (\() ->
          (let elem = fresh cx.i.ar in
           let ps =
             V.map
               (\it ->
                 (let p = it cx in
                  let u = unifyAt cx.i (typInferringPat p) elem in
                  p))
               items
           in Pat.List { items = ps, typ = listT elem }))
    | Pat.Vector { items } -> placed cx here (\() -> Pat.Vector { items, typ = Error })
    | Pat.Record { raw fields, open } ->
        placed cx here (\() ->
          (match patRecordParts cx src out fields open with
           | (fs, t) -> Pat.Record { fields = fs, open, typ = t }))
    | Pat.View { fn, pat } ->
        placed cx here (\() ->
          (let arg = fresh cx.i.ar in
           let phi = freshEffect cx.i.ar in
           let u = unifyAt cx.i (typInferringExpr fn) (Fun [arg] (typInferringPat pat) phi) in
           let v = joinEffect cx.i phi in
           Pat.View { fn, pat, typ = arg }))
    | Bind.Fun { id, later params, raw ret, later body } ->
        placed cx here (\() ->
          (match funBindParts cx src out id params ret body with
           | (ps, b) ->
               Bind.Fun {
                 id,
                 params = ps,
                 ret = M.map (\t -> inferType src out (plain cx) t) ret,
                 body = b
               }))
    | Bind.Pat { later pat, later value } ->
        placed cx here (\() ->
          (match patBindParts cx out pat value with
           | (p, v) -> Bind.Pat { pat = p, value = v }))
}

-- `id`, a pattern's name, bound to `t` and collected as the pattern's.
fun bindPatVar (cx : Cx s) (id : Int) (t : Type) : Type ! { St s | e } =
  let u = bindMono cx.i id t in
  let v = stSetRef cx.bound (V.pushBack (stGetRef cx.bound) (id, t)) in
  t

-- A literal's type: a number's a variable of numbers until something says
-- which.
fun litTypeIn (i : Inf s) out (l : InferringLit) : Type ! { St s | e } =
  match kindInferringLit out l with
  | InferringLitKind.Int -> freshNum i.ar
  | InferringLitKind.Float -> freshIn i.ar Frac
  | InferringLitKind.String -> stringT ()
  | InferringLitKind.Char -> charT ()

-- A name's type where it is used: several meanings wait to be chosen, and
-- one a scheme instantiated, its arrows opened.
fun varType (cx : Cx s) out (ref : InferringRef) : Type ! { St s | e } =
  let i = cx.i in
  let id = inferringRefId out ref in
  let alts = inferringRefAlts out ref in
  if not (V.isEmpty alts) then defer i "${show cx.here.m}:${show ref}" (V.map (\x -> Value x) alts)
  else
    match schemeOf i id with
    | Just sc ->
        (let grouped = V.elem id (stGetRef i.group) in
         -- A name that is of one type and not of the group is its type:
         -- nothing is kept of the mention, so nothing is named by it.
         if V.isEmpty sc.quant and not grouped then openArrows i sc.ty
         else
           (let key = "${show cx.here.m}:${show ref}" in
            -- A member of the group being inferred has no scheme yet: what
            -- it will ask for is handed over when the group is closed.
            let u =
              if grouped then
                stSetRef i.mentions (V.pushBack (stGetRef i.mentions) (key, id, stGetRef i.member))
              else ()
            in openArrows i (instantiateAt i key sc)))
    | None ->
        (let t = freshGlobal i.ar in
         let u = setScheme i id (mono t) in
         t)

-- A lambda: its parameters and body in a region of their own -- or, as
-- `runSt`'s body, its one parameter `()` and its body performing the state
-- the `runSt` made.
fun lamParts (cx : Cx s) out params body =
  match cx.seed with
  | Just state ->
      (if V.len params == 1 then seededLam cx out state params body
       else plainLam cx out params body)
  | None -> plainLam cx out params body

fun plainLam (cx : Cx s) out params body =
  let i = cx.i in
  let bodyEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u = stSetRef i.curEffect bodyEff in
  let pc = binding cx in
  let ps = V.map (\p -> p pc) params in
  let b = body (plain cx) in
  let v = stSetRef i.curEffect saved in
  (ps, b, funcEff (V.map (\p -> typInferringPat out p) ps) (typInferringExpr out b) bodyEff)

fun seededLam (cx : Cx s) out (state : Type) params body =
  let i = cx.i in
  let ps = V.map (\p -> p (binding cx)) params in
  let w = unifyAt i (typInferringPat out (V.getOr 0 ps 0)) (unitT ()) in
  let tail = freshEffect i.ar in
  let seeded = RowExtend "St" (Tuple [state]) tail in
  let saved = stGetRef i.curEffect in
  let x = stSetRef i.curEffect seeded in
  let b = body (plain cx) in
  let y = stSetRef i.curEffect saved in
  (ps, b, funcEff [unitT ()] (typInferringExpr out b) seeded)

-- A call: `runSt` applied is the one place a type is polymorphic in its
-- argument; anything else, each argument in turn, only the last call running
-- the function and so joining its effect.
fun appParts (cx : Cx s) (src : HirArena) out (func : HirExpr) (args : [HirExpr]) =
  let i = cx.i in
  let isRunSt =
    (match viewHirExpr src func with
     | HirExprView.Var r ->
         hirRefId src r.ref == i.runSt and not (V.isEmpty args) and V.isEmpty (hirRefAlts src r.ref)
     | _ -> False)
  in
  let f = inferExpr src out (plain cx) func in
  if isRunSt then
    (match runStArg cx src out (V.getOr func args 0) with
     | (x0, result) ->
         (match applied cx src out result (V.drop args 1) with
          | (xs, t) -> (f, V.pushFront xs x0, t)))
  else
    (match applied cx src out (typInferringExpr out f) args with
     | (xs, t) -> (f, xs, t))

-- Each of `args` applied in turn to what has type `fty0`.
fun applied (cx : Cx s) (src : HirArena) out (fty0 : Type) (args : [HirExpr]) =
  let i = cx.i in
  let last = V.len args - 1 in
  V.foldl
    (\acc k ->
      match acc with
      | (xs, fty) ->
          let x = inferExpr src out (plain cx) (V.getOr 0 args k) in
          let aty = typInferringExpr out x in
          let ret = fresh i.ar in
          let phi = freshEffect i.ar in
          let u =
            (match prune i.ar fty with
             | Fun params fret feff ->
                 if V.len params == 1 and isFun (prune i.ar (V.getOr Error params 0)) then
                   (let loose = loosenParameter i (V.getOr Error params 0) in
                    let x2 = unifyAt i aty loose in
                    let y = unifyAt i fret ret in
                    unifyAt i feff phi)
                 else unifyAt i fty (Fun [aty] ret phi)
             | other -> unifyAt i other (Fun [aty] ret phi))
          in
          let v =
            (if k == last then
               (let outer =
                  (match prune i.ar phi with
                   | Var id -> slotLevel i.ar id < levelOf i.ar
                   | _ -> False)
                in if outer then
                     stSetRef
                       i.subsumptions
                       (V.pushBack (stGetRef i.subsumptions) (phi, stGetRef i.curEffect))
                   else joinEffect i phi)
             else unifyAt i phi RowEmpty)
          in (V.pushBack xs x, ret))
    ([], fty0)
    (V.range 0 (V.len args))

-- `runSt`'s argument: a `() -> a ! { St s | e }` for a rigid `s` made here,
-- one level in, which nothing outside may meet. What the `runSt` answers.
fun runStArg (cx : Cx s) (src : HirArena) out (body : HirExpr) =
  let i = cx.i in
  let result = fresh i.ar in
  let outside = freshEffect i.ar in
  let mark = V.len (stGetRef i.subsumptions) in
  let u = enterLevel i.ar in
  let v = stSetRef i.stLevels (V.pushBack (stGetRef i.stLevels) (levelOf i.ar)) in
  let state = freshSkolem i.ar in
  let lam =
    (match viewHirExpr src body with
     | HirExprView.Lam r -> V.len r.params == 1
     | _ -> False)
  in
  let pl = plain cx in
  let x = inferExpr src out (if lam then { pl | seed = Just state } else pl) body in
  let bodyRow = RowExtend "St" (Tuple [state]) outside in
  let w = unifyAt i (typInferringExpr out x) (funcEff [unitT ()] result bodyRow) in
  -- What the body asked of a trait at a type that names `s` is answered in
  -- here too: the `impl` found for it is over variables of its own, which
  -- made out there could not stand for `s` -- that would be the state
  -- escaping -- though nothing of it gets out.
  let w2 = solveWanted i in
  let x2 = solveSubsumptions i mark in
  let levels = stGetRef i.stLevels in
  let y = stSetRef i.stLevels (V.take levels (V.len levels - 1)) in
  let z = solveSubsumptions i mark in
  let q = exitLevel i.ar in
  let r2 = joinEffect i outside in
  (x, result)

-- A constructor applied: to its arguments in turn -- or, for one with named
-- fields given a record with no base, to its fields in the order it declares
-- them, the record written back as it was.
fun consParts (cx : Cx s) (src : HirArena) out (ref : InferringRef) (args : [HirExpr]) =
  let i = cx.i in
  let alts = inferringRefAlts out ref in
  let name = canonOf i (inferringRefId out ref) "" in
  let known =
    if not (V.isEmpty alts) then
      Just (defer i "${show cx.here.m}:${show ref}" (V.map (\x -> Ctor (canonOf i x "")) alts))
    else ctorType i name
  in
  let step =
    \cty aty ->
      (let ret = fresh i.ar in
       let eff = freshEffect i.ar in
       let u = unifyAt i cty (Fun [aty] ret eff) in
       ret)
  in match namedRecordArg src args (ctorLabels i name) with
     | Just (given, labels) ->
         let fields = hirExprRecordFields src given in
         let values =
           V.map
             (\l ->
               M.map
                 (\f -> (f, inferExpr src out (plain cx) (hirExprFieldValue src f)))
                 (V.find (\f -> hirNameText src (hirExprFieldName src f) == l) fields))
             labels
         in
         let t =
           (match known with
            | Just cty0 ->
                V.foldl
                  (\cty v ->
                    step
                      cty
                      (match v with
                       | Just (_, x) -> typInferringExpr out x
                       | None -> Error))
                  cty0
                  values
            | None -> Error)
         in (
              [rewrittenRecord
                 cx
                 src
                 out
                 given
                 (V.concatMap (\v -> match v with | Just p -> [p] | None -> []) values)],
              t
            )
     | None ->
         (match known with
          | Just cty0 ->
              V.foldl
                (\acc a0 ->
                  match acc with
                  | (xs, cty) ->
                      (let x = inferExpr src out (plain cx) a0 in
                       (V.pushBack xs x, step cty (typInferringExpr out x))))
                ([], cty0)
                args
          | None -> (V.map (\a0 -> inferExpr src out (plain cx) a0) args, Error))

-- The one argument `args` is, when it is a record with no base for a
-- constructor with named fields: the record, and the constructor's labels.
fun namedRecordArg (src : HirArena) (args : [HirExpr]) (labels : Maybe [String])
    : Maybe (HirExpr, [String]) =
  match (V.len args, labels) with
  | (1, Just ls) ->
      (match viewHirExpr src (V.getOr 0 args 0) with
       | HirExprView.Record r -> (if M.isSome r.base then None else Just (V.getOr 0 args 0, ls))
       | _ -> None)
  | _ -> None

-- A constructor's record written back, its fields in the order written: those
-- inferred already as the constructor's, and any other as it comes.
fun rewrittenRecord
    (cx : Cx s)
    (src : HirArena)
    out
    (given : HirExpr)
    (done : [(HirExprField, InferringExpr)])
    : InferringExpr ! { St s | e } =
  let fs =
    V.map
      (\f ->
        let x =
          (match V.find (\p -> fst p == f) done with
           | Just (_, x0) -> x0
           | None -> inferExpr src out (plain cx) (hirExprFieldValue src f))
        in newInferringExprField
             out
             (metaHirExprField src f)
             (inferName src out (plain cx) (hirExprFieldName src f))
             x)
      (hirExprRecordFields src given)
  in
  let row =
    V.foldl
      (\rest fx ->
        RowExtend
          (inferringNameText out (inferringExprFieldName out fx))
          (typInferringExpr out (inferringExprFieldValue out fx))
          rest)
      RowEmpty
      (V.reverse fs)
  in newInferringExprRecord out (metaHirExpr src given) fs None (Record row)

-- `{ base | f = v, … }` with no base: the fields from the last written to the
-- first, each the row so far extended.
fun recordParts (cx : Cx s) (src : HirArena) out (fields : [HirExprField]) base =
  let i = cx.i in
  let labels = V.map (\f -> hirNameText src (hirExprFieldName src f)) fields in
  let b = M.map (\bt -> bt (plain cx)) base in
  let row0 =
    (match b with
     | Just bx ->
         let rv = freshRow i.ar in
         let u = unifyAt i (typInferringExpr out bx) (Record rv) in
         let v =
           (match requireLacks i.ar rv labels with
            | Ok _ -> ()
            | Err _ -> report i "a record would have a field twice")
         in rv
     | None -> RowEmpty)
  in
  let backwards = V.map (\f -> inferExprField src out (plain cx) f) (V.reverse fields) in
  let row =
    V.foldl
      (\r fx ->
        RowExtend
          (inferringNameText out (inferringExprFieldName out fx))
          (typInferringExpr out (inferringExprFieldValue out fx))
          r)
      row0
      backwards
  in (V.reverse backwards, b, Record row)

-- `{ base | x = v, … }`: a value of a record type keeps its type, each value
-- its field's; otherwise an anonymous record with every field named.
fun updateParts (cx : Cx s) (src : HirArena) out base (fields : [HirExprField]) =
  let i = cx.i in
  let b = base (plain cx) in
  let pruned = zonk i.ar (typInferringExpr out b) in
  let nominal =
    (match pruned with
     | Con tyname _ -> M.map (\acc -> (tyname, acc)) (H.lookup tyname (stGetRef i.recordFields))
     | _ -> None)
  in
  let valueTy = \fx -> typInferringExpr out (inferringExprFieldValue out fx) in
  match nominal with
  | Just (tyname, accessors) ->
      let one =
        (match H.lookup tyname (stGetRef i.variants) with
         | Just vs -> V.len vs == 1
         | None -> False)
      in if not one then
           (let fs = V.map (\f -> inferExprField src out (plain cx) f) fields in
            let v = report i "more than one constructor, so no one record to update" in
            (b, fs, pruned))
         else
           let fs =
             V.map
               (\f ->
                 let fx = inferExprField src out (plain cx) f in
                 let w =
                   (match H.lookup (hirNameText src (hirExprFieldName src f)) accessors with
                    | None -> report i "no such field"
                    | Just sc ->
                        let accessor = instantiate i sc in
                        let field = fresh i.ar in
                        let eff = freshEffect i.ar in
                        let x = unifyAt i accessor (Fun [pruned] field eff) in
                        unifyAt i field (valueTy fx))
                 in fx)
               fields
           in (b, fs, pruned)
  | None ->
      let named =
        V.foldl
          (\acc f ->
            (let l = hirNameText src (hirExprFieldName src f) in
             if V.any (\x -> fst x == l) acc then acc else V.pushBack acc (l, fresh i.ar)))
          []
          fields
      in
      let rest = freshRow i.ar in
      let row = V.foldl (\acc x -> RowExtend (fst x) (snd x) acc) rest (V.reverse named) in
      let u = unifyAt i (typInferringExpr out b) (Record row) in
      let fs =
        V.map
          (\f ->
            let fx = inferExprField src out (plain cx) f in
            let t =
              M.unwrapOr
                Error
                (M.map snd (V.find (\x -> fst x == hirNameText src (hirExprFieldName src f)) named))
            in
            let v = unifyAt i t (valueTy fx) in
            fx)
          fields
      in (b, fs, typInferringExpr out b)

-- `e.f`: a field of a record type by its accessor, of any other record by
-- its row.
fun projType (cx : Cx s) out (target : InferringExpr) (label : InferringName)
    : Type ! { St s | e } =
  let i = cx.i in
  let ot = typInferringExpr out target in
  let fname = inferringNameText out label in
  let pruned = zonk i.ar ot in
  let nominal =
    (match pruned with
     | Con tyname _ ->
         M.andThen (\m -> H.lookup fname m) (H.lookup tyname (stGetRef i.recordFields))
     | _ -> None)
  in match nominal with
     | Just sc ->
         let accessor = instantiate i sc in
         let res = fresh i.ar in
         let eff = freshEffect i.ar in
         let u = unifyAt i accessor (Fun [pruned] res eff) in
         res
     | None ->
         let field = fresh i.ar in
         let rest = freshRow i.ar in
         let u = unifyAt i ot (Record (RowExtend fname field rest)) in
         field

-- `handle body with { … }`: the body in a region of its own; every effect the
-- clauses name taken out of it, with fresh arguments, in the order first
-- mentioned; each clause then inferred at its operation's types.
fun handleParts (cx : Cx s) (src : HirArena) out body (arms : [HirHArm]) (ret : Maybe HirRet) =
  let i = cx.i in
  let bodyEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u = stSetRef i.curEffect bodyEff in
  let b = body (plain cx) in
  let bodyTy = typInferringExpr out b in
  let v = stSetRef i.curEffect saved in
  let result = fresh i.ar in
  let armEffects = V.map (\h -> armEffect i src h) arms in
  let handled =
    V.foldl
      (\acc me ->
        match me with
        | Just name ->
            if V.any (\x -> match x with | (n, _, _) -> n == name) acc then acc
            else
              (match H.lookup name (stGetRef i.effects) with
               | Just (info : EffectInfo) ->
                   V.pushBack acc (name, info, V.map (\k -> fresh i.ar) (V.range 0 info.params))
               | None -> acc)
        | None -> acc)
      []
      armEffects
  in
  let rho = freshEffect i.ar in
  let rowOf =
    \effs ->
      V.foldl
        (\tail x -> match x with | (n, _, ps) -> RowExtend n (Tuple ps) tail)
        rho
        (V.reverse effs)
  in
  let inside = rowOf handled in
  let answered =
    \eff op ->
      V.any
        (\k ->
          hirNameText src (hirHArmOp src (V.getOr 0 arms k)) == op
            and V.getOr None armEffects k == Just eff)
        (V.range 0 (V.len arms))
  in
  let outside =
    rowOf
      (V.filter
         (\x ->
           match x with
           | (n, info, _) -> V.any (\(o : EffOp) -> not (answered n o.name)) (opsOf info))
         handled)
  in
  let w = unifyAt i bodyEff inside in
  let x = joinEffect i outside in
  let pl = plain cx in
  let hs =
    V.map
      (\k ->
        let h = V.getOr 0 arms k in
        let opName = hirNameText src (hirHArmOp src h) in
        let found =
          V.foldl
            (\f x2 ->
              match f with
              | Just y2 -> Just y2
              | None ->
                  (match x2 with
                   | (n, info, ps) ->
                       (if Just n == V.getOr None armEffects k then
                          M.map
                            (\(o : EffOp) -> (o, ps))
                            (V.find (\(o : EffOp) -> o.name == opName) (opsOf info))
                        else None)))
            None
            handled
        in
        let tys =
          (match found with
           | Just (o, ps) -> (substBound o.arg ps, substBound o.ret ps)
           | None -> (fresh i.ar, fresh i.ar))
        in inferHArm
             src
             out
             { pl | clause = Just (ClauseTys { arg = fst tys, ret = snd tys, result, outside }) }
             h)
      (V.range 0 (V.len arms))
  in
  let r = M.map (\rt -> inferRet src out { pl | back = Just (bodyTy, result) } rt) ret in
  let y = (if M.isNone ret then unifyAt i result bodyTy else ()) in
  (b, hs, r, result)

-- The effect a handler clause answers: its operation's own, which the
-- resolver found where the `handle` is written, or else some effect with an
-- operation of that name -- the same one every time.
fun armEffect (i : Inf s) (a : HirArena) (h : HirHArm) : Maybe String ! { St s | e } =
  let op = hirNameText a (hirHArmOp a h) in
  let effects = H.toVec (stGetRef i.effects) in
  let having = V.filter (\kv -> V.any (\(o : EffOp) -> o.name == op) (opsOf (snd kv))) effects in
  let owner = opOwner i (hirRefId a (hirHArmOpRef a h)) in
  match V.find (\kv -> Just (spelling (fst kv)) == owner) having with
  | Just kv -> Just (fst kv)
  | None -> M.map fst (V.get (sortOn fst having) 0)

-- The spelled name of the effect an operation's binder belongs to.
fun opOwner (i : Inf s) (id : Int) : Maybe String =
  match H.lookup id i.canon with
  | Just c -> (if S.startsWith "op:" c then Just (stringSlice c 3 (stringByteLength c)) else None)
  | None -> None

-- A constructor pattern: its parts in turn -- or, given a record pattern for
-- its named fields, each field's pattern in the constructor's order, a
-- wildcard for one left out, the record pattern written back as it was.
fun patConsParts (cx : Cx s) (src : HirArena) out (ref : InferringRef) (args : [HirPat]) =
  let i = cx.i in
  let alts = inferringRefAlts out ref in
  let name = canonOf i (inferringRefId out ref) "" in
  let known =
    if not (V.isEmpty alts) then
      Just (defer i "${show cx.here.m}:${show ref}" (V.map (\x -> Ctor (canonOf i x "")) alts))
    else ctorType i name
  in
  let step =
    \cty sty ->
      (let ret = fresh i.ar in
       let eff = freshEffect i.ar in
       let u = unifyAt i cty (Fun [sty] ret eff) in
       ret)
  in match namedRecordPat src args (ctorLabels i name) with
     | Just (given, labels) ->
         let fields = hirPatRecordFields src given in
         let parts =
           V.map
             (\l ->
               M.map
                 (\f -> (f, inferPat src out cx (hirPatFieldPat src f)))
                 (V.find (\f -> hirNameText src (hirPatFieldName src f) == l) fields))
             labels
         in
         let t =
           (match known with
            | Just cty0 ->
                V.foldl
                  (\cty p ->
                    step
                      cty
                      (match p with
                       | Just (_, x) -> typInferringPat out x
                       | None -> fresh i.ar))
                  cty0
                  parts
            | None -> Error)
         in (
              [rewrittenPRecord
                 cx
                 src
                 out
                 given
                 (V.concatMap (\p -> match p with | Just q -> [q] | None -> []) parts)],
              t
            )
     | None ->
         (match known with
          | Just cty0 ->
              V.foldl
                (\acc a0 ->
                  match acc with
                  | (ps, cty) ->
                      (let p = inferPat src out cx a0 in
                       (V.pushBack ps p, step cty (typInferringPat out p))))
                ([], cty0)
                args
          | None -> (V.map (\a0 -> inferPat src out cx a0) args, Error))

fun namedRecordPat (src : HirArena) (args : [HirPat]) (labels : Maybe [String])
    : Maybe (HirPat, [String]) =
  match (V.len args, labels) with
  | (1, Just ls) ->
      (match viewHirPat src (V.getOr 0 args 0) with
       | HirPatView.Record _ -> Just (V.getOr 0 args 0, ls)
       | _ -> None)
  | _ -> None

fun rewrittenPRecord
    (cx : Cx s)
    (src : HirArena)
    out
    (given : HirPat)
    (done : [(HirPatField, InferringPat)])
    : InferringPat ! { St s | e } =
  let fs =
    V.map
      (\f ->
        let p =
          (match V.find (\q -> fst q == f) done with
           | Just (_, p0) -> p0
           | None -> inferPat src out cx (hirPatFieldPat src f))
        in newInferringPatField
             out
             (metaHirPatField src f)
             (inferName src out (plain cx) (hirPatFieldName src f))
             p)
      (hirPatRecordFields src given)
  in
  let row =
    V.foldl
      (\rest pf ->
        RowExtend
          (inferringNameText out (inferringPatFieldName out pf))
          (typInferringPat out (inferringPatFieldPat out pf))
          rest)
      RowEmpty
      (V.reverse fs)
  in newInferringPatRecord out (metaHirPat src given) fs (hirPatRecordOpen src given) (Record row)

-- `{ f = p, … }`, open or not: the fields from the last written to the first.
fun patRecordParts (cx : Cx s) (src : HirArena) out (fields : [HirPatField]) (open : Bool) =
  let i = cx.i in
  let labels = V.map (\f -> hirNameText src (hirPatFieldName src f)) fields in
  let row0 =
    (if open then
       (let rest = freshRow i.ar in
        let u = requireLacks i.ar rest labels in
        rest)
     else RowEmpty)
  in
  let backwards = V.map (\f -> inferPatField src out cx f) (V.reverse fields) in
  let row =
    V.foldl
      (\r pf ->
        RowExtend
          (inferringNameText out (inferringPatFieldName out pf))
          (typInferringPat out (inferringPatFieldPat out pf))
          r)
      row0
      backwards
  in (V.reverse backwards, Record row)

-- A top-level `def` has to be pure to evaluate (`check_pure_def`): its
-- right-hand side is evaluated once and the value kept, which is the same
-- program as evaluating it at every use only when evaluating it does nothing
-- a program can see. A `def` may be a function that prints, not a value
-- whose making prints. `main` is the exception: running it once is running
-- the program.
fun pureDef (i : Inf s) (bound : [Int]) (eff : Type) : () ! { St s | e } =
  if V.any (\v -> V.elem v i.entries) bound then ()
  else
    (let labels = performed (zonk i.ar eff) [] in
     if V.isEmpty labels then ()
     else
       (let list = S.join ", " (V.map (\l -> "`${spelling l}`") labels) in
        report
          i
          "a top-level `def` cannot perform effects, and this one performs ${list}; perform them inside a function instead -- `fun name () = ...` -- or in `main`"))

-- The effects a row names, each once, after `seen`.
fun performed (row : Type) (seen : [String]) : [String] =
  match row with
  | RowExtend l _ rest -> performed rest (if V.elem l seen then seen else V.pushBack seen l)
  | _ -> seen

-- A function binding, as `cx.mode` says: alone -- in an expression, or at the
-- top of a module and generalized when it is done -- or as one of a group.
fun funBindParts (cx : Cx s) (src : HirArena) out (vid : Int) params (ret : Maybe HirType) body =
  match cx.mode with
  | Mode.Member seed -> memberFun cx out seed params ret body
  | Mode.Top -> aloneFun cx out True vid params ret body
  | Mode.Local -> aloneFun cx out False vid params ret body

fun aloneFun (cx : Cx s) out (toplevel : Bool) (vid : Int) params (ret : Maybe HirType) body =
  let i = cx.i in
  let started = if toplevel then Just (beginBinding i) else None in
  let u0 =
    (if toplevel then (let x = stSetRef i.group [vid] in stSetRef i.member (Just vid)) else ())
  in
  let u1 = enterLevel i.ar in
  let bodyEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u2 = stSetRef i.curEffect bodyEff in
  let pc = binding cx in
  let ps = V.map (\p -> p pc) params in
  let paramTys = V.map (\p -> typInferringPat out p) ps in
  match declaredResult i cx.here ret with
  | (rt, declaredEff) ->
      let u3 =
        (match declaredEff with
         | Just eff -> unifyAt i bodyEff eff
         | None -> ())
      in
      let fnTy = funcEff paramTys rt bodyEff in
      let u4 = bindMono i vid fnTy in
      let u5 = seedSig i vid fnTy in
      let mark = V.len (stGetRef i.subsumptions) in
      let b = body (plain cx) in
      let u6 = unifyAt i rt (typInferringExpr out b) in
      let u7 = stSetRef i.curEffect saved in
      let u8 = solveOverloads i toplevel in
      let u9 = solveSubsumptions i mark in
      let u10 = solveWanted i in
      let u11 = exitLevel i.ar in
      let preds =
        (match started with
         | Just st ->
             (let x = stSetRef i.member None in
              M.unwrapOr [] (H.lookup vid (closeBinding i st [(vid, fnTy)] True)))
         | None -> (let x = holdBackWanted i in []))
      in
      let sc = generalizeNamed i (Just vid) fnTy True preds in
      let u12 = setScheme i vid sc in
      let u13 = if toplevel then stSetRef i.exports (V.pushBack (stGetRef i.exports) vid) else () in
      (ps, b)

-- One function of a recursive group: its body inferred and tied to the seed
-- the rest of the group sees.
fun memberFun (cx : Cx s) out (seed : [(Int, Type)]) params (ret : Maybe HirType) body =
  let i = cx.i in
  let bodyEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u = stSetRef i.curEffect bodyEff in
  let pc = binding cx in
  let ps = V.map (\p -> p pc) params in
  let paramTys = V.map (\p -> typInferringPat out p) ps in
  match declaredResult i cx.here ret with
  | (rt, declaredEff) ->
      let v =
        (match declaredEff with
         | Just eff -> unifyAt i bodyEff eff
         | None -> ())
      in
      let fnTy = funcEff paramTys rt bodyEff in
      let w =
        (match V.get seed 0 with
         | Just (_, st) -> unifyAt i st fnTy
         | None -> ())
      in
      let b = body (plain cx) in
      let x = unifyAt i rt (typInferringExpr out b) in
      let y = stSetRef i.curEffect saved in
      (ps, b)

-- A pattern binding, as `cx.mode` says: its value first, then its pattern.
fun patBindParts (cx : Cx s) out pat value =
  match cx.mode with
  | Mode.Member seed -> memberPat cx out seed pat value
  | Mode.Top -> alonePat cx out True pat value
  | Mode.Local -> alonePat cx out False pat value

fun alonePat (cx : Cx s) out (toplevel : Bool) pat value =
  let i = cx.i in
  let u1 = enterLevel i.ar in
  let rhsEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u2 = stSetRef i.curEffect rhsEff in
  let mark = V.len (stGetRef i.subsumptions) in
  let v = value (plain cx) in
  let pc = binding cx in
  let p = pat pc in
  let bound = stGetRef pc.bound in
  let u3 = unifyAt i (typInferringPat out p) (typInferringExpr out v) in
  let u4 = V.foldl (\w x -> seedSig i (fst x) (snd x)) () bound in
  let u5 = stSetRef i.curEffect saved in
  let u6 = solveOverloads i toplevel in
  let u7 = solveSubsumptions i mark in
  let pured = if toplevel then pureDef i (V.map fst bound) rhsEff else () in
  let u8 = solveWanted i in
  let u9 = exitLevel i.ar in
  let u10 = holdBackWanted i in
  let waiting = hasPendingJoin i mark rhsEff in
  let pure =
    not waiting
      and (match zonk i.ar rhsEff with
       | RowEmpty -> True
       | Var id -> slotLevel i.ar id > levelOf i.ar
       | _ -> False)
  in
  let u11 =
    (if pure then
       (match zonk i.ar rhsEff with
        | Var id ->
            (if V.elem id (V.foldl (\acc x -> freeVars i.ar (snd x) acc) [] bound) then ()
             else unifyAt i rhsEff RowEmpty)
        | _ -> ())
     else ())
  in
  let u12 =
    (if not pure and not toplevel then joinEffectInto i (stGetRef i.curEffect) rhsEff else ())
  in
  let u13 =
    V.foldl
      (\w x ->
        let vid = fst x in
        let vty = snd x in
        let sc =
          (if pure then generalizeNamed i (Just vid) vty False []
           else
             (let level = levelOf i.ar in
              let y = holdBack i.ar vty level in
              let s1 = mono (zonk i.ar vty) in
              let z = recordMono i vid s1 in
              s1))
        in
        let q = setScheme i vid sc in
        if toplevel then stSetRef i.exports (V.pushBack (stGetRef i.exports) vid) else ())
      ()
      bound
  in (p, v)

-- One pattern binding of a recursive group: whether its value stayed pure
-- is said in `cx.pure`.
fun memberPat (cx : Cx s) out (seed : [(Int, Type)]) pat value =
  let i = cx.i in
  let rhsEff = freshEffect i.ar in
  let saved = stGetRef i.curEffect in
  let u = stSetRef i.curEffect rhsEff in
  let mark = V.len (stGetRef i.subsumptions) in
  let v = value (plain cx) in
  let pc = binding cx in
  let p = pat pc in
  let w = unifyAt i (typInferringPat out p) (typInferringExpr out v) in
  let x = stSetRef i.curEffect saved in
  let y =
    V.foldl
      (\z bx ->
        (match V.find (\sd -> fst sd == fst bx) seed with
         | Just sd -> unifyAt i (snd sd) (snd bx)
         | None -> ()))
      ()
      (stGetRef pc.bound)
  in
  let z = solveSubsumptions i mark in
  let q =
    (match zonk i.ar rhsEff with
     | RowEmpty -> ()
     | Var _ -> ()
     | _ -> stSetRef cx.pure False)
  in (p, v)

-- --- settling ----------------------------------------------------------------

-- Every type the tree holds read out of the arena, once inference has written
-- all it will.
pass! {
  pub settle : Inferring -> Typed with st
    -- A name with several meanings is the one inference chose.
    | Ref { id, alts } ->
        Ref {
          id =
            if V.isEmpty alts then id
            else
              (match H.lookup "${show st.m}:${show node}" st.chosen with
               | Just k -> V.getOr id alts k
               | None -> id),
          alts
        }
    | Expr.Lit { lit, typ } -> Expr.Lit { lit, typ = settled st.ar typ }
    | Expr.Unit { typ } -> Expr.Unit { typ = settled st.ar typ }
    | Expr.Hole { typ } -> Expr.Hole { typ = settled st.ar typ }
    | Expr.MacCall { call, typ } -> Expr.MacCall { call, typ = settled st.ar typ }
    -- A name mentioned, with the dictionaries it was found to be applied
    -- to: by where the mention is, as inference kept them.
    | Expr.Var { raw ref, typ } ->
        Expr.Var {
          ref = settleRef src out st ref,
          ev = M.unwrapOr [] (H.lookup "${show st.m}:${show ref}" st.evidence),
          inst = M.unwrapOr [] (H.lookup "${show st.m}:${show ref}" st.insts),
          typ = settled st.ar typ
        }
    | Lam { params, body, typ } -> Lam { params, body, typ = settled st.ar typ }
    | App { func, args, typ } -> App { func, args, typ = settled st.ar typ }
    | Let { binds, body, typ } -> Let { binds, body, typ = settled st.ar typ }
    | If { cond, yes, no, typ } -> If { cond, yes, no, typ = settled st.ar typ }
    | Match { scrutinee, arms, typ } -> Match { scrutinee, arms, typ = settled st.ar typ }
    | Expr.Tuple { items, typ } -> Expr.Tuple { items, typ = settled st.ar typ }
    | Expr.Array { items, typ } -> Expr.Array { items, typ = settled st.ar typ }
    | Expr.List { items, typ } -> Expr.List { items, typ = settled st.ar typ }
    | Expr.Cons { ref, args, typ } -> Expr.Cons { ref, args, typ = settled st.ar typ }
    | Expr.Record { fields, base, typ } -> Expr.Record { fields, base, typ = settled st.ar typ }
    | Update { base, fields, typ } -> Update { base, fields, typ = settled st.ar typ }
    | Proj { target, label, typ } -> Proj { target, label, typ = settled st.ar typ }
    | Handle { body, arms, ret, typ } -> Handle { body, arms, ret, typ = settled st.ar typ }
    | Pat.Wild { typ } -> Pat.Wild { typ = settled st.ar typ }
    | Pat.Unit { typ } -> Pat.Unit { typ = settled st.ar typ }
    | Pat.MacCall { call, typ } -> Pat.MacCall { call, typ = settled st.ar typ }
    | Pat.Lit { lit, typ } -> Pat.Lit { lit, typ = settled st.ar typ }
    | Pat.Var { id, typ } -> Pat.Var { id, typ = settled st.ar typ }
    | Pat.As { id, pat, typ } -> Pat.As { id, pat, typ = settled st.ar typ }
    | Pat.Ann { pat, ty, typ } -> Pat.Ann { pat, ty, typ = settled st.ar typ }
    | Pat.Cons { ref, args, typ } -> Pat.Cons { ref, args, typ = settled st.ar typ }
    | Pat.Tuple { items, typ } -> Pat.Tuple { items, typ = settled st.ar typ }
    | Pat.Array { items, typ } -> Pat.Array { items, typ = settled st.ar typ }
    | Pat.List { items, typ } -> Pat.List { items, typ = settled st.ar typ }
    | Pat.Vector { items, typ } -> Pat.Vector { items, typ = settled st.ar typ }
    | Pat.Record { fields, open, typ } -> Pat.Record { fields, open, typ = settled st.ar typ }
    | Pat.View { fn, pat, typ } -> Pat.View { fn, pat, typ = settled st.ar typ }
}

-- A group of top-level bindings, each with where it is, inferred together
-- when they mention one another (`recursive`), each written into its
-- module's tables and what it became kept in `done`.
fun inferGroup
    (i : Inf s)
    outs
    (done : StRef s (HashMap String Int))
    (binds : [(Here, HirBind)])
    (recursive : Bool)
    : () ! { St s | e } =
  if not recursive and V.len binds == 1 then
    (match V.get binds 0 with
     | Just (here, b) -> topBind i outs done here b
     | None -> ())
  else
    let started = beginBinding i in
    let u = enterLevel i.ar in
    let mark = V.len (stGetRef i.subsumptions) in
    -- Every name in the group seeded before any body: a function as the
    -- function it is, anything else as a variable.
    let seeds = V.map (\x -> match x with | (here, b) -> seedGroup i here b) binds in
    let v = stSetRef i.group (V.concatMap (\s1 -> V.map fst s1) seeds) in
    let pure =
      V.foldl
        (\acc k ->
          match V.get binds k with
          | Just (here, b) ->
              let seed = V.getOr [] seeds k in
              let x = stSetRef i.member (M.map fst (V.get seed 0)) in
              let cx = newCx i here (Mode.Member seed) in
              let y = written done here b (inferBind here.a (outOf outs here.m) cx b) in
              stGetRef cx.pure and acc
          | None -> acc)
        True
        (V.range 0 (V.len binds))
    in
    let w = stSetRef i.member None in
    let x = solveOverloads i True in
    let y = solveSubsumptions i mark in
    let z = solveWanted i in
    let q = exitLevel i.ar in
    let functions = V.all (\x2 -> match x2 with | (here, b) -> isFunBind here b) binds in
    let members = V.concat seeds in
    let preds = closeBinding i started members (pure and functions) in
    V.foldl
      (\acc k ->
        match V.get binds k with
        | Just (here, b) ->
            let classes = isFunBind here b in
            V.foldl
              (\w2 sd ->
                let vid = fst sd in
                let sc =
                  (if pure then
                     generalizeNamed
                       i
                       (Just vid)
                       (snd sd)
                       classes
                       (M.unwrapOr [] (H.lookup vid preds))
                   else
                     (let s1 = mono (zonk i.ar (snd sd)) in
                      let r = recordMono i vid s1 in
                      s1))
                in
                let x3 = setScheme i vid sc in
                stSetRef i.exports (V.pushBack (stGetRef i.exports) vid))
              ()
              (V.getOr [] seeds k)
        | None -> ())
      ()
      (V.range 0 (V.len binds))

-- A binding alone at the top of a module, written into its module's tables.
fun topBind (i : Inf s) outs (done : StRef s (HashMap String Int)) (here : Here) (b : HirBind)
    : () ! { St s | e } =
  written done here b (inferBind here.a (outOf outs here.m) (newCx i here Mode.Top) b)

-- What binding `b` of `here`'s module became.
fun written (done : StRef s (HashMap String Int)) (here : Here) (b : HirBind) (x : Int)
    : () ! { St s | e } =
  stSetRef done (H.insert "${show here.m}:${show b}" x (stGetRef done))

-- Module `k`'s tables, being written.
fun outOf outs (k : Int) =
  match V.get outs k with
  | Just o -> o
  | None -> newInferringBuilder ()

fun isFunBind (here : Here) (b : HirBind) : Bool =
  match viewHirBind here.a b with
  | HirBindView.Fun _ -> True
  | _ -> False

fun seedGroup (i : Inf s) (here : Here) (b : HirBind) : [(Int, Type)] ! { St s | e } =
  let arity =
    (match viewHirBind here.a b with
     | HirBindView.Fun r -> V.len r.params
     | _ -> 0)
  in V.map
       (\vid ->
         let t =
           (if arity > 0 then
              (let ps = V.map (\k -> fresh i.ar) (V.range 0 arity) in
               let ret = fresh i.ar in
               let eff = freshEffect i.ar in
               funcEff ps ret eff)
            else fresh i.ar)
         in
         let u = bindMono i vid t in
         let v = seedSig i vid t in
         (vid, t))
       (boundBy here.a b)

-- --- a unit's declarations ---------------------------------------------------

-- A module's top-level declarations, each under its attributes' peel. One a
-- `@cfg` leaves out is not among them: renaming took it out.
fun declsOfModule (a : HirArena) (root : HirModule) : [HirDecl] =
  V.map (peelDecl a) (hirModuleDecls a root)

fun peelDecl (a : HirArena) (d : HirDecl) : HirDecl =
  match viewHirDecl a d with
  | HirDeclView.Attributed r -> peelDecl a r.decl
  | _ -> d

-- A declared item of a module by kind, owner and name.
fun itemNamed (items : [Item]) (kind : String) (owner : String) (name : String) : Maybe Item =
  V.find
    (\(it : Item) -> it.kind == kind and (S.isEmpty owner or it.owner == owner) and it.name == name)
    items

fun typeCanon (items : [Item]) (name : String) : String =
  M.unwrapOr name (M.map (\(it : Item) -> it.canon) (itemNamed items "t" "" name))

-- A module's aliases, traits, data, records and effects -- aliases first,
-- which the rest may be written in terms of.
fun registerTypes (i : Inf s) (here : Here) (items : [Item]) (decls : [HirDecl])
    : () ! { St s | e } =
  let a = here.a in
  let aliases =
    V.concatMap
      (\d ->
        match viewHirDecl a d with
        | HirDeclView.Alias r ->
            [AliasSrc {
               name = typeCanon items (hirNameText a r.name),
               params = V.map (\n -> hirNameText a n) r.params,
               ty = r.ty
             }]
        | _ -> [])
      decls
  in
  let u = V.foldl (\w (x : AliasSrc) -> expandAlias i a aliases [] x.name) () aliases in
  -- An alias of effects: the closed row it stands for, its parameters bound.
  let w0 =
    V.foldl
      (\w d ->
        match viewHirDecl a d with
        | HirDeclView.EffectAlias r ->
            let params = V.map (\n -> hirNameText a n) r.params in
            let body = effOf i a r.row (indexed params) in
            stSetRef
              i.aliases
              (H.insert
                 (typeCanon items (hirNameText a r.name))
                 (AliasDef { params = V.len params, body })
                 (stGetRef i.aliases))
        | _ -> ())
      ()
      decls
  in
  let v =
    V.foldl
      (\w d ->
        match viewHirDecl a d with
        | HirDeclView.Trait r ->
            registerTraitDecl
              i
              a
              items
              r.name
              r.params
              r.supers
              r.assocs
              r.effects
              r.sigs
              r.defaults
        | _ -> ())
      ()
      decls
  in V.foldl
       (\w d ->
         match viewHirDecl a d with
         | HirDeclView.Data r ->
             let canon = typeCanon items (hirNameText a r.name) in
             let params = V.map (\n -> hirNameText a n) r.params in
             let vars = indexed params in
             let quant = V.replicate (V.len params) Plain in
             let head = Con canon (V.map (\k -> Bound k) (V.range 0 (V.len params))) in
             V.foldl
               (\x v2 ->
                 let fields =
                   (if hirVariantNamed a v2 then
                      V.map
                        (\f ->
                          (Just (hirNameText a (hirFieldName a f)), tyOf i a (hirFieldTy a f) vars))
                        (hirVariantFields a v2)
                    else V.map (\t -> (None, tyOf i a t vars)) (hirVariantPositional a v2))
                 in recordCtorIn
                      i
                      canon
                      (canon ++ "." ++ hirNameText a (hirVariantName a v2))
                      quant
                      head
                      fields)
               ()
               r.variants
         | HirDeclView.Record r ->
             let canon = typeCanon items (hirNameText a r.name) in
             let params = V.map (\n -> hirNameText a n) r.params in
             let vars = indexed params in
             let head = Con canon (V.map (\k -> Bound k) (V.range 0 (V.len params))) in
             recordCtorIn
               i
               canon
               (canon ++ "." ++ hirNameText a r.name)
               (V.replicate (V.len params) Plain)
               head
               (V.map
                  (\f -> (Just (hirNameText a (hirFieldName a f)), tyOf i a (hirFieldTy a f) vars))
                  r.fields)
         | HirDeclView.Effect r ->
             let ename = hirNameText a r.name in
             let canon = typeCanon items ename in
             let params = V.map (\n -> hirNameText a n) r.params in
             let n = V.len params in
             let vars = indexed params in
             let headArgs = V.map (\k -> Bound k) (V.range 0 n) in
             let ops =
               V.map
                 (\f ->
                   let opName = hirNameText a (hirFieldName a f) in
                   let t = tyOf i a (hirFieldTy a f) vars in
                   let parts =
                     (match t with
                      | Fun args r2 _ -> (V.getOr (unitT ()) args 0, r2)
                      | _ -> (unitT (), t))
                   in
                   let quant = V.pushBack (V.replicate n Plain) Effect in
                   let row = RowExtend canon (Tuple headArgs) (Bound n) in
                   let x =
                     (match itemNamed items "v" ("op:" ++ ename) opName with
                      | Just (it : Item) ->
                          setScheme
                            i
                            it.id
                            (Scheme {
                               quant,
                               preds = [],
                               ty = Fun [fst parts] (snd parts) row,
                               lacks = []
                             })
                      | None -> ())
                   in EffOp { name = opName, arg = fst parts, ret = snd parts })
                 r.ops
             in stSetRef
                  i.effects
                  (H.insert canon (EffectInfo { params = n, ops }) (stGetRef i.effects))
         | _ -> ())
       ()
       decls

-- A `type` alias as written: its canonical name, its parameters' names, and
-- what it stands for.
record AliasSrc = {
  name : String,
  params : [String],
  ty : HirType
}

-- An alias expanded -- the aliases it is written in first -- and a cycle an
-- error, as `meadow_infer`'s `alias_reaches` finds it.
fun expandAlias
    (i : Inf s)
    (a : HirArena)
    (batch : [AliasSrc])
    (visiting : [String])
    (name : String)
    : () ! { St s | e } =
  if M.isSome (H.lookup name (stGetRef i.aliases)) then ()
  else
    match V.find (\(x : AliasSrc) -> x.name == name) batch with
    | None -> ()
    | Just (r : AliasSrc) ->
        if V.elem name visiting then
          stSetRef
            i.aliases
            (H.insert
               name
               (AliasDef { params = V.len r.params, body = Error })
               (stGetRef i.aliases))
        else
          let mentioned = typeNames i a r.ty [] in
          let u =
            V.foldl
              (\w m ->
                if m != name and V.any (\(x : AliasSrc) -> x.name == m) batch then
                  expandAlias i a batch (V.pushBack visiting name) m
                else ())
              ()
              mentioned
          in if V.elem name mentioned then
               stSetRef
                 i.aliases
                 (H.insert
                    name
                    (AliasDef { params = V.len r.params, body = Error })
                    (stGetRef i.aliases))
             else if M.isSome (H.lookup name (stGetRef i.aliases)) then ()
             else
               stSetRef
                 i.aliases
                 (H.insert
                    name
                    (AliasDef { params = V.len r.params, body = tyOf i a r.ty (indexed r.params) })
                    (stGetRef i.aliases))

fun typeNames (i : Inf s) (a : HirArena) (t : HirType) (out : [String]) : [String] =
  match viewHirType a t with
  | HirTypeView.Con r ->
      V.foldl
        (\acc x -> typeNames i a x acc)
        (V.pushBack out (canonOf i (hirRefId a r.ref) (hirNameText a r.name)))
        r.args
  | HirTypeView.Fun r ->
      let ps = V.foldl (\acc x -> typeNames i a x acc) out r.params in
      let res = typeNames i a r.result ps in
      (match r.row with
       | Just row ->
           V.foldl
             (\acc l -> V.foldl (\o x -> typeNames i a x o) acc (hirLabelArgs a l))
             res
             (hirRowLabels a row)
       | None -> res)
  | HirTypeView.Tuple r -> V.foldl (\acc x -> typeNames i a x acc) out r.items
  | HirTypeView.Vector r -> typeNames i a r.item out
  | HirTypeView.List r -> typeNames i a r.item out
  | HirTypeView.Record r -> V.foldl (\acc f -> typeNames i a (hirTypeFieldTy a f) acc) out r.fields
  | _ -> out

-- A trait declaration, registered.
fun registerTraitDecl
    (i : Inf s)
    (a : HirArena)
    (items : [Item])
    (nameNode : HirName)
    (paramNodes : [HirName])
    (superBounds : [HirBound])
    (assocNodes : [HirAssoc])
    (effectNodes : [HirAssoc])
    (sigs : [HirMethodSig])
    (defaults : [HirBind])
    : () ! { St s | e } =
  let tname = hirNameText a nameNode in
  let canon = typeCanon items tname in
  let params = V.map (\n -> hirNameText a n) paramNodes in
  let supers =
    V.concatMap
      (\b ->
        let tys = hirBoundTys a b in
        let over =
          V.map
            (\t ->
              (match viewHirType a t with
               | HirTypeView.Var tv ->
                   V.find
                     (\k -> V.getOr "" params k == hirNameText a tv.name)
                     (V.range 0 (V.len params))
               | _ -> None))
            tys
        in if V.all M.isSome over then
             [Super {
                tr = canonOf i (hirRefId a (hirBoundRef a b)) (hirNameText a (hirBoundTr a b)),
                over = V.map (M.unwrapOr 0) over
              }]
           else [])
      superBounds
  in
  let assocs =
    V.map
      (\x ->
        M.unwrapOr
          (hirNameText a (hirAssocName a x))
          (M.map
             (\(it : Item) -> it.canon)
             (itemNamed items "t" ("assoc:" ++ tname) (hirNameText a (hirAssocName a x)))))
      assocNodes
  in
  -- An associated effect is one of them, after the types: a row the
  -- implementation chooses, where those are types.
  let effects =
    V.map
      (\x ->
        M.unwrapOr
          (hirNameText a (hirAssocName a x))
          (M.map
             (\(it : Item) -> it.canon)
             (itemNamed items "t" ("assocEffect:" ++ tname) (hirNameText a (hirAssocName a x)))))
      effectNodes
  in
  let methods =
    V.map
      (\ms ->
        let mname = hirNameText a (hirMethodSigName a ms) in
        let var =
          M.unwrapOr (0 - 1) (M.map (\(it : Item) -> it.id) (itemNamed items "v" tname mname))
        in
        let dflt =
          V.find (\id -> V.getOr "" i.names id == mname) (V.concatMap (\b -> boundBy a b) defaults)
        in (mname, var, hirMethodSigTy a ms, dflt))
      sigs
  in registerTrait
       i
       a
       canon
       params
       supers
       (V.append assocs effects)
       (V.len effects)
       methods
       (canon ++ ".#dict")

-- A module's `impl`s, each after those of the traits its trait requires.
fun registerImpls (i : Inf s) (here : Here) (decls : [HirDecl]) (dicts : HashMap String Int)
    : () ! { St s | e } =
  let a = here.a in
  let impls =
    V.concatMap
      (\d ->
        match viewHirDecl a d with
        | HirDeclView.Impl r -> [(d, r)]
        | _ -> [])
      decls
  in
  let sorted =
    sortOn
      (\x -> traitDepth i (canonOf i (hirRefId a (snd x).trRef) (hirNameText a (snd x).tr)) 0)
      impls
  in V.foldl
       (\w x ->
         match x with
         | (d, r) ->
             let tr = canonOf i (hirRefId a r.trRef) (hirNameText a r.tr) in
             let shape = H.lookup tr (stGetRef i.shapes) in
             let assocs =
               V.map
                 (\ad ->
                   (assocCanon shape (hirNameText a (hirAssocDefName a ad)), hirAssocDefTy a ad))
                 r.assocs
             in
             let effects =
               V.map
                 (\ed ->
                   (
                     assocCanon shape (hirNameText a (hirAssocEffDefName a ed)),
                     hirAssocEffDefRow a ed
                   ))
                 r.effects
             in registerImpl
                  i
                  a
                  tr
                  r.tys
                  r.context
                  assocs
                  effects
                  (M.unwrapOr 0 (H.lookup "${show here.m}:${show d}" dicts)))
       ()
       sorted

-- An associated type's canonical name, among a trait's, by its spelling.
fun assocCanon (shape : Maybe TraitShape) (name : String) : String =
  match shape with
  | Just (sh : TraitShape) -> M.unwrapOr name (V.find (\x -> spelling x == name) sh.assocs)
  | None -> name

-- The bodies inside a module's traits and `impl`s: each default, and each
-- `impl`'s methods held to the trait's types at the implementing type.
fun inferTraits
    (i : Inf s)
    outs
    (done : StRef s (HashMap String Int))
    (here : Here)
    (decls : [HirDecl])
    (dicts : HashMap String Int)
    : () ! { St s | e } =
  let a = here.a in
  V.foldl
    (\w d ->
      let within = { here | scope = "${show here.m}:${show d}" } in
      match viewHirDecl a d with
      | HirDeclView.Trait r -> V.foldl (\x b -> topBind i outs done within b) () r.defaults
      | HirDeclView.Impl r ->
          inferImpl
            i
            outs
            done
            within
            (canonOf i (hirRefId a r.trRef) (hirNameText a r.tr))
            r.methods
            (M.unwrapOr 0 (H.lookup "${show here.m}:${show d}" dicts))
      | _ -> ())
    ()
    decls

fun inferImpl
    (i : Inf s)
    outs
    (done : StRef s (HashMap String Int))
    (here : Here)
    (tr : String)
    (methods : [HirBind])
    (dict : Int)
    : () ! { St s | e } =
  let a = here.a in
  match (H.lookup tr (stGetRef i.shapes), schemeOf i dict) with
  | (Just (shape : TraitShape), Just found) ->
      (match found.ty with
       | Con _ dictArgs ->
           let u =
             V.foldl
               (\w b ->
                 let vid = V.getOr 0 (boundBy a b) 0 in
                 let name = V.getOr "" i.names vid in
                 match H.lookup (methodKey tr name) (stGetRef i.methods) with
                 | Just (method : Scheme) ->
                     let base = V.len found.quant in
                     let own = V.len dictArgs in
                     let quant = V.append found.quant (V.drop method.quant own) in
                     let subst =
                       V.map
                         (\k ->
                           if k < own then V.getOr Error dictArgs k else Bound (base + (k - own)))
                         (V.range 0 (V.len method.quant))
                     in
                     let sc =
                       Scheme {
                         quant,
                         preds = found.preds,
                         ty = substBound method.ty subst,
                         lacks = []
                       }
                     in
                     let x = stSetRef i.methodSigs (H.insert vid sc (stGetRef i.methodSigs)) in
                     topBind i outs done here b
                 | None -> ())
               ()
               methods
           in
           -- Every method the trait does not do itself is the `impl`'s to do.
           let written = V.map (\b -> V.getOr "" i.names (V.getOr 0 (boundBy a b) 0)) methods in
           let lacking =
             V.filter
               (\m -> not (V.elem m shape.defaulted) and not (V.elem m written))
               shape.methods
           in
           let said =
             if V.isEmpty lacking then ()
             else
               report
                 i
                 "this `impl ${spelling tr}` is missing ${S.join ", " (V.map (\m -> "`${m}`") lacking)}"
           in if V.isEmpty shape.supers then ()
              else
                let started = beginBinding i in
                let v = enterLevel i.ar in
                let binders =
                  M.unwrapOr
                    []
                    (M.map
                       (\(g : Generalized) -> V.map (\x -> Var x) g.vars)
                       (H.lookup dict (stGetRef i.generalized)))
                in
                let inst =
                  (if V.len binders == V.len found.quant then
                     (
                       substBound found.ty binders,
                       V.map
                         (\(p : Pred) ->
                           Pred {
                             tr = p.tr,
                             tys = V.map (\t -> substBound t binders) p.tys,
                             assocs = V.map (\t -> substBound t binders) p.assocs
                           })
                         found.preds
                     )
                   else instantiateWithPreds i found)
                in (match inst with
                    | (instTy, given) ->
                        let x = stSetRef i.givens given in
                        let over = (match instTy with | Con _ args -> args | _ -> []) in
                        let y =
                          V.map
                            (\(sup : Super) ->
                              (wanting
                                 i
                                 (Wanted {
                                    pred =
                                      Pred {
                                        tr = sup.tr,
                                        tys = V.map (\j -> V.getOr Error over j) sup.over,
                                        assocs =
                                          superAssocs
                                            i
                                            tr
                                            (V.drop over shape.params)
                                            sup.tr
                                            sup.over
                                      },
                                    owner = Just dict,
                                    sol = None
                                  })))
                            shape.supers
                        in
                        -- What the dictionary is built with for each trait
                        -- its own requires: kept by the dictionary's binder.
                        let y2 =
                          stSetRef i.atNode (H.insert "dict:${show dict}" y (stGetRef i.atNode))
                        in
                        let z = solveWanted i in
                        let q = exitLevel i.ar in
                        let s1 =
                          stSetRef i.methodSigs (H.insert dict found (stGetRef i.methodSigs))
                        in
                        let s2 = closeBinding i started [(dict, instTy)] True in
                        stSetRef i.methodSigs (H.delete dict (stGetRef i.methodSigs)))
       | _ -> ())
  | _ -> ()

-- --- a unit ------------------------------------------------------------------

-- What inferring a unit made: each module's top-level bindings' schemes as
-- the infer test compares them, by file; the schemes of the binders it
-- exports; and what it tells the units after it about types.
@pub record Inferred = {
  dumps : [(String, [String])],
  schemes : HashMap Int Scheme,
  types : TypeEnv,
  typed : [TypedProgram],
  -- The traits each binding's `where` came to, in order: the dictionaries a
  -- top-level function, a method or an `impl`'s dictionary takes.
  wheres : HashMap Int [String],
  -- What each `impl`'s dictionary is built with for the traits its own
  -- requires, by `dict:` and its binder.
  evidence : HashMap String [Evidence],
  -- Each generalized binding with its scheme and the variable behind each
  -- of its quantifiers, as the typed tree's types have it.
  generics : HashMap Int Generalized,
  -- The variables over number types that bindings are generic in, each with
  -- whether it is over fractions: what a type in the typed tree that is one
  -- of them is where its binding is not copied for another -- an `Int`, or
  -- a `Float`.
  numbers : [(Int, Bool)],
  -- What is wrong with the unit's `main`, if it has one: a unit is not
  -- compiled with a `main` that is not `() -> () ! Eff`, whatever it is
  -- built with.
  problems : [String],
  -- Everything inference says is wrong with the unit, those included: what
  -- a build that is `checked` stops at, as every build is unless it is told
  -- otherwise. It says nothing of the standard library, of MeadowBoot or of
  -- what MeadowBoot is built on, as the Rust compiler says nothing of them.
  said : [String],
  -- Where each of those is: the module, and the byte it starts at (-1 for
  -- what is of no one place).
  saidAt : [(Int, Int)]
}

-- Infer unit `r`, whose dependencies exported `deps` -- their values' schemes
-- -- and `depTypes`, in the order its dependencies' items were given binders.
@pub fun inferUnit
    (r : Renamed)
    (deps : [DepExports])
    (depTypes : [TypeEnv])
    (texts : HashMap String String)
    : Inferred =
  runSt (\() ->
    let i = newInf r in
    let u1 =
      V.foldl
        (\w p ->
          match primScheme (fst p) with
          | Just sc -> setScheme i (snd p) sc
          | None -> ())
        ()
        r.prims
    in
    -- What the dependencies exported: their values' schemes, and their types.
    let depExports = V.concatMap (\(d : DepExports) -> d.exports) deps in
    let u2 =
      V.foldl
        (\w k ->
          (match (V.get r.depItems k, V.get depExports k) with
           | (Just (it : Item), Just (ex : Export)) ->
               (match ex.scheme with
                | Just sc -> setScheme i it.id sc
                | None -> ())
           | _ -> ()))
        ()
        (V.range 0 (V.len r.depItems))
    in
    let u3 = V.foldl (\w t -> loadTypes i t) () depTypes in
    -- The modules, in dependency order.
    let mods =
      V.map
        (\k -> (V.getOr (emptyMod ()) i.mods k, V.getOr (emptyDeclared ()) r.modules k, k))
        (V.range 0 (V.len i.mods))
    in
    let tables = V.map (\x -> match x with | (md, _, k) -> (modArena md, rootDecls r k)) mods in
    let bindings = V.map (\x -> (fst x, bindingsOf (fst x) (snd x))) tables in
    let order = moduleOrder bindings H.empty in
    let dicts = implDicts r (firstDictOf depTypes) in
    -- Each module's tables, which the pass writes a binding into as its turn
    -- comes; and what each binding became.
    let outs = V.map (\k -> newInferringBuilder ()) (V.range 0 (V.len i.mods)) in
    let done = stNewRef H.empty in
    let u4 =
      V.foldl
        (\w k ->
          (let here = hereOf i k in registerTypes i here (declaredOf r k).items (rootDecls r k)))
        ()
        order
    in
    let u5 = V.foldl (\w k -> exportEffectOps i (declaredOf r k).items) () order in
    let u6 =
      V.foldl
        (\w k ->
          (let here = hereOf i k in
           let x = registerImpls i here (rootDecls r k) dicts in
           exportTraits i here (declaredOf r k).items (rootDecls r k) dicts))
        ()
        order
    in
    let u7 = V.foldl (\w k -> declarations i k (rootDecls r k) (declaredOf r k).items) () order in
    -- The unit's bindings as one graph, each module's grouped first.
    let grouped =
      V.map
        (\k ->
          (match V.get bindings k with
           | Just (a, bs) -> (a, fst (groupModule a bs H.empty))
           | None -> (emptyArena (), [])))
        order
    in
    let groups = unitGroups grouped H.empty in
    let u8 =
      V.foldl
        (\w (g : Group) ->
          inferGroup
            i
            outs
            done
            (V.map
               (\p ->
                 (let m = V.getOr 0 order (fst p) in
                  let bs = snd (V.getOr (emptyArena (), []) grouped (fst p)) in
                  (
                    hereAtBind i m (V.getOr (Binding { bind = 0, binds = [] }) bs (snd p)),
                    (V.getOr (Binding { bind = 0, binds = [] }) bs (snd p)).bind
                  )))
               g.members)
            g.recursive)
        ()
        groups
    in
    let u9 =
      V.foldl (\w k -> inferTraits i outs done (hereOf i k) (rootDecls r k) dicts) () order
    in
    let before = V.len (stGetRef i.errors) in
    let u9b = checkMain i r in
    -- What is wrong with `main`: what a unit is not compiled for.
    let ofMain = V.drop (stGetRef i.errors) before in
    -- The unit is done.
    let u10 = solveOverloads i True in
    let quantified =
      V.foldl
        (\h (g : Generalized) -> V.foldl (\h2 v -> H.insert v True h2) h g.vars)
        H.empty
        (H.values (stGetRef i.generalized))
    in
    let u11 = defaultNumVars i.ar quantified in
    let u12 = finishWanted i in
    -- What each binding generalized to, for the dump; and each exported
    -- binder's scheme, for the units after this one.
    let general =
      H.fromVec
        (V.map
           (\kv -> (fst kv, normalizeScheme i (genScheme (snd kv))))
           (H.toVec (stGetRef i.generalized)))
    in
    let exported =
      V.foldl
        (\h id ->
          match schemeOf i id with
          | Just sc -> H.insert id (normalizeScheme i sc) h
          | None -> h)
        H.empty
        (stGetRef i.exports)
    in
    let dumps = V.map (\k -> dumpModule i r k general texts) (V.range 0 (V.len r.modules)) in
    let evidence = evidenceOfUnit i in
    let insts = instsOfUnit i in
    let typed =
      V.map
        (\k -> writtenModule i r outs (stGetRef done) evidence insts k)
        (V.range 0 (V.len r.programs))
    in
    let asked = \(sc : Scheme) -> V.map (\(p : Pred) -> p.tr) sc.preds in
    let wheres =
      V.foldl
        (\h (d : ImplDef) -> H.insert d.dict (asked d.scheme) h)
        (V.foldl
           (\h kv -> H.insert (fst kv) (asked (genScheme (snd kv))) h)
           H.empty
           (H.toVec (stGetRef i.generalized)))
        (H.values (stGetRef i.impls))
    in Inferred {
         problems = ofMain,
         said = stGetRef i.errors,
         saidAt = stGetRef i.errorsAt,
         dumps,
         schemes = exported,
         types = ownTypes i,
         typed,
         wheres,
         evidence,
         generics =
           V.foldl
             (\h kv ->
               (let g : Generalized = snd kv in
                if V.isEmpty g.vars then h else H.insert (fst kv) g h))
             H.empty
             (H.toVec (stGetRef i.generalized)),
         numbers =
           V.concatMap
             (\id ->
               match numberKind i.ar id with
               | Just frac -> [(id, frac)]
               | None -> [])
             (H.keys quantified)
       })

-- Module `k` as inference wrote it, every type settled.
fun writtenModule
    (i : Inf s)
    (r : Renamed)
    outs
    (done : HashMap String Int)
    (evidence : HashMap String [Evidence])
    (insts : HashMap String [Type])
    (k : Int)
    : TypedProgram ! { St s | e } =
  match V.get r.programs k with
  | Just (_, HirProgram src root) ->
      let out = outOf outs k in
      let cx = newCx i (hereOf i k) Mode.Local in
      let ds =
        V.concatMap
          (\d ->
            match writtenDecl cx src out done d with
            | Just x -> [x]
            | None -> [])
          (hirModuleDecls src root)
      in
      let m = newInferringModule out (metaHirModule src root) ds in
      settleSt
        { ar = i.ar, m = k, evidence, insts, chosen = stGetRef i.chosenAt }
        (InferringProgram (freezeInferring out) m)
  | None -> runSt (\() -> TypedProgram (freezeTyped (newTypedBuilder ())) 0)

-- A module's declaration as inference wrote it: a binding as its group did, a
-- trait's or an `impl`'s with its bodies as they were, the rest copied.
fun writtenDecl (cx : Cx s) (src : HirArena) out (done : HashMap String Int) (d : HirDecl)
    : Maybe InferringDecl ! { St s | e } =
  let pl = plain cx in
  let meta = metaHirDecl src d in
  match viewHirDecl src d with
  | HirDeclView.Attributed r ->
      M.map
        (\inner ->
          newInferringDeclAttributed
            out
            meta
            (V.map (\at -> inferAttr src out pl at) r.attrs)
            inner)
        (writtenDecl cx src out done r.decl)
  | HirDeclView.Bind r -> Just (newInferringDeclBind out meta (writtenBind cx src out done r.bind))
  | HirDeclView.Trait r ->
      Just
        (newInferringDeclTrait
           out
           meta
           (inferName src out pl r.name)
           (V.map (\n -> inferName src out pl n) r.params)
           (V.map (\x -> inferBound src out pl x) r.supers)
           (V.map (\x -> inferAssoc src out pl x) r.assocs)
           (V.map (\x -> inferAssoc src out pl x) r.effects)
           (V.map (\x -> inferMethodSig src out pl x) r.sigs)
           (V.map (\b -> writtenBind cx src out done b) r.defaults))
  | HirDeclView.Impl r ->
      Just
        (newInferringDeclImpl
           out
           meta
           (inferName src out pl r.tr)
           (inferRef src out pl r.trRef)
           (V.map (\t -> inferType src out pl t) r.tys)
           (V.map (\x -> inferBound src out pl x) r.context)
           (V.map (\x -> inferAssocDef src out pl x) r.assocs)
           (V.map (\x -> inferAssocEffDef src out pl x) r.effects)
           (V.map (\b -> writtenBind cx src out done b) r.methods))
  | _ -> Just (inferDecl src out pl d)

-- A binding as its turn wrote it -- or, one nothing inferred, an `impl`'s
-- method its trait does not have, written now on its own.
fun writtenBind (cx : Cx s) (src : HirArena) out (done : HashMap String Int) (b : HirBind)
    : InferringBind ! { St s | e } =
  match H.lookup "${show cx.here.m}:${show b}" done with
  | Just x -> x
  | None -> inferBind src out (plain cx) b

-- The effects the runtime answers itself: `Std.Eff`, `meadow_infer`'s
-- `THREAD_EFFECTS`.
def runtimeEffects : [String] =
  [
    "Thread", "Console", "Fs", "Process", "Random", "Time", "Test", "Mut", "Std.Log.Log",
    "Std.Net.Net"
  ]

-- The root module's `main` is `() -> () ! Eff`: given nothing, giving nothing
-- back, and performing at most what the runtime answers -- as
-- `meadow_infer`'s `check_main` holds it, after it is generalized.
fun checkMain (i : Inf s) (r : Renamed) : () ! { St s | e } =
  let mains =
    V.concatMap
      (\(d : Declared) ->
        if V.isEmpty d.path then
          V.filter (\(it : Item) -> it.kind == "v" and it.name == "main") d.items
        else [])
      r.modules
  in match V.get mains 0 with
     | None -> ()
     | Just (it : Item) ->
         (match H.lookup it.id (stGetRef i.generalized) with
          | Just (g : Generalized) ->
              -- One that fits is `() -> () ! Eff` from then on: nothing runs
              -- `main` at another row.
              if mainFits i g.scheme then
                (let closed = closeRow i g in
                 let fixed =
                   Scheme {
                     quant = [],
                     preds = [],
                     ty =
                       Fun
                         [unitT ()]
                         (unitT ())
                         (V.foldr (\l rest -> RowExtend l (Tuple []) rest) RowEmpty runtimeEffects),
                     lacks = []
                   }
                 in
                 let u =
                   stSetRef
                     i.generalized
                     (H.insert
                        it.id
                        (Generalized { scheme = fixed, vars = [] })
                        (stGetRef i.generalized))
                 in
                 -- And what the unit says of it to whoever asks.
                 if M.isSome (schemeOf i it.id) then setScheme i it.id fixed else ())
              else ()
          | None -> ())

-- The row `main` was inferred at, closed to `Eff`: the variable it ended in
-- is the effects of `Eff` it did not perform, so that each node's type in
-- it says so too.
fun closeRow (i : Inf s) (g : Generalized) : () ! { St s | e } =
  match g.scheme.ty with
  | Fun _ _ row ->
      (match rowEnd row with
       | Bound k ->
           (match V.get g.vars k with
            | Just v ->
                (let present = V.map fst (labelsOf row) in
                 let others =
                   V.foldr
                     (\l rest -> if V.elem l present then rest else RowExtend l (Tuple []) rest)
                     RowEmpty
                     runtimeEffects
                 in
                 let u = unify i.ar (Var v) others in
                 ())
            | None -> ())
       | _ -> ())
  | _ -> ()

-- Whether `main`, of scheme `sc`, is what a `main` may be; what is wrong
-- with it is said if not.
fun mainFits (i : Inf s) (sc : Scheme) : Bool ! { St s | e } =
  let wrong =
    \u -> (let r = report i "`main` is `${showScheme sc}`, and has to be `() -> () ! Eff`" in False)
  in
  -- A number of any type is not `()`, whatever unifying a variable says.
  let numeric =
    (match sc.ty with
     | Fun _ (Bound k) _ ->
         (let kind = V.getOr VarKind.Plain sc.quant k in
          kind == VarKind.Num or kind == VarKind.Frac)
     | _ -> False)
  in if numeric then wrong ()
     else
       match zonk i.ar (instantiate i sc) with
       | Fun params ret eff ->
           if V.len params == 1
             and fits i (V.getOr (unitT ()) params 0) (unitT ())
             and fits i ret (unitT ()) then unanswered i (zonk i.ar eff)
           else wrong ()
       | _ -> wrong ()

fun fits (i : Inf s) (a : Type) (b : Type) : Bool ! { St s | e } =
  match unify i.ar a b with | Ok _ -> True | Err _ -> False

-- Whether `main` performs nothing but what the runtime answers; what nobody
-- would answer is said.
fun unanswered (i : Inf s) (eff : Type) : Bool ! { St s | e } =
  let names = V.filter (\l -> not (V.elem l runtimeEffects)) (V.map fst (labelsOf eff)) in
  if V.isEmpty names then True
  else
    (let r =
       report
         i
         "`main` performs ${S.join ", " (V.map (\l -> "`${spelling l}`") names)}, which nothing would handle"
     in False)

fun emptyMod () : Mod = Mod { a = emptyArena (), file = "" }

fun modArena (m : Mod) : HirArena = m.a

fun genScheme (g : Generalized) : Scheme = g.scheme

fun opsOf (e : EffectInfo) : [EffOp] = e.ops

fun paramsOf (e : EffectInfo) : Int = e.params

fun emptyDeclared () : Declared = Declared { file = "", path = [], items = [] }

fun emptyArena () : HirArena = match freezeProgram () with | HirProgram a _ -> a

fun freezeProgram () : HirProgram =
  runSt (\() -> (let b = newHirBuilder () in HirProgram (freezeHir b) 0))

fun declaredOf (r : Renamed) (k : Int) : Declared = V.getOr (emptyDeclared ()) r.modules k

fun rootDecls (r : Renamed) (k : Int) : [HirDecl] =
  match V.get r.programs k with
  | Just (_, HirProgram a root) -> declsOfModule a root
  | None -> []

fun hereOf (i : Inf s) (k : Int) : Here =
  Here { a = (V.getOr (emptyMod ()) i.mods k).a, m = k, scope = "${show k}" }

fun hereAtBind (i : Inf s) (k : Int) (b : Binding) : Here =
  { (hereOf i k) | scope = "${show k}:b${show b.bind}" }

-- A binder of its own for each `impl`'s dictionary, by module and node: below
-- every binder the unit has, where nothing else is.
fun implDicts (r : Renamed) (first : Int) : HashMap String Int =
  fst
    (V.foldl
       (\acc k ->
         V.foldl
           (\acc2 d ->
             match V.get r.programs k with
             | Just (_, HirProgram a _) ->
                 (match viewHirDecl a d with
                  | HirDeclView.Impl _ ->
                      (H.insert "${show k}:${show d}" (snd acc2) (fst acc2), snd acc2 - 1)
                  | _ -> acc2)
             | None -> acc2)
           acc
           (rootDecls r k))
       (H.empty, first)
       (V.range 0 (V.len r.programs)))

fun newInf (r : Renamed) : Inf s ! { St s | e } =
  let canon = canonTable r in
  Inf {
    ar = newArena (),
    env = stNewRef H.empty,
    exports = stNewRef [],
    generalized = stNewRef H.empty,
    ctors = stNewRef H.empty,
    variants = stNewRef H.empty,
    recordFields = stNewRef H.empty,
    effects = stNewRef H.empty,
    curEffect = stNewRef RowEmpty,
    annTyvars = stNewRef H.empty,
    aliases = stNewRef H.empty,
    sigs = stNewRef H.empty,
    sigFailed = stNewRef H.empty,
    overloads = H.empty,
    pending = stNewRef [],
    subsumptions = stNewRef [],
    atNode = stNewRef H.empty,
    instAt = stNewRef H.empty,
    unanswered = stNewRef [],
    chosenAt = stNewRef H.empty,
    mentions = stNewRef [],
    fixed = stNewRef H.empty,
    assocEffectVars = stNewRef [],
    settlingJoins = stNewRef False,
    errors = stNewRef [],
    at = stNewRef (0 - 1, 0 - 1),
    errorsAt = stNewRef [],
    runSt = M.unwrapOr (0 - 1) (M.map snd (V.find (\p -> fst p == "runSt") r.prims)),
    stLevels = stNewRef [],
    entries = entriesOf r,
    canon,
    mods = V.map (\x -> match x with | (file, HirProgram a _) -> Mod { a, file }) r.programs,
    shapes = stNewRef H.empty,
    methods = stNewRef H.empty,
    assocOf = stNewRef H.empty,
    impls = stNewRef H.empty,
    wanted = B.buffer (),
    givens = stNewRef [],
    group = stNewRef [],
    member = stNewRef None,
    methodSigs = stNewRef H.empty,
    names = V.map (\(b : Binder) -> b.name) r.binders
  }

-- Every declared binder's canonical name -- an operation's is `op:` and its
-- effect's name -- the unit's and its dependencies', and those of the
-- constructors a unit built with no library has a binder of its own for.
fun canonTable (r : Renamed) : HashMap Int String =
  let own = V.concatMap (\(d : Declared) -> d.items) r.modules in
  V.foldl
    (\h (it : Item) ->
      if S.startsWith "op:" it.owner then H.insert it.id it.owner h
      else if S.isEmpty it.canon then h
      else H.insert it.id it.canon h)
    (V.foldl
       (\h k ->
         match V.get r.binders k with
         | Just (b : Binder) ->
             if b.kind != "c" or b.site != "-" then h
             else if b.name == "Nil" or b.name == "Cons" then H.insert k "List.${b.name}" h
             else if b.name == "True" or b.name == "False" then H.insert k "Bool.${b.name}" h
             else h
         | None -> h)
       H.empty
       (V.range 0 (V.len r.binders)))
    (V.append own r.depItems)

-- The root module's `main`: the definition that is run rather than defined.
fun entriesOf (r : Renamed) : [Int] =
  V.concatMap
    (\(d : Declared) ->
      if V.isEmpty d.path then
        V.concatMap
          (\(it : Item) ->
            if it.kind == "v" and it.name == "main" and S.isEmpty it.owner then [it.id] else [])
          d.items
      else [])
    r.modules

-- A dependency's types, loaded.
fun loadTypes (i : Inf s) (t : TypeEnv) : () ! { St s | e } =
  let a =
    stSetRef
      i.ctors
      (V.foldl (\h (e : Entry Scheme) -> H.insert e.key e.value h) (stGetRef i.ctors) t.ctors)
  in
  let b =
    stSetRef
      i.variants
      (V.foldl
         (\h (e : Entry [VariantSig]) -> H.insert e.key e.value h)
         (stGetRef i.variants)
         t.variants)
  in
  let c =
    stSetRef
      i.recordFields
      (V.foldl
         (\h (e : Entry [Entry Scheme]) ->
           H.insert e.key (H.fromVec (V.map (\(f : Entry Scheme) -> (f.key, f.value)) e.value)) h)
         (stGetRef i.recordFields)
         t.fields)
  in
  let d =
    stSetRef
      i.effects
      (V.foldl
         (\h (e : Entry EffectInfo) -> H.insert e.key e.value h)
         (stGetRef i.effects)
         t.effects)
  in
  let f =
    stSetRef
      i.aliases
      (V.foldl (\h (e : Entry AliasDef) -> H.insert e.key e.value h) (stGetRef i.aliases) t.aliases)
  in
  let g =
    stSetRef
      i.shapes
      (V.foldl (\h (e : Entry TraitShape) -> H.insert e.key e.value h) (stGetRef i.shapes) t.shapes)
  in
  let m =
    stSetRef
      i.methods
      (V.foldl (\h (e : Entry Scheme) -> H.insert e.key e.value h) (stGetRef i.methods) t.methods)
  in
  let n =
    stSetRef
      i.assocOf
      (V.foldl
         (\h (e : Entry AssocOwner) -> H.insert e.key e.value h)
         (stGetRef i.assocOf)
         t.assocOf)
  in stSetRef
       i.impls
       (V.foldl (\h (e : Entry ImplDef) -> H.insert e.key e.value h) (stGetRef i.impls) t.impls)

-- What this unit knows about types, to tell the units after it: everything,
-- its dependencies' included, as the Rust compiler's units pass declarations
-- along.
fun ownTypes (i : Inf s) : TypeEnv ! { St s | e } =
  let entries = \h -> V.map (\kv -> Entry { key = fst kv, value = snd kv }) (H.toVec h) in
  TypeEnv {
    ctors = entries (stGetRef i.ctors),
    variants = entries (stGetRef i.variants),
    fields =
      V.map
        (\kv ->
          Entry {
            key = fst kv,
            value = V.map (\f -> Entry { key = fst f, value = snd f }) (H.toVec (snd kv))
          })
        (H.toVec (stGetRef i.recordFields)),
    effects = entries (stGetRef i.effects),
    aliases = entries (stGetRef i.aliases),
    shapes = entries (stGetRef i.shapes),
    methods = entries (stGetRef i.methods),
    assocOf = entries (stGetRef i.assocOf),
    impls = entries (stGetRef i.impls)
  }

-- This unit's effects' operations, exported.
fun exportEffectOps (i : Inf s) (items : [Item]) : () ! { St s | e } =
  V.foldl
    (\w (it : Item) ->
      if S.startsWith "op:" it.owner then stSetRef i.exports (V.pushBack (stGetRef i.exports) it.id)
      else ())
    ()
    items

-- This unit's traits' methods and `impl`s' dictionaries, recorded and
-- exported.
fun exportTraits
    (i : Inf s)
    (here : Here)
    (items : [Item])
    (decls : [HirDecl])
    (dicts : HashMap String Int)
    : () ! { St s | e } =
  let a = here.a in
  V.foldl
    (\w d ->
      match viewHirDecl a d with
      | HirDeclView.Trait r ->
          V.foldl
            (\x ms ->
              (match M.andThen
                 (\(it : Item) -> M.map (\sc -> (it.id, sc)) (schemeOf i it.id))
                 (itemNamed
                    items
                    "v"
                    (hirNameText a r.name)
                    (hirNameText a (hirMethodSigName a ms))) with
               | Just (vid, sc) ->
                   (let y = recordPoly i vid sc in
                    stSetRef i.exports (V.pushBack (stGetRef i.exports) vid))
               | None -> ()))
            ()
            r.sigs
      | HirDeclView.Impl r ->
          (match H.lookup "${show here.m}:${show d}" dicts with
           | Just dict ->
               (match schemeOf i dict with
                | Just sc ->
                    (let y = recordPoly i dict sc in
                     stSetRef i.exports (V.pushBack (stGetRef i.exports) dict))
                | None -> ())
           | None -> ())
      | _ -> ())
    ()
    decls

-- Each top-level signature, for the binding it is of.
fun declarations (i : Inf s) (k : Int) (decls : [HirDecl]) (items : [Item]) : () ! { St s | e } =
  let a = (V.getOr (emptyMod ()) i.mods k).a in
  V.foldl
    (\w d ->
      match viewHirDecl a d with
      | HirDeclView.Sig r ->
          (match itemNamed items "v" "" (hirNameText a r.name) with
           | Just (it : Item) ->
               stSetRef
                 i.sigs
                 (H.insert
                    it.id
                    (SigOf {
                       here = Here { a, m = k, scope = "${show k}:sig${show d}" },
                       ty = r.ty,
                       bounds = r.bounds
                     })
                    (stGetRef i.sigs))
           | None -> ())
      | _ -> ())
    ()
    decls

-- A module's top-level binders, each a line: where it is written, its name,
-- and its scheme -- `from to name : scheme`.
fun dumpModule
    (i : Inf s)
    (r : Renamed)
    (k : Int)
    (schemes : HashMap Int Scheme)
    (texts : HashMap String String)
    : (String, [String]) ! { St s | e } =
  let d = declaredOf r k in
  let text = H.lookup d.file texts in
  let binders =
    V.concatMap
      (\(b : Binding) -> b.binds)
      (match V.get r.programs k with
       | Just (_, HirProgram a root) -> bindingsOf a (declsOfModule a root)
       | None -> [])
  in
  let lines =
    V.map
      (\id ->
        let b =
          V.getOr
            (Binder { name = "?", kind = "v", site = "", uses = [], until = 0 - 1 })
            r.binders
            id
        in
        let from = siteOffset b.site in
        let to = if b.until >= 0 then b.until else from + stringByteLength b.name in
        -- What is written there: a name, or a macro's call -- a derive's
        -- spans nothing, and reads as nothing.
        let written =
          (match text with
           | Just t -> stringSlice t from to
           | None -> if to > from then b.name else "")
        in (
             (from, to),
             "${show from} ${show to} ${written} : ${M.unwrapOr "?" (M.map showScheme (H.lookup id schemes))}"
           ))
      binders
  in
  -- By where each is written; those a macro's call writes alike, by what
  -- they say.
  (d.file, V.map snd (sortOn (\l -> l) lines))

fun siteOffset (site : String) : Int =
  match S.indexOf "@" site with
  | Just at -> M.unwrapOr 0 (S.toInt (stringSlice site (at + 1) (stringByteLength site)))
  | None -> 0
