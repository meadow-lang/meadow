-- The CEK machine: `meadow_eval`'s, in Meadow, step for step.
--
-- `(Control, Environment, Kontinuation)`: a term and the names it sees, or a
-- value; and a stack of frames, each saying what to do with the value of the
-- sub-expression under way. The frames are the Rust machine's `K`, one for one,
-- and so is what each step does with them -- the order a thing is evaluated
-- in, what a guard that fails goes on to, where a `perform` unwinds to -- since
-- what this machine is for is to answer as that one does. Effects are deep,
-- one-shot handlers: a `perform` splits the stack at the nearest handler for
-- its operation, and resuming puts the frames it took back.
--
-- The environment is a map from each name to a cell. A `letrec` makes its
-- names' cells first and fills them in as their values come, so that what is
-- made in the meantime sees them -- the Rust machine's `define` into a scope
-- that was already captured.
--
-- A term is a row of the program's tables (`Core`), read with the patterns
-- `lang!` made: `ErasedTermApp f x` matches the row's production and reads its
-- fields, and builds nothing. So the machine makes no terms either. Where the
-- Rust machine rewrites a join point as a `letrec` of nested lambdas, and a
-- jump as the applications of it, this one has a closure take its parameters
-- one at a time, and a jump push the arguments' frames those applications
-- would have pushed.

use MeadowBoot.Core
use Std.Collections.Map as Map
use Std.Collections.Map (Map)
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.Collections.Vector as V
use Std.Collections.List as L
use Std.String as S
use Std.Char as C
use Std.Sort (sortOn)
use Std.Maybe as Mb
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Value.*
use Frame.*
use Control.*

-- --- values ------------------------------------------------------------------

@pub data Value
  = Int Int
  -- The sized integers, each Meadow's own: what they do is what the machine
  -- this runs on does with them, which is what `meadow_core::num` says.
  | I8 Int8
  | I16 Int16
  | I32 Int32
  | U8 UInt8
  | U16 UInt16
  | U32 UInt32
  | U64 UInt64
  | Big BigInt
  | Float Float
  | F32 Float32
  | Bool Bool
  | Str String
  | Char Char
  | Unit
  | Tuple [Value]
  | Array [Value]
  -- A record's fields, each label once, in the order they were made.
  | Record [(String, Value)]
  | Ctor String [Value]
  -- A function: the parameters it has still to take -- a lambda's one, or a
  -- join point's several -- its body, and its scope.
  | Closure [Int] ErasedTerm (Map (Ref Value))
  -- A captured continuation: the frames a `perform` took, until it is resumed.
  | Cont (Ref (Maybe (List Frame)))
  | Ref (Ref Value)
  -- A mutable array, from `stNewArray`: one cell, holding what it holds now.
  | Mut (Ref [Value])
  -- A value in a compact region.
  | Compact Value
  -- A top-level value not evaluated yet: its definition.
  | Lazy ErasedTerm

-- --- the machine -------------------------------------------------------------

-- One frame of the continuation: `meadow_eval`'s `K`.
@pub data Frame
  = EvalArg ErasedTerm (Map (Ref Value))
  | ApplyTo Value
  -- An argument a caller of the machine has in hand, for the function on its way.
  | Give Value
  | If ErasedTerm ErasedTerm (Map (Ref Value))
  | Bind Int ErasedTerm (Map (Ref Value))
  -- The scope, the bindings still to evaluate -- the first is under way -- and
  -- the body.
  | LetRec (Map (Ref Value)) [(Int, ErasedTerm)] ErasedTerm
  -- What is being built, what is done, what is still to evaluate after the
  -- one under way.
  | Build Shape [Value] [ErasedTerm] (Map (Ref Value))
  | BuildRecord [(String, Value)] [ErasedField] (Map (Ref Value))
  | Proj Int
  | Sel String
  | ExtendVal String ErasedTerm (Map (Ref Value))
  | ExtendWith String Value
  | Match [ErasedArm] (Map (Ref Value))
  -- An arm matched and its guard is under way: the arms, where they were
  -- written, the arm after it, the scrutinee, and the scope the arm bound.
  | Guard [ErasedArm] (Map (Ref Value)) Int Value (Map (Ref Value))
  | PerformWith String String
  | HandleMark [ErasedClause] (Maybe (Int, ErasedTerm)) (Map (Ref Value))
  | Cache Int

@pub data Shape = Tuple | Array | Ctor String | Prim String

data Control = Eval ErasedTerm (Map (Ref Value)) | Ret Value

-- What does not change as the machine runs: the program's tables, the
-- definitions, each a cell, and each constructor's named fields.
--
-- The definitions are in a table by their hash and a scope is a tree by
-- order: a program has thousands of definitions, numbered as they come, and
-- a tree they are put in one after another is a list, searched to its end
-- for every mention of one. A scope is the few names a function binds.
@pub record Machine = {
  arena : ErasedArena,
  root : HashMap Int (Ref Value),
  fields : [(String, [String])]
}

-- `p`'s entry point evaluated, or what went wrong: `meadow_eval::run`.
@pub fun run (p : ErasedProgram) =
  let m = machine p in
  let entry = erasedFileEntry (erasedArena p) (erasedRoot p) in
  if entry < 0 then Ok Unit else variable m entry Map.empty [;]

-- A machine for `p`, its definitions loaded: one to `call` into as often as
-- wanted, a definition evaluated the first time it is asked for and kept.
@pub fun machine (p : ErasedProgram) : Machine ! { Mut | e } =
  let a = erasedArena p in
  let file = erasedRoot p in
  let root =
    V.foldl
      (\env d -> H.insert (erasedDefId a d) (newRef (loaded a (erasedDefBody a d))) env)
      H.empty
      (erasedFileDefs a file)
  in Machine {
       arena = a,
       root,
       fields = V.map (\n -> (erasedNamedName a n, erasedNamedLabels a n)) (erasedFileNamed a file)
     }

-- A text as a value, and a value's text if it is one: what a caller of
-- the machine hands it and reads back.
@pub fun text (s : String) : Value = Str s

@pub fun textOf (v : Value) : Maybe String = match v with | Str s -> Just s | _ -> None

-- Definition `f` applied to `args`, each in turn, or what went wrong.
@pub fun call (m : Machine) (f : Int) (args : [Value]) =
  variable m f Map.empty (V.foldr (\x acc -> Give x :: acc) [;] args)

-- A definition as the machine keeps it: a function made, anything else left
-- to be evaluated where it is first used.
fun loaded (a : ErasedArena) (t : ErasedTerm) : Value =
  match (a, t) with
  | ErasedTermLam p body -> Closure [p] body Map.empty
  | _ -> Lazy t

fun go (m : Machine) (c : Control) (k : List Frame) =
  match c with
  | Eval t env -> eval m t env k
  | Ret v -> (match k with | [;] -> Ok v | f :: rest -> ret m v f rest)

-- The cell `v` is in: the scope's, or a definition's.
fun lookup (m : Machine) (env : Map (Ref Value)) (v : Int) : Maybe (Ref Value) =
  match Map.lookup v env with
  | Just r -> Just r
  | None -> H.lookup v m.root

fun define (env : Map (Ref Value)) (v : Int) (x : Value) = Map.insert v (newRef x) env

-- Variable `v`'s value: a definition's evaluated the first time it is asked
-- for, and kept.
fun variable (m : Machine) (v : Int) (env : Map (Ref Value)) (k : List Frame) =
  match lookup m env v with
  | Just r ->
      (match getRef r with
       | Lazy body -> go m (Eval body Map.empty) (Cache v :: k)
       | val -> go m (Ret val) k)
  | None -> Err "unbound variable VarId(${show v})"

fun eval (m : Machine) (t : ErasedTerm) (env : Map (Ref Value)) (k : List Frame) =
  let a = m.arena in
  match (a, t) with
  | ErasedTermVar v -> variable m v env k
  | ErasedTermConst l -> go m (Ret (literal a l)) k
  | ErasedTermLam p body -> go m (Ret (Closure [p] body env)) k
  | ErasedTermApp f x -> go m (Eval f env) (EvalArg x env :: k)
  | ErasedTermLet v rhs body -> go m (Eval rhs env) (Bind v body env :: k)
  -- A `letrec` of the join point's lambdas: with parameters, the lambda is a
  -- closure at once; with none, it is the body, evaluated now.
  | ErasedTermJoin j params rhs body ->
      let scope = define env j Unit in
      if V.isEmpty params then go m (Eval rhs scope) (LetRec scope [(j, rhs)] body :: k)
      else (let u = fill scope j (Closure params rhs scope) in go m (Eval body scope) k)
  -- The join point applied to each argument in turn: the frames of
  -- `((j a) b)`, under `j`.
  | ErasedTermJump j args -> variable m j env (V.foldr (\x acc -> EvalArg x env :: acc) k args)
  | ErasedTermLetRec binds body ->
      let pairs = V.map (\b -> (erasedBindId a b, erasedBindValue a b)) binds in
      let scope = V.foldl (\e b -> define e (fst b) Unit) env pairs in
      (match V.get pairs 0 with
       | Just (_, rhs) -> go m (Eval rhs scope) (LetRec scope pairs body :: k)
       | None -> go m (Eval body scope) k)
  | ErasedTermIf c y n -> go m (Eval c env) (If y n env :: k)
  | ErasedTermTuple xs -> start m Shape.Tuple xs env k
  | ErasedTermArray xs -> start m Shape.Array xs env k
  | ErasedTermCtor n xs -> start m (Shape.Ctor n) xs env k
  | ErasedTermPrim op xs -> start m (Shape.Prim op) xs env k
  | ErasedTermRecord fs ->
      (match V.get fs 0 with
       | Just first -> go m (Eval (erasedFieldValue a first) env) (BuildRecord [] fs env :: k)
       | None -> go m (Ret (Record [])) k)
  | ErasedTermProj x i -> go m (Eval x env) (Proj i :: k)
  | ErasedTermSel x l -> go m (Eval x env) (Sel l :: k)
  | ErasedTermExtend r l val -> go m (Eval r env) (ExtendVal l val env :: k)
  | ErasedTermCase s arms -> go m (Eval s env) (Match arms env :: k)
  | ErasedTermPerform e o x -> go m (Eval x env) (PerformWith e o :: k)
  | ErasedTermHandle body clauses retId r ->
      let returned =
        (match (retId, r) with
         | (Just v, Just b) -> Just (v, b)
         | _ -> None)
      in go m (Eval body env) (HandleMark clauses returned env :: k)
  | ErasedTermIll -> Err "evaluating an ill-formed expression"

-- A sequence of sub-expressions, left to right, then what they make.
fun start (m : Machine) (s : Shape) (xs : [ErasedTerm]) (env : Map (Ref Value)) (k : List Frame) =
  match V.get xs 0 with
  | Just first -> go m (Eval first env) (Build s [] (V.drop xs 1) env :: k)
  | None ->
      go
        m
        (Ret
           (match s with
            | Shape.Tuple -> Tuple []
            | Shape.Array -> Array []
            | Shape.Ctor n -> Ctor n []
            | Shape.Prim _ -> Unit))
        k

fun ret (m : Machine) (v : Value) (f : Frame) (k : List Frame) =
  match f with
  | EvalArg x env -> go m (Eval x env) (ApplyTo v :: k)
  | ApplyTo func -> apply m func v k
  | Give x -> apply m v x k
  | If y n env ->
      (match v with
       | Bool True -> go m (Eval y env) k
       | Bool False -> go m (Eval n env) k
       | other -> Err "`if` condition is not a Bool: ${display other}")
  | Bind var body env -> go m (Eval body (define env var v)) k
  | LetRec scope binds body ->
      let u =
        (match V.get binds 0 with
         | Just (var, _) -> fill scope var v
         | None -> ())
      in
      let later = V.drop binds 1 in
      (match V.get later 0 with
       | Just (_, rhs) -> go m (Eval rhs scope) (LetRec scope later body :: k)
       | None -> go m (Eval body scope) k)
  | Build s done pending env ->
      let all = V.pushBack done v in
      (match V.get pending 0 with
       | Just next -> go m (Eval next env) (Build s all (V.drop pending 1) env :: k)
       | None ->
           (match s with
            | Shape.Tuple -> go m (Ret (Tuple all)) k
            | Shape.Array -> go m (Ret (Array all)) k
            | Shape.Ctor n -> go m (Ret (Ctor n all)) k
            | Shape.Prim op ->
                (match prim op all with
                 | Ok r -> go m (Ret r) k
                 | Err e -> Err e)))
  | BuildRecord done pending env ->
      let label =
        (match V.get pending 0 with
         | Just f -> erasedFieldLabel m.arena f
         | None -> "")
      in
      let all = withField label v done in
      let later = V.drop pending 1 in
      (match V.get later 0 with
       | Just next ->
           go m (Eval (erasedFieldValue m.arena next) env) (BuildRecord all later env :: k)
       | None -> go m (Ret (Record all)) k)
  | Proj i ->
      (match v with
       | Tuple xs ->
           (match V.get xs i with
            | Just x -> go m (Ret x) k
            | None -> Err "tuple projection ${show i} out of range")
       | other -> Err "cannot project field ${show i} out of ${display other}")
  | Sel label -> select m label v k
  | ExtendVal label val env -> go m (Eval val env) (ExtendWith label v :: k)
  | ExtendWith label rec ->
      (match rec with
       | Record fs -> go m (Ret (Record (withField label v fs))) k
       | other -> Err "cannot extend non-record ${display other}")
  | Match arms env -> arms_ m arms env 0 v k
  | Guard arms env next scrutinee scope ->
      (match v with
       | Bool True ->
           (match V.get arms (next - 1) with
            | Just arm -> go m (Eval (erasedArmBody m.arena arm) scope) k
            | None -> Err "non-exhaustive pattern match")
       | Bool False -> arms_ m arms env next scrutinee k
       | other -> Err "a `match` guard is not a Bool: ${display other}")
  | PerformWith e o -> perform m e o v k
  | Cache var ->
      let u =
        (match H.lookup var m.root with
         | Just r -> setRef r v
         | None -> ())
      in go m (Ret v) k
  | HandleMark _ r henv ->
      (match r with
       | Just (param, body) -> go m (Eval body (define henv param v)) k
       | None -> go m (Ret v) k)

fun fill (scope : Map (Ref Value)) (var : Int) (v : Value) =
  match Map.lookup var scope with
  | Just r -> setRef r v
  | None -> ()

-- `fs` with `label` set to `v`: replaced where it is, or added at the end.
fun withField (label : String) (v : Value) (fs : [(String, Value)]) : [(String, Value)] =
  if V.any (\f -> fst f == label) fs then V.map (\f -> if fst f == label then (label, v) else f) fs
  else V.pushBack fs (label, v)

fun select (m : Machine) (label : String) (v : Value) (k : List Frame) =
  match v with
  | Record fs ->
      (match V.find (\f -> fst f == label) fs with
       | Just (_, x) -> go m (Ret x) k
       | None -> Err "record has no field `${label}`")
  | Ctor name vals ->
      let named = V.find (\f -> fst f == name) m.fields in
      let at =
        (match named with
         | Just (_, fs) -> indexOf label fs 0
         | None -> 0 - 1)
      in (match V.get vals at with
          | Just x -> go m (Ret x) k
          | None -> Err "`${ctorSpelling name}` has no field `${label}`")
  | other -> Err "cannot select `.${label}` from ${display other}"

-- Where `x` is in `xs`, from `i` on, or -1.
fun indexOf (x : String) (xs : [String]) (i : Int) : Int =
  match V.get xs i with
  | Just y -> if y == x then i else indexOf x xs (i + 1)
  | None -> 0 - 1

-- The arms from `from` on, against `v`: the first whose pattern matches, and
-- whose guard -- evaluated next, if it has one -- holds.
fun arms_
    (m : Machine)
    (arms : [ErasedArm])
    (env : Map (Ref Value))
    (from : Int)
    (v : Value)
    (k : List Frame) =
  let a = m.arena in
  match V.get arms from with
  | None -> Err "non-exhaustive pattern match"
  | Just arm ->
      (match matched a (erasedArmPat a arm) v env with
       | None -> arms_ m arms env (from + 1) v k
       | Just scope ->
           (match erasedArmGuard a arm with
            | None -> go m (Eval (erasedArmBody a arm) scope) k
            | Just g -> go m (Eval g scope) (Guard arms env (from + 1) v scope :: k)))

-- The scope `p` matching `v` makes of `env`, or `None`.
fun matched (a : ErasedArena) (p : ErasedPat) (v : Value) (env : Map (Ref Value))
    : Maybe (Map (Ref Value)) ! { Mut | e } =
  match (a, p) with
  | ErasedPatPWild -> Just env
  | ErasedPatPVar x -> Just (define env x v)
  | ErasedPatPAs x sub -> matched a sub v (define env x v)
  | ErasedPatPLit l -> if litMatches a l v then Just env else None
  | ErasedPatPTuple ps ->
      (match v with
       | Tuple vs -> (if V.len ps == V.len vs then all a ps vs env else None)
       | _ -> None)
  | ErasedPatPArray ps ->
      (match v with
       | Array vs -> (if V.len ps == V.len vs then all a ps vs env else None)
       | _ -> None)
  | ErasedPatPCtor name ps ->
      (match v with
       | Ctor vname vs -> if name == vname and V.len ps == V.len vs then all a ps vs env else None
       | _ -> None)
  | ErasedPatPRecord fs ->
      (match v with
       | Record vfs ->
           V.foldl
             (\acc f ->
               match (acc, V.find (\g -> fst g == erasedPFieldLabel a f) vfs) with
               | (Just e, Just (_, x)) -> matched a (erasedPFieldPat a f) x e
               | _ -> None)
             (Just env)
             fs
       | _ -> None)

fun all (a : ErasedArena) (ps : [ErasedPat]) (vs : [Value]) (env : Map (Ref Value))
    : Maybe (Map (Ref Value)) ! { Mut | e } =
  V.foldl
    (\acc i ->
      match (acc, V.get ps i, V.get vs i) with
      | (Just e, Just p, Just x) -> matched a p x e
      | _ -> None)
    (Just env)
    (V.range 0 (V.len ps))

fun litMatches (a : ErasedArena) (l : ErasedLit) (v : Value) : Bool =
  match (a, l) with
  | ErasedLitLInt n -> (match v with | Int b -> n == b | _ -> equal (literal a l) v)
  | ErasedLitLBig _ -> equal (literal a l) v
  | ErasedLitLWord _ _ -> equal (literal a l) v
  | ErasedLitLF64 x -> (match v with | Float y -> x == y | _ -> False)
  | ErasedLitLF32 _ -> equal (literal a l) v
  | ErasedLitLStr s -> (match v with | Str t -> s == t | _ -> False)
  | ErasedLitLChar c -> (match v with | Char ch -> c == C.code ch | _ -> False)
  | ErasedLitLBool b -> (match v with | Bool w -> b == w | _ -> False)
  | ErasedLitLUnit -> (match v with | Unit -> True | _ -> False)

fun literal (a : ErasedArena) (l : ErasedLit) : Value =
  match (a, l) with
  | ErasedLitLInt n -> Int n
  | ErasedLitLBig n -> Big (toBigInt n)
  | ErasedLitLWord w n -> sized w (Int n)
  | ErasedLitLF64 x -> Float x
  | ErasedLitLF32 x -> F32 (toFloat32 x)
  | ErasedLitLStr s -> Str s
  | ErasedLitLChar c -> Char (C.fromCode c)
  | ErasedLitLBool b -> Bool b
  | ErasedLitLUnit -> Unit

-- `f` applied to `arg`. A closure with parameters still to take after this
-- one is a closure again, as the lambda inside a lambda would have made.
fun apply (m : Machine) (f : Value) (arg : Value) (k : List Frame) =
  match f with
  | Closure ps body env ->
      (match V.get ps 0 with
       | Just p ->
           let scope = define env p arg in
           if V.len ps == 1 then go m (Eval body scope) k
           else go m (Ret (Closure (V.drop ps 1) body scope)) k
       | None -> go m (Eval body env) k)
  | Cont cell ->
      (match getRef cell with
       | Just saved ->
           let u = setRef cell None in
           go m (Ret arg) (L.append saved k)
       | None -> Err "continuation resumed more than once")
  | other -> Err "${display other} is not a function"

-- A `perform`: the continuation split at the nearest handler with a clause for
-- the operation -- the handler's frame and everything above it taken, to be
-- the resumption -- and the clause run.
fun perform (m : Machine) (e : String) (o : String) (arg : Value) (k : List Frame) =
  let a = m.arena in
  match handlerIn a e o k [;] with
  | None -> Err "unhandled effect ${afterLast "." e}.${o}"
  | Just (taken, outer, clause, henv) ->
      let cont = Cont (newRef (Just taken)) in
      let scope =
        define (define henv (erasedClauseParam a clause) arg) (erasedClauseResume a clause) cont
      in go m (Eval (erasedClauseBody a clause) scope) outer

-- The frames down to the first handler for `e.o`, that handler's frame last;
-- what is under it; its clause; and its scope.
fun handlerIn (a : ErasedArena) (e : String) (o : String) (k : List Frame) (above : List Frame) =
  match k with
  | [;] -> None
  | f :: rest ->
      (match f with
       | HandleMark clauses _ henv ->
           (match V.find (\c -> erasedClauseEff a c == e and erasedClauseOp a c == o) clauses with
            | Just c -> Just (L.reverse (f :: above), rest, c, henv)
            | None -> handlerIn a e o rest (f :: above))
       | _ -> handlerIn a e o rest (f :: above))

-- --- primitives --------------------------------------------------------------

fun prim (op : String) (args : [Value]) : Result String Value ! { Mut | e } =
  let a = V.getOr Unit args 0 in
  let b = V.getOr Unit args 1 in
  let c = V.getOr Unit args 2 in
  match op with
  | "Add" -> integral "+" op a b
  | "Sub" -> integral "-" op a b
  | "Mul" -> integral "*" op a b
  | "Div" -> integral "/" op a b
  | "Mod" -> integral "%" op a b
  | "Pow" -> integral "^" op a b
  | "BitAnd" -> integral "bitAnd" op a b
  | "BitOr" -> integral "bitOr" op a b
  | "BitXor" -> integral "bitXor" op a b
  | "Shl" -> integral "shl" op a b
  | "Shr" -> integral "shr" op a b
  | "Ushr" -> integral "ushr" op a b
  | "Lt" -> ordered "<" op a b
  | "Gt" -> ordered ">" op a b
  | "Le" -> ordered "<=" op a b
  | "Ge" -> ordered ">=" op a b
  | "Neg" -> negated a
  | "BitNot" -> inverted a
  | "AddF" -> fractional "+" op a b
  | "SubF" -> fractional "-" op a b
  | "MulF" -> fractional "*" op a b
  | "DivF" -> fractional "/" op a b
  | "LtF" -> fractionalOrder "<" op a b
  | "GtF" -> fractionalOrder ">" op a b
  | "LeF" -> fractionalOrder "<=" op a b
  | "GeF" -> fractionalOrder ">=" op a b
  | "Eq" -> Ok (Bool (equal a b))
  | "Ne" -> Ok (Bool (not (equal a b)))
  | "ToFloat" -> asFloat a
  | "ToFloat32" ->
      (match a with
       | Float x -> Ok (F32 (toFloat32 x))
       | F32 x -> Ok (F32 x)
       | other -> Err "`toFloat32` expects a float, got ${display other}")
  | "Floor" ->
      (match a with
       | Float x -> Ok (Int (floor x))
       | F32 x -> Ok (Int (floor x))
       | other -> Err "expected a number, got ${display other}")
  | "ToInt" -> toWidth "Int" a
  | "ToBig" -> toWidth "BigInt" a
  | "Display" -> Ok (Str (displayed a))
  | "Show" -> Ok (Str (display a))
  | "ConcatStrings" ->
      (match a with
       | Array xs ->
           Ok (Str (V.foldl (\acc x -> match x with | Str s -> acc ++ s | _ -> acc) "" xs))
       | other -> Err "concatStrings: expected an Array, got ${display other}")
  | "StringByteLength" ->
      (match a with
       | Str s -> Ok (Int (stringByteLength s))
       | other -> Err "stringByteLength: expected a String, got ${display other}")
  | "StringSlice" ->
      (match (a, b, c) with
       | (Str s, Int x, Int y) -> Ok (Str (stringSlice s x y))
       | _ -> Err "stringSlice: expected a String")
  | "StringCompare" ->
      (match (a, b) with
       | (Str x, Str y) -> Ok (Int (stringCompare x y))
       | _ -> Err "stringCompare: expected a String")
  | "StringIndexOf" ->
      (match (a, b, c) with
       | (Str h, Str n, Int from) -> Ok (Int (stringIndexOf h n from))
       | _ -> Err "stringIndexOf: expected a String")
  | "CharCode" ->
      (match a with
       | Char ch -> Ok (Int (C.code ch))
       | other -> Err "charCode: expected a Char, got ${display other}")
  | "CharFromCode" ->
      (match a with
       | Int n ->
           if C.isScalar n then Ok (Char (C.fromCode n))
           else Err "charFromCode: ${show n} is not a Unicode scalar value"
       | other -> Err "charFromCode: expected an Int, got ${display other}")
  | "StringByteAt" ->
      (match (a, b) with
       | (Str s, Int i) ->
           if i < 0 or i >= stringByteLength s then
             Err "stringByteAt: index ${show i} out of bounds (len ${show (stringByteLength s)})"
           else Ok (U8 (stringByteAt s i))
       | _ -> Err "stringByteAt: expected a String and an Int")
  | "StringToBytes" ->
      (match a with
       | Str s -> Ok (Array (V.map U8 (V.fromArray (stringToBytes s))))
       | other -> Err "stringToBytes: expected a String, got ${display other}")
  | "BytesToString" ->
      (match a with
       | Array xs ->
           Ok
             (Str
                (bytesToString
                   (V.toArray (V.map (\x -> match x with | U8 n -> n | _ -> toUInt8 0) xs))))
       | other -> Err "bytesToString: expected an Array, got ${display other}")
  | "StringToChars" ->
      (match a with
       | Str s -> Ok (Array (V.map Char (V.fromArray (stringToChars s))))
       | other -> Err "stringToChars: expected a String, got ${display other}")
  | "CharsToString" ->
      (match a with
       | Array xs ->
           Ok
             (Str
                (V.foldl
                   (\acc x -> match x with | Char ch -> acc ++ C.toString ch | _ -> acc)
                   ""
                   xs))
       | other -> Err "charsToString: expected an Array, got ${display other}")
  | other if S.startsWith "ToWord(" other ->
      toWidth (stringSlice other 7 (stringByteLength other - 1)) a
  | "ArrayLen" ->
      (match a with
       | Array xs -> Ok (Int (V.len xs))
       | other -> Err "expected an Array, got ${display other}")
  | "ArrayGet" ->
      (match (a, b) with
       | (Array xs, Int i) ->
           (match V.get xs i with
            | Just x -> Ok x
            | None -> Err "arrayGet: index ${show i} out of bounds (len ${show (V.len xs)})")
       | _ -> Err "arrayGet: expected an Array")
  | "ArrayGetOr" ->
      (match (b, c) with
       | (Array xs, Int i) -> Ok (V.getOr a xs i)
       | _ -> Err "arrayGetOr: expected an Array")
  | "ArraySet" ->
      (match (a, b) with
       | (Array xs, Int i) ->
           if i >= 0 and i < V.len xs then Ok (Array (V.set xs i c))
           else Err "arraySet: index ${show i} out of bounds (len ${show (V.len xs)})"
       | _ -> Err "arraySet: expected an Array")
  | "ArrayPush" ->
      (match a with
       | Array xs -> Ok (Array (V.pushBack xs b))
       | _ -> Err "arrayPush: expected an Array")
  | "ArrayPop" ->
      (match a with
       | Array xs ->
           if V.isEmpty xs then Err "arrayPop: empty array"
           else Ok (Array (V.take xs (V.len xs - 1)))
       | _ -> Err "arrayPop: expected an Array")
  | "ArrayConcat" ->
      (match (a, b) with
       | (Array x, Array y) -> Ok (Array (V.append x y))
       | _ -> Err "arrayConcat: expected an Array")
  | "ArraySlice" ->
      (match (a, b, c) with
       | (Array xs, Int x, Int y) ->
           let n = V.len xs in
           let from = clamp x 0 n in
           Ok (Array (V.slice xs from (clamp y from n)))
       | _ -> Err "arraySlice: expected an Array")
  | "Hash" -> made Int (hashed a)
  | "PopCount" ->
      (match a with
       | Int x -> Ok (Int (popCount x))
       | I8 x -> Ok (Int (popCount x))
       | I16 x -> Ok (Int (popCount x))
       | I32 x -> Ok (Int (popCount x))
       | U8 x -> Ok (Int (popCount x))
       | U16 x -> Ok (Int (popCount x))
       | U32 x -> Ok (Int (popCount x))
       | U64 x -> Ok (Int (popCount x))
       | other -> Err "`popCount` expects an integer, got ${display other}")
  | "BitWidth" ->
      (match a with
       | Int _ -> Ok (Int 64)
       | I8 _ -> Ok (Int 8)
       | I16 _ -> Ok (Int 16)
       | I32 _ -> Ok (Int 32)
       | U8 _ -> Ok (Int 8)
       | U16 _ -> Ok (Int 16)
       | U32 _ -> Ok (Int 32)
       | U64 _ -> Ok (Int 64)
       | Big _ -> Err "`bitWidth` of a BigInt, which has no fixed width"
       | other -> Err "`bitWidth` expects an integer, got ${display other}")
  | "StNewArray" ->
      (match a with
       | Int n ->
           if n >= 0 then Ok (Mut (newRef (V.map (\_ -> b) (V.range 0 n))))
           else Err "stNewArray: expected a length of zero or more, got ${display a}"
       | other -> Err "stNewArray: expected a length of zero or more, got ${display other}")
  | "StGetArray" ->
      (match (a, b) with
       | (Mut r, Int i) ->
           let cells = getRef r in
           (match V.get cells i with
            | Just x -> Ok x
            | None -> Err "stGetArray: index ${show i} out of bounds (len ${show (V.len cells)})")
       | _ -> Err "stGetArray: expected a mutable array")
  | "StSetArray" ->
      (match (a, b) with
       | (Mut r, Int i) ->
           let cells = getRef r in
           if i >= 0 and i < V.len cells then (let u = setRef r (V.set cells i c) in Ok Unit)
           else Err "stSetArray: index ${show i} out of bounds (len ${show (V.len cells)})"
       | _ -> Err "stSetArray: expected a mutable array")
  | "StArrayLen" ->
      (match a with
       | Mut r -> Ok (Int (V.len (getRef r)))
       | _ -> Err "stArrayLen: expected a mutable array")
  | "StFreeze" ->
      (match a with
       | Mut r -> Ok (Array (getRef r))
       | _ -> Err "stFreeze: expected a mutable array")
  | "StThaw" ->
      (match a with
       | Array xs -> Ok (Mut (newRef xs))
       | other -> Err "stThaw: expected an Array, got ${display other}")
  | "Compact" -> Ok (Compact a)
  | "GetCompact" ->
      (match a with
       | Compact x -> Ok x
       | other -> Err "expected a compact, got ${display other}")
  | "CompactAdd" ->
      (match a with
       | Compact _ -> Ok (Compact b)
       | other -> Err "expected a compact, got ${display other}")
  | "NewRef" -> Ok (Ref (newRef a))
  | "GetRef" ->
      (match a with
       | Ref r -> Ok (getRef r)
       | other -> Err "getRef: expected a Ref, got ${display other}")
  | "SetRef" ->
      (match a with
       | Ref r -> (let u = setRef r b in Ok Unit)
       | other -> Err "setRef: expected a Ref, got ${display other}")
  | other -> Err "MeadowBoot's CEK machine does not have the primitive `${other}` yet"

-- Toward zero, as Rust's `as i64` has it.
fun truncated (x : Float) : Int = if x >= 0.0 then floor x else 0 - floor (0.0 - x)

fun clamp (x : Int) (lo : Int) (hi : Int) : Int = if x < lo then lo else if x > hi then hi else x

-- --- numbers -----------------------------------------------------------------

-- `x op y` on two integers of one type: what `meadow_core::num::int_arith` and
-- `int_bits` do, done by Meadow's own integers of that type.
fun arith (op : String) (x : n) (y : n) =
  match op with
  | "Add" -> Ok (x + y)
  | "Sub" -> Ok (x - y)
  | "Mul" -> Ok (x * y)
  | "Div" -> if y == 0 then Err "division by zero" else Ok (x / y)
  | "Mod" -> if y == 0 then Err "modulo by zero" else Ok (x % y)
  | "Pow" -> Ok (x ^ y)
  | "BitAnd" -> Ok (bitAnd x y)
  | "BitOr" -> Ok (bitOr x y)
  | "BitXor" -> Ok (bitXor x y)
  | "Shl" -> Ok (x << toInt y)
  | "Shr" -> Ok (x >> toInt y)
  | "Ushr" -> Ok (x >>> toInt y)
  | other -> Err "`${other}` is not an operation on integers"

fun compared (op : String) (x : n) (y : n) : Bool =
  match op with
  | "Lt" -> x < y
  | "Gt" -> x > y
  | "Le" -> x <= y
  | _ -> x >= y

fun made (f : n -> Value) (r : Result String n) = match r with | Ok x -> Ok (f x) | Err e -> Err e

-- Two integers of one type -- an `Int` beside a sized one taking its type, as
-- `meadow_core::num`'s `int_pair` has it -- and `op` on them.
fun integral (what : String) (op : String) (a : Value) (b : Value) =
  match (a, b) with
  | (Int x, Int y) -> made Int (arith op x y)
  | (I8 x, I8 y) -> made I8 (arith op x y)
  | (I8 x, Int y) -> made I8 (arith op x (toInt8 y))
  | (Int x, I8 y) -> made I8 (arith op (toInt8 x) y)
  | (I16 x, I16 y) -> made I16 (arith op x y)
  | (I16 x, Int y) -> made I16 (arith op x (toInt16 y))
  | (Int x, I16 y) -> made I16 (arith op (toInt16 x) y)
  | (I32 x, I32 y) -> made I32 (arith op x y)
  | (I32 x, Int y) -> made I32 (arith op x (toInt32 y))
  | (Int x, I32 y) -> made I32 (arith op (toInt32 x) y)
  | (U8 x, U8 y) -> made U8 (arith op x y)
  | (U8 x, Int y) -> made U8 (arith op x (toUInt8 y))
  | (Int x, U8 y) -> made U8 (arith op (toUInt8 x) y)
  | (U16 x, U16 y) -> made U16 (arith op x y)
  | (U16 x, Int y) -> made U16 (arith op x (toUInt16 y))
  | (Int x, U16 y) -> made U16 (arith op (toUInt16 x) y)
  | (U32 x, U32 y) -> made U32 (arith op x y)
  | (U32 x, Int y) -> made U32 (arith op x (toUInt32 y))
  | (Int x, U32 y) -> made U32 (arith op (toUInt32 x) y)
  | (U64 x, U64 y) -> made U64 (arith op x y)
  | (U64 x, Int y) -> made U64 (arith op x (toUInt64 y))
  | (Int x, U64 y) -> made U64 (arith op (toUInt64 x) y)
  | (Big x, Big y) -> made Big (arith op x y)
  | (Big x, Int y) -> made Big (arith op x (toBigInt y))
  | (Int x, Big y) -> made Big (arith op (toBigInt x) y)
  | _ -> Err "`${what}` expects two integers of one type, got ${display a} and ${display b}"

fun ordered (what : String) (op : String) (a : Value) (b : Value) =
  let ok = \x -> Ok (Bool x) in
  match (a, b) with
  | (Int x, Int y) -> ok (compared op x y)
  | (I8 x, I8 y) -> ok (compared op x y)
  | (I8 x, Int y) -> ok (compared op x (toInt8 y))
  | (Int x, I8 y) -> ok (compared op (toInt8 x) y)
  | (I16 x, I16 y) -> ok (compared op x y)
  | (I16 x, Int y) -> ok (compared op x (toInt16 y))
  | (Int x, I16 y) -> ok (compared op (toInt16 x) y)
  | (I32 x, I32 y) -> ok (compared op x y)
  | (I32 x, Int y) -> ok (compared op x (toInt32 y))
  | (Int x, I32 y) -> ok (compared op (toInt32 x) y)
  | (U8 x, U8 y) -> ok (compared op x y)
  | (U8 x, Int y) -> ok (compared op x (toUInt8 y))
  | (Int x, U8 y) -> ok (compared op (toUInt8 x) y)
  | (U16 x, U16 y) -> ok (compared op x y)
  | (U16 x, Int y) -> ok (compared op x (toUInt16 y))
  | (Int x, U16 y) -> ok (compared op (toUInt16 x) y)
  | (U32 x, U32 y) -> ok (compared op x y)
  | (U32 x, Int y) -> ok (compared op x (toUInt32 y))
  | (Int x, U32 y) -> ok (compared op (toUInt32 x) y)
  | (U64 x, U64 y) -> ok (compared op x y)
  | (U64 x, Int y) -> ok (compared op x (toUInt64 y))
  | (Int x, U64 y) -> ok (compared op (toUInt64 x) y)
  | (Big x, Big y) -> ok (compared op x y)
  | (Big x, Int y) -> ok (compared op x (toBigInt y))
  | (Int x, Big y) -> ok (compared op (toBigInt x) y)
  | _ -> Err "`${what}` expects two integers of one type, got ${display a} and ${display b}"

fun negated (a : Value) =
  match a with
  | Int x -> Ok (Int (0 - x))
  | I8 x -> Ok (I8 (0 - x))
  | I16 x -> Ok (I16 (0 - x))
  | I32 x -> Ok (I32 (0 - x))
  | U8 x -> Ok (U8 (0 - x))
  | U16 x -> Ok (U16 (0 - x))
  | U32 x -> Ok (U32 (0 - x))
  | U64 x -> Ok (U64 (0 - x))
  | Big x -> Ok (Big (0 - x))
  | other -> Err "`neg` expects an integer, got ${display other}"

fun inverted (a : Value) =
  match a with
  | Int x -> Ok (Int (bitNot x))
  | I8 x -> Ok (I8 (bitNot x))
  | I16 x -> Ok (I16 (bitNot x))
  | I32 x -> Ok (I32 (bitNot x))
  | U8 x -> Ok (U8 (bitNot x))
  | U16 x -> Ok (U16 (bitNot x))
  | U32 x -> Ok (U32 (bitNot x))
  | U64 x -> Ok (U64 (bitNot x))
  | Big x -> Ok (Big (bitNot x))
  | other -> Err "`bitNot` expects an integer, got ${display other}"

-- An integer as a `BigInt`, exactly: what two integers of any types are
-- compared by. `None` for anything that is not one.
fun exactly (a : Value) : Maybe BigInt =
  match a with
  | Int x -> Just (toBigInt x)
  | I8 x -> Just (toBigInt x)
  | I16 x -> Just (toBigInt x)
  | I32 x -> Just (toBigInt x)
  | U8 x -> Just (toBigInt x)
  | U16 x -> Just (toBigInt x)
  | U32 x -> Just (toBigInt x)
  | U64 x -> Just (toBigInt x)
  | Big x -> Just x
  | _ -> None

-- `a` as the integer type `w` names, wrapped to it: `toUInt8` and the rest.
fun toWidth (w : String) (a : Value) =
  match exactly a with
  | Just x -> Ok (sized w (Big x))
  | None -> Err "`to${w}` expects an integer, got ${display a}"

-- The integer `a` -- a `Int` or a `Big` -- as the type `w` names.
fun sized (w : String) (a : Value) : Value =
  let big =
    (match a with
     | Big x -> x
     | Int x -> toBigInt x
     | _ -> toBigInt 0)
  in match w with
     | "I8" -> I8 (toInt8 big)
     | "I16" -> I16 (toInt16 big)
     | "I32" -> I32 (toInt32 big)
     | "U8" -> U8 (toUInt8 big)
     | "U16" -> U16 (toUInt16 big)
     | "U32" -> U32 (toUInt32 big)
     | "U64" -> U64 (toUInt64 big)
     | "BigInt" -> Big big
     | _ -> Int (toInt big)

fun asFloat (a : Value) =
  match a with
  | Float x -> Ok (Float x)
  | F32 x -> Ok (Float (toFloat64 x))
  | Int x -> Ok (Float (toFloat x))
  | Big x -> Ok (Float (toFloat x))
  | other ->
      (match exactly other with
       | Just x -> Ok (Float (toFloat x))
       | None -> Err "`toFloat` expects a number, got ${display other}")

-- `x op y` on two floats of one type.
fun floatArith (op : String) (x : f) (y : f) : f =
  if op == "AddF" then x + y
  else if op == "SubF" then x - y
  else if op == "MulF" then x * y
  else x / y

fun floatCompare (op : String) (x : f) (y : f) : Bool =
  if op == "LtF" then x < y
  else if op == "GtF" then x > y
  else if op == "LeF" then x <= y
  else x >= y

fun fractional (what : String) (op : String) (a : Value) (b : Value) =
  let f = \x y -> floatArith op x y in
  let g = \x y -> floatArith op x y in
  match (a, b) with
  | (Float x, Float y) -> Ok (Float (f x y))
  | (F32 x, F32 y) -> Ok (F32 (g x y))
  | (F32 x, Float y) -> Ok (F32 (g x (toFloat32 y)))
  | (Float x, F32 y) -> Ok (F32 (g (toFloat32 x) y))
  | _ -> Err "`${what}` expects two floats of one type, got ${display a} and ${display b}"

fun fractionalOrder (what : String) (op : String) (a : Value) (b : Value) =
  let f = \x y -> floatCompare op x y in
  let g = \x y -> floatCompare op x y in
  match (a, b) with
  | (Float x, Float y) -> Ok (Bool (f x y))
  | (F32 x, F32 y) -> Ok (Bool (g x y))
  | (F32 x, Float y) -> Ok (Bool (g x (toFloat32 y)))
  | (Float x, F32 y) -> Ok (Bool (g (toFloat32 x) y))
  | _ -> Err "`${what}` expects two floats of one type, got ${display a} and ${display b}"

-- Structural, as `meadow_eval`'s `value_eq`: a cell by which one it is.
fun equal (a : Value) (b : Value) : Bool =
  match (exactly a, exactly b) with
  | (Just x, Just y) -> x == y
  | _ -> sameShape a b

fun sameShape (a : Value) (b : Value) : Bool =
  match (a, b) with
  | (Float x, Float y) -> x == y
  | (F32 x, F32 y) -> x == y
  | (F32 x, Float y) -> x == toFloat32 y
  | (Float x, F32 y) -> toFloat32 x == y
  | (Bool x, Bool y) -> x == y
  | (Str x, Str y) -> x == y
  | (Char x, Char y) -> x == y
  | (Unit, Unit) -> True
  | (Tuple xs, Tuple ys) -> allEqual xs ys
  | (Array xs, Array ys) -> allEqual xs ys
  | (Ctor n xs, Ctor m ys) -> n == m and allEqual xs ys
  | (Record xs, Record ys) ->
      V.len xs == V.len ys
        and V.all
          (\f ->
            match V.find (\g -> fst g == fst f) ys with
            | Just g -> equal (snd f) (snd g)
            | None -> False)
          xs
  | (Ref x, Ref y) -> x == y
  | (Mut x, Mut y) -> x == y
  | (Compact x, Compact y) -> equal x y
  | _ -> False

fun allEqual (xs : [Value]) (ys : [Value]) : Bool =
  V.len xs == V.len ys
    and V.all (\i -> equal (V.getOr Unit xs i) (V.getOr Unit ys i)) (V.range 0 (V.len xs))

-- --- hashing -----------------------------------------------------------------
--
-- `meadow_core::hash`, word for word: a value's head, then its parts left to
-- right, each mixed into one 64-bit state -- held in an `Int`, whose
-- arithmetic wraps as the Rust `u64`'s does, with `>>>` the unsigned shift.

-- `v`'s hash, or why it has none.
fun hashed (v : Value) =
  match hashInto v 7640891576956012808 with
  | Ok h -> Ok (finished h)
  | Err e -> Err e

fun mix (h : Int) (w : Int) : Int = bitXor (bitOr (h << 5) (h >>> 59)) w * 5871781006564002453

fun finished (h : Int) : Int =
  let a = bitXor h (h >>> 30) * (0 - 4658895280553007687) in
  let b = bitXor a (a >>> 27) * (0 - 7723592293110705685) in
  bitXor b (b >>> 31)

fun tagged (h : Int) (t : Int) : Int = mix h t

fun intInto (h : Int) (n : Int) : Int = mix (tagged h 1) n

-- The bytes of `s`, their count first, eight to a word, little-endian.
fun bytesInto (h : Int) (s : String) : Int =
  let n = stringByteLength s in
  V.foldl (\acc i -> mix acc (wordAt s (i * 8))) (mix h n) (V.range 0 ((n + 7) / 8))

fun wordAt (s : String) (at : Int) : Int =
  V.foldl
    (\acc k ->
      if at + k < stringByteLength s then bitOr acc (toInt (stringByteAt s (at + k)) << (8 * k))
      else acc)
    0
    (V.range 0 8)

fun strInto (h : Int) (s : String) : Int = bytesInto (tagged h 6) s

fun dataInto (h : Int) (name : String) (arity : Int) : Int =
  if arity == 0 and (name == "True" or name == "Bool.True") then mix (tagged h 4) 1
  else if arity == 0 and (name == "False" or name == "Bool.False") then mix (tagged h 4) 0
  else mix (bytesInto (tagged h 8) name) arity

-- An integer of any type the same, as long as it fits in an `Int`.
fun integerInto (h : Int) (x : BigInt) =
  if x >= toBigInt (0 - 9223372036854775807 - 1) and x <= toBigInt 9223372036854775807 then
    Ok (intInto h (toInt x))
  else Err "MeadowBoot's CEK machine cannot hash an integer past an Int yet"

fun hashInto (v : Value) (h : Int) =
  match v with
  | Float x -> Ok (mix (tagged h 3) (floatBits x))
  | F32 x -> Ok (mix (tagged h 3) (floatBits (toFloat64 x)))
  | Bool b -> Ok (mix (tagged h 4) (if b then 1 else 0))
  | Char c -> Ok (mix (tagged h 5) (C.code c))
  | Str s -> Ok (strInto h s)
  | Unit -> Ok (tagged h 7)
  | Tuple xs -> hashAll xs (dataInto h "#tuple" (V.len xs))
  | Ctor name xs -> hashAll xs (dataInto h name (V.len xs))
  | Array xs -> hashAll xs (mix (tagged h 10) (V.len xs))
  | Record fs ->
      V.foldl
        (\acc f ->
          match acc with
          | Ok g -> hashInto (snd f) (strInto g (fst f))
          | Err e -> Err e)
        (Ok (mix (tagged h 11) (V.len fs)))
        (sortOn fst fs)
  | Compact x -> hashInto x (tagged h 12)
  | Ref _ -> Err "cannot hash a Ref: it has no structure to compare by"
  | Mut _ -> Err "cannot hash a mutable array: it has no structure to compare by"
  | Closure _ _ _ -> Err "cannot hash a function: it has no structure to compare by"
  | Cont _ -> Err "cannot hash a function: it has no structure to compare by"
  | Lazy _ -> Err "hash: a top-level value that was never evaluated"
  | other ->
      (match exactly other with
       | Just x -> integerInto h x
       | None -> Err "cannot hash ${display other}")

fun hashAll (xs : [Value]) (h : Int) =
  V.foldl (\acc x -> match acc with | Ok g -> hashInto x g | Err e -> Err e) (Ok h) xs

-- The bits of `x` as a hash takes them: both zeros alike, and every NaN the
-- one `f64::NAN` is. Worked out, since nothing gives a float's bits: `x` is
-- scaled by twos, which is exact, until its mantissa is a whole number.
fun floatBits (x : Float) : Int =
  if x == 0.0 then 0
  else if x != x then 9221120237041090560
  else
    let negative = x < 0.0 in
    let a = if negative then 0.0 - x else x in
    let magnitude = if a == 1.0 / 0.0 then 9218868437227405312 else finiteBits a in
    if negative then bitOr magnitude (0 - 9223372036854775807 - 1) else magnitude

fun finiteBits (a : Float) : Int =
  match normalised a 0 with
  | (m, e) ->
      if m >= 4503599627370496.0 then bitOr ((e + 1075) << 52) (floor m - 4503599627370496)
      else floor m

-- `a` as `m × 2^e` with `m` in [2^52, 2^53) -- or, below the smallest normal
-- float, `e` at -1074 and `m` smaller.
fun normalised (a : Float) (e : Int) : (Float, Int) =
  if a >= 9007199254740992.0 then normalised (a * 0.5) (e + 1)
  else if a < 4503599627370496.0 and e > 0 - 1074 then normalised (a * 2.0) (e - 1)
  else (a, e)

-- --- display -----------------------------------------------------------------

-- How `print` shows a value: a string as its text, anything else as `display`.
fun displayed (v : Value) = match v with | Str s -> s | other -> display other

-- A value as `meadow_eval`'s `Display` writes it.
@pub fun display (v : Value) : String ! { Mut | e } =
  match v with
  | Int n -> show n
  | I8 n -> show n
  | I16 n -> show n
  | I32 n -> show n
  | U8 n -> show n
  | U16 n -> show n
  | U32 n -> show n
  | U64 n -> show n
  | Big n -> show n
  | Float x -> show x
  | F32 x -> show x
  | Bool b -> if b then "True" else "False"
  | Str s -> show s
  | Char c -> show c
  | Unit -> "()"
  | Tuple xs -> "(" ++ joined ", " xs ++ ")"
  | Array xs -> "#[" ++ joined ", " xs ++ "]"
  | Record fs ->
      "{ " ++ S.join ", " (V.map (\f -> "${fst f} = ${display (snd f)}") (sortOn fst fs)) ++ " }"
  | Ctor name xs ->
      if name == "List.Nil" or name == "List.Cons" then
        (match listItems v [] with
         | Just items -> "[" ++ joined "; " items ++ "]"
         | None -> "${bare name}(..)")
      else if V.isEmpty xs then bare name
      else "${bare name}(" ++ joined ", " xs ++ ")"
  | Closure _ _ _ -> "<closure>"
  | Cont _ -> "<continuation>"
  | Ref r -> "ref ${display (getRef r)}"
  | Mut r -> "mut #[" ++ joined ", " (getRef r) ++ "]"
  | Compact x -> "compact ${display x}"
  | Lazy _ -> "<unevaluated>"

fun joined (sep : String) (xs : [Value]) = S.join sep (V.map display xs)

-- A list's elements, when it is one.
fun listItems (v : Value) (sofar : [Value]) : Maybe [Value] =
  match v with
  | Ctor "List.Nil" xs -> if V.isEmpty xs then Just sofar else None
  | Ctor "List.Cons" xs ->
      (match (V.get xs 0, V.get xs 1) with
       | (Just h, Just t) -> listItems t (V.pushBack sofar h)
       | _ -> None)
  | _ -> None

-- A constructor as a reader wants it: `Maybe.Just` is `Just`.
fun bare (name : String) : String = afterLast "." name

-- What follows the last `sep` in `s`, or all of `s`.
-- A constructor's name as a person writes it: `Type.Ctor`, without the path
-- in front of its type.
fun ctorSpelling (name : String) : String =
  let at = lastIndex "." name 0 (0 - 1) in
  if at < 0 then name
  else
    stringSlice name (lastIndex "." (stringSlice name 0 at) 0 (0 - 1) + 1) (stringByteLength name)

fun afterLast (sep : String) (s : String) : String =
  match lastIndex sep s 0 (0 - 1) with
  | i -> if i < 0 then s else stringSlice s (i + stringByteLength sep) (stringByteLength s)

fun lastIndex (sep : String) (s : String) (from : Int) (found : Int) : Int =
  match S.indexOfFrom sep s from with
  | Just i -> lastIndex sep s (i + 1) i
  | None -> found
