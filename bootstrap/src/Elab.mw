-- Elab: a unit's typed modules made core -- `meadow_core`'s lowering, with
-- each term and pattern keeping its type; `Core.erase` takes those off for
-- the CEK machine.
--
-- Two passes. `bare` takes off what says nothing at run time: a pattern's
-- annotation, and a function's written result type. What is left reaches no
-- written type, so the second need say nothing of them. `emit` is the
-- lowering: each expression the term it is, each pattern the pattern, and a
-- binding its pattern and its value for whoever binds it to put together --
-- a `let`, or a module's definitions.
--
-- What it does not do yet, and `meadow_core` does: the dictionaries a trait's
-- methods are found in, the copies of a definition a number's type chooses
-- between, a view in a pattern, an update of a record type's value, and
-- which of several constructors of one name was meant.

use Lingua (lang!, pass!)
use Std.Macro (Reflect)
use Lingua.Lang (Meta, spanMeta)
use MeadowBoot.Rename
use MeadowBoot.Rename (Hir!)
use MeadowBoot.Infer
use MeadowBoot.Infer (Typed!)
use MeadowBoot.Infer (Inferred)
use MeadowBoot.Solve (
  Evidence, TraitShape, ImplDef, Entry, Super, Generalized, TypeEnv, VariantSig, firstDictOf
)
use MeadowBoot.Traits (methodKey)
use MeadowBoot.Core
use MeadowBoot.Core (Core!)
use MeadowBoot.Dictionaries (Summary)
use MeadowBoot.Types
use MeadowBoot.Types.Type.*
use MeadowBoot.Scopes (Renamed, Item, Declared, Export)
use MeadowBoot.Prims (primOps)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*

-- --- the languages -----------------------------------------------------------

-- A type of inference's, as `Typed`'s nodes name it.
type Ty = Type

-- The dictionaries a mention is applied to, as `Typed` holds them.
type Evs = [Evidence]

-- `Typed` with nothing in an expression that is a written type.
@pub(pkg) lang! {
  pub Bare extends Typed
  Pat - Ann
  Bind - Fun
  Bind + Fun { id : Int, params : [Pat], body : Expr }
}

pass! {
  bare : Typed -> Bare
    | Pat.Ann { pat } -> pat
    | Bind.Fun { id, params, body } -> Bind.Fun { id, params, body }
}

-- --- what lowering knows -----------------------------------------------------

-- What `emit` carries: each primitive's operation in core and how many
-- arguments it takes, by its binder; each effect operation's effect and
-- name; each constructor's name in core and how many arguments it takes;
-- the names of its fields, for one that has them; and the next binder
-- nothing has, for a variable lowering makes. And what a `where` comes to:
-- the traits each binding asks dictionaries of, what each `impl`'s
-- dictionary is built with, each `impl` by its dictionary's binder, each
-- generalized binding with its scheme and the variables it is generic in,
-- every trait's shape, method types and defaults, each binder's name, the
-- dictionaries the definition being lowered was given -- each with its trait
-- -- and the next `impl`'s dictionary's binder.
record Low s = {
  prims : HashMap Int (String, Int),
  ops : HashMap Int (String, String),
  ctors : HashMap Int (String, Int),
  fields : HashMap Int [String],
  next : StRef s Int,
  wheres : HashMap Int [String],
  evidence : HashMap String [Evidence],
  impls : HashMap Int ImplDef,
  generics : HashMap Int Generalized,
  extTypes : HashMap Int Int,
  -- How many number types a definition of another unit is generic in.
  extNums : HashMap Int Int,
  shapes : HashMap String TraitShape,
  methods : HashMap String Scheme,
  defaults : HashMap String Int,
  names : [String],
  dicts : StRef s [(Int, String)],
  nextDict : StRef s Int,
  -- The views the pattern being lowered holds: the name each stands as, its
  -- type, the function it is seen through, and the pattern for what that
  -- answers.
  views : StRef s [(Int, Type, CoreTerm, CorePat)]
}

fun fresh (cx : Low s) : Int ! { St s | e } =
  let n = stGetRef cx.next in
  let u = stSetRef cx.next (n + 1) in
  n

-- --- the lowering ------------------------------------------------------------

pass! {
  emit : Bare -> Core with cx from Bind, Expr
    | Name { text } -> text
    | Ref { id } -> id
    | MacCall.MacCall { path } -> ()
    | Lit.Int { text } -> ("int", text)
    | Lit.Float { text } -> ("float", text)
    | Lit.String { text } -> ("string", text)
    | Lit.Char { text } -> ("char", text)
    | Expr.Unit { typ } -> newCoreTermConst out here (newCoreLitLUnit out here) typ
    | Expr.Hole { typ } -> newCoreTermIll out here typ
    | Expr.MacCall { call, typ } -> newCoreTermIll out here typ
    | Expr.Lit { lit, typ } -> newCoreTermConst out here (literal out here lit typ) typ
    | Expr.Var { ref, ev, inst, typ } -> mention out cx here ref ev inst typ
    | Lam { params, body } -> lambdas out cx here params body
    | App { raw func, args, typ } -> applied src out cx here func args typ
    | Let { binds, body } -> V.foldr (\b acc -> bound out cx here b acc) body binds
    | If { cond, yes, no, typ } -> newCoreTermIf out here cond yes no typ
    | Match { scrutinee, arms, typ } -> newCoreTermCase out here scrutinee arms typ
    | Arm { raw pat, raw guard, raw body } -> arm src out cx here pat guard body
    | Expr.Tuple { items, typ } -> newCoreTermTuple out here items typ
    | Expr.Array { items, typ } -> newCoreTermArray out here items typ
    | Expr.List { items, typ } ->
        V.foldr
          (\x acc -> newCoreTermCtor out here "List.Cons" [x, acc] typ)
          (newCoreTermCtor out here "List.Nil" [] typ)
          items
    | Expr.Cons { ref, raw args, typ } ->
        constructed out cx here ref (consArgs src out cx ref args) typ
    | Expr.Record { fields, base, typ } ->
        (match base with
         | None ->
             newCoreTermRecord
               out
               here
               (V.map (\f -> newCoreField out here (fst f) (snd f)) fields)
               typ
         | Just b -> V.foldl (\t f -> newCoreTermExtend out here t (fst f) (snd f) typ) b fields)
    | ExprField { name, value } -> (name, value)
    | Update { base, fields, typ } ->
        V.foldl (\t f -> newCoreTermExtend out here t (fst f) (snd f) typ) base fields
    | Proj { target, label, typ } -> newCoreTermSel out here target label typ
    | Handle { body, arms, ret, typ } ->
        newCoreTermHandle out here body arms (M.map fst ret) (M.map snd ret) typ
    | HArm { op, opRef, param, resume, body } ->
        (let binder = binderOf out cx here param body in
         let named = M.unwrapOr ("", op) (H.lookup opRef cx.ops) in
         newCoreClause
           out
           here
           (fst named)
           (snd named)
           (fst binder)
           (tyCorePat param)
           resume
           (snd binder))
    | Ret { pat, body } -> binderOf out cx here pat body
    | Pat.Wild { typ } -> newCorePatPWild out here typ
    | Pat.Unit { typ } -> newCorePatPLit out here (newCoreLitLUnit out here) typ
    | Pat.MacCall { call, typ } -> newCorePatPWild out here typ
    | Pat.Lit { lit, typ } -> newCorePatPLit out here (literal out here lit typ) typ
    | Pat.Var { id, typ } -> newCorePatPVar out here id typ
    | Pat.As { id, pat, typ } -> newCorePatPAs out here id pat typ
    | Pat.Cons { ref, raw args, typ } ->
        constructedPat out cx here ref (consPats src out cx here ref args) typ
    | Pat.Tuple { items, typ } -> newCorePatPTuple out here items typ
    | Pat.Array { items, typ } -> newCorePatPArray out here items typ
    | Pat.Vector { items, typ } -> newCorePatPWild out here typ
    | Pat.List { items, typ } ->
        V.foldr
          (\x acc -> newCorePatPCtor out here "List.Cons" [x, acc] typ)
          (newCorePatPCtor out here "List.Nil" [] typ)
          items
    | Pat.Record { fields, typ } -> newCorePatPRecord out here fields typ
    | PatField { name, pat } -> newCorePField out here name pat
    -- A view is a name here, and what it is seen through waits for the arm
    -- (`arm`).
    | Pat.View { fn, pat, typ } ->
        (let x = fresh cx in
         let u = stSetRef cx.views (V.pushBack (stGetRef cx.views) (x, typ, fn, pat)) in
         newCorePatPVar out here x typ)
    | Bind.Pat { pat, value } -> (pat, value, False)
    | Bind.Fun { id, params, body } ->
        (let f = lambdas out cx here params body in
         (newCorePatPVar out here id (tyCoreTerm f), f, True))
}

-- One arm of a `match`. A view in its pattern, `(f -> q)`, is a name there:
-- the arm holds only if `f` of what the name is matches `q`, which its guard
-- asks first, and its body is under that match, for what `q` binds.
fun arm src out (cx : Low s) (m : Meta) pat guard body =
  let u = stSetRef cx.views [] in
  let p = emitPat src out cx pat in
  let views = stGetRef cx.views in
  let v = stSetRef cx.views [] in
  let g = M.map (\x -> emitExpr src out cx x) guard in
  let b = emitExpr src out cx body in
  if V.isEmpty views then newCoreArm out m p g b
  else
    (let truth = \value -> newCoreTermConst out m (newCoreLitLBool out m value) (boolT ()) in
     let seen =
       \view ->
         match view with
         | (x, t, f, q) -> newCoreTermApp out m f (newCoreTermVar out m x t) (tyCorePat out q)
     in
     let holds =
       V.foldr
         (\view rest ->
           match view with
           | (_, _, _, q) ->
               newCoreTermCase
                 out
                 m
                 (seen view)
                 [
                   newCoreArm out m q None rest,
                   newCoreArm out m (newCorePatPWild out m (tyCorePat out q)) None (truth False)
                 ]
                 (boolT ()))
         (M.unwrapOr (truth True) g)
         views
     in
     let under =
       V.foldr
         (\view rest ->
           match view with
           | (_, _, _, q) ->
               newCoreTermCase out m (seen view) [newCoreArm out m q None rest] (tyCoreTerm out b))
         b
         views
     in newCoreArm out m p (Just holds) under)

-- The type of a function from `param` to `result`.
fun arrow (param : Type) (result : Type) : Type = Fun [param] result RowEmpty

-- What a function of type `t` takes first, and what it is once it has it.
fun applying (t : Type) : (Type, Type) =
  match t with
  | Fun params result eff ->
      if V.len params <= 1 then (V.getOr Error params 0, result)
      else (V.getOr Error params 0, Fun (V.drop params 1) result eff)
  | _ -> (Error, Error)

-- A literal as its type has it: a whole number a word of its width, a big
-- one, or an `Int`; a fraction a `Float32` or a `Float`.
fun literal out (m : Meta) (lit : (String, String)) (t : Type) =
  let text = snd lit in
  if fst lit == "int" then
    (let n = M.unwrapOr 0 (S.toInt text) in
     match t with
     | Con "BigInt" [] -> newCoreLitLBig out m n
     | Con name [] ->
         (match widthOf name with
          | Just w -> newCoreLitLWord out m w n
          | None -> newCoreLitLInt out m n)
     | _ -> newCoreLitLInt out m n)
  else if fst lit == "float" then
    (let x = fraction text in
     match t with
     | Con "Float32" [] -> newCoreLitLF32 out m x
     | _ -> newCoreLitLF64 out m x)
  else if fst lit == "char" then newCoreLitLChar out m (M.unwrapOr 0 (S.toInt text))
  else newCoreLitLStr out m text

-- The `Float` a literal's text writes: its digits as a whole number, over
-- the power of ten its point says -- one division, which rounds once, so
-- what comes of it is the nearest `Float` while the digits are few enough
-- to be one exactly.
fun fraction (text : String) : Float =
  let parts = S.split "." text in
  if V.len parts == 2 then
    (let part = V.getOr "" parts 1 in
     toFloat (M.unwrapOr 0 (S.toInt (V.getOr "" parts 0 ++ part))) /. tenTo (stringByteLength part))
  else toFloat (M.unwrapOr 0 (S.toInt text))

fun tenTo (k : Int) : Float = if k <= 0 then 1.0 else 10.0 *. tenTo (k - 1)

-- The width a sized integer type's name says, as core writes it.
fun widthOf (name : String) : Maybe String =
  match name with
  | "Int8" -> Just "I8"
  | "Int16" -> Just "I16"
  | "Int32" -> Just "I32"
  | "UInt8" -> Just "U8"
  | "UInt16" -> Just "U16"
  | "UInt32" -> Just "U32"
  | "UInt64" -> Just "U64"
  | _ -> None

-- A name mentioned at type `t`: a primitive a function of as many arguments
-- as it takes, an effect's operation a function that performs it, and
-- anything else itself, given the dictionaries its `where` asks for.
fun mention out (cx : Low s) (m : Meta) (id : Int) (ev : Evs) (inst : [Type]) (t : Type) =
  match H.lookup id cx.prims with
  | Just (op, arity) ->
      if op == "RunSt" then
        (let f = fresh cx in
         match applying t with
         | (fty, result) ->
             newCoreTermLam
               out
               m
               f
               fty
               (newCoreTermApp out m (newCoreTermVar out m f fty) (unit out m) result)
               t)
      else etaPrim out cx m op arity [] t
  | None ->
      (match H.lookup id cx.ops with
       | Just (eff, op) ->
           (let x = fresh cx in
            match applying t with
            | (arg, result) ->
                newCoreTermLam
                  out
                  m
                  x
                  arg
                  (newCoreTermPerform out m eff op (newCoreTermVar out m x arg) result)
                  t)
       | None -> withDicts out cx m id t inst ev)

-- --- dictionaries --------------------------------------------------------------
--
-- A trait is a type of one constructor, its dictionary: a field for each
-- trait it requires and one for each method. A method is the function that
-- reads its field; an `impl` is a definition of a dictionary, a function of
-- the dictionaries its own `where` asks for; and a function with a `where`
-- takes a dictionary for each trait in it, before anything else.

-- The type of trait `tr`'s dictionary.
fun dictT (tr : String) : Type = Con tr []

-- Its one constructor, in core.
fun dictCtor (tr : String) : String = "${tr}.Dict"

-- The dictionary `e` says answers a wanted trait, and the trait it is of.
fun witness out (cx : Low s) (m : Meta) (e : Evidence) =
  match e with
  | Evidence.Given at ->
      (match V.get (stGetRef cx.dicts) at with
       | Just (d, tr) -> (newCoreTermVar out m d (dictT tr), tr)
       | None -> (newCoreTermIll out m Error, ""))
  | Evidence.Super inner label ->
      (let w = witness out cx m inner in
       let tr = S.drop label (stringByteLength "#super.") in
       (newCoreTermSel out m (fst w) label (dictT tr), tr))
  | Evidence.Impl dict tys args ->
      (let tr = implTrait cx dict in (withDicts out cx m dict (dictT tr) tys args, tr))
  | Evidence.Missing -> (newCoreTermIll out m Error, "")

-- Binder `id`, of type `t` once it has its dictionaries, at types `tys`
-- and given them.
fun withDicts out (cx : Low s) (m : Meta) (id : Int) (t : Type) (tys : [Type]) (evs : [Evidence]) =
  let ws = V.map (\e -> witness out cx m e) evs in
  let whole = V.foldr (\w acc -> arrow (dictT (snd w)) acc) t ws in
  applications out m (instance out cx m id whole tys) (V.map fst ws)

-- --- types -------------------------------------------------------------------
--
-- How a value of a variable's type is represented is the type's to say, so
-- a binding generic in its type is a function of its types -- `TyLam`, over
-- the variables its types are written with -- and a mention of one says the
-- types it is at, `TyApp`. Only a variable over types counts: a row or an
-- effect is how nothing is represented.

-- Those of `xs`, one for each of `sc`'s quantifiers, that are for variables
-- over types.
fun plainOf (sc : Scheme) (xs : [a]) (other : a) : [a] =
  V.concatMap
    (\k -> if V.getOr VarKind.Plain sc.quant k == VarKind.Plain then [V.getOr other xs k] else [])
    (V.range 0 (V.len sc.quant))

-- The variables binder `id`'s types are written with, which it is generic
-- in.
fun tyvarsOf (cx : Low s) (id : Int) : [Int] =
  match H.lookup id cx.generics with
  | Just (g : Generalized) -> plainOf g.scheme g.vars 0
  | None -> []

-- How many types binder `id` is generic in: an `impl`'s dictionary in its
-- `impl`'s.
fun typesOf (cx : Low s) (id : Int) : Int =
  match H.lookup id cx.extTypes with
  | Just n -> n
  | None ->
      (match H.lookup id cx.impls with
       | Just (d : ImplDef) -> plains d.scheme
       | None -> V.len (tyvarsOf cx id))

-- How many of a scheme's quantifiers are variables over types.
fun plains (sc : Scheme) : Int = V.len (plainOf sc sc.quant VarKind.Plain)

-- Those of `xs`, one for each of `sc`'s quantifiers, that are for variables
-- over number types.
fun numberOf (sc : Scheme) (xs : [a]) (other : a) : [a] =
  V.concatMap
    (\k ->
      (let kind = V.getOr VarKind.Plain sc.quant k in
       if kind == VarKind.Num or kind == VarKind.Frac then [V.getOr other xs k] else []))
    (V.range 0 (V.len sc.quant))

-- The variables over number types binder `id` is generic in.
fun numvarsOf (cx : Low s) (id : Int) : [Int] =
  match H.lookup id cx.generics with
  | Just (g : Generalized) -> numberOf g.scheme g.vars 0
  | None -> []

-- How many number types binder `id` is generic in.
fun numbersOf (cx : Low s) (id : Int) : Int =
  match H.lookup id cx.extNums with
  | Just n -> n
  | None -> V.len (numvarsOf cx id)

-- A mention of binder `id`, of type `t`, at types `tys`. One of a binding
-- from inside it is at the binding's own variables, which nothing wrote.
-- `tys` are the types and then, where inference said, the number types:
-- a mention it did not say them of is at no number type that is known.
fun instance out (cx : Low s) (m : Meta) (id : Int) (t : Type) (tys : [Type]) =
  let n = typesOf cx id in
  let k = numbersOf cx id in
  let head = newCoreTermVar out m id t in
  if n == 0 and k == 0 then head
  else if V.len tys == n + k then newCoreTermTyApp out m head (V.take tys n) (V.drop tys n) t
  else
    -- Inference said nothing of the number types: a mention from inside the
    -- binding, which is at the binding's own, so that a copy of it for a
    -- number type calls that copy and not the binding as it was written.
    (let own = V.map (\v -> Var v) (tyvarsOf cx id) in
     let nums = V.map (\v -> Var v) (numvarsOf cx id) in
     let plain = if V.len tys == n then tys else V.map (\i -> V.getOr Error own i) (V.range 0 n) in
     newCoreTermTyApp out m head plain nums t)

-- `value`, generic in `vars`, and in `nums` over number types.
fun typeAbs out (vars : [Int]) (nums : [Int]) value =
  if V.isEmpty vars and V.isEmpty nums then value
  else newCoreTermTyLam out nowhere vars nums value (tyCoreTerm out value)

-- What each of `pattern`'s quantifiers is where it is `actual`, after `h`.
fun matchTy (pattern : Type) (actual : Type) (h : HashMap Int Type) : HashMap Int Type =
  let all = \ps ts acc -> V.foldl (\x pt -> matchTy (fst pt) (snd pt) x) acc (V.zip ps ts) in
  match (pattern, actual) with
  | (Bound k, _) -> if M.isSome (H.lookup k h) then h else H.insert k actual h
  | (Con _ ps, Con _ ts) -> all ps ts h
  | (Fun ps pr pe, Fun ts tr te) ->
      if V.len ps == V.len ts then matchTy pe te (matchTy pr tr (all ps ts h)) else h
  | (Tuple ps, Tuple ts) -> all ps ts h
  | (Record p, Record t) -> matchTy p t h
  | (RowExtend pl pf pr, RowExtend tl tf tr) ->
      if pl == tl then matchTy pr tr (matchTy pf tf h) else h
  | _ -> h

-- The types binder `id` is at where its type is `expected`.
fun instOf (cx : Low s) (id : Int) (expected : Type) : [Type] =
  match H.lookup id cx.generics with
  | Just (g : Generalized) ->
      (let h = matchTy g.scheme.ty expected H.empty in
       plainOf
         g.scheme
         (V.map (\k -> M.unwrapOr Error (H.lookup k h)) (V.range 0 (V.len g.scheme.quant)))
         Error)
  | None -> []

-- The trait an `impl` is of, by its dictionary's binder.
fun implTrait (cx : Low s) (dict : Int) : String =
  match H.lookup dict cx.impls with
  | Just (d : ImplDef) -> (match d.scheme.ty with | Con tr _ -> tr | _ -> "")
  | None -> ""

-- `value` as a function of dictionaries `ds`.
fun abstracted out ds value =
  V.foldr
    (\d acc ->
      newCoreTermLam
        out
        nowhere
        (fst d)
        (dictT (snd d))
        acc
        (arrow (dictT (snd d)) (tyCoreTerm out acc)))
    value
    ds

-- The binder a top-level binding binds, where it binds one name.
fun boundId (a : BareArena) b : Maybe Int =
  if kindBareBind a b == BareBindKind.Fun then Just (bareBindFunId a b)
  else
    (let p = bareBindPatPat a b in
     if kindBarePat a p == BarePatKind.Var then Just (barePatVarId a p) else None)

-- A top-level binding: lowered under the dictionaries its `where` asks for,
-- and a function of them.
fun topBind (a : BareArena) out (cx : Low s) b =
  let trs = M.unwrapOr [] (M.andThen (\id -> H.lookup id cx.wheres) (boundId a b)) in
  let ds = V.map (\tr -> (fresh cx, tr)) trs in
  let u = stSetRef cx.dicts ds in
  match emitBind a out cx b with
  | (pat, value, isFun) ->
      (let v = stSetRef cx.dicts [] in
       let vars = M.unwrapOr [] (M.map (\id -> tyvarsOf cx id) (boundId a b)) in
       let nums = M.unwrapOr [] (M.map (\id -> numvarsOf cx id) (boundId a b)) in
       (pat, typeAbs out vars nums (abstracted out ds value), isFun))

-- A method's type, over its trait's parameters.
fun methodType (cx : Low s) (tr : String) (name : String) : Type =
  M.unwrapOr Error (M.map (\(sc : Scheme) -> sc.ty) (H.lookup (methodKey tr name) cx.methods))

-- A trait's canonical name, by the name its module declares it under.
fun traitCanon (items : [Item]) (name : String) : String =
  M.unwrapOr
    name
    (M.map
       (\(it : Item) -> it.canon)
       (V.find (\(it : Item) -> it.kind == "t" and it.name == name) items))

-- A `trait`'s definitions: each method the function that reads it out of a
-- dictionary, and each default a function of the dictionary it is in.
fun traitDefs out (cx : Low s) (items : [Item]) (a : BareArena) d =
  let tname = bareNameText a (bareDeclTraitName a d) in
  let canon = traitCanon items tname in
  let self = dictT canon in
  let selectors =
    V.concatMap
      (\mn ->
        match V.find
          (\(it : Item) -> it.kind == "v" and it.owner == tname and it.name == mn)
          items with
        | Just (it : Item) ->
            (let dv = fresh cx in
             let t = methodType cx canon mn in
             [newCoreDef
                out
                nowhere
                it.id
                (newCoreTermLam
                   out
                   nowhere
                   dv
                   self
                   (newCoreTermSel out nowhere (newCoreTermVar out nowhere dv self) mn t)
                   (arrow self t))])
        | None -> [])
      (M.unwrapOr [] (M.map (\(sh : TraitShape) -> sh.methods) (H.lookup canon cx.shapes)))
  in V.append
       selectors
       (V.concatMap (\b -> defsOf out cx (topBind a out cx b)) (bareDeclTraitDefaults a d))

-- Those of `ds` a definition asking for `trs` takes: each trait's, in order.
fun picked (ds : [(Int, String)]) (trs : [String]) : [(Int, String)] =
  fst
    (V.foldl
       (\acc tr ->
         match acc with
         | (got, rest) ->
             (match V.find (\k -> snd (V.getOr (0, "") rest k) == tr) (V.range 0 (V.len rest)) with
              | Just k -> (V.pushBack got (V.getOr (0, "") rest k), V.drop rest (k + 1))
              | None -> (got, rest)))
       ([], ds)
       trs)

-- Binder `id`, a function of those of dictionaries `ds` it asks for, at
-- types `tys` and given them: of type `t` then.
fun given out (cx : Low s) (id : Int) (ds : [(Int, String)]) (t : Type) (tys : [Type]) =
  let mine = picked ds (M.unwrapOr [] (H.lookup id cx.wheres)) in
  applications
    out
    nowhere
    (instance out cx nowhere id (V.foldr (\d acc -> arrow (dictT (snd d)) acc) t mine) tys)
    (V.map (\d -> newCoreTermVar out nowhere (fst d) (dictT (snd d))) mine)

-- An `impl`'s definitions: its methods, and its dictionary under binder
-- `dict` -- a function of the dictionaries its `where` asks for, holding
-- the dictionary of each trait its own requires and then each method: the
-- `impl`'s, or the trait's default given this dictionary.
fun implDefs out (cx : Low s) (a : BareArena) d (dict : Int) =
  let tr = implTrait cx dict in
  let binds = bareDeclImplMethods a d in
  let methodDefs = V.concatMap (\b -> defsOf out cx (topBind a out cx b)) binds in
  match H.lookup tr cx.shapes with
  | None -> methodDefs
  | Just (shape : TraitShape) ->
      let own =
        V.concatMap
          (\b ->
            match boundId a b with
            | Just id -> [(V.getOr "" cx.names id, id)]
            | None -> [])
          binds
      in
      let self = dictT tr in
      let sc =
        M.unwrapOr
          (Scheme { quant = [], preds = [], ty = Error, lacks = [] })
          (M.map (\(i : ImplDef) -> i.scheme) (H.lookup dict cx.impls))
      in
      -- The variable each of the `impl`'s quantifiers is, in the dictionary:
      -- the one inference gave it, where the dictionary was generalized --
      -- what it is built with is written with those -- or one of its own.
      let known =
        (match H.lookup dict cx.generics with
         | Just (g : Generalized) ->
             (let h = matchTy g.scheme.ty sc.ty H.empty in
              V.concatMap
                (\kv ->
                  match snd kv with
                  | Bound k -> [(k, V.getOr 0 g.vars (fst kv))]
                  | _ -> [])
                (H.toVec h))
         | None -> [])
      in
      let ws =
        V.map
          (\k ->
            match V.find (\x -> fst x == k) known with
            | Just (_, v) -> v
            | None -> 0 - fresh cx)
          (V.range 0 (V.len sc.quant))
      in
      let typed = plainOf sc ws 0 in
      -- The trait's parameters and associated types, at this `impl`.
      let at =
        (match sc.ty with
         | Con _ args -> V.map (\x -> substBound x (V.map (\w -> Var w) ws)) args
         | _ -> [])
      in
      -- A method's type here: the trait's, at them.
      let here =
        \mn ->
          (match H.lookup (methodKey tr mn) cx.methods with
           | Just (m : Scheme) ->
               substBound m.ty (V.map (\k -> V.getOr Error at k) (V.range 0 (V.len m.quant)))
           | None -> Error)
      in
      let ds = V.map (\t -> (fresh cx, t)) (M.unwrapOr [] (H.lookup dict cx.wheres)) in
      let u = stSetRef cx.dicts ds in
      let found = M.unwrapOr [] (H.lookup "dict:${show dict}" cx.evidence) in
      let supers =
        V.map
          (\k ->
            match V.get found k with
            | Just e -> fst (witness out cx nowhere e)
            | None -> newCoreTermIll out nowhere Error)
          (V.range 0 (V.len shape.supers))
      in
      let fields =
        V.map
          (\mn ->
            -- The method's type at this `impl`, not over the trait's own
            -- parameters: what a default's argument is here is this type's.
            (let t = here mn in
             match V.find (\o -> fst o == mn) own with
             | Just (_, mid) -> given out cx mid ds t (instOf cx mid t)
             | None ->
                 (match H.lookup (methodKey tr mn) cx.defaults with
                  | Just did ->
                      (let whole = arrow self t in
                       let me = given out cx dict ds self (V.map (\w -> Var w) typed) in
                       let asks = not (V.isEmpty (M.unwrapOr [] (H.lookup did cx.wheres))) in
                       let f =
                         if asks then
                           newCoreTermApp
                             out
                             nowhere
                             (instance out cx nowhere did whole (instOf cx did (here mn)))
                             me
                             t
                         else instance out cx nowhere did t (instOf cx did (here mn))
                       in
                       -- A function waits for its argument, so that the
                       -- dictionary is not built of itself.
                       match t with
                       | Fun _ _ _ ->
                           (let x = fresh cx in
                            match applying t with
                            | (arg, result) ->
                                newCoreTermLam
                                  out
                                  nowhere
                                  x
                                  arg
                                  (newCoreTermApp
                                     out
                                     nowhere
                                     f
                                     (newCoreTermVar out nowhere x arg)
                                     result)
                                  t)
                       | _ -> f)
                  | None -> newCoreTermIll out nowhere t)))
          shape.methods
      in
      let v = stSetRef cx.dicts [] in
      V.pushBack
        methodDefs
        (newCoreDef
           out
           nowhere
           dict
           (typeAbs
              out
              typed
              []
              (abstracted
                 out
                 ds
                 (newCoreTermCtor out nowhere (dictCtor tr) (V.append supers fields) self))))

-- `\a b -> op(a, b)`, at type `t`: a function of each argument the
-- primitive still wants, around the operation.
fun etaPrim out (cx : Low s) (m : Meta) (op : String) (wants : Int) have (t : Type) =
  if wants <= 0 then newCoreTermPrim out m op have t
  else
    (let v = fresh cx in
     match applying t with
     | (arg, rest) ->
         newCoreTermLam
           out
           m
           v
           arg
           (etaPrim out cx m op (wants - 1) (V.pushBack have (newCoreTermVar out m v arg)) rest)
           t)

fun unit out (m : Meta) = newCoreTermConst out m (newCoreLitLUnit out m) (unitT ())

-- `func` applied to `args`, the whole of type `t`: a primitive given all it
-- takes at once is the operation, `runSt f` is `f ()`, and the rest are
-- applications one at a time.
fun applied src out (cx : Low s) (m : Meta) func args (t : Type) =
  let prim =
    if kindBareExpr src func == BareExprKind.Var then
      H.lookup (bareRefId src (bareExprVarRef src func)) cx.prims
    else None
  in match prim with
     | Just (op, arity) ->
         if op == "RunSt" and V.len args == 1 then
           newCoreTermApp out m (V.getOr (unit out m) args 0) (unit out m) t
         else if arity == V.len args then newCoreTermPrim out m op args t
         else applications out m (emitExpr src out cx func) args
     | None -> applications out m (emitExpr src out cx func) args

-- `f` applied to each of `args` in turn, each application of the type the
-- function's says it is.
fun applications out (m : Meta) f args =
  V.foldl (\g a -> newCoreTermApp out m g a (snd (applying (tyCoreTerm out g)))) f args

-- A function of `params`: each a variable, or a fresh one taken apart at the
-- top of the body.
fun lambdas out (cx : Low s) (m : Meta) params body =
  V.foldr
    (\p acc ->
      (let binder = binderOf out cx m p acc in
       let pty = tyCorePat out p in
       newCoreTermLam
         out
         m
         (fst binder)
         pty
         (snd binder)
         (arrow pty (tyCoreTerm out (snd binder)))))
    body
    params

-- What binds pattern `p` around `body`: the variable to bind, and the body
-- -- under a `case` of that variable where the pattern is more than a name.
fun binderOf out (cx : Low s) (m : Meta) p body =
  if kindCorePat out p == CorePatKind.PVar then (corePatPVarId out p, body)
  else
    (let v = fresh cx in
     if kindCorePat out p == CorePatKind.PWild then (v, body)
     else
       (
         v,
         newCoreTermCase
           out
           m
           (newCoreTermVar out m v (tyCorePat out p))
           [newCoreArm out m p None body]
           (tyCoreTerm out body)
       ))

-- A `let`'s binding around what it is in scope for.
fun bound out (cx : Low s) (m : Meta) b body =
  let t = tyCoreTerm out body in
  match b with
  | (p, value, isFun) ->
      if isFun then
        (let id = corePatPVarId out p in
         newCoreTermLetRec
           out
           m
           [newCoreBind out m id (typeAbs out (tyvarsOf cx id) [] value)]
           body
           t)
      else if kindCorePat out p == CorePatKind.PVar then
        (let id = corePatPVarId out p in
         newCoreTermLet out m id (typeAbs out (tyvarsOf cx id) [] value) body t)
      else if kindCorePat out p == CorePatKind.PWild then
        newCoreTermLet out m (fresh cx) value body t
      else newCoreTermCase out m value [newCoreArm out m p None body] t

-- A constructor applied, at type `t`: `True` and `False` the truths they
-- are, one given fewer arguments than it takes a function of the rest.
fun constructed out (cx : Low s) (m : Meta) (id : Int) args (t : Type) =
  match M.unwrapOr ("?", V.len args) (H.lookup id cx.ctors) with
  | (name, arity) ->
      if name == "Bool.True" and V.isEmpty args then
        newCoreTermConst out m (newCoreLitLBool out m True) t
      else if name == "Bool.False" and V.isEmpty args then
        newCoreTermConst out m (newCoreLitLBool out m False) t
      else etaCtor out cx m name (arity - V.len args) args t

fun etaCtor out (cx : Low s) (m : Meta) (name : String) (wants : Int) have (t : Type) =
  if wants <= 0 then newCoreTermCtor out m name have t
  else
    (let v = fresh cx in
     match applying t with
     | (arg, rest) ->
         newCoreTermLam
           out
           m
           v
           arg
           (etaCtor out cx m name (wants - 1) (V.pushBack have (newCoreTermVar out m v arg)) rest)
           t)

-- What a constructor is given, in the order it holds them: one with named
-- fields given a record has each field's value, by its name.
fun consArgs src out (cx : Low s) (id : Int) args =
  match (H.lookup id cx.fields, V.get args 0) with
  | (Just labels, Just r) ->
      if V.len args == 1 and kindBareExpr src r == BareExprKind.Record then
        (let given =
           V.map
             (\f -> (bareNameText src (bareExprFieldName src f), bareExprFieldValue src f))
             (bareExprRecordFields src r)
         in V.concatMap
              (\l ->
                match V.find (\g -> fst g == l) given with
                | Just g -> [emitExpr src out cx (snd g)]
                | None -> [])
              labels)
      else V.map (\a -> emitExpr src out cx a) args
  | _ -> V.map (\a -> emitExpr src out cx a) args

-- The same of a pattern: a field it does not name is anything.
fun consPats src out (cx : Low s) (m : Meta) (id : Int) args =
  match (H.lookup id cx.fields, V.get args 0) with
  | (Just labels, Just r) ->
      if V.len args == 1 and kindBarePat src r == BarePatKind.Record then
        (let given =
           V.map
             (\f -> (bareNameText src (barePatFieldName src f), barePatFieldPat src f))
             (barePatRecordFields src r)
         in V.map
              (\l ->
                match V.find (\g -> fst g == l) given with
                | Just g -> emitPat src out cx (snd g)
                | None -> newCorePatPWild out m Error)
              labels)
      else V.map (\a -> emitPat src out cx a) args
  | _ -> V.map (\a -> emitPat src out cx a) args

fun constructedPat out (cx : Low s) (m : Meta) (id : Int) args (t : Type) =
  match M.unwrapOr ("?", 0) (H.lookup id cx.ctors) with
  | (name, _) ->
      if name == "Bool.True" and V.isEmpty args then
        newCorePatPLit out m (newCoreLitLBool out m True) t
      else if name == "Bool.False" and V.isEmpty args then
        newCorePatPLit out m (newCoreLitLBool out m False) t
      else newCorePatPCtor out m name args t

-- --- a unit ------------------------------------------------------------------

def nowhere : Meta = spanMeta 0 0

-- What a unit gives the units after it to be lowered with: its package;
-- the packages of the units it is made with, its own last; every declared
-- type it knows, and each constructor's named fields; its own `impl`s'
-- dictionaries' binders; and its own traits' defaults.
@derive(Reflect, Debug, PartialEq)
@pub record Linked = {
  package : String,
  packages : [String],
  datas : [DataSig],
  named : [Entry [String]],
  dicts : [Int],
  defaults : [DefaultSig],
  -- What it exports of another unit's: the binder the name has here, and
  -- the symbol it is.
  aliases : [Entry String],
  -- Each function it writes with its parameters, and each it exports of
  -- another unit's: its symbol, and how many they are.
  arities : [Entry Int],
  -- What `Dictionaries` needs to know of its definitions.
  summary : Summary,
  -- The functions it keeps for a unit that imports it to copy to its calls
  -- (`Inline.exports`).
  bodies : CoreProgram,
  -- Its definitions that are generic in a number's type, as they were
  -- written, and those of the units it imports, a program a package: what a
  -- unit that uses one at a number type makes its copy of
  -- (`Inline.numbered`). A unit hands on what it was handed, since a
  -- definition it keeps may mention one of theirs.
  numbers : [Numbers],
  -- All of it, as it was written and before anything was made of it, where
  -- the build's units are to be optimised as one program
  -- (`Core.joinedUnits`); nothing otherwise.
  whole : CoreProgram
}

-- A unit's definitions that are generic in a number's type, as they were
-- written, with each variable over number types they are written with and
-- whether it is over fractions.
@derive(Reflect, Debug, PartialEq)
@pub record Numbers = {
  program : CoreProgram,
  vars : [Int],
  fracs : [Bool]
}

-- A declared type: its name in core, how many types it takes, and each
-- constructor's fields' types.
@derive(Reflect, Debug, PartialEq)
@pub record DataSig = {
  name : String,
  arity : Int,
  ctors : [Entry [Type]]
}

-- A trait's default for a method: the trait and method (`methodKey`), its
-- binder in its unit, the traits it asks dictionaries of, and its scheme.
@derive(Reflect, Debug, PartialEq)
@pub record DefaultSig = {
  key : String,
  binder : Int,
  asks : [String],
  scheme : Scheme
}

-- A unit this one depends on: what it exports, what it knows about types,
-- and what it is lowered with.
@pub record Imported = {
  package : String,
  exports : [Export],
  types : TypeEnv,
  linked : Linked
}

-- A definition's symbol in Cut: its package, and its binder -- an `impl`'s
-- dictionary's is below every other, and is spelt for what it is.
@pub fun defSymbol (pkg : String) (id : Int) : String =
  if id < 0 then "meadow:${pkg}/impl${show (0 - id)}" else "meadow:${pkg}/d${show id}"

-- Unit `r` of package `pkg`, whose modules inference typed as `done` has
-- them, as one program of core, entered at its `entry` if it is to have one
-- -- or `None` when nothing of that name is there -- with the binders of
-- its `impl`s' dictionaries and its traits' defaults. What it mentions of
-- `deps` is named by symbol.
@pub fun unitCore
    (pkg : String)
    (r : Renamed)
    (done : Inferred)
    (deps : [Imported])
    (entry : Maybe String)
    : Maybe (CoreProgram, [Int], [DefaultSig], [Entry String]) =
  let bares = V.map bare done.typed in
  let itemsOf = \k -> M.unwrapOr [] (M.map (\(d : Declared) -> d.items) (V.get r.modules k)) in
  let allTypes = V.pushBack (V.map (\(d : Imported) -> d.types) deps) done.types in
  let traitShapes =
    V.foldl
      (\h (t : TypeEnv) ->
        V.foldl (\g (e : Entry TraitShape) -> H.insert e.key e.value g) h t.shapes)
      H.empty
      allTypes
  in
  let items = V.concatMap (\(d : Declared) -> d.items) r.modules in
  let shapes = V.concatMap (\p -> shapesOf p) bares in
  -- Each of the dependencies' exports, with the item it is here and its
  -- package.
  let theirs =
    (let flat =
       V.concatMap (\(d : Imported) -> V.map (\(e : Export) -> (d.package, e)) d.exports) deps
     in V.concatMap
          (\k ->
            match (V.get r.depItems k, V.get flat k) with
            | (Just (it : Item), Just (p, ex)) -> [(it, ex, p)]
            | _ -> [])
          (V.range 0 (V.len r.depItems)))
  in
  let variants =
    V.concatMap
      (\(t : TypeEnv) -> V.concatMap (\(e : Entry [VariantSig]) -> e.value) t.variants)
      allTypes
  in
  let entryId =
    (match entry with
     | None -> Just (0 - 1)
     | Just name ->
         V.foldl
           (\found (i : Item) -> if i.kind == "v" and i.name == name then Just i.id else found)
           None
           items)
  in M.map
       (\e ->
         runSt (\() ->
           let out = newCoreBuilder () in
           let next = stNewRef (V.len r.binders) in
           let names = V.map binderName r.binders in
           let ownDefaults =
             V.foldl
               (\h k ->
                 match V.get bares k with
                 | Just p -> moduleDefaults (itemsOf k) names p h
                 | None -> h)
               H.empty
               (V.range 0 (V.len bares))
           in
           -- A dependency's default has a binder made for it here.
           let theirDefaults =
             V.concatMap
               (\(d : Imported) ->
                 V.map
                   (\(s : DefaultSig) ->
                     (let n = stGetRef next in
                      let u = stSetRef next (n + 1) in
                      (n, d.package, s)))
                   d.linked.defaults)
               deps
           in
           let impls =
             V.foldl
               (\h (t : TypeEnv) ->
                 V.foldl (\g (x : Entry ImplDef) -> H.insert x.value.dict x.value g) h t.impls)
               H.empty
               allTypes
           in
           let first = firstDictOf (V.map (\(d : Imported) -> d.types) deps) in
           let arities =
             V.foldl
               (\h (d : Imported) ->
                 V.foldl (\g (a : Entry Int) -> H.insert a.key a.value g) h d.linked.arities)
               H.empty
               deps
           in
           let aliased =
             V.foldl
               (\h (d : Imported) ->
                 V.foldl
                   (\g (a : Entry String) -> H.insert "${d.package}:${a.key}" a.value g)
                   h
                   d.linked.aliases)
               H.empty
               deps
           in
           let externs =
             V.concat [
               V.concatMap
                 (\x ->
                   match x with
                   | ((it : Item), (ex : Export), p) ->
                       if it.kind != "v" or S.startsWith "op:" it.owner then []
                       else
                         [(
                           it.id,
                           -- One the unit exports of another's is that
                           -- one's.
                           M.unwrapOr
                             (defSymbol p ex.binder)
                             (H.lookup "${p}:${show ex.binder}" aliased),
                           if S.isEmpty it.owner then M.unwrapOr 0 (M.map plains ex.scheme) else 0
                         )])
                 theirs,
               V.map
                 (\x ->
                   match x with
                   | (id, p, (s : DefaultSig)) -> (id, defSymbol p s.binder, plains s.scheme))
                 theirDefaults,
               V.concatMap
                 (\(d : Imported) ->
                   V.map
                     (\dict ->
                       (
                         dict,
                         defSymbol d.package dict,
                         M.unwrapOr
                           0
                           (M.map (\(i : ImplDef) -> plains i.scheme) (H.lookup dict impls))
                       ))
                     d.linked.dicts)
                 deps
             ]
           in
           let cx =
             Low {
               prims = primTable r,
               ops =
                 V.foldl
                   (\h x ->
                     match x with
                     | ((it : Item), _, p) ->
                         if it.kind == "v" and S.startsWith "op:" it.owner then
                           H.insert it.id ("${p}/${S.drop it.owner 3}", it.name) h
                         else h)
                   (opTable pkg items)
                   theirs,
               ctors =
                 V.foldl
                   (\h x ->
                     match x with
                     | ((it : Item), (ex : Export), _) ->
                         if it.kind != "c" then h
                         else
                           H.insert
                             it.id
                             (
                               ex.canon,
                               M.unwrapOr
                                 0
                                 (M.map
                                    (\(v : VariantSig) -> V.len v.fields)
                                    (V.find (\(v : VariantSig) -> v.name == ex.canon) variants))
                             )
                             h)
                   -- A module's constructors by its own declarations: two
                   -- modules may each declare a type of one name.
                   (V.foldl
                      (\h k ->
                        V.foldl
                          (\g kv -> H.insert (fst kv) (snd kv) g)
                          h
                          (H.toVec
                             (ctorTable
                                r
                                (itemsOf k)
                                (M.unwrapOr [] (M.map shapesOf (V.get bares k))))))
                      (ctorTable r [] [])
                      (V.range 0 (V.len bares)))
                   theirs,
               fields =
                 V.foldl
                   (\h x ->
                     match x with
                     | ((it : Item), (ex : Export), _) ->
                         (match (it.kind == "c", ex.fields) with
                          | (True, Just labels) -> H.insert it.id labels h
                          | _ -> h))
                   (V.foldl
                      (\h k ->
                        V.foldl
                          (\g kv -> H.insert (fst kv) (snd kv) g)
                          h
                          (H.toVec
                             (fieldTable
                                (itemsOf k)
                                (M.unwrapOr [] (M.map shapesOf (V.get bares k))))))
                      H.empty
                      (V.range 0 (V.len bares)))
                   theirs,
               next,
               wheres =
                 V.foldl
                   (\h x ->
                     match x with
                     | (id, _, (s : DefaultSig)) -> H.insert id s.asks h)
                   done.wheres
                   theirDefaults,
               evidence = done.evidence,
               impls,
               generics =
                 V.foldl
                   (\h x ->
                     match x with
                     | (id, _, (s : DefaultSig)) ->
                         H.insert
                           id
                           (Generalized {
                              scheme = s.scheme,
                              vars = V.range 0 (V.len s.scheme.quant)
                            })
                           h)
                   done.generics
                   theirDefaults,
               extTypes =
                 V.foldl (\h x -> match x with | (id, _, n) -> H.insert id n h) H.empty externs,
               extNums =
                 V.foldl
                   (\h x ->
                     match x with
                     | ((it : Item), (ex : Export), _) ->
                         if it.kind != "v" or not (S.isEmpty it.owner) then h
                         else
                           H.insert
                             it.id
                             (M.unwrapOr
                                0
                                (M.map
                                   (\(sc : Scheme) -> V.len (numberOf sc sc.quant VarKind.Plain))
                                   ex.scheme))
                             h)
                   H.empty
                   theirs,
               shapes = traitShapes,
               methods =
                 V.foldl
                   (\h (t : TypeEnv) ->
                     V.foldl (\g (x : Entry Scheme) -> H.insert x.key x.value g) h t.methods)
                   H.empty
                   allTypes,
               defaults =
                 V.foldl
                   (\h x ->
                     match x with
                     | (id, _, (s : DefaultSig)) -> H.insert s.key id h)
                   ownDefaults
                   theirDefaults,
               names,
               dicts = stNewRef [],
               nextDict = stNewRef first,
               views = stNewRef []
             }
           in
           let defs =
             V.concatMap
               (\k ->
                 match V.get bares k with
                 | Just p -> moduleDefs out cx (itemsOf k) p
                 | None -> [])
               (V.range 0 (V.len bares))
           in
           let named =
             V.concatMap
               (\(i : Item) ->
                 match H.lookup i.id cx.fields with
                 | Just labels -> [newCoreNamed out nowhere i.canon labels]
                 | None -> [])
               items
           in
           -- A trait's dictionary is a type of one constructor, its fields
           -- named: declared by the unit that declares the trait.
           let ownTraits =
             V.concatMap
               (\k ->
                 match V.get bares k with
                 | Just p -> moduleTraits (itemsOf k) p
                 | None -> [])
               (V.range 0 (V.len bares))
           in
           let ownShapes =
             V.concatMap
               (\tr ->
                 match H.lookup tr traitShapes with
                 | Just (sh : TraitShape) -> [(tr, sh)]
                 | None -> [])
               ownTraits
           in
           let dictNamed =
             V.map
               (\kv ->
                 (let sh : TraitShape = snd kv in
                  newCoreNamed out nowhere (dictCtor (fst kv)) sh.labels))
               ownShapes
           in
           let dictDatas =
             V.map
               (\kv ->
                 (let sh : TraitShape = snd kv in
                  newCoreData
                    out
                    nowhere
                    (fst kv)
                    (sh.params + V.len sh.assocs)
                    [newCoreDataCtor
                       out
                       nowhere
                       (dictCtor (fst kv))
                       (V.append
                          (V.map (\(sup : Super) -> dictT sup.tr) sh.supers)
                          (V.map (\mn -> methodType cx (fst kv) mn) sh.methods))]))
               ownShapes
           in
           let datas =
             V.append
               dictDatas
               (V.concatMap
                  (\k ->
                    match V.get bares k with
                    | Just p -> moduleDatas out (itemsOf k) variants p
                    | None -> [])
                  (V.range 0 (V.len bares)))
           in
           let lists =
             if V.any (\(i : Item) -> i.kind == "c" and i.owner == "List") items then []
             else
               [newCoreData out nowhere "List" 1 [
                  newCoreDataCtor out nowhere "List.Nil" [],
                  newCoreDataCtor out nowhere "List.Cons" [Bound 0, Con "List" [Bound 0]]
                ]]
           in
           let effects = V.concatMap (\p -> moduleEffects out pkg p) bares in
           let root =
             newCoreFile
               out
               nowhere
               pkg
               e
               defs
               (V.append named dictNamed)
               (V.append lists datas)
               effects
               (V.map
                  (\x ->
                    match x with
                    | (id, symbol, n) ->
                        newCoreExtern
                          out
                          nowhere
                          id
                          symbol
                          n
                          (M.unwrapOr 0 (H.lookup symbol arities)))
                  externs)
           in
           let last = stGetRef cx.nextDict in
           (
             CoreProgram (freezeCore out) root,
             V.map (\k -> first - k) (V.range 0 (first - last)),
             V.map
               (\kv ->
                 DefaultSig {
                   key = fst kv,
                   binder = snd kv,
                   asks = M.unwrapOr [] (H.lookup (snd kv) done.wheres),
                   scheme =
                     M.unwrapOr
                       (Scheme { quant = [], preds = [], ty = Error, lacks = [] })
                       (M.map (\(g : Generalized) -> g.scheme) (H.lookup (snd kv) done.generics))
                 })
               (H.toVec ownDefaults),
             V.concatMap
               (\x ->
                 match x with
                 | (id, symbol, _) ->
                     if V.any (\(ex : Export) -> ex.binder == id and ex.kind == "v") r.exports then
                       [Entry { key = show id, value = symbol }]
                     else [])
               externs
           )))
       entryId

-- The traits a module declares, by their canonical names.
fun moduleTraits (items : [Item]) (p : BareProgram) : [String] =
  match p with
  | BareProgram a root ->
      V.concatMap
        (\d0 ->
          (let d = peeled a d0 in
           if kindBareDecl a d != BareDeclKind.Trait then []
           else [traitCanon items (bareNameText a (bareDeclTraitName a d))]))
        (bareModuleDecls a root)

-- Each primitive's operation and how many arguments it takes, by binder.
fun primTable (r : Renamed) : HashMap Int (String, Int) =
  V.foldl
    (\h p ->
      match V.find (\o -> match o with | (n, _, _) -> n == fst p) primOps with
      | Just (_, op, arity) -> H.insert (snd p) (op, arity) h
      | None -> h)
    H.empty
    r.prims

-- Each effect operation's effect -- under its package -- and name, by
-- binder.
fun opTable (pkg : String) (items : [Item]) : HashMap Int (String, String) =
  V.foldl
    (\h (i : Item) ->
      if i.kind == "v" and S.startsWith "op:" i.owner then
        H.insert i.id ("${pkg}/${S.drop i.owner 3}", i.name) h
      else h)
    H.empty
    items

-- Each constructor's name in core and how many arguments it takes, by
-- binder: the unit's own, by what its declarations say, and the ones every
-- module has without a library to declare them.
fun ctorTable (r : Renamed) (items : [Item]) shapes : HashMap Int (String, Int) =
  let own =
    V.foldl
      (\h (i : Item) ->
        if i.kind != "c" then h
        else
          (let arity =
             M.unwrapOr
               0
               (M.map
                  (\s -> match s with | (_, _, n, _) -> n)
                  (V.find
                     (\s -> match s with | (o, n, _, _) -> o == i.owner and n == i.name)
                     shapes))
           in H.insert i.id (i.canon, arity) h))
      H.empty
      items
  in V.foldl
       (\h k ->
         match V.get r.binders k with
         | Just (b : Binder) ->
             if b.kind != "c" or b.site != "-" then h
             else if b.name == "Nil" then H.insert k ("List.Nil", 0) h
             else if b.name == "Cons" then H.insert k ("List.Cons", 2) h
             else if b.name == "True" then H.insert k ("Bool.True", 0) h
             else if b.name == "False" then H.insert k ("Bool.False", 0) h
             else h
         | None -> h)
       own
       (V.range 0 (V.len r.binders))

-- The names of each constructor's fields, for those that have them.
fun fieldTable (items : [Item]) shapes : HashMap Int [String] =
  V.foldl
    (\h (i : Item) ->
      if i.kind != "c" then h
      else
        match V.find (\s -> match s with | (o, n, _, _) -> o == i.owner and n == i.name) shapes with
        | Just (_, _, _, Just labels) -> H.insert i.id labels h
        | _ -> h)
    H.empty
    items

-- What a module's `data` and `record` declarations say of their
-- constructors: each one's type, its name, how many arguments it takes, and
-- its fields' names if it has them.
fun shapesOf (p : BareProgram) : [(String, String, Int, Maybe [String])] =
  match p with
  | BareProgram a root -> V.concatMap (\d -> declShapes a (peeled a d)) (bareModuleDecls a root)

fun peeled (a : BareArena) (d : BareDecl) : BareDecl =
  if kindBareDecl a d == BareDeclKind.Attributed then peeled a (bareDeclAttributedDecl a d) else d

fun declShapes (a : BareArena) (d : BareDecl) : [(String, String, Int, Maybe [String])] =
  if kindBareDecl a d == BareDeclKind.Data then
    (let owner = bareNameText a (bareDeclDataName a d) in
     V.map
       (\v ->
         (let name = bareNameText a (bareVariantName a v) in
          if bareVariantNamed a v then
            (let labels =
               V.map (\f -> bareNameText a (bareFieldName a f)) (bareVariantFields a v)
             in (owner, name, V.len labels, Just labels))
          else (owner, name, V.len (bareVariantPositional a v), None)))
       (bareDeclDataVariants a d))
  else if kindBareDecl a d == BareDeclKind.Record then
    (let owner = bareNameText a (bareDeclRecordName a d) in
     let labels = V.map (\f -> bareNameText a (bareFieldName a f)) (bareDeclRecordFields a d) in
     [(owner, owner, V.len labels, Just labels)])
  else []

-- A module's `data` and `record` declarations, as core declares a type: its
-- canonical name, how many types it takes, and each constructor with its
-- fields' types.
fun moduleDatas out (items : [Item]) (variants : [VariantSig]) (p : BareProgram) =
  match p with
  | BareProgram a root ->
      -- Each constructor's and each type's name in core, by what the module
      -- calls it -- the first so called -- and each constructor's fields as
      -- inference has them.
      let ctorCanons =
        V.foldr
          (\(i : Item) h -> if i.kind == "c" then H.insert "${i.owner}.${i.name}" i.canon h else h)
          H.empty
          items
      in
      let typeCanons =
        V.foldr
          (\(i : Item) h -> if i.kind == "t" then H.insert i.name i.canon h else h)
          H.empty
          items
      in
      let fields = V.foldr (\(v : VariantSig) h -> H.insert v.name v h) H.empty variants in
      V.concatMap
        (\d0 ->
          (let d = peeled a d0 in
           let canon =
             \owner name -> M.unwrapOr "${owner}.${name}" (H.lookup "${owner}.${name}" ctorCanons)
           in
           let typeCanon = \owner -> M.unwrapOr owner (H.lookup owner typeCanons) in
           if kindBareDecl a d == BareDeclKind.Data then
             (let owner = bareNameText a (bareDeclDataName a d) in
              let params = V.map (\n -> bareNameText a n) (bareDeclDataParams a d) in
              [newCoreData
                 out
                 nowhere
                 (typeCanon owner)
                 (V.len params)
                 (V.map
                    (\v ->
                      newCoreDataCtor
                        out
                        nowhere
                        (canon owner (bareNameText a (bareVariantName a v)))
                        (resolved
                           fields
                           (canon owner (bareNameText a (bareVariantName a v)))
                           (if bareVariantNamed a v then
                              V.map
                                (\f -> written a params (bareFieldTy a f))
                                (bareVariantFields a v)
                            else V.map (\t -> written a params t) (bareVariantPositional a v))))
                    (bareDeclDataVariants a d))])
           else if kindBareDecl a d == BareDeclKind.Record then
             (let owner = bareNameText a (bareDeclRecordName a d) in
              let params = V.map (\n -> bareNameText a n) (bareDeclRecordParams a d) in
              [newCoreData
                 out
                 nowhere
                 (typeCanon owner)
                 (V.len params)
                 [newCoreDataCtor
                    out
                    nowhere
                    (canon owner owner)
                    (resolved
                       fields
                       (canon owner owner)
                       (V.map
                          (\f -> written a params (bareFieldTy a f))
                          (bareDeclRecordFields a d)))]])
           else []))
        (bareModuleDecls a root)

-- A constructor's fields' types as inference has them -- an alias what it
-- stands for, which is what says how a field is represented: a type written
-- `Node` that is an `Int` is an `Int` -- or as they were written, for one
-- inference does not know.
fun resolved (variants : HashMap String VariantSig) (ctor : String) (written : [Type]) : [Type] =
  match H.lookup ctor variants with
  | Just (v : VariantSig) -> if V.len v.fields == V.len written then v.fields else written
  | None -> written

-- A module's effects, as core declares one: its name, and each operation
-- with what it takes and what it answers.
fun moduleEffects out (pkg : String) (p : BareProgram) =
  match p with
  | BareProgram a root ->
      V.concatMap
        (\d0 ->
          (let d = peeled a d0 in
           if kindBareDecl a d != BareDeclKind.Effect then []
           else
             (let params = V.map (\n -> bareNameText a n) (bareDeclEffectParams a d) in
              [newCoreEffect
                 out
                 nowhere
                 "${pkg}/${bareNameText a (bareDeclEffectName a d)}"
                 (V.map
                    (\f ->
                      (let t = bareFieldTy a f in
                       let isFun = kindBareType a t == BareTypeKind.Fun in
                       let arg =
                         if isFun then
                           M.unwrapOr
                             (Con "Unit" [])
                             (M.map (written a params) (V.get (bareTypeFunParams a t) 0))
                         else Con "Unit" []
                       in
                       let result = written a params (if isFun then bareTypeFunResult a t else t) in
                       newCoreOp out nowhere (bareNameText a (bareFieldName a f)) arg result))
                    (bareDeclEffectOps a d))])))
        (bareModuleDecls a root)

-- A written type as far as how its values are represented goes: a named
-- type by its name, one of the declaration's own parameters by its place,
-- and anything else something on the heap.
fun written (a : BareArena) (params : [String]) (t : BareType) : Type =
  if kindBareType a t == BareTypeKind.Con then Con (bareNameText a (bareTypeConName a t)) []
  else if kindBareType a t == BareTypeKind.Var then
    (let name = bareNameText a (bareTypeVarName a t) in
     match V.find (\i -> V.get params i == Just name) (V.range 0 (V.len params)) with
     | Just i -> Bound i
     | None -> Error)
  else if kindBareType a t == BareTypeKind.Tuple and V.isEmpty (bareTypeTupleItems a t) then
    Con "Unit" []
  else Error

-- A module's bindings as definitions: a name its value, and a pattern a
-- definition of the value and one of each name in it, read out of that. A
-- `trait`'s and an `impl`'s are with them.
fun moduleDefs out (cx : Low s) (items : [Item]) (p : BareProgram) =
  match p with
  | BareProgram a root ->
      V.concatMap
        (\d0 ->
          (let d = peeled a d0 in
           let k = kindBareDecl a d in
           if k == BareDeclKind.Bind then defsOf out cx (topBind a out cx (bareDeclBindBind a d))
           else if k == BareDeclKind.Trait then traitDefs out cx items a d
           else if k == BareDeclKind.Impl then
             (let dict = stGetRef cx.nextDict in
              let u = stSetRef cx.nextDict (dict - 1) in
              implDefs out cx a d dict)
           else []))
        (bareModuleDecls a root)

-- A lowered binding as definitions.
fun defsOf out (cx : Low s) bind =
  match bind with
  | (pat, value, _) ->
      if kindCorePat out pat == CorePatKind.PVar then
        [newCoreDef out nowhere (corePatPVarId out pat) value]
      else
        (let v = fresh cx in
         let whole = tyCorePat out pat in
         V.pushFront
           (V.map
              (\x ->
                newCoreDef
                  out
                  nowhere
                  (fst x)
                  (newCoreTermCase
                     out
                     nowhere
                     (newCoreTermVar out nowhere v whole)
                     [newCoreArm out nowhere pat None (newCoreTermVar out nowhere (fst x) (snd x))]
                     (snd x)))
              (patVars out pat))
           (newCoreDef out nowhere v value))

-- Each trait's defaults a module declares: the default's binder, by the
-- trait and the method.
fun moduleDefaults (items : [Item]) (names : [String]) (p : BareProgram) (h : HashMap String Int)
    : HashMap String Int =
  match p with
  | BareProgram a root ->
      V.foldl
        (\acc d0 ->
          (let d = peeled a d0 in
           if kindBareDecl a d != BareDeclKind.Trait then acc
           else
             (let canon = traitCanon items (bareNameText a (bareDeclTraitName a d)) in
              V.foldl
                (\acc2 b ->
                  match boundId a b with
                  | Just id -> H.insert (methodKey canon (V.getOr "" names id)) id acc2
                  | None -> acc2)
                acc
                (bareDeclTraitDefaults a d))))
        h
        (bareModuleDecls a root)

fun binderName (b : Binder) : String = b.name

-- The variables a pattern of core binds, each with its type.
fun patVars out p =
  let k = kindCorePat out p in
  if k == CorePatKind.PVar then [(corePatPVarId out p, tyCorePat out p)]
  else if k == CorePatKind.PAs then
    V.pushFront (patVars out (corePatPAsPat out p)) (corePatPAsId out p, tyCorePat out p)
  else if k == CorePatKind.PTuple then V.concatMap (patVars out) (corePatPTupleItems out p)
  else if k == CorePatKind.PArray then V.concatMap (patVars out) (corePatPArrayItems out p)
  else if k == CorePatKind.PCtor then V.concatMap (patVars out) (corePatPCtorArgs out p)
  else if k == CorePatKind.PRecord then
    V.concatMap (\f -> patVars out (corePFieldPat out f)) (corePatPRecordFields out p)
  else []
