-- The command line is `meadow`'s, command for command and flag for flag
-- (`buildtools/meadow/src/main.rs`): whoever runs one runs the other the
-- same way, and `a_command_takes_what_meadow_s_takes` in
-- `buildtools/meadow/tests/bootstrap.rs` holds the two together. What several
-- commands take is declared once, so they cannot come to take it differently.
-- After those are the commands only MeadowBoot has: each pass's output, for
-- the tests that set it against the Rust compiler's.
cli! {
  pub
    Cli
    "meadowboot"
    "Meadow's compiler, written in Meadow"
    version
    "0.3.0-dev"
    default
    repl
    unnamed
    options
    {
      offline
        : Flag
          "Never fetch a dependency. What is already in the cache is used; anything else is an error saying what would have had to be fetched"
      locked : Flag "Refuse anything that would change `Meadow.lock`"
    }
