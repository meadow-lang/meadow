    Build
    {
      release : Flag "Build with the release profile: `-O2`, and `match` must be exhaustive"
      debug : Flag "Build with the debug profile (the default)"
      optLevel
        : Option Int "Optimization level: 0, 1 or 2. Overrides the profile" short "O" value "LEVEL"
      strict : Flag "Reject a non-exhaustive `match`, whatever the profile says"
      lenient : Flag "Allow a non-exhaustive `match`, whatever the profile says"
      runtime
