          ("glade" | "silo")
          "The runtime system: `glade` (the default), bytecode and a garbage collector, or `silo`, compiled all the way down by LLVM and counting references"
          value
          "RUNTIME"
      backend
        : Option
          ("vm" | "jit" | "aot")
          "How Glade runs the program: the bytecode interpreter, the JIT, or machine code compiled ahead of time"
          value
          "BACKEND"
      jit : Flag "`--backend jit`"
      aot : Flag "`--backend aot`: Glade, compiled ahead of time into an executable" alias "native"
