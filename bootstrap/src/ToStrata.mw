-- --- what the translation knows ----------------------------------------------

-- A declaration of the core: what it is (`def`, `data`, `con`, `effect`,
-- `op`, `alias`, `trait`, `method`, `impl`, `default`, `lifted`, `builtin`,
-- and `extern` for one of another unit's the checker reads), its name, its
-- unique -- its binder, a synthetic one, or -1 for what has none here --
-- its type, and its definition, for one that has one.
@pub record Def = {
  kind : String,
  name : String,
  unique : Int,
  ty : Core,
  term : Maybe Core
}

-- A unit as the core says it: its own declarations, which the dump writes;
-- those of other units and of Meadow's builtins its declarations mention,
-- which the checker reads; each data type's constructors, by unique; and
-- each alias's definition, by unique.
@pub record Translated = {
  defs : [Def],
  externs : [Def],
  datas : [(Int, [Int])],
  globals : [(Int, Core)]
}

-- What is in scope at a term, innermost last, each a binder of the core,
-- with its type where the translation knows it: a local by its binder; a
-- type variable -- the arena's variable behind it in the typed tree, or -1
-- for a scheme's -- its place among its binding's quantifiers, and its kind;
-- a dictionary by its place among its binding's, its trait and its type; a
-- dictionary of a variable over number types, by the variable; `runSt`'s
-- state, by the rigid type inference made of it; and a binder nothing
-- names.
data Slot
  = Local Int String (Maybe Core)
  | Quant Int Int String Core
  | Dict Int Pred Core
  | NumDict Int Bool Core
  | Skolem String
  | Anon String (Maybe Core)

use Slot.*

-- What the translation of a module reads: its tables; every binder's name;
-- each type and constructor by its canonical name; each type's
-- constructors, and what its parameters range over; what inference says of the unit's bindings, its traits and
-- its `impl`s; the binder of each default, by its method's key; the
-- primitives' binders, by name; the top-level definition being translated;
-- the binders of the `let`s being defined, which are not in scope in
-- themselves; and the local functions being lifted, each with how many
-- binders were in scope where it was defined.
record Env = {
  a : TypedArena,
  binders : [Binder],
  ids : HashMap String Int,
  variants : HashMap String [VariantSig],
  ctorSchemes : HashMap String Scheme,
  kinds : HashMap String [VarKind],
  schemes : HashMap Int Scheme,
  generics : HashMap Int Generalized,
  wheres : HashMap Int [String],
  numbers : HashMap Int Bool,
  implNames : HashMap Int String,
  impls : HashMap Int [(String, ImplDef)],
  implKeys : HashMap Int (String, ImplDef),
  shapes : HashMap String TraitShape,
  methods : HashMap String Scheme,
  evidence : HashMap String [Evidence],
  defaults : HashMap String Int,
  prims : HashMap String Int,
  monos : HashMap Int Type,
  owner : String,
  pending : [Int],
  lifting : [(Int, Int)]
}

-- Every binder's grade, and every type's: ω, Idyll's `[]`.
def omega : Core = Core.GradeLit G.any

-- A construct the core has nothing for yet, said where it was, by its kind.
fun unmapped (kind : String) : Core = Core.Runtime (Note.Goal ("unmapped:" ++ kind)) Core.Error

-- What a match no arm of holds comes to: a failure, which the one implied
-- effect of running a program, `Div`, covers (docs/2LTT.md).
def noMatch : Core = Core.Runtime (Note.Goal "no-match") Core.Error

fun apps (f : Core) (xs : [Core]) : Core = V.foldl (\g x -> Core.App g x) f xs

-- A lambda of the core, with the grade and the type of what it binds.
fun lam (x : String) (dom : Maybe Core) (body : Core) : Core =
  Core.Runtime (Note.Binds (Just G.any) dom) (Core.Lam x body)

fun pi (x : String) (icit : Icit) (dom : Core) (cod : Core) : Core =
  Core.Pi x icit omega omega dom cod

def typeKind : Core = Core.Type 0

def effectKind : Core = Core.LitTy Builtin.Effect

def unitType : Core = Core.LitTy Builtin.Unit

def emptyRow : Core = Core.Row [] []

-- The `i`th quantifier's name: `a`, `b`, and so on.
fun letter (i : Int) : String =
  if i < 26 then stringSlice "abcdefghijklmnopqrstuvwxyz" i (i + 1) else "a${show i}"

fun nameOf (env : Env) (id : Int) : String =
  match V.get env.binders id with
  | Just (b : Binder) -> b.name
  | None -> M.unwrapOr "#${show id}" (H.lookup id env.implNames)

-- The last segment of a canonical name: `Shape.Circle`'s `Circle`.
fun lastOf (name : String) : String = M.unwrapOr name (V.last (S.split "." name))

fun slotName (s : Slot) : String =
  match s with
  | Local _ n _ -> n
  | Quant _ _ n _ -> n
  | Dict k _ _ -> "d${show k}"
  | NumDict v _ _ -> "n${show v}"
  | Skolem _ -> "s"
  | Anon n _ -> n

fun slotType (s : Slot) : Maybe Core =
  match s with
  | Local _ _ t -> t
  | Quant _ _ _ k -> Just k
  | Dict _ _ t -> Just t
  | NumDict _ _ t -> Just t
  | Skolem _ -> Just typeKind
  | Anon _ t -> t

-- The innermost slot `p` holds of, as a de Bruijn index, and the slot.
fun innermost (ctx : [Slot]) (p : Slot -> Bool) : Maybe (Int, Slot) =
  innermostFrom ctx p (V.len ctx - 1)

fun innermostFrom (ctx : [Slot]) (p : Slot -> Bool) (k : Int) : Maybe (Int, Slot) =
  if k < 0 then None
  else
    match V.get ctx k with
    | Just s -> if p s then Just (V.len ctx - 1 - k, s) else innermostFrom ctx p (k - 1)
    | None -> None

fun isVarQuant (v : Int) (s : Slot) : Bool = match s with | Quant u _ _ _ -> u == v | _ -> False

fun isPlaceQuant (q : Int) (s : Slot) : Bool = match s with | Quant _ j _ _ -> j == q | _ -> False

-- Where in `xs` the first that `p` holds of is.
fun indexWhere (p : a -> Bool) (xs : [a]) : Maybe Int =
  V.find (\i -> match V.get xs i with | Just x -> p x | None -> False) (V.range 0 (V.len xs))

-- `c`, made to mean what it meant under `k` more binders.
fun shift (k : Int) (c : Core) : Core =
  if k == 0 then c
  else
    transform c 0 (\x d ->
      match x with
      | Core.Var i n -> if i >= d then Just (Core.Var (i + k) n) else None
      | _ -> None)

-- The variable at `lvl` of a scope of `ctx`'s length, as an index.
fun varAt (ctx : [Slot]) (lvl : Int) : Core =
  Core.Var (V.len ctx - 1 - lvl) (M.unwrapOr "x" (M.map slotName (V.get ctx lvl)))

-- --- synthetic uniques -------------------------------------------------------
--
-- What Meadow has no binder for, at uniques of its own: 2^61 and up, above
-- every binder a unit gives out and below where Strata's checker counts down
-- from for slots no name refers to (`Tc.freshKey`).

def synthetic : Int = 2305843009213693952

-- Meadow's own types and effects, and what the translation needs: the
-- builtins, at `synthetic` and their place here.
def builtinNames : [String] =
  [
    "Array", "BigInt", "St", "StArray", "StRef", "Ref", "Mut", "Thread", "TVar", "Task", "Compact",
    "#array", "#Num", "#Frac", "#fracNum", "#fromInt", "#fromFloat", "#Num.Int", "#Num.BigInt",
    "#Num.Int8", "#Num.Int16", "#Num.Int32", "#Num.UInt8", "#Num.UInt16", "#Num.UInt32",
    "#Num.UInt64", "#Num.Float", "#Num.Float32", "#Frac.Float", "#Frac.Float32", "Channel"
  ]

fun builtinUnique (name : String) : Maybe Int =
  M.map (\i -> synthetic + i) (indexWhere (\n -> n == name) builtinNames)

fun builtin (name : String) : Core = Core.Opaque (M.unwrapOr (0 - 1) (builtinUnique name)) name

fun tupleType (n : Int) : Int = synthetic + 1000 + n

fun tupleCtor (n : Int) : Int = synthetic + 2000 + n

fun tupleName (n : Int) : String = "Tuple${show n}"

-- A dependency's default for a method, the `k`th the units it depends on
-- tell it of.
fun depDefault (k : Int) : Int = synthetic + 549755813888 + k

-- A record of `labels`, sorted: its data type and its constructor, at
-- uniques its labels hash to.
fun shapeName (labels : [String]) : String = "#rec{${S.join "," labels}}"

fun shapeType (labels : [String]) : Int =
  synthetic + 1099511627776 + 2 * textHash (S.join "," labels) 0 0

fun shapeCtor (labels : [String]) : Int = shapeType labels + 1

-- A hash of `s` from byte `i`, below 2^38.
fun textHash (s : String) (i : Int) (h : Int) : Int =
  if i >= stringByteLength s then h
  else textHash s (i + 1) ((h * 31 + toInt (stringByteAt s i)) % 274877906944)

-- The labels of a record whose data type is named `name`.
fun shapeLabels (name : String) : [String] =
  let inner = S.drop name 5 in
  let body = stringSlice inner 0 (stringByteLength inner - 1) in
  if S.isEmpty body then [] else S.split "," body

-- The type of builtin `name`.
fun builtinType (env : Env) (name : String) : Core =
  let t = typeKind in
  let arrow = \d c -> pi "_" Icit.Explicit d (shift 1 c) in
  let numOf = \x -> Core.App (builtin "#Num") x in
  let fracOf = \x -> Core.App (builtin "#Frac") x in
  let a0 = Core.Var 0 "a" in
  match name with
  | "Array" -> arrow t t
  | "BigInt" -> t
  | "St" -> arrow t effectKind
  | "StArray" -> arrow t (arrow t t)
  | "StRef" -> arrow t (arrow t t)
  | "Ref" -> arrow t t
  | "Mut" -> effectKind
  | "Thread" -> effectKind
  | "TVar" -> arrow t t
  | "Task" -> arrow t t
  | "Compact" -> arrow t t
  | "Channel" -> arrow t t
  | "#array" ->
      pi
        "a"
        Icit.Implicit
        t
        (pi
           "_"
           Icit.Explicit
           (Core.App (Core.Opaque (idOf env "List") "List") a0)
           (Core.App (builtin "Array") (Core.Var 1 "a")))
  | "#Num" -> arrow t t
  | "#Frac" -> arrow t t
  | "#fracNum" -> pi "a" Icit.Implicit t (pi "_" Icit.Explicit (fracOf a0) (numOf (Core.Var 1 "a")))
  | "#fromInt" ->
      pi
        "a"
        Icit.Implicit
        t
        (pi
           "_"
           Icit.Explicit
           (numOf a0)
           (pi "_" Icit.Explicit (Core.LitTy Builtin.Int) (Core.Var 2 "a")))
  | "#fromFloat" ->
      pi
        "a"
        Icit.Implicit
        t
        (pi
           "_"
           Icit.Explicit
           (fracOf a0)
           (pi "_" Icit.Explicit (Core.LitTy (Builtin.Number "Float")) (Core.Var 2 "a")))
  | n ->
      if S.startsWith "#Num." n then numOf (typeCon env (S.drop n 5))
      else if S.startsWith "#Frac." n then fracOf (typeCon env (S.drop n 6))
      else unmapped "builtin"

-- `runSt`'s type, generic in its state as inference has it of no other
-- function: `{a} -> {e} -> ({s} -> () -> a ! {St s | e}) -> a ! e`.
def runStType : Core =
  pi
    "a"
    Icit.Implicit
    typeKind
    (pi
       "e"
       Icit.Implicit
       effectKind
       (pi
          "_"
          Icit.Explicit
          (pi
             "s"
             Icit.Implicit
             typeKind
             (pi
                "_"
                Icit.Explicit
                unitType
                (Core.Comp
                   (Core.Var 3 "a")
                   (Core.Row [Core.App (builtin "St") (Core.Var 1 "s")] [Core.Var 2 "e"]))))
          (Core.Comp (Core.Var 2 "a") (Core.Row [] [Core.Var 1 "e"]))))

fun idOf (env : Env) (name : String) : Int =
  match H.lookup name env.ids with
  | Just id -> id
  | None -> synthetic + 4398046511104 + 2 * textHash name 0 0

fun primId (env : Env) (name : String) : Int = M.unwrapOr (0 - 1) (H.lookup name env.prims)

-- --- types -------------------------------------------------------------------

-- A type of inference's, in scope `ctx`. A variable nothing constrains,
-- which inference left unsolved, is `()`: whatever it is, nothing reads it.
fun typeOf (env : Env) (ctx : [Slot]) (t : Type) : Core =
  match t with
  | Var v ->
      (match innermost ctx (isVarQuant v) with
       | Just (i, s) -> Core.Var i (slotName s)
       -- A variable over number types that its binding is not copied for
       -- is the type it defaults to.
       | None ->
           (match H.lookup v env.numbers with
            | Just frac ->
                if frac then Core.LitTy (Builtin.Number "Float") else Core.LitTy Builtin.Int
            | None -> unitType))
  | Bound q ->
      (match innermost ctx (isPlaceQuant q) with
       | Just (i, s) -> Core.Var i (slotName s)
       | None -> unmapped "free-type-variable")
  | Con name args ->
      (match innermost ctx (\s -> match s with | Skolem n -> n == name | _ -> False) with
       | Just (i, s) -> Core.Var i "s"
       | None ->
           let kinds = paramKinds env name in
           apps
             (typeCon env name)
             (V.map
                (\k -> typeAtKind env ctx (V.getOr VarKind.Plain kinds k) (V.getOr Error args k))
                (V.range 0 (V.len args))))
  | Fun ps ret eff -> arrows env ctx ps ret eff
  | Tuple ts ->
      if V.isEmpty ts then unitType
      else
        apps (Core.Opaque (tupleType (V.len ts)) (tupleName (V.len ts))) (V.map (typeOf env ctx) ts)
  | Record r ->
      (match recordFields r with
       | Just fields ->
           let labels = V.map fst fields in
           apps
             (Core.Opaque (shapeType labels) (shapeName labels))
             (V.map (\f -> typeOf env ctx (snd f)) fields)
       | None -> unmapped "record-row-variable")
  | RowEmpty -> emptyRow
  | RowExtend _ _ _ -> row env ctx t
  | Error -> unmapped "error-type"

-- What a data type's parameters range over (`kindTable`).
fun paramKinds (env : Env) (name : String) : [VarKind] = M.unwrapOr [] (H.lookup name env.kinds)

-- What each data type's parameters range over. Inference gives every
-- parameter of a data type or record a plain type's kind, as the Rust
-- compiler does, so a parameter its fields use as an effect row -- the
-- tail of a function's effects, or where another data type's parameter is
-- a row -- is a type in its constructors' schemes, and so is a quantifier
-- of a generic definition that is a row only as such a data type's
-- argument. Here such a parameter is a row, `Effect`: the kind its uses
-- demand. A row's tail is of that kind in the core, so nothing that was
-- well kinded is not now; the same is done for a definition's quantifiers
-- (`kindsOf`). It is the least such assignment, found by going over the
-- data types until nothing changes, as one data type's fields may pass a
-- parameter to another's. A trait's dictionary keeps its parameters'
-- kinds, as its constructor's type is written from its trait.
fun kindTable
    (variants : HashMap String [VariantSig])
    (ctorSchemes : HashMap String Scheme)
    (dicts : HashMap String TraitShape)
    : HashMap String [VarKind] =
  let start =
    H.fromVec
      (V.map
         (\kv ->
           (
             fst kv,
             match M.andThen
               (\(v : VariantSig) -> H.lookup v.name ctorSchemes)
               (V.get (snd kv) 0) with
             | Just (sc : Scheme) -> sc.quant
             | None -> []
           ))
         (H.toVec variants))
  in settleKinds variants ctorSchemes dicts start 0

fun settleKinds
    (variants : HashMap String [VariantSig])
    (ctorSchemes : HashMap String Scheme)
    (dicts : HashMap String TraitShape)
    (table : HashMap String [VarKind])
    (rounds : Int)
    : HashMap String [VarKind] =
  let next =
    H.fromVec
      (V.map
         (\kv ->
           let quant = M.unwrapOr [] (H.lookup (fst kv) table) in
           let rows =
             if M.isSome (H.lookup (fst kv) dicts) then []
             else
               V.concatMap
                 (\(v : VariantSig) ->
                   match H.lookup v.name ctorSchemes with
                   | Just (sc : Scheme) -> rowUses table sc.ty
                   | None -> [])
                 (snd kv)
           in (fst kv, promoted quant rows))
         (H.toVec variants))
  in if effectCount next == effectCount table or rounds > 16 then next
     else settleKinds variants ctorSchemes dicts next (rounds + 1)

fun effectCount (table : HashMap String [VarKind]) : Int =
  V.foldl (\n kv -> n + V.len (V.filter (\k -> k == VarKind.Effect) (snd kv))) 0 (H.toVec table)

-- Quantifiers of a plain type's kind that are used as rows, made rows.
fun promoted (quant : [VarKind]) (rows : [Int]) : [VarKind] =
  V.map
    (\i ->
      let k = V.getOr VarKind.Plain quant i in
      if k == VarKind.Plain and V.elem i rows then VarKind.Effect else k)
    (V.range 0 (V.len quant))

-- What a scheme's quantifiers range over: as inference says, but one of a
-- plain type's kind that its type uses as an effect row is a row
-- (`kindTable`).
fun kindsOf (env : Env) (sc : Scheme) : [VarKind] = promoted sc.quant (rowUses env.kinds sc.ty)

-- The quantifiers, by place, that `t` uses as effect rows: as the tail of
-- a row, or as a data type's argument where its parameter is one.
fun rowUses (table : HashMap String [VarKind]) (t : Type) : [Int] =
  match t with
  | Fun ps ret eff ->
      V.concat [V.concatMap (rowUses table) ps, rowUses table ret, rowUsesAsRow table eff]
  | Con name args ->
      let kinds = M.unwrapOr [] (H.lookup name table) in
      V.concatMap
        (\j ->
          let arg = V.getOr Error args j in
          if V.getOr VarKind.Plain kinds j == VarKind.Effect then rowUsesAsRow table arg
          else rowUses table arg)
        (V.range 0 (V.len args))
  | Tuple ts -> V.concatMap (rowUses table) ts
  | Record r -> rowUses table r
  | RowExtend _ f rest -> V.append (rowUses table f) (rowUses table rest)
  | _ -> []

fun rowUsesAsRow (table : HashMap String [VarKind]) (t : Type) : [Int] =
  match splitRow t [] with
  | (labels, rest) ->
      V.append
        (V.concatMap (\l -> rowUses table (snd l)) labels)
        (match rest with
         | Bound q -> [q]
         | other -> rowUses table other)

-- A closed record's fields, sorted by label; nothing for an open one.
fun recordFields (r : Type) : Maybe [(String, Type)] =
  match splitRow r [] with
  | (fields, RowEmpty) -> Just (sortOn fst fields)
  | _ -> None

-- A type constructor: one of the core's builtins, a type by its binder, or
-- one of Meadow's own.
fun typeCon (env : Env) (name : String) : Core =
  match name with
  | "Int" -> Core.LitTy Builtin.Int
  | "Int64" -> Core.LitTy Builtin.Int
  | "Bool" -> Core.LitTy Builtin.Bool
  | "String" -> Core.LitTy Builtin.Str
  | "Char" -> Core.LitTy Builtin.Char
  | "Unit" -> Core.LitTy Builtin.Unit
  | "Float64" -> Core.LitTy (Builtin.Number "Float")
  | n if V.elem n numberTypes -> Core.LitTy (Builtin.Number n)
  | _ ->
      (match H.lookup name env.ids with
       | Just id -> Core.Opaque id name
       | None -> Core.Opaque (M.unwrapOr (0 - 1) (builtinUnique name)) name)

-- A function's type: a Pi for each parameter, and what it answers, under
-- its latent effect if it has one.
fun arrows (env : Env) (ctx : [Slot]) (ps : [Type]) (ret : Type) (eff : Type) : Core =
  match V.get ps 0 with
  | Just p ->
      pi
        "_"
        Icit.Explicit
        (typeOf env ctx p)
        (arrows env (V.pushBack ctx (Anon "_" None)) (V.drop ps 1) ret eff)
  | None ->
      (match eff with
       | RowEmpty -> typeOf env ctx ret
       | _ -> Core.Comp (typeOf env ctx ret) (row env ctx eff))

-- An effect row: each effect applied to its arguments, and its end. An end
-- nothing constrains is the empty row.
fun row (env : Env) (ctx : [Slot]) (t : Type) : Core =
  match splitRow t [] with
  | (labels, rest) ->
      let effects =
        V.map
          (\l ->
            match l with
            | (name, Tuple args) -> apps (typeCon env name) (V.map (typeOf env ctx) args)
            | (name, arg) -> Core.App (typeCon env name) (typeOf env ctx arg))
          labels
      in Core.Row effects (rowTail env ctx rest)

fun rowTail (env : Env) (ctx : [Slot]) (rest : Type) : [Core] =
  match rest with
  | RowEmpty -> []
  | Var v ->
      (match innermost ctx (isVarQuant v) with
       | Just (i, s) -> [Core.Var i (slotName s)]
       | None -> [])
  -- (what a quantifier nothing constrains is, `()`: at one that is a row
  -- only by `kindsOf`, the empty row)
  | Con n [] if n == "Unit" -> []
  | other -> [typeOf env ctx other]

fun splitRow (t : Type) (acc : [(String, Type)]) : ([(String, Type)], Type) =
  match t with
  | RowExtend l f rest -> splitRow rest (V.pushBack acc (l, f))
  | other -> (acc, other)

-- What a quantified variable ranges over.
fun kindOf (k : VarKind) : Core =
  match k with
  | VarKind.Effect -> effectKind
  | VarKind.Row -> unmapped "record-row-variable"
  | _ -> typeKind

-- A type at a quantifier of kind `k`: an effect's a row.
fun typeAtKind (env : Env) (ctx : [Slot]) (k : VarKind) (t : Type) : Core =
  match k with
  | VarKind.Effect -> row env ctx t
  | VarKind.Row -> unmapped "record-row-variable"
  | _ -> typeOf env ctx t

-- A trait asked of types: its dictionary's type, over the trait's
-- parameters and then its associated types.
fun predType (env : Env) (ctx : [Slot]) (p : Pred) : Core =
  apps (typeCon env p.tr) (V.map (typeOf env ctx) (V.append p.tys p.assocs))

-- The type of a dictionary of a variable over number types.
fun numClass (frac : Bool) (t : Core) : Core =
  Core.App (builtin (if frac then "#Frac" else "#Num")) t

fun isNumKind (k : VarKind) : Bool = k == VarKind.Num or k == VarKind.Frac

-- A scheme's type: an implicit Pi for each quantifier, an auto Pi for each
-- trait it asks for and for each variable over number types, and its type.
fun schemeType (env : Env) (ctx : [Slot]) (sc : Scheme) : Core =
  quantPis env ctx sc (kindsOf env sc) 0

fun quantPis (env : Env) (ctx : [Slot]) (sc : Scheme) (kinds : [VarKind]) (i : Int) : Core =
  match V.get kinds i with
  | Just k ->
      pi
        (letter i)
        Icit.Implicit
        (kindOf k)
        (quantPis env (V.pushBack ctx (Quant (0 - 1) i (letter i) (kindOf k))) sc kinds (i + 1))
  | None -> predPis env ctx sc 0

fun predPis (env : Env) (ctx : [Slot]) (sc : Scheme) (k : Int) : Core =
  match V.get sc.preds k with
  | Just p ->
      let dom = predType env ctx p in
      pi "_" Icit.Auto dom (predPis env (V.pushBack ctx (Anon "_" (Just dom))) sc (k + 1))
  | None -> numPis env ctx sc 0

fun numPis (env : Env) (ctx : [Slot]) (sc : Scheme) (k : Int) : Core =
  match V.get sc.quant k with
  | Just kind ->
      if isNumKind kind then
        (let dom = numClass (kind == VarKind.Frac) (typeOf env ctx (Bound k)) in
         pi "_" Icit.Auto dom (numPis env (V.pushBack ctx (Anon "_" (Just dom))) sc (k + 1)))
      else numPis env ctx sc (k + 1)
  | None -> typeOf env ctx sc.ty

-- `Type -> … -> Type`, a type constructor's type, over `kinds`.
fun constructorType (kinds : [Core]) (result : Core) : Core =
  V.foldr (\k acc -> pi "_" Icit.Explicit k (shift 1 acc)) result kinds

-- What each of `pattern`'s quantifiers is where it is `actual`, after `h`.
fun matchTy (pattern : Type) (actual : Type) (h : HashMap Int Type) : HashMap Int Type =
  let all = \ps ts acc -> V.foldl (\x pt -> matchTy (fst pt) (snd pt) x) acc (V.zip ps ts) in
  match (pattern, actual) with
  | (Bound k, _) -> if M.isSome (H.lookup k h) then h else H.insert k actual h
  | (Con _ ps, Con _ ts) -> all ps ts h
  | (Fun ps pr pe, Fun ts tr te) ->
      if V.len ps == V.len ts then matchTy pe te (matchTy pr tr (all ps ts h)) else h
  | (Tuple ps, Tuple ts) -> all ps ts h
  | (Record p, Record t) -> matchTy p t h
  | (RowExtend pl pf pr, _) ->
      (match takeLabel actual pl with
       | Just (tf, tr) -> matchTy pr tr (matchTy pf tf h)
       | None -> h)
  | _ -> h

-- The field of label `l` in row `t`, and the rest of the row.
fun takeLabel (t : Type) (l : String) : Maybe (Type, Type) =
  match t with
  | RowExtend tl tf tr ->
      if tl == l then Just (tf, tr)
      else M.map (\x -> (fst x, RowExtend tl tf (snd x))) (takeLabel tr l)
  | _ -> None

-- --- terms -------------------------------------------------------------------

-- A binding's definition: lambdas for the types it is generic in, the
-- dictionaries its `where` asks for, and those of its variables over number
-- types, around `body`.
fun generic (env : Env) (ctx : [Slot]) (id : Int) (body : [Slot] -> Core) : Core =
  let g = H.lookup id env.generics in
  let vars = M.unwrapOr [] (M.map (\(x : Generalized) -> x.vars) g) in
  let quant = M.unwrapOr [] (M.map (\(x : Generalized) -> kindsOf env x.scheme) g) in
  -- (its traits at the variables it is generic in, as the typed tree's
  -- types are written)
  let at = V.map (\v -> Var v) vars in
  let preds =
    V.map
      (\(p : Pred) ->
        Pred {
          tr = p.tr,
          tys = V.map (\x -> substBound x at) p.tys,
          assocs = V.map (\x -> substBound x at) p.assocs
        })
      (M.unwrapOr [] (M.map (\(x : Generalized) -> x.scheme.preds) g))
  in
  let dicts = M.unwrapOr [] (H.lookup id env.wheres) in
  typeLams env ctx vars quant 0 (\c ->
    dictLams env c preds dicts 0 (\c2 -> numLams env c2 vars quant 0 body))

fun typeLams
    (env : Env)
    (ctx : [Slot])
    (vars : [Int])
    (quant : [VarKind])
    (i : Int)
    (body : [Slot] -> Core)
    : Core =
  match V.get vars i with
  | Just v ->
      let kind = kindOf (V.getOr VarKind.Plain quant i) in
      lam
        (letter i)
        (Just kind)
        (typeLams env (V.pushBack ctx (Quant v i (letter i) kind)) vars quant (i + 1) body)
  | None -> body ctx

fun dictLams
    (env : Env)
    (ctx : [Slot])
    (preds : [Pred])
    (dicts : [String])
    (k : Int)
    (body : [Slot] -> Core)
    : Core =
  if k >= V.len dicts then body ctx
  else
    (let tr = V.getOr "" dicts k in
     let p = M.unwrapOr (Pred { tr, tys = [], assocs = [] }) (V.get preds k) in
     let dom = M.unwrapOr (unmapped "dictionary-type") (M.map (predType env ctx) (V.get preds k)) in
     lam
       "d${show k}"
       (Just dom)
       (dictLams env (V.pushBack ctx (Dict k p dom)) preds dicts (k + 1) body))

fun numLams
    (env : Env)
    (ctx : [Slot])
    (vars : [Int])
    (quant : [VarKind])
    (i : Int)
    (body : [Slot] -> Core)
    : Core =
  match V.get quant i with
  | Just kind ->
      if isNumKind kind then
        (let v = V.getOr 0 vars i in
         let frac = kind == VarKind.Frac in
         let dom = numClass frac (typeOf env ctx (Var v)) in
         lam
           "n${show v}"
           (Just dom)
           (numLams env (V.pushBack ctx (NumDict v frac dom)) vars quant (i + 1) body))
      else numLams env ctx vars quant (i + 1) body
  | None -> body ctx

-- An expression, in scope `ctx`.
fun expr (env : Env) (ctx : [Slot]) (e : TypedExpr) : Core =
  let a = env.a in
  let t = typTypedExpr a e in
  match viewTypedExpr a e with
  | TypedExprView.Var r -> mention env ctx (typedRefId a r.ref) r.ev r.inst t
  | TypedExprView.Lit r -> literal env ctx (viewTypedLit a r.lit) t
  | TypedExprView.Unit _ -> Core.Lit Literal.Unit
  | TypedExprView.Hole _ -> Core.Runtime (Note.Goal "_") Core.Error
  | TypedExprView.MacCall _ -> unmapped "macro-call"
  | TypedExprView.Lam r -> lambdas env ctx r.params (\c -> expr env c r.body)
  | TypedExprView.App r -> applied env ctx r.func r.args
  | TypedExprView.Let r -> lets env ctx r.binds (\c -> expr env c r.body)
  | TypedExprView.If r ->
      Core.Case (expr env ctx r.cond) [
        CaseAlt.CaseAlt (Head.BoolLit True) "True" [] (expr env ctx r.yes),
        CaseAlt.CaseAlt (Head.BoolLit False) "False" [] (expr env ctx r.no)
      ]
  | TypedExprView.Match r ->
      matching
        env
        ctx
        (expr env ctx r.scrutinee)
        (typTypedExpr a r.scrutinee)
        (V.map
           (\arm -> (typedArmPat a arm, typedArmGuard a arm, \c -> expr env c (typedArmBody a arm)))
           r.arms)
  | TypedExprView.Tuple r ->
      let n = V.len r.items in
      let tys =
        (match t with
         | Tuple ts -> V.map (typeOf env ctx) ts
         | _ -> [])
      in apps
           (Core.Opaque (tupleCtor n) (tupleName n))
           (V.append tys (V.map (expr env ctx) r.items))
  | TypedExprView.Array r ->
      let elem = (match t with | Con _ xs -> V.getOr Error xs 0 | _ -> Error) in
      apps (builtin "#array") [typeOf env ctx elem, listOf env ctx elem r.items]
  | TypedExprView.List r ->
      let elem = (match t with | Con _ xs -> V.getOr Error xs 0 | _ -> Error) in
      listOf env ctx elem r.items
  | TypedExprView.Cons r ->
      let id = typedRefId a r.ref in
      let name = nameOf env id in
      let given =
        (match (namedOf env id t, V.len r.args, V.get r.args 0) with
         | (Just labels, 1, Just arg) ->
             (match viewTypedExpr a arg with
              | TypedExprView.Record x ->
                  if M.isSome x.base then None
                  else Just (V.map (\label -> fieldGiven env ctx x.fields label) labels)
              | _ -> None)
         | _ -> None)
      in if (name == "True" or name == "False") and t == Con "Bool" [] then
           Core.Lit (Literal.Bool (name == "True"))
         else
           apps
             (Core.Opaque id name)
             (V.append
                (V.map (typeOf env ctx) (resultArgs t))
                (M.unwrapOr (V.map (expr env ctx) r.args) given))
  | TypedExprView.Record r ->
      (match (r.base, recordOf env t) with
       | (None, Just (v, targs)) ->
           apps
             (constructor env v)
             (V.append
                (V.map (typeOf env ctx) targs)
                (V.map (\label -> fieldGiven env ctx r.fields label) (labelsOf v)))
       | (Just b, Just (v, targs)) -> updated env ctx b r.fields v targs
       | (None, None) -> structural env ctx t r.fields
       | (Just b, None) -> extended env ctx b r.fields t)
  | TypedExprView.Update r ->
      (match recordOf env (typTypedExpr a r.base) with
       | Just (v, targs) -> updated env ctx r.base r.fields v targs
       | None -> extended env ctx r.base r.fields t)
  | TypedExprView.Proj r ->
      let label = typedNameText a r.label in
      (match recordOf env (typTypedExpr a r.target) with
       | Just (v, targs) ->
           let labels = labelsOf v in
           (match indexWhere (\l -> l == label) labels with
            | Just j -> projection (expr env ctx r.target) (conHead env v) (lastOf v.name) labels j
            | None -> unmapped "structural-record")
       | None ->
           (match recordFieldsOf (typTypedExpr a r.target) with
            | Just fields ->
                let labels = V.map fst fields in
                (match indexWhere (\l -> l == label) labels with
                 | Just j ->
                     projection
                       (expr env ctx r.target)
                       (Head.Con (shapeCtor labels))
                       (shapeName labels)
                       labels
                       j
                 | None -> unmapped "structural-record")
            | None -> unmapped "record-row-variable"))
  | TypedExprView.Handle r ->
      let ret =
        (match r.ret with
         | Just x -> lambdas env ctx [typedRetPat a x] (\c -> expr env c (typedRetBody a x))
         | None -> lam "x" None (Core.Var 0 "x"))
      in
      let ops =
        V.map
          (\h ->
            let op = typedRefId a (typedHArmOpRef a h) in
            let k = typedHArmResume a h in
            OpClause.OpClause
              op
              (typedNameText a (typedHArmOp a h))
              0
              (lambdas env ctx [typedHArmParam a h] (\c ->
                 let kty = M.map (typeOf env c) (H.lookup k env.monos) in
                 lam
                   (nameOf env k)
                   kty
                   (expr env (V.pushBack c (Local k (nameOf env k) kty)) (typedHArmBody a h)))))
          r.arms
      in ascribed (typeOf env ctx t) (Core.Handle (expr env ctx r.body) ret ops)
  | _ -> unmapped "expression"

-- `c`, said to be of type `t`: an ascription, `Note.Has`. A `handle` is
-- said to be of its type, which a checker cannot read off its `return`
-- clause: what its body answers may be a function that performs what its
-- clauses do.
fun ascribed (t : Core) (c : Core) : Core = Core.Runtime (Note.Has t) c

-- `case target of { C x y z -> y }`: field `j` of a value of one
-- constructor.
fun projection (target : Core) (head : Head) (name : String) (labels : [String]) (j : Int) : Core =
  let n = V.len labels in
  Core.Case target [CaseAlt.CaseAlt head name labels (Core.Var (n - 1 - j) (V.getOr "x" labels j))]

-- The value a record expression gives `label`.
fun fieldGiven (env : Env) (ctx : [Slot]) (fields : [TypedExprField]) (label : String) : Core =
  match V.find (\f -> typedNameText env.a (typedExprFieldName env.a f) == label) fields with
  | Just f -> expr env ctx (typedExprFieldValue env.a f)
  | None -> unmapped "missing-field"

-- A list of `items`, each of type `elem`.
fun listOf (env : Env) (ctx : [Slot]) (elem : Type) (items : [TypedExpr]) : Core =
  let ty = typeOf env ctx elem in
  let cons = Core.App (Core.Opaque (idOf env "List.Cons") "Cons") ty in
  V.foldr
    (\x acc -> apps cons [expr env ctx x, acc])
    (Core.App (Core.Opaque (idOf env "List.Nil") "Nil") ty)
    items

-- A call. `runSt`'s first argument is generic in the state, the rigid type
-- inference made of it: here it is bound.
fun applied (env : Env) (ctx : [Slot]) (func : TypedExpr) (args : [TypedExpr]) : Core =
  let a = env.a in
  let plain = \() -> apps (expr env ctx func) (V.map (expr env ctx) args) in
  match (viewTypedExpr a func, V.get args 0) with
  | (TypedExprView.Var r, Just arg) ->
      if typedRefId a r.ref != primId env "runSt" then plain ()
      else
        (match typTypedExpr a arg with
         | Fun ps result eff ->
             (match (if V.len ps == 1 then stateOf eff else None) with
              | Just (state, outside) ->
                  let body = expr env (V.pushBack ctx (Skolem state)) arg in
                  apps
                    (Core.Opaque (typedRefId a r.ref) "runSt")
                    (V.append
                       [typeOf env ctx result, row env ctx outside, lam "s" (Just typeKind) body]
                       (V.map (expr env ctx) (V.drop args 1)))
              | None -> plain ())
         | _ -> plain ())
  | _ -> plain ()

-- The rigid state of an effect row with `St` in it, and the rest of it.
fun stateOf (eff : Type) : Maybe (String, Type) =
  match takeLabel eff "St" with
  | Just (Tuple items, rest) ->
      (match V.get items 0 with
       | Just (Con s []) ->
           if V.len items == 1 and S.startsWith "s#" s then Just (s, rest) else None
       | _ -> None)
  | Just (Con s [], rest) -> if S.startsWith "s#" s then Just (s, rest) else None
  | _ -> None

-- The scheme a mention of binder `id` instantiates, if it has one.
fun schemeOfId (env : Env) (id : Int) : Maybe Scheme = H.lookup id env.schemes

-- A name mentioned at type `t`: a local, or a constant by its binder,
-- applied to the types it is used at, to the dictionaries found for it, and
-- to those of the number types it is used at. The types are what inference
-- says it is used at, `inst` -- its types and its number types -- and,
-- for its effects and rows, what its scheme's type is where it is `t`.
fun mention (env : Env) (ctx : [Slot]) (id : Int) (evs : [Evidence]) (inst : [Type]) (t : Type)
    : Core =
  let head =
    (match innermost ctx (\s -> match s with | Local b _ _ -> b == id | _ -> False) with
     | Just (i, _) -> Core.Var i (nameOf env id)
     | None ->
         (match V.find (\l -> fst l == id) env.lifting with
          | Just (_, depth) ->
              if V.len ctx < depth then unmapped "recursive-let"
              else
                apps
                  (Core.Opaque id (liftedName env id))
                  (V.map (\j -> varAt ctx j) (V.range 0 depth))
          | None ->
              if V.elem id env.pending then unmapped "recursive-let"
              else Core.Opaque id (nameOf env id)))
  in
  let wants =
    \k ->
      M.unwrapOr
        ""
        (M.andThen
           (\(sc : Scheme) -> M.map (\(p : Pred) -> p.tr) (V.get sc.preds k))
           (schemeOfId env id))
  in
  let plain =
    \() ->
      V.map
        (\k -> evidence env ctx (wants k) (V.getOr Evidence.Missing evs k))
        (V.range 0 (V.len evs))
  in match schemeOfId env id with
     | Just sc ->
         let tys = instTypes sc inst t (evidenced env ctx sc evs) in
         -- (the type each dictionary is wanted at: of two `impl`s of one
         -- binder and one trait, the one for that type is meant)
         let at =
           \k ->
             M.unwrapOr
               ""
               (M.andThen
                  (\(p : Pred) -> M.map (\x -> headOf (substBound x tys)) (V.get p.tys 0))
                  (V.get sc.preds k))
         in
         let dicts =
           V.map
             (\k -> evidenceAt env ctx (wants k) (at k) (V.getOr Evidence.Missing evs k))
             (V.range 0 (V.len evs))
         in instantiated env ctx head sc tys dicts
     | None -> apps (apps head (V.map (typeOf env ctx) inst)) (plain ())

-- The name of a type's head: its constructor's, or none.
fun headOf (t : Type) : String =
  match t with
  | Con n _ -> n
  | Tuple ts -> "Tuple${show (V.len ts)}"
  | _ -> ""

-- What each of `sc`'s quantifiers is at a mention of type `t` that
-- inference says is at `inst`.
fun instTypes (sc : Scheme) (inst : [Type]) (t : Type) (seen : HashMap Int Type) : [Type] =
  let h =
    V.foldl
      (\acc kv -> if M.isSome (H.lookup (fst kv) acc) then acc else H.insert (fst kv) (snd kv) acc)
      (matchTy sc.ty t H.empty)
      (H.toVec seen)
  in
  let plains = V.len (V.filter (\k -> k == VarKind.Plain) sc.quant) in
  let numbers = V.len (V.filter isNumKind sc.quant) in
  let full = V.len inst == plains + numbers in
  fst
    (V.foldl
       (\acc k ->
         match acc with
         | (out, (p, n)) ->
             let kind = V.getOr VarKind.Plain sc.quant k in
             let matched = H.lookup k h in
             (match kind with
              | VarKind.Plain ->
                  let ty =
                    (if full or p < V.len inst then V.getOr Error inst p
                     else M.unwrapOr (Con "Unit" []) matched)
                  in (V.pushBack out ty, (p + 1, n))
              | VarKind.Num ->
                  let ty =
                    (if full then V.getOr Error inst (plains + n)
                     else M.unwrapOr (Con "Int" []) matched)
                  in (V.pushBack out ty, (p, n + 1))
              | VarKind.Frac ->
                  let ty =
                    (if full then V.getOr Error inst (plains + n)
                     else M.unwrapOr (Con "Float" []) matched)
                  in (V.pushBack out ty, (p, n + 1))
              | _ -> (V.pushBack out (M.unwrapOr RowEmpty matched), (p, n))))
       ([], (0, 0))
       (V.range 0 (V.len sc.quant)))

-- What each of `sc`'s quantifiers is that the dictionaries found for a
-- mention of it say: a quantifier its type does not mention, only its
-- `where`, is at the types its dictionary is.
fun evidenced (env : Env) (ctx : [Slot]) (sc : Scheme) (evs : [Evidence]) : HashMap Int Type =
  V.foldl
    (\h k ->
      match (V.get sc.preds k, V.get evs k) with
      | (Just (p : Pred), Just (Evidence.Given j)) ->
          (match innermost ctx (\s -> match s with | Dict i _ _ -> i == j | _ -> False) with
           | Just (_, Dict _ (q : Pred) _) ->
               matchTy (Con p.tr (V.append p.tys p.assocs)) (Con q.tr (V.append q.tys q.assocs)) h
           | _ -> h)
      | (Just (p : Pred), Just (Evidence.Impl d tys _)) ->
          (match implOf env d (\(i : ImplDef) -> implTrait i == p.tr) with
           | Just (_, (i : ImplDef)) ->
               matchTy
                 (Con p.tr (V.append p.tys p.assocs))
                 (substBound i.scheme.ty (implTypes i.scheme tys))
                 h
           | None -> h)
      | _ -> h)
    H.empty
    (V.range 0 (V.len sc.preds))

-- `head`, of scheme `sc`, applied to `tys` -- a type for each of its
-- quantifiers -- to the dictionaries `dicts` its traits are found in, and
-- to those of its number types.
fun instantiated
    (env : Env)
    (ctx : [Slot])
    (head : Core)
    (sc : Scheme)
    (tys : [Type])
    (dicts : [Core])
    : Core =
  let kinds = kindsOf env sc in
  let types =
    V.map
      (\k -> typeAtKind env ctx (V.getOr VarKind.Plain kinds k) (V.getOr Error tys k))
      (V.range 0 (V.len sc.quant))
  in
  let nums =
    V.concatMap
      (\k ->
        let kind = V.getOr VarKind.Plain sc.quant k in
        if isNumKind kind then [numDict env ctx (kind == VarKind.Frac) (V.getOr Error tys k)]
        else [])
      (V.range 0 (V.len sc.quant))
  in apps head (V.concat [types, dicts, nums])

-- The dictionary of number type `t`: one of Meadow's, or one the scope
-- has, for a variable.
fun numDict (env : Env) (ctx : [Slot]) (frac : Bool) (t : Type) : Core =
  let named =
    \(n : String) ->
      let canon = if n == "Int64" then "Int" else if n == "Float64" then "Float" else n in
      if frac then builtin "#Frac.${canon}" else builtin "#Num.${canon}"
  in match t with
     | Con n [] -> named n
     | Var v ->
         (match innermost ctx (\s -> match s with | NumDict u _ _ -> u == v | _ -> False) with
          | Just (i, NumDict _ f _) ->
              let d = Core.Var i "n${show v}" in
              if f == frac or f then
                (if f and not frac then apps (builtin "#fracNum") [typeOf env ctx t, d] else d)
              else unmapped "number-dictionary"
          | _ ->
              (match H.lookup v env.numbers with
               | Just f -> named (if f then "Float" else "Int")
               | None -> named (if frac then "Float" else "Int")))
     | _ -> unmapped "number-dictionary"

-- A dictionary, as inference found it, of trait `want` where that is known.
-- An `impl`'s dictionary is by its binder, which is its own among the units
-- one unit sees, but not among units that do not see each other: two of a
-- unit's dependencies may each have an `impl` of one binder. Of those, the
-- one of the trait wanted is meant, and the core names each by its key.
fun evidence (env : Env) (ctx : [Slot]) (want : String) (ev : Evidence) : Core =
  evidenceAt env ctx want "" ev

-- The same, wanted at a type whose head is `at`, where that is known.
fun evidenceAt (env : Env) (ctx : [Slot]) (want : String) (at : String) (ev : Evidence) : Core =
  match ev with
  | Evidence.Given k ->
      (match innermost ctx (\s -> match s with | Dict j _ _ -> j == k | _ -> False) with
       | Just (i, _) -> Core.Var i "d${show k}"
       | None -> unmapped "dictionary-not-in-scope")
  -- A required trait's dictionary, a field of the one requiring it.
  | Evidence.Super inner label ->
      let required = S.drop label 7 in
      let owner = evidenceTrait env ctx (requiring env required) inner in
      (match dictVariant env owner with
       | Just (v : VariantSig) ->
           let labels = labelsOf v in
           (match indexWhere (\l -> l == label) labels with
            | Just j -> projection (evidence env ctx owner inner) (conHead env v) "#dict" labels j
            | None -> unmapped "required-trait-field")
       | None -> unmapped "required-trait-field")
  | Evidence.Impl d tys evs ->
      (match implOf env d (\(i : ImplDef) ->
         implTrait i == want and (at == "" or implAt i == at)) with
       | Just (key, (i : ImplDef)) ->
           instantiated
             env
             ctx
             (implHead key)
             i.scheme
             (implTypes i.scheme tys)
             (V.map
                (\k ->
                  evidence
                    env
                    ctx
                    (M.unwrapOr "" (M.map (\(p : Pred) -> p.tr) (V.get i.scheme.preds k)))
                    (V.getOr Evidence.Missing evs k))
                (V.range 0 (V.len evs)))
       | None -> unmapped "unknown-dictionary")
  | Evidence.Missing -> unmapped "missing-evidence"

-- An `impl`'s dictionary, as a constant, by its key.
fun implHead (key : String) : Core = Core.Opaque (implUnique key) "#impl.${spaced key}"

fun implUnique (key : String) : Int = synthetic + 8796093022208 + 2 * textHash key 0 0

-- The trait an `impl` is of.
fun implTrait (i : ImplDef) : String = match i.scheme.ty with | Con tr _ -> tr | _ -> ""

-- The head of the type an `impl` is for.
fun implAt (i : ImplDef) : String =
  match i.scheme.ty with
  | Con _ args -> M.unwrapOr "" (M.map headOf (V.get args 0))
  | _ -> ""

-- The `impl` of binder `d` that `fits`, or the first there is.
fun implOf (env : Env) (d : Int) (fits : ImplDef -> Bool) : Maybe (String, ImplDef) =
  match H.lookup d env.impls with
  | Just cands ->
      (match V.find (\c -> match c with | (_, (i : ImplDef)) -> fits i) cands with
       | Just c -> Just c
       | None -> V.get cands 0)
  | None -> None

-- Whether a trait requires `required`.
fun requiring (env : Env) (required : String) : String -> Bool =
  \tr ->
    match H.lookup tr env.shapes with
    | Just (s : TraitShape) -> V.any (\(x : Super) -> x.tr == required) s.supers
    | None -> False

-- The types an `impl`'s dictionary is at, for each of its quantifiers, from
-- those inference gave it, which are for its variables over types.
fun implTypes (sc : Scheme) (tys : [Type]) : [Type] =
  fst
    (V.foldl
       (\acc k ->
         match acc with
         | (out, p) ->
             (match V.getOr VarKind.Plain sc.quant k with
              | VarKind.Effect -> (V.pushBack out RowEmpty, p)
              | VarKind.Row -> (V.pushBack out RowEmpty, p)
              | _ -> (V.pushBack out (V.getOr Error tys p), p + 1)))
       ([], 0)
       (V.range 0 (V.len sc.quant)))

-- The trait of a dictionary inference found, one that `fits` where an
-- `impl`'s binder is of several.
fun evidenceTrait (env : Env) (ctx : [Slot]) (fits : String -> Bool) (ev : Evidence) : String =
  match ev with
  | Evidence.Given k ->
      (match innermost ctx (\s -> match s with | Dict j _ _ -> j == k | _ -> False) with
       | Just (_, Dict _ (p : Pred) _) -> p.tr
       | _ -> "")
  | Evidence.Super _ label -> S.drop label 7
  | Evidence.Impl d _ _ ->
      (match implOf env d (\(i : ImplDef) -> fits (implTrait i)) with
       | Just (_, (i : ImplDef)) -> implTrait i
       | None -> "")
  | Evidence.Missing -> ""

-- A trait's dictionary's one constructor.
fun dictVariant (env : Env) (tr : String) : Maybe VariantSig =
  M.andThen (\vs -> V.get vs 0) (H.lookup tr env.variants)

-- The type arguments of what a constructor builds.
fun resultArgs (t : Type) : [Type] =
  match t with
  | Con _ args -> args
  | Fun _ r _ -> resultArgs r
  | _ -> []

-- A literal, at its type: at a variable over number types, read through
-- that type's dictionary.
fun literal (env : Env) (ctx : [Slot]) (l : TypedLitView) (t : Type) : Core =
  match (l, t) with
  | (TypedLitView.Int r, Var v) ->
      (match innermost ctx (\s -> match s with | NumDict u _ _ -> u == v | _ -> False) with
       | Just (i, NumDict _ frac _) ->
           let n = Core.Lit (Literal.Int (M.unwrapOr 0 (S.toInt r.text))) in
           let d = Core.Var i "n${show v}" in
           let num = if frac then apps (builtin "#fracNum") [typeOf env ctx t, d] else d in
           apps (builtin "#fromInt") [typeOf env ctx t, num, n]
       | _ ->
           (match H.lookup v env.numbers with
            | Just True -> literalAt l (Con "Float" [])
            | _ -> literalAt l (Con "Int" [])))
  | (TypedLitView.Float r, Var v) ->
      (match innermost ctx (\s -> match s with | NumDict u _ _ -> u == v | _ -> False) with
       | Just (i, NumDict _ True _) ->
           apps (builtin "#fromFloat") [
             typeOf env ctx t,
             Core.Var i "n${show v}",
             Core.Lit (Literal.Float (fraction r.text))
           ]
       | _ -> literalAt l (Con "Float" []))
  | _ -> literalAt l t

fun literalAt (l : TypedLitView) (t : Type) : Core =
  match l with
  | TypedLitView.Int r ->
      let n = M.unwrapOr 0 (S.toInt r.text) in
      (match t with
       | Con "BigInt" [] -> unmapped "bigint-literal"
       | Con "Int" [] -> Core.Lit (Literal.Int n)
       | Con "Int64" [] -> Core.Lit (Literal.Int n)
       | Con "Float" [] -> Core.Lit (Literal.Float (toFloat n))
       | Con "Float32" [] -> Core.Lit (Literal.Float32 (toFloat32 (toFloat n)))
       | Con name [] ->
           if V.elem name numberTypes then Core.Lit (Literal.Word name n)
           else Core.Lit (Literal.Int n)
       | _ -> Core.Lit (Literal.Int n))
  | TypedLitView.Float r ->
      let x = fraction r.text in
      (match t with
       | Con "Float32" [] -> Core.Lit (Literal.Float32 (toFloat32 x))
       | _ -> Core.Lit (Literal.Float x))
  | TypedLitView.Char r -> Core.Lit (Literal.Char (charFromCode (M.unwrapOr 0 (S.toInt r.text))))
  | TypedLitView.String r -> Core.Lit (Literal.Str r.text)

-- The `Float` a literal's text writes, as `Elab` reads one.
fun fraction (text : String) : Float =
  if S.startsWith "-" text then fraction (S.drop text 1) * (0.0 - 1.0)
  else
    (let parts = S.split "." text in
     let part = V.getOr "" parts 1 in
     F.fromDecimal (V.getOr "" parts 0 ++ part) (0 - stringByteLength part))

-- --- binders -----------------------------------------------------------------

fun bare (a : TypedArena) (p : TypedPat) : TypedPat =
  match viewTypedPat a p with
  | TypedPatView.Ann r -> bare a r.pat
  | _ -> p

-- What a pattern that matches anything binds: a name, or nothing.
fun simple (env : Env) (p : TypedPat) (ty : Maybe Core) : Maybe Slot =
  match viewTypedPat env.a (bare env.a p) with
  | TypedPatView.Var r -> Just (Local r.id (nameOf env r.id) ty)
  | TypedPatView.Wild _ -> Just (Anon "_" ty)
  | TypedPatView.Unit _ -> Just (Anon "_" ty)
  | _ -> None

-- Lambdas binding `pats`, around `body`: a pattern that is more than a
-- name is matched on what its lambda binds.
fun lambdas (env : Env) (ctx : [Slot]) (pats : [TypedPat]) (body : [Slot] -> Core) : Core =
  match V.get pats 0 with
  | None -> body ctx
  | Just p ->
      let rest = V.drop pats 1 in
      let pty = typTypedPat env.a p in
      let dom = Just (typeOf env ctx pty) in
      (match simple env p dom with
       | Just s -> lam (slotName s) dom (lambdas env (V.pushBack ctx s) rest body)
       | None ->
           lam
             "x"
             dom
             (matching
                env
                (V.pushBack ctx (Anon "x" dom))
                (Core.Var 0 "x")
                pty
                [(p, None, \c -> lambdas env c rest body)]))

-- The type a binder has, where inference says.
fun binderType (env : Env) (ctx : [Slot]) (id : Int) : Maybe Core =
  match H.lookup id env.schemes with
  | Just sc -> Just (schemeType env ctx sc)
  | None -> M.map (typeOf env ctx) (H.lookup id env.monos)

-- The name a local function lifted to a constant has: its definition's and
-- its own, `countGo`.
fun liftedName (env : Env) (id : Int) : String =
  let own = nameOf env id in
  let first = stringSlice own 0 1 in
  "${env.owner}${S.toUpper first}${S.drop own 1}"

-- A `let`'s bindings, each in scope in those after it and in `body`. A
-- function that mentions itself is lifted: a constant of what is in scope
-- here and of its own parameters, which the `let` binds applied to what is
-- in scope. One that mentions a function after it is a recursion a `let`
-- has none of.
fun lets (env : Env) (ctx : [Slot]) (binds : [TypedBind]) (body : [Slot] -> Core) : Core =
  match V.get binds 0 with
  | None -> body ctx
  | Just b ->
      let rest = V.drop binds 1 in
      let defining = V.concatMap (\x -> funId env.a x) binds in
      (match viewTypedBind env.a b with
       | TypedBindView.Fun r ->
           let depth = V.len ctx in
           let inside =
             {
               env | pending = V.append env.pending (V.filter (\i -> i != r.id) defining),
               lifting = V.pushBack env.lifting (r.id, depth)
             }
           in
           let value =
             generic inside ctx r.id (\c ->
               lambdas inside c r.params (\c2 -> expr inside c2 r.body))
           in
           let name = nameOf env r.id in
           let ty = binderType env ctx r.id in
           let selfCalls =
             C.anyNode value (\x -> match x with | Core.Opaque u _ -> u == r.id | _ -> False)
           in
           let bound =
             (if not selfCalls then value
              else
                (match (ty, V.all (\s -> M.isSome (slotType s)) ctx) with
                 | (Just t, True) -> liftMarker env ctx r.id t value
                 | _ -> unmapped "recursive-let"))
           in Core.Let name bound (lets env (V.pushBack ctx (Local r.id name ty)) rest body)
       | TypedBindView.Pat r ->
           let value = expr env ctx r.value in
           let vty = typTypedExpr env.a r.value in
           (match simple env r.pat (Just (typeOf env ctx vty)) with
            | Just s ->
                let named =
                  (match s with
                   | Local id n _ ->
                       (
                         generic env ctx id (\c -> expr env c r.value),
                         Local id n (binderType env ctx id)
                       )
                   | _ -> (value, s))
                in Core.Let
                     (slotName (snd named))
                     (fst named)
                     (lets env (V.pushBack ctx (snd named)) rest body)
            | None ->
                Core.Let
                  "p"
                  value
                  (matching
                     env
                     (V.pushBack ctx (Anon "p" (Just (typeOf env ctx vty))))
                     (Core.Var 0 "p")
                     (typTypedPat env.a r.pat)
                     [(r.pat, None, \c -> lets env c rest body)])))

fun funId (a : TypedArena) (b : TypedBind) : [Int] =
  match viewTypedBind a b with
  | TypedBindView.Fun r -> [r.id]
  | _ -> []

-- Where a local function lifted to constant `id` was: a goal the
-- declarations are read out of (`lifted`) before anything else sees them,
-- holding what the `let` binds -- the constant applied to what is in scope
-- -- and the constant's type and definition, each a function of what is in
-- scope first.
fun liftMarker (env : Env) (ctx : [Slot]) (id : Int) (ty : Core) (value : Core) : Core =
  let name = liftedName env id in
  let call = apps (Core.Opaque id name) (V.map (\j -> varAt ctx j) (V.range 0 (V.len ctx))) in
  let closedTy =
    V.foldr (\s acc -> pi (slotName s) (slotIcit s) (M.unwrapOr Core.Error (slotType s)) acc) ty ctx
  in
  let closed = V.foldr (\s acc -> lam (slotName s) (slotType s) acc) value ctx in
  Core.Runtime
    (Note.Goal "#lift:${show id}:${name}")
    (Core.App call (Core.Runtime (Note.Binds None (Just closedTy)) closed))

fun slotIcit (s : Slot) : Icit =
  match s with
  | Quant _ _ _ _ -> Icit.Implicit
  | Skolem _ -> Icit.Implicit
  | Dict _ _ _ -> Icit.Auto
  | NumDict _ _ _ -> Icit.Auto
  | _ -> Icit.Explicit

-- The local functions lifted out of `c`, as declarations, and `c` with each
-- where it was the constant applied to what was in scope there.
fun lifted (c : Core) : (Core, [Def]) =
  let found =
    \x ->
      match x with
      | Core.Runtime (Note.Goal g) (Core.App call (Core.Runtime (Note.Binds _ (Just ty)) term)) ->
          if S.startsWith "#lift:" g then Just (g, call, ty, term) else None
      | _ -> None
  in
  let defs =
    collectNodes c (\x ->
      match found x with
      | Just (g, _, ty, term) ->
          let parts = S.split ":" g in
          let inner = lifted term in
          V.pushFront
            (snd inner)
            (Def {
               kind = "lifted",
               name = V.getOr "" parts 2,
               unique = M.unwrapOr (0 - 1) (S.toInt (V.getOr "" parts 1)),
               ty,
               term = Just (fst inner)
             })
      | None -> [])
  in
  let replaced =
    transform c 0 (\x d ->
      match found x with
      | Just (_, call, _, _) -> Just call
      | None -> None)
  in (replaced, defs)

-- What `f` finds in each node of `c` it finds anything in, outermost first;
-- not looking inside what it found something in.
fun collectNodes (c : Core) (f : Core -> [a]) : [a] =
  let found = f c in
  if not (V.isEmpty found) then found
  else
    let go = \x -> collectNodes x f in
    match c with
    | Core.Pi _ _ g r dom cod -> V.concat [go g, go r, go dom, go cod]
    | Core.Lam _ b -> go b
    | Core.App x y -> V.append (go x) (go y)
    | Core.Let _ x y -> V.append (go x) (go y)
    | Core.Case s alts ->
        V.append
          (go s)
          (V.concatMap (\alt -> match alt with | CaseAlt.CaseAlt _ _ _ b -> go b) alts)
    | Core.Runtime n x ->
        V.append
          (match n with
           | Note.Binds _ (Just t) -> go t
           | Note.Has t -> go t
           | _ -> [])
          (go x)
    | Core.Comp x y -> V.append (go x) (go y)
    | Core.Code x -> go x
    | Core.Quote x -> go x
    | Core.Splice x -> go x
    | Core.Row ls ts -> V.append (V.concatMap go ls) (V.concatMap go ts)
    | Core.Handle b r ops ->
        V.concat [
          go b,
          go r,
          V.concatMap (\o -> match o with | OpClause.OpClause _ _ _ body -> go body) ops
        ]
    | _ -> []

-- --- matches -----------------------------------------------------------------
--
-- A `match` is compiled to a tree of `case`s, each of one level, as a match
-- of Meadow's is to a case tree (Maranget, "Compiling pattern matching to
-- good decision trees", 2008). A row is an arm still in the running: the
-- patterns it has yet to match, each against a variable in scope (by its
-- level) of a type; what it has bound so far; its guard; and its body. The
-- first row's first pattern that tests anything is split on: on every
-- constructor of its type, each row that does not test that variable going
-- into every alternative; on a literal, by a test of equality; or, for a
-- view, by applying its function and matching what that answers. A row
-- that tests nothing more is taken, its guard deciding between its body and
-- the rows after it.

-- A pattern, as the compiler reads one: one that matches anything; a name
-- for what a pattern matches; a constructor, its unique, its name, its head
-- in a `case`, and its fields' patterns; a literal and its type; a view's
-- function, its pattern, and the type of what it answers; and one the core
-- cannot say yet, by its kind.
data MPat
  = PWild
  | PBind Int String MPat
  | PCon Int String Head [MPat]
  | PLit TypedLitView Type
  | PView TypedExpr MPat Type
  | PUnsaid String

use MPat.*

record MRow = {
  cols : [(Int, Type, MPat)],
  binds : [(Int, String, Int, Type)],
  guard : Maybe TypedExpr,
  body : [Slot] -> Core
}

-- A typed pattern, as the compiler reads it.
fun mpat (env : Env) (p : TypedPat) : MPat =
  let a = env.a in
  let t = typTypedPat a p in
  match viewTypedPat a (bare a p) with
  | TypedPatView.Var r -> PBind r.id (nameOf env r.id) PWild
  | TypedPatView.Wild _ -> PWild
  | TypedPatView.Unit _ -> PWild
  | TypedPatView.As r -> PBind r.id (nameOf env r.id) (mpat env r.pat)
  | TypedPatView.Cons r ->
      let id = typedRefId a r.ref in
      let name = nameOf env id in
      if (name == "True" or name == "False") and t == Con "Bool" [] then
        PCon id name (Head.BoolLit (name == "True")) []
      else
        (let args =
           (match (namedOf env id t, V.len r.args, V.get r.args 0) with
            | (Just labels, 1, Just only) ->
                (match viewTypedPat a (bare a only) with
                 | TypedPatView.Record x -> V.map (\l -> fieldPat env x.fields l) labels
                 | _ -> V.map (mpat env) r.args)
            | _ -> V.map (mpat env) r.args)
         in PCon id name (Head.Con id) args)
  | TypedPatView.Tuple r ->
      let n = V.len r.items in
      PCon (tupleCtor n) (tupleName n) (Head.Con (tupleCtor n)) (V.map (mpat env) r.items)
  | TypedPatView.Lit r -> PLit (viewTypedLit a r.lit) t
  | TypedPatView.Record r ->
      (match recordOf env t with
       | Just (v, _) ->
           PCon
             (idOf env v.name)
             (lastOf v.name)
             (conHead env v)
             (V.map (\l -> fieldPat env r.fields l) (labelsOf v))
       | None ->
           (match recordFieldsOf t with
            | Just fields ->
                let labels = V.map fst fields in
                PCon
                  (shapeCtor labels)
                  (shapeName labels)
                  (Head.Con (shapeCtor labels))
                  (V.map (\l -> fieldPat env r.fields l) labels)
            | None -> PUnsaid "record-row-variable"))
  | TypedPatView.List r ->
      V.foldr
        (\x acc ->
          PCon (idOf env "List.Cons") "Cons" (Head.Con (idOf env "List.Cons")) [mpat env x, acc])
        (PCon (idOf env "List.Nil") "Nil" (Head.Con (idOf env "List.Nil")) [])
        r.items
  | TypedPatView.Array _ -> PUnsaid "collection-pattern"
  | TypedPatView.Vector _ -> PUnsaid "collection-pattern"
  | TypedPatView.View r -> PView r.fn (mpat env r.pat) (typTypedPat a r.pat)
  | _ -> PUnsaid "pattern"

fun fieldPat (env : Env) (fields : [TypedPatField]) (label : String) : MPat =
  match V.find (\f -> typedNameText env.a (typedPatFieldName env.a f) == label) fields with
  | Just f -> mpat env (typedPatFieldPat env.a f)
  | None -> PWild

-- The first kind a pattern says nothing of, anywhere in it.
fun unsaid (p : MPat) : Maybe String =
  match p with
  | PUnsaid k -> Just k
  | PBind _ _ q -> unsaid q
  | PCon _ _ _ ps -> V.foldl (\acc q -> match acc with | Just _ -> acc | None -> unsaid q) None ps
  | PView _ q _ -> unsaid q
  | _ -> None

-- A `match` of `scrut`, of type `t`, valid in `ctx`: each arm its pattern,
-- its guard, and its body in the scope its pattern makes.
fun matching
    (env : Env)
    (ctx : [Slot])
    (scrut : Core)
    (t : Type)
    (arms : [(TypedPat, Maybe TypedExpr, [Slot] -> Core)])
    : Core =
  let pats = V.map (\x -> match x with | (p, _, _) -> mpat env p) arms in
  match V.foldl (\acc p -> match acc with | Just _ -> acc | None -> unsaid p) None pats with
  | Just kind -> unmapped kind
  | None ->
      let rows =
        \(lvl : Int) ->
          V.map
            (\k ->
              match V.get arms k with
              | Just (_, g, body) ->
                  MRow { cols = [(lvl, t, V.getOr PWild pats k)], binds = [], guard = g, body }
              | None -> MRow { cols = [], binds = [], guard = None, body = \c -> noMatch })
            (V.range 0 (V.len arms))
      in (match scrut with
          | Core.Var i _ -> compile env ctx (rows (V.len ctx - 1 - i)) None
          | _ ->
              let inner = V.pushBack ctx (Anon "s" (Just (typeOf env ctx t))) in
              Core.Let "s" scrut (compile env inner (rows (V.len ctx)) None))

-- A row with what its patterns bind taken out of them, and those that test
-- nothing gone.
fun settled (r : MRow) : MRow =
  let step =
    \acc col ->
      match acc with
      | (cols, binds) ->
          (match col with
           | (lvl, ty, p) ->
               (match peeled p lvl ty [] with
                | (PWild, bs) -> (cols, V.append binds bs)
                | (q, bs) -> (V.pushBack cols (lvl, ty, q), V.append binds bs)))
  in match V.foldl step ([], r.binds) r.cols with
     | (cols, binds) -> { r | cols = cols, binds = binds }

fun peeled (p : MPat) (lvl : Int) (ty : Type) (acc : [(Int, String, Int, Type)])
    : (MPat, [(Int, String, Int, Type)]) =
  match p with
  | PBind id name q -> peeled q lvl ty (V.pushBack acc (id, name, lvl, ty))
  | other -> (other, acc)

-- The rows, compiled. Where none is left, the match goes on with the rows
-- after the block it is in (`fallback`: the level of a function of `()`
-- that does), or fails.
--
-- A split on a constructor or a literal takes every row, a row that does
-- not test the variable going into each alternative, so that a match that
-- covers every value has a tree with no leaf of no arm. Where a view tests
-- the variable, rows are compiled a block at a time instead (Augustsson's
-- mixture rule): the first rows that test it the way the first row does.
-- A row that does not test it is not copied into each alternative of a
-- split on it, where its body would be written once for each -- as the
-- rows after a view are, a view for each row, to a size exponential in
-- them; the rows after the block are a function of `()` written once,
-- which each alternative where the block has nothing calls.
fun compile (env : Env) (ctx : [Slot]) (rows0 : [MRow]) (fallback : Maybe Int) : Core =
  let rows = V.map settled rows0 in
  match V.get rows 0 with
  | None -> failure ctx fallback
  | Just r ->
      (match V.get r.cols 0 with
       | None -> taken env ctx r (V.drop rows 1) fallback
       | Just (lvl, ty, p) ->
           let viewing =
             V.any
               (\(r2 : MRow) ->
                 match colAt r2 lvl with
                 | Just (PView _ _ _) -> True
                 | _ -> False)
               rows
           in
           let n = if viewing then blockOf env ctx rows lvl p else V.len rows in
           if n >= V.len rows then split env ctx rows lvl ty p fallback
           else
             (let rest =
                compile env (V.pushBack ctx (Anon "_" (Just unitType))) (V.drop rows n) fallback
              in
              let inner = V.pushBack ctx (Anon "fallback" None) in
              Core.Let
                "fallback"
                (lam "_" (Just unitType) rest)
                (split env inner (V.take rows n) lvl ty p (Just (V.len ctx)))))

-- No row left: the rows after the block, or a failure.
fun failure (ctx : [Slot]) (fallback : Maybe Int) : Core =
  match fallback with
  | Just l -> Core.App (varAt ctx l) (Core.Lit Literal.Unit)
  | None -> noMatch

-- How many rows from the first test the variable at `lvl` as `p` does: by
-- a constructor, by a literal, or by a view of the same function.
fun blockOf (env : Env) (ctx : [Slot]) (rows : [MRow]) (lvl : Int) (p : MPat) : Int =
  let key = viewKey env ctx p in
  let alike =
    \(r : MRow) ->
      match (colAt r lvl, p) with
      | (Just (PCon _ _ _ _), PCon _ _ _ _) -> True
      | (Just (PLit _ _), PLit _ _) -> True
      | (Just q, PView _ _ _) -> viewKey env ctx q == key
      | _ -> False
  in M.unwrapOr (V.len rows) (indexWhere (\(r : MRow) -> not (alike r)) rows)

-- A view's function as the core writes it, to tell views of one function.
fun viewKey (env : Env) (ctx : [Slot]) (p : MPat) : String =
  match p with
  | PView f _ _ -> shown False (expr env ctx f)
  | _ -> ""

-- A row that tests nothing more: what it binds, its guard, and its body,
-- the rows after it where the guard does not hold.
fun taken (env : Env) (ctx : [Slot]) (r : MRow) (rest : [MRow]) (fallback : Maybe Int) : Core =
  bound env ctx r.binds (\c ->
    match r.guard with
    | None -> r.body c
    | Just g ->
        Core.Case (expr env c g) [
          CaseAlt.CaseAlt (Head.BoolLit True) "True" [] (r.body c),
          CaseAlt.CaseAlt (Head.BoolLit False) "False" [] (compile env c rest fallback)
        ])

fun bound (env : Env) (ctx : [Slot]) (binds : [(Int, String, Int, Type)]) (k : [Slot] -> Core)
    : Core =
  match V.get binds 0 with
  | None -> k ctx
  | Just (id, name, lvl, ty) ->
      Core.Let
        name
        (varAt ctx lvl)
        (bound env (V.pushBack ctx (Local id name (Just (typeOf env ctx ty)))) (V.drop binds 1) k)

-- The pattern of `r` against the variable at `lvl`, if it has one.
fun colAt (r : MRow) (lvl : Int) : Maybe MPat =
  M.map
    (\c -> match c with | (_, _, p) -> p)
    (V.find (\c -> match c with | (l, _, _) -> l == lvl) r.cols)

-- `r` with its pattern against `lvl` replaced by `cols`.
fun replaced (r : MRow) (lvl : Int) (cols : [(Int, Type, MPat)]) : MRow =
  {
    r | cols = V.concatMap (\c -> match c with | (l, _, _) -> if l == lvl then cols else [c]) r.cols
  }

-- A block, each of its rows testing the variable at `lvl` as `p` does.
fun split
    (env : Env)
    (ctx : [Slot])
    (rows : [MRow])
    (lvl : Int)
    (ty : Type)
    (p : MPat)
    (fallback : Maybe Int)
    : Core =
  match p with
  | PView f q qty -> viewed env ctx rows lvl f qty fallback
  | PLit l lty -> tested env ctx rows lvl ty l fallback
  | PCon _ _ _ _ -> constructed env ctx rows lvl ty fallback
  | _ -> unmapped "pattern"

-- Views of one function, `(f -> q)`: `f` applied to the variable, and what
-- it answers matched against each row's `q`.
fun viewed
    (env : Env)
    (ctx : [Slot])
    (rows : [MRow])
    (lvl : Int)
    (f : TypedExpr)
    (qty : Type)
    (fallback : Maybe Int)
    : Core =
  let fc = expr env ctx f in
  let fresh = V.len ctx in
  let inner = V.pushBack ctx (Anon "v" (Just (typeOf env ctx qty))) in
  let moved =
    V.map
      (\(r : MRow) ->
        match colAt r lvl with
        | Just (PView _ q2 _) -> replaced r lvl [(fresh, qty, q2)]
        | _ -> r)
      rows
  in Core.Let "v" (Core.App fc (varAt ctx lvl)) (compile env inner moved fallback)

-- Literals: the variable compared with the first, the rows that want it
-- taken where it is, the others where it is not.
fun tested
    (env : Env)
    (ctx : [Slot])
    (rows : [MRow])
    (lvl : Int)
    (ty : Type)
    (l : TypedLitView)
    (fallback : Maybe Int)
    : Core =
  let lit = literalAt l ty in
  let key = shown False lit in
  let same =
    \(r : MRow) ->
      match colAt r lvl with
      | Just (PLit l2 _) -> shown False (literalAt l2 ty) == key
      | _ -> False
  in
  let other =
    \(r : MRow) ->
      match colAt r lvl with
      | Just (PLit l2 _) -> shown False (literalAt l2 ty) != key
      | _ -> False
  in
  let yes =
    V.map (\r -> if same r then replaced r lvl [] else r) (V.filter (\r -> not (other r)) rows)
  in
  let no = V.filter (\r -> not (same r)) rows in
  match equality env ctx ty (varAt ctx lvl) l with
  | Just test ->
      Core.Case test [
        CaseAlt.CaseAlt (Head.BoolLit True) "True" [] (compile env ctx yes fallback),
        CaseAlt.CaseAlt (Head.BoolLit False) "False" [] (compile env ctx no fallback)
      ]
  | None -> unmapped "literal-pattern"

-- Whether `x`, of type `t`, is literal `l`: an `Int` by the core's own
-- equality, a character by its code, a string by `stringCompare`, and a
-- sized number by Meadow's equality at its type.
fun equality (env : Env) (ctx : [Slot]) (t : Type) (x : Core) (l : TypedLitView) : Maybe Core =
  let intEq = \a b -> apps (Core.Prim Prim.IntEq) [a, b] in
  match (t, l) with
  | (Con "BigInt" [], _) -> None
  | (Con "Int" [], TypedLitView.Int _) -> Just (intEq x (literalAt l t))
  | (Con "Int64" [], TypedLitView.Int _) -> Just (intEq x (literalAt l t))
  | (Con "Char" [], TypedLitView.Char r) ->
      Just
        (intEq
           (apps (Core.Opaque (primId env "charCode") "charCode") [emptyRow, x])
           (Core.Lit (Literal.Int (M.unwrapOr 0 (S.toInt r.text)))))
  | (Con "String" [], TypedLitView.String _) ->
      Just
        (intEq
           (apps (Core.Opaque (primId env "stringCompare") "stringCompare") [
              emptyRow,
              emptyRow,
              x,
              literalAt l t
            ])
           (Core.Lit (Literal.Int 0)))
  -- (a variable over number types: the literal read through its
  -- dictionary, and compared at that type)
  | (Var _, _) ->
      Just
        (apps (Core.Opaque (primId env "_primEq") "_primEq") [
           typeOf env ctx t,
           emptyRow,
           emptyRow,
           x,
           literal env ctx l t
         ])
  | (Con n [], _) ->
      if V.elem n numberTypes or n == "Float64" then
        Just
          (apps (Core.Opaque (primId env "_primEq") "_primEq") [
             typeOf env ctx t,
             emptyRow,
             emptyRow,
             x,
             literalAt l t
           ])
      else None
  | _ -> None

-- Constructors: a `case` of every constructor of the variable's type, the
-- rows that want each going into its alternative with its fields' patterns.
fun constructed
    (env : Env)
    (ctx : [Slot])
    (rows : [MRow])
    (lvl : Int)
    (ty : Type)
    (fallback : Maybe Int)
    : Core =
  match signature env ty with
  | None -> unmapped "nested-pattern"
  | Just sig ->
      let alts =
        V.map
          (\x ->
            match x with
            | (cid, cname, head, labels, ftys) ->
                let base = V.len ctx in
                -- (each field's type where it is bound, under those before it)
                let fields =
                  V.foldl
                    (\acc j ->
                      V.pushBack
                        acc
                        (Anon
                           (V.getOr "x" labels j)
                           (Just (typeOf env (V.append ctx acc) (V.getOr Error ftys j)))))
                    []
                    (V.range 0 (V.len ftys))
                in
                let cols =
                  V.map (\j -> (base + j, V.getOr Error ftys j)) (V.range 0 (V.len ftys))
                in
                let picked =
                  V.concatMap
                    (\(r : MRow) ->
                      match colAt r lvl with
                      | Just (PCon c _ h ps) ->
                          if h == head then
                            [replaced
                               r
                               lvl
                               (V.map
                                  (\j ->
                                    match V.get cols j with
                                    | Just (l, t) -> (l, t, V.getOr PWild ps j)
                                    | None -> (0, Error, PWild))
                                  (V.range 0 (V.len cols)))]
                          else []
                      | _ -> [r])
                    rows
                in CaseAlt.CaseAlt
                     head
                     cname
                     (V.map slotName fields)
                     (compile env (V.append ctx fields) picked fallback))
          sig
      in Core.Case (varAt ctx lvl) alts

-- Every constructor of a type, each its unique, its name, its head in a
-- `case`, its fields' labels and its fields' types there; where the
-- translation knows them.
fun signature (env : Env) (t : Type) : Maybe [(Int, String, Head, [String], [Type])] =
  match t with
  | Con "Bool" [] ->
      Just [
        (idOf env "Bool.True", "True", Head.BoolLit True, [], []),
        (idOf env "Bool.False", "False", Head.BoolLit False, [], [])
      ]
  | Con name args ->
      M.map
        (\vs ->
          V.map
            (\(v : VariantSig) ->
              let id = idOf env v.name in
              (
                id,
                lastOf v.name,
                Head.Con id,
                labelsOf v,
                V.map (\f -> substBound f args) v.fields
              ))
            vs)
        (H.lookup name env.variants)
  | Tuple ts ->
      let n = V.len ts in
      Just [(tupleCtor n, tupleName n, Head.Con (tupleCtor n), [], ts)]
  | Record _ ->
      M.map
        (\fields ->
          let labels = V.map fst fields in
          [(
            shapeCtor labels,
            shapeName labels,
            Head.Con (shapeCtor labels),
            labels,
            V.map snd fields
          )])
        (recordFieldsOf t)
  | _ -> None

-- --- records -----------------------------------------------------------------

-- A named record's one constructor, and the type's arguments.
fun recordOf (env : Env) (t : Type) : Maybe (VariantSig, [Type]) =
  match t with
  | Con name args ->
      (match H.lookup name env.variants with
       | Just vs ->
           (match (V.len vs, V.get vs 0) with
            | (1, Just (v : VariantSig)) -> if M.isSome v.labels then Just (v, args) else None
            | _ -> None)
       | None -> None)
  | _ -> None

-- A structural record type's fields, sorted by label, where it is closed.
fun recordFieldsOf (t : Type) : Maybe [(String, Type)] =
  match t with | Record r -> recordFields r | _ -> None

fun labelsOf (v : VariantSig) : [String] = M.unwrapOr [] v.labels

-- The labels of constructor `id`'s fields, where they are named, by the
-- type `t` it builds.
fun namedOf (env : Env) (id : Int) (t : Type) : Maybe [String] =
  match resultOf t with
  | Con name _ ->
      M.andThen
        (\(v : VariantSig) -> v.labels)
        (M.andThen
           (\vs -> V.find (\(v : VariantSig) -> H.lookup v.name env.ids == Just id) vs)
           (H.lookup name env.variants))
  | _ -> None

-- What a constructor's type builds.
fun resultOf (t : Type) : Type = match t with | Fun _ r _ -> resultOf r | other -> other

-- A key of inference's tables, whose parts are a line each, as one line.
fun spaced (key : String) : String = S.join " " (S.split "\n" key)

fun constructor (env : Env) (v : VariantSig) : Core = Core.Opaque (idOf env v.name) (lastOf v.name)

fun conHead (env : Env) (v : VariantSig) : Head = Head.Con (idOf env v.name)

-- A named record `base` with `fields` given again: taken apart, and built
-- again of the fields given and those it had.
fun updated
    (env : Env)
    (ctx : [Slot])
    (base : TypedExpr)
    (fields : [TypedExprField])
    (v : VariantSig)
    (targs : [Type])
    : Core =
  let a = env.a in
  let labels = labelsOf v in
  let n = V.len labels in
  let inside = V.append ctx (V.map (\l -> Anon l None) labels) in
  Core.Case
    (expr env ctx base)
    [CaseAlt.CaseAlt
       (conHead env v)
       (lastOf v.name)
       labels
       (apps
          (constructor env v)
          (V.append
             (V.map (typeOf env inside) targs)
             (V.map
                (\j ->
                  let label = V.getOr "" labels j in
                  match V.find (\f -> typedNameText a (typedExprFieldName a f) == label) fields with
                  | Just f -> expr env inside (typedExprFieldValue a f)
                  | None -> Core.Var (n - 1 - j) label)
                (V.range 0 n))))]

-- A structural record of type `t`, of `fields`: its constructor applied to
-- them in its labels' order, each value bound first, in the order written,
-- where that is another.
fun structural (env : Env) (ctx : [Slot]) (t : Type) (fields : [TypedExprField]) : Core =
  match recordFieldsOf t with
  | None -> unmapped "record-row-variable"
  | Just sorted ->
      let a = env.a in
      let labels = V.map fst sorted in
      let written = V.map (\f -> typedNameText a (typedExprFieldName a f)) fields in
      let head =
        apps
          (Core.Opaque (shapeCtor labels) (shapeName labels))
          (V.map (\f -> typeOf env ctx (snd f)) sorted)
      in if written == labels then
           V.foldl (\acc f -> Core.App acc (expr env ctx (typedExprFieldValue a f))) head fields
         else
           (let n = V.len fields in
            let inner = V.append ctx (V.map (\w -> Anon w None) written) in
            let body =
              apps
                (shift n head)
                (V.map
                   (\l ->
                     match indexWhere (\w -> w == l) written with
                     | Just j -> Core.Var (n - 1 - j) l
                     | None -> unmapped "missing-field")
                   labels)
            in V.foldr
                 (\j acc ->
                   Core.Let
                     (V.getOr "x" written j)
                     (match V.get fields j with
                      | Just f -> expr env (V.take inner (V.len ctx + j)) (typedExprFieldValue a f)
                      | None -> Core.Error)
                     acc)
                 body
                 (V.range 0 n))

-- A structural record `base` with `fields` given again or added, of type
-- `t`: taken apart and built again.
fun extended (env : Env) (ctx : [Slot]) (base : TypedExpr) (fields : [TypedExprField]) (t : Type)
    : Core =
  let a = env.a in
  match (recordFieldsOf (typTypedExpr a base), recordFieldsOf t) with
  | (Just had, Just made) ->
      let old = V.map fst had in
      let n = V.len old in
      let inside = V.append ctx (V.map (\l -> Anon l None) old) in
      Core.Case
        (expr env ctx base)
        [CaseAlt.CaseAlt
           (Head.Con (shapeCtor old))
           (shapeName old)
           old
           (apps
              (Core.Opaque (shapeCtor (V.map fst made)) (shapeName (V.map fst made)))
              (V.append
                 (V.map (\f -> typeOf env inside (snd f)) made)
                 (V.map
                    (\f ->
                      let label = fst f in
                      match V.find
                        (\x -> typedNameText a (typedExprFieldName a x) == label)
                        fields with
                      | Just x -> expr env inside (typedExprFieldValue a x)
                      | None ->
                          (match indexWhere (\l -> l == label) old with
                           | Just j -> Core.Var (n - 1 - j) label
                           | None -> unmapped "missing-field"))
                    made)))]
  | _ -> unmapped "record-row-variable"

-- --- declarations ------------------------------------------------------------

fun schemeTypeOf (env : Env) (id : Int) : Core =
  match H.lookup id env.schemes with
  | Just sc -> schemeType env [] sc
  | None -> unmapped "no-scheme"

-- A declaration of a module, and the `impl`s' dictionaries' binders still
-- to give out, the next first.
fun declDefs (env : Env) (d : TypedDecl) (dict : Int) : ([Def], Int) =
  match viewTypedDecl env.a d with
  | TypedDeclView.Bind r -> (bindDefs env "def" r.bind, dict)
  | TypedDeclView.Attributed r -> declDefs env r.decl dict
  | TypedDeclView.Trait r -> (V.concatMap (bindDefs env "default") r.defaults, dict)
  | TypedDeclView.Impl r ->
      let methods = V.concatMap (bindDefs env "method") r.methods in
      let own =
        V.concatMap
          (\b ->
            match viewTypedBind env.a b with
            | TypedBindView.Fun f -> [(nameOf env f.id, f.id)]
            | TypedBindView.Pat p ->
                (match viewTypedPat env.a (bare env.a p.pat) with
                 | TypedPatView.Var v -> [(nameOf env v.id, v.id)]
                 | _ -> []))
          r.methods
      in (V.pushBack methods (implDef env dict own), dict - 1)
  | _ -> ([], dict)

fun bindDefs (env0 : Env) (kind : String) (b : TypedBind) : [Def] =
  match viewTypedBind env0.a b with
  | TypedBindView.Fun r ->
      let env = { env0 | owner = nameOf env0 r.id } in
      let made =
        lifted (generic env [] r.id (\c -> lambdas env c r.params (\c2 -> expr env c2 r.body)))
      in V.pushFront
           (snd made)
           (Def {
              kind,
              name = nameOf env r.id,
              unique = r.id,
              ty = schemeTypeOf env r.id,
              term = Just (fst made)
            })
  | TypedBindView.Pat r ->
      (match simple env0 r.pat None with
       | Just (Local id name _) ->
           let env = { env0 | owner = name } in
           let made = lifted (generic env [] id (\c -> expr env c r.value)) in
           V.pushFront
             (snd made)
             (Def { kind, name, unique = id, ty = schemeTypeOf env id, term = Just (fst made) })
       | _ ->
           [Def {
              kind,
              name = "_",
              unique = 0 - 1,
              ty = unmapped "top-level-pattern",
              term = Just (unmapped "top-level-pattern")
            }])

-- An `impl`'s dictionary, under binder `dict`: a function of the types it
-- is generic in and of the dictionaries its `where` asks for, holding the
-- dictionary of each trait its trait requires, then each method -- `own`,
-- its own, by name, or the trait's default given this dictionary -- each a
-- function of the types the method is generic in beyond its trait.
fun implDef (env0 : Env) (dict : Int) (own : [(String, Int)]) : Def =
  let env = { env0 | owner = "impl" } in
  match implOf env dict (\(i : ImplDef) -> True) with
  | None ->
      Def {
        kind = "impl",
        name = nameOf env dict,
        unique = 0 - 1,
        ty = unmapped "impl",
        term = Just (unmapped "impl")
      }
  | Just (key, (i : ImplDef)) ->
      let tr = implTrait i in
      let ty = schemeType env [] i.scheme in
      let name = "#impl.${spaced key}" in
      let unique = implUnique key in
      (match (H.lookup tr env.shapes, dictVariant env tr) with
       | (Just (shape : TraitShape), Just (v : VariantSig)) ->
           let term =
             generic env [] dict (\ctx ->
               let g = H.lookup dict env.generics in
               let vars = M.unwrapOr [] (M.map (\(x : Generalized) -> x.vars) g) in
               let at =
                 (match i.scheme.ty with
                  | Con _ args -> V.map (\x -> substBound x (V.map (\w -> Var w) vars)) args
                  | _ -> [])
               in
               let found = M.unwrapOr [] (H.lookup "dict:${show dict}" env.evidence) in
               let supers =
                 V.map
                   (\k ->
                     match V.get found k with
                     | Just e ->
                         evidence
                           env
                           ctx
                           (M.unwrapOr "" (M.map (\(x : Super) -> x.tr) (V.get shape.supers k)))
                           e
                     | None -> unmapped "required-trait-dictionary")
                   (V.range 0 (V.len shape.supers))
               in
               let fields =
                 V.map
                   (\m -> methodField env ctx tr shape (implHead key) i.scheme vars at own m)
                   shape.methods
               in apps (constructor env v) (V.concat [V.map (typeOf env ctx) at, supers, fields]))
           in Def { kind = "impl", name, unique, ty, term = Just term }
       | _ -> Def { kind = "impl", name, unique, ty, term = Just (unmapped "dictionary-record") })

-- The field of an `impl`'s dictionary for method `m`: a function of the
-- types the method is generic in beyond its trait, of the `impl`'s own
-- method at the method's type here, or of the trait's default.
fun methodField
    (env : Env)
    (ctx : [Slot])
    (tr : String)
    (shape : TraitShape)
    (selfHead : Core)
    (isc : Scheme)
    (vars : [Int])
    (at : [Type])
    (own : [(String, Int)])
    (m : String)
    : Core =
  match H.lookup "${tr}\n${m}" env.methods with
  | None -> unmapped "dictionary-field"
  | Just (msc : Scheme) ->
      let np = V.len at in
      let mine = V.range np (V.len msc.quant) in
      -- The method's own variables, as variables of the dictionary's: below
      -- every variable of the arena's.
      let marker = \k -> 0 - 1000 - k in
      let here =
        substBound
          msc.ty
          (V.map
             (\k -> if k < np then V.getOr Error at k else Var (marker k))
             (V.range 0 (V.len msc.quant)))
      in
      let ownLams =
        \(c : [Slot]) (body : [Slot] -> Core) ->
          V.foldr
            (\k acc ->
              \c2 ->
                let kind = kindOf (V.getOr VarKind.Plain msc.quant k) in
                lam
                  (letter k)
                  (Just kind)
                  (acc (V.pushBack c2 (Quant (marker k) k (letter k) kind))))
            body
            mine
            c
      in ownLams ctx (\c ->
           match V.find (\o -> fst o == m) own with
           | Just (_, mid) -> givenAt env c mid here (implDicts env c)
           | None ->
               (match H.lookup "${tr}\n${m}" env.defaults with
                | Just did ->
                    let self =
                      instantiated
                        env
                        c
                        selfHead
                        isc
                        (V.map (\w -> Var w) vars)
                        (V.map snd (implDicts env c))
                    in givenAt env c did here (V.pushFront (implDicts env c) (tr, self))
                | None -> unmapped "missing-method"))

-- The dictionaries in scope, each with its trait, outermost first.
fun implDicts (env : Env) (ctx : [Slot]) : [(String, Core)] =
  V.concatMap
    (\j ->
      match V.get ctx j with
      | Just (Dict _ (p : Pred) _) -> [(p.tr, varAt ctx j)]
      | _ -> [])
    (V.range 0 (V.len ctx))

-- Binder `id` at type `t`, given those of `ds` its `where` asks for, in
-- order.
fun givenAt (env : Env) (ctx : [Slot]) (id : Int) (t : Type) (ds : [(String, Core)]) : Core =
  match H.lookup id env.schemes with
  | None -> unmapped "no-scheme"
  | Just sc ->
      let asks = M.unwrapOr (V.map (\(p : Pred) -> p.tr) sc.preds) (H.lookup id env.wheres) in
      let picked =
        fst
          (V.foldl
             (\acc tr ->
               match acc with
               | (got, rest) ->
                   (match indexWhere (\d -> fst d == tr) rest with
                    | Just k ->
                        (
                          V.pushBack got (snd (V.getOr ("", Core.Error) rest k)),
                          V.drop rest (k + 1)
                        )
                    | None -> (V.pushBack got (unmapped "dictionary-not-in-scope"), rest)))
             ([], ds)
             asks)
      in instantiated env ctx (Core.Opaque id (nameOf env id)) sc (instTypes sc [] t H.empty) picked

-- What the unit declares of types, as it tells the units after it.
fun typeDefs (env : Env) (types : TypeEnv) (items : [Item]) : [Def] =
  let datas =
    V.concatMap
      (\(e : Entry [VariantSig]) ->
        let kinds = dataKinds env e.key in
        V.append
          [Def {
             kind = "data",
             name = e.key,
             unique = idOf env e.key,
             ty = constructorType kinds (Core.Type 0),
             term = None
           }]
          (V.map
             (\(v : VariantSig) ->
               Def {
                 kind = "con",
                 name = v.name,
                 unique = idOf env v.name,
                 ty = ctorType env e.key v,
                 term = None
               })
             e.value))
      types.variants
  in
  let effects =
    V.concatMap
      (\(e : Entry EffectInfo) ->
        let params = e.value.params in
        let quants = V.map (\i -> Quant (0 - 1) i (letter i) typeKind) (V.range 0 params) in
        let applied =
          apps
            (typeCon env e.key)
            (V.map (\i -> Core.Var (params - 1 - i) (letter i)) (V.range 0 params))
        in V.append
             [Def {
                kind = "effect",
                name = e.key,
                unique = idOf env e.key,
                ty = constructorType (V.map (\i -> Core.Type 0) (V.range 0 params)) effectKind,
                term = None
              }]
             (V.map
                (\(op : EffOp) ->
                  Def {
                    kind = "op",
                    name = "${e.key}.${op.name}",
                    unique = opId items e.key op.name,
                    -- (its scheme's, where inference says it: a mention of it
                    -- is at the row it is performed in)
                    ty =
                      M.unwrapOr
                        (V.foldr
                           (\i acc -> pi (letter i) Icit.Implicit (Core.Type 0) acc)
                           (pi
                              "_"
                              Icit.Explicit
                              (typeOf env quants op.arg)
                              (Core.Comp
                                 (typeOf env (V.pushBack quants (Anon "_" None)) op.ret)
                                 (Core.Row [shift 1 applied] [])))
                           (V.range 0 params))
                        (M.map
                           (schemeType env [])
                           (H.lookup (opId items e.key op.name) env.schemes)),
                    term = None
                  })
                e.value.ops))
      types.effects
  in
  let aliases =
    V.map
      (\(e : Entry AliasDef) ->
        let params = e.value.params in
        let quants = V.map (\i -> Quant (0 - 1) i (letter i) typeKind) (V.range 0 params) in
        Def {
          kind = "alias",
          name = e.key,
          unique = idOf env e.key,
          ty =
            constructorType (V.map (\i -> Core.Type 0) (V.range 0 params)) (aliasKind e.value.body),
          term =
            Just
              (V.foldr
                 (\i acc -> lam (letter i) (Just (Core.Type 0)) acc)
                 (typeOf env quants e.value.body)
                 (V.range 0 params))
        })
      types.aliases
  in
  let traits =
    V.map
      (\(e : Entry TraitShape) ->
        Def {
          kind = "trait",
          name = e.key,
          unique = 0 - 1,
          ty = constructorType (dataKinds env e.key) (Core.Type 0),
          term = None
        })
      types.shapes
  in
  let methods =
    V.map
      (\(e : Entry Scheme) ->
        let parts = S.split "\n" e.key in
        let tr = V.getOr "" parts 0 in
        let m = V.getOr "" parts 1 in
        Def {
          kind = "method",
          name = S.join "." parts,
          unique = methodId items tr m,
          ty = schemeType env [] e.value,
          term = Just (selector env tr (H.lookup tr env.shapes) m e.value)
        })
      types.methods
  in V.concat [datas, effects, aliases, traits, methods]

-- The binder of operation `op` of effect `eff`.
fun opId (items : [Item]) (eff : String) (op : String) : Int =
  M.unwrapOr
    (0 - 1)
    (M.map
       (\(it : Item) -> it.id)
       (V.find
          (\(it : Item) -> it.kind == "v" and it.owner == "op:${lastOf eff}" and it.name == op)
          items))

-- What an alias stands for: a row, or a type.
fun aliasKind (t : Type) : Core =
  match t with
  | RowExtend _ _ _ -> effectKind
  | RowEmpty -> effectKind
  | _ -> Core.Type 0

-- The binder of method `m` of trait `tr`: the value of its name the trait's
-- module declares.
fun methodId (items : [Item]) (tr : String) (m : String) : Int =
  M.unwrapOr
    (0 - 1)
    (M.map
       (\(it : Item) -> it.id)
       (V.find (\(it : Item) -> it.kind == "v" and it.owner == lastOf tr and it.name == m) items))

-- What a data type's parameters range over (`kindTable`).
fun dataKinds (env : Env) (name : String) : [Core] = V.map kindOf (paramKinds env name)

-- A constructor's type: its scheme's, but for a trait's dictionary's, whose
-- field for a method generic in more than its trait is generic in the rest.
fun ctorType (env : Env) (typeName : String) (v : VariantSig) : Core =
  match (H.lookup v.name env.ctorSchemes, H.lookup typeName env.shapes) with
  | (Just sc, Just (shape : TraitShape)) -> dictCtorType env typeName v sc
  | (Just sc, None) -> schemeType env [] sc
  | (None, _) -> unmapped "no-scheme"

fun dictCtorType (env : Env) (tr : String) (v : VariantSig) (sc : Scheme) : Core =
  let q = V.len sc.quant in
  let ctx0 =
    V.map
      (\i -> Quant (0 - 1) i (letter i) (kindOf (V.getOr VarKind.Plain sc.quant i)))
      (V.range 0 q)
  in
  let labels = labelsOf v in
  let fieldType =
    \(ctx : [Slot]) (j : Int) ->
      let label = V.getOr "" labels j in
      if S.startsWith "#super." label then typeOf env ctx (V.getOr Error v.fields j)
      else
        (match H.lookup "${tr}\n${label}" env.methods with
         | Just (msc : Scheme) -> ownPis env ctx msc q q
         | None -> typeOf env ctx (V.getOr Error v.fields j))
  in
  let result =
    \(ctx : [Slot]) -> apps (typeCon env tr) (V.map (\i -> typeOf env ctx (Bound i)) (V.range 0 q))
  in
  let fields =
    V.foldr
      (\j acc ->
        \(ctx : [Slot]) ->
          pi "_" Icit.Explicit (fieldType ctx j) (acc (V.pushBack ctx (Anon "_" None))))
      result
      (V.range 0 (V.len labels))
  in V.foldr
       (\i acc -> pi (letter i) Icit.Implicit (kindOf (V.getOr VarKind.Plain sc.quant i)) acc)
       (fields ctx0)
       (V.range 0 q)

-- A method's type in its trait's dictionary: generic in its quantifiers
-- from the `k`th on, those beyond its trait's.
fun ownPis (env : Env) (ctx : [Slot]) (msc : Scheme) (from : Int) (k : Int) : Core =
  match V.get msc.quant k with
  | Just kind ->
      pi
        (letter k)
        Icit.Implicit
        (kindOf kind)
        (ownPis env (V.pushBack ctx (Quant (0 - 1) k (letter k) (kindOf kind))) msc from (k + 1))
  | None -> typeOf env ctx msc.ty

-- Method `m` of trait `tr`, of scheme `sc`: its field of the trait's
-- dictionary, which is a data type of one constructor, applied to the
-- method's own quantifiers.
fun selector (env : Env) (tr : String) (shape : Maybe TraitShape) (m : String) (sc : Scheme)
    : Core =
  match (shape, dictVariant env tr) with
  | (Just (s : TraitShape), Just (v : VariantSig)) ->
      let labels = labelsOf v in
      let n = V.len labels in
      let q = V.len sc.quant in
      let np = s.params + V.len s.assocs in
      (match (indexWhere (\l -> l == m) labels, V.get sc.preds 0) with
       | (Just j, Just p) ->
           if V.len sc.preds != 1 then unmapped "method-with-a-where-of-its-own"
           else
             (let quants =
                V.map
                  (\i -> Quant (0 - 1) i (letter i) (kindOf (V.getOr VarKind.Plain sc.quant i)))
                  (V.range 0 q)
              in
              let dty = predType env quants p in
              let inner =
                V.append
                  (V.pushBack quants (Anon "d0" (Just dty)))
                  (V.map (\l -> Anon l None) labels)
              in V.foldr
                   (\i acc -> lam (letter i) (Just (kindOf (V.getOr VarKind.Plain sc.quant i))) acc)
                   (lam
                      "d0"
                      (Just dty)
                      (Core.Case
                         (Core.Var 0 "d0")
                         [CaseAlt.CaseAlt
                            (conHead env v)
                            (lastOf v.name)
                            labels
                            (apps
                               (Core.Var (n - 1 - j) m)
                               (V.map (\i -> typeOf env inner (Bound i)) (V.range np q)))]))
                   (V.range 0 q))
       | _ -> unmapped "dictionary-field")
  | _ -> unmapped "dictionary-field"

-- Unit `r`, as inference typed it, `done`, with `theirs` what the units it
-- depends on tell it of types and `defaults` their traits' defaults: every
-- declaration of it as the core says it, and what it mentions of theirs.
@pub fun unitDefs
    (r : Renamed)
    (done : Inferred)
    (deps : [DepExports])
    (theirs : [TypeEnv])
    (defaults : [DefaultSig])
    : Translated =
  let all = V.pushBack theirs done.types in
  let items = V.append (V.concatMap (\(d : Declared) -> d.items) r.modules) r.depItems in
  let ids =
    V.foldl
      (\h (i : Item) ->
        if (i.kind == "t" or i.kind == "c") and not (S.isEmpty i.canon) then H.insert i.canon i.id h
        else h)
      H.empty
      items
  in
  let ownDefaults =
    V.foldl
      (\h p ->
        match p with
        | TypedProgram a root ->
            V.foldl (\acc d -> traitDefaults a r.binders items d acc) h (typedModuleDecls a root))
      H.empty
      done.typed
  in
  let depSchemes =
    V.foldl
      (\h k ->
        match V.get defaults k with
        | Just (s : DefaultSig) -> H.insert (depDefault k) s.scheme h
        | None -> h)
      H.empty
      (V.range 0 (V.len defaults))
  in
  let env =
    Env {
      a = newEmptyArena (),
      binders = r.binders,
      ids,
      variants =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl (\g (e : Entry [VariantSig]) -> H.insert e.key e.value g) h t.variants)
          H.empty
          all,
      ctorSchemes =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl (\g (e : Entry Scheme) -> H.insert e.key e.value g) h t.ctors)
          H.empty
          all,
      kinds = H.empty,
      schemes = allSchemes r done deps depSchemes,
      generics = done.generics,
      wheres =
        V.foldl
          (\h k ->
            match V.get defaults k with
            | Just (s : DefaultSig) -> H.insert (depDefault k) s.asks h
            | None -> h)
          done.wheres
          (V.range 0 (V.len defaults)),
      numbers = H.fromVec done.numbers,
      implNames =
        V.foldl
          (\h k ->
            match V.get defaults k with
            | Just (s : DefaultSig) -> H.insert (depDefault k) "#default.${spaced s.key}" h
            | None -> h)
          (V.foldl
             (\h (t : TypeEnv) ->
               V.foldl
                 (\g (e : Entry ImplDef) -> H.insert e.value.dict "#impl.${spaced e.key}" g)
                 h
                 t.impls)
             H.empty
             all)
          (V.range 0 (V.len defaults)),
      impls =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl
              (\g (e : Entry ImplDef) ->
                H.insert
                  e.value.dict
                  (V.pushBack (M.unwrapOr [] (H.lookup e.value.dict g)) (e.key, e.value))
                  g)
              h
              t.impls)
          H.empty
          all,
      implKeys =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl
              (\g (e : Entry ImplDef) -> H.insert (implUnique e.key) (e.key, e.value) g)
              h
              t.impls)
          H.empty
          all,
      shapes =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl (\g (e : Entry TraitShape) -> H.insert e.key e.value g) h t.shapes)
          H.empty
          all,
      methods =
        V.foldl
          (\h (t : TypeEnv) ->
            V.foldl (\g (e : Entry Scheme) -> H.insert e.key e.value g) h t.methods)
          H.empty
          all,
      evidence = done.evidence,
      defaults =
        V.foldl
          (\h k ->
            match V.get defaults k with
            | Just (s : DefaultSig) -> H.insert s.key (depDefault k) h
            | None -> h)
          ownDefaults
          (V.range 0 (V.len defaults)),
      prims = H.fromVec r.prims,
      monos = done.monos,
      owner = "",
      pending = [],
      lifting = []
    }
  in
  let env = { env | kinds = kindTable env.variants env.ctorSchemes env.shapes } in
  let firstDict = firstDictOfTheirs theirs in
  let own =
    fst
      (V.foldl
         (\acc p ->
           match (acc, p) with
           | ((defs, dict), TypedProgram a root) ->
               V.foldl
                 (\acc2 d ->
                   match acc2 with
                   | (ds, k) ->
                       (match declDefs { env | a = a } d k with
                        | (more, next) -> (V.append ds more, next)))
                 (defs, dict)
                 (typedModuleDecls a root))
         ([], firstDict)
         done.typed)
  in
  let defs = V.append (typeDefs env (ownTypes theirs done.types) items) own in
  let made = V.append defs (synthesized env defs) in
  let declared = V.foldl (\h (d : Def) -> H.insert d.unique True h) H.empty made in
  let ext = externs env all items declared made in
  let everything = V.append made ext in
  Translated {
    defs = made,
    externs = ext,
    datas = V.append (dataTable env all) (madeDatas everything),
    globals =
      V.concatMap
        (\(d : Def) ->
          if d.kind == "alias" then (match d.term with | Just t -> [(d.unique, t)] | None -> [])
          else [])
        everything
  }

-- Every binder's scheme the translation reads: the primitives', the
-- dependencies' exported values', each generalized binding's, and the
-- dependencies' defaults' -- the unit's own over the rest.
fun allSchemes (r : Renamed) (done : Inferred) (deps : [DepExports]) (defaults : HashMap Int Scheme)
    : HashMap Int Scheme =
  let prims =
    V.foldl
      (\h p ->
        match primScheme (fst p) with
        | Just sc -> H.insert (snd p) sc h
        | None -> h)
      H.empty
      r.prims
  in
  let exports = V.concatMap (\(d : DepExports) -> d.exports) deps in
  let theirs =
    V.foldl
      (\h k ->
        match (V.get r.depItems k, V.get exports k) with
        | (Just (it : Item), Just (ex : Export)) ->
            (match ex.scheme with
             | Just sc -> H.insert it.id sc h
             | None -> h)
        | _ -> h)
      prims
      (V.range 0 (V.len r.depItems))
  in
  let generalized =
    V.foldl
      (\h kv ->
        match kv with
        | (k, (g : Generalized)) -> H.insert k g.scheme h)
      theirs
      (H.toVec done.generics)
  in
  let own =
    V.foldl
      (\h kv -> H.insert (fst kv) (snd kv) h)
      generalized
      (V.append (H.toVec done.general) (H.toVec done.schemes))
  in V.foldl (\h kv -> H.insert (fst kv) (snd kv) h) own (H.toVec defaults)

-- The binder the first of a unit's own `impl`s' dictionaries has
-- (`Solve.firstDictOf`).
fun firstDictOfTheirs (types : [TypeEnv]) : Int =
  V.foldl
    (\m (t : TypeEnv) -> V.foldl (\n (e : Entry ImplDef) -> min n (e.value.dict - 1)) m t.impls)
    (0 - 2)
    types

-- The defaults a module's trait declares, by their methods' keys.
fun traitDefaults
    (a : TypedArena)
    (binders : [Binder])
    (items : [Item])
    (d : TypedDecl)
    (h : HashMap String Int)
    : HashMap String Int =
  match viewTypedDecl a d with
  | TypedDeclView.Attributed r -> traitDefaults a binders items r.decl h
  | TypedDeclView.Trait r ->
      let tname = typedNameText a r.name in
      let canon =
        M.unwrapOr
          tname
          (M.map
             (\(it : Item) -> it.canon)
             (V.find (\(it : Item) -> it.kind == "t" and it.name == tname) items))
      in V.foldl
           (\acc b ->
             match viewTypedBind a b with
             | TypedBindView.Fun f ->
                 H.insert
                   "${canon}\n${M.unwrapOr "" (M.map (\(x : Binder) -> x.name) (V.get binders f.id))}"
                   f.id
                   acc
             | _ -> acc)
           h
           r.defaults
  | _ -> h

-- Every data type's constructors, by unique, the tuples' and records' among
-- them where the unit's declarations mention them.
fun dataTable (env : Env) (all : [TypeEnv]) : [(Int, [Int])] =
  V.concatMap
    (\(t : TypeEnv) ->
      V.map
        (\(e : Entry [VariantSig]) ->
          (idOf env e.key, V.map (\(v : VariantSig) -> idOf env v.name) e.value))
        t.variants)
    all

-- The data types the translation made, of the tuples and records the
-- declarations mention, and the builtins they mention, as declarations.
fun synthesized (env : Env) (defs : [Def]) : [Def] =
  let found =
    V.foldl
      (\h (d : Def) ->
        let inTerm = (match d.term with | Just t -> opaques t | None -> []) in
        V.foldl
          (\g x ->
            match x with
            | (u, name) ->
                if u >= synthetic + 1000 and u < synthetic + 3000 then
                  H.insert
                    "t${show ((u - synthetic) % 1000)}"
                    (synthetic + 1000 + (u - synthetic) % 1000)
                    g
                else if u >= synthetic + 1099511627776 and S.startsWith "#rec{" name then
                  H.insert name u g
                else if u >= synthetic and u < synthetic + 1000 then H.insert name u g
                else g)
          h
          (V.append (opaques d.ty) inTerm))
      H.empty
      defs
  in V.concatMap
       (\x ->
         match x with
         | (name, u) ->
             if u >= synthetic + 1000 and u < synthetic + 2000 then tupleDefs (u - synthetic - 1000)
             else if S.startsWith "#rec{" name then recordDefs (shapeLabels name)
             else
               [Def { kind = "builtin", name, unique = u, ty = builtinType env name, term = None }])
       (sortOn fst (H.toVec found))

-- The constructors of the data types the translation made.
fun madeDatas (defs : [Def]) : [(Int, [Int])] =
  V.concatMap
    (\(d : Def) ->
      if d.kind != "data" or d.unique < synthetic then []
      else if S.startsWith "#rec{" d.name then [(d.unique, [d.unique + 1])]
      else if S.startsWith "Tuple" d.name then [(d.unique, [d.unique + 1000])]
      else [])
    defs

-- Every constant a term mentions: its unique and its name.
-- A constructor a `case` names counts as mentioned.
fun opaques (c : Core) : [(Int, String)] =
  collectNodes c (\x ->
    match x with
    | Core.Opaque u n -> [(u, n)]
    | Core.Case s alts ->
        V.append
          (V.concatMap
             (\alt ->
               match alt with
               | CaseAlt.CaseAlt (Head.Con u) n _ body -> V.pushFront (opaques body) (u, n)
               | CaseAlt.CaseAlt _ _ _ body -> opaques body)
             alts)
          (opaques s)
    | _ -> [])

fun tupleDefs (n : Int) : [Def] =
  let quants = V.map (\i -> Quant (0 - 1) i (letter i) typeKind) (V.range 0 n) in
  let fields =
    V.foldr
      (\i acc -> \k -> pi "_" Icit.Explicit (Core.Var (k + n - 1 - i) (letter i)) (acc (k + 1)))
      (\k ->
        apps
          (Core.Opaque (tupleType n) (tupleName n))
          (V.map (\i -> Core.Var (k + n - 1 - i) (letter i)) (V.range 0 n)))
      (V.range 0 n)
  in [
       Def {
         kind = "data",
         name = tupleName n,
         unique = tupleType n,
         ty = constructorType (V.map (\i -> typeKind) (V.range 0 n)) typeKind,
         term = None
       },
       Def {
         kind = "con",
         name = tupleName n,
         unique = tupleCtor n,
         ty = V.foldr (\i acc -> pi (letter i) Icit.Implicit typeKind acc) (fields 0) (V.range 0 n),
         term = None
       }
     ]

fun recordDefs (labels : [String]) : [Def] =
  let n = V.len labels in
  let fields =
    V.foldr
      (\i acc ->
        \k ->
          pi
            (V.getOr "_" labels i)
            Icit.Explicit
            (Core.Var (k + n - 1 - i) (letter i))
            (acc (k + 1)))
      (\k ->
        apps
          (Core.Opaque (shapeType labels) (shapeName labels))
          (V.map (\i -> Core.Var (k + n - 1 - i) (letter i)) (V.range 0 n)))
      (V.range 0 n)
  in [
       Def {
         kind = "data",
         name = shapeName labels,
         unique = shapeType labels,
         ty = constructorType (V.map (\i -> typeKind) (V.range 0 n)) typeKind,
         term = None
       },
       Def {
         kind = "con",
         name = shapeName labels,
         unique = shapeCtor labels,
         ty = V.foldr (\i acc -> pi (letter i) Icit.Implicit typeKind acc) (fields 0) (V.range 0 n),
         term = None
       }
     ]

-- What the declarations mention that they do not declare: other units'
-- types, constructors, effects, values and dictionaries, at their types,
-- and the tuples, records and builtins those mention -- until nothing more
-- is mentioned.
fun externs
    (env : Env)
    (all : [TypeEnv])
    (items : [Item])
    (declared : HashMap Int Bool)
    (defs : [Def])
    : [Def] =
  let allDefs =
    typeDefs
      env
      (TypeEnv {
         ctors = V.concatMap (\(t : TypeEnv) -> t.ctors) all,
         variants = V.concatMap (\(t : TypeEnv) -> t.variants) all,
         fields = [],
         effects = V.concatMap (\(t : TypeEnv) -> t.effects) all,
         aliases = V.concatMap (\(t : TypeEnv) -> t.aliases) all,
         shapes = [],
         methods = [],
         assocOf = [],
         impls = []
       })
      items
  in
  let byUnique =
    V.foldl (\h (d : Def) -> if d.unique >= 0 then H.insert d.unique d h else h) H.empty allDefs
  in externsFrom env byUnique declared defs []

fun externsFrom
    (env : Env)
    (byUnique : HashMap Int Def)
    (known : HashMap Int Bool)
    (todo : [Def])
    (acc : [Def])
    : [Def] =
  if V.isEmpty todo then acc
  else
    let wanted =
      V.foldl
        (\h (d : Def) ->
          let inTerm = (match d.term with | Just t -> opaques t | None -> []) in
          V.foldl
            (\g x -> if H.member (fst x) known then g else H.insert (fst x) (snd x) g)
            h
            (V.append (opaques d.ty) inTerm))
        H.empty
        todo
    in
    let fresh =
      V.concatMap (\x -> externOf env byUnique (fst x) (snd x)) (sortOn fst (H.toVec wanted))
    in
    let known2 = V.foldl (\h x -> H.insert (fst x) True h) known (H.toVec wanted) in
    let more =
      V.append
        fresh
        (V.filter (\(d : Def) -> not (H.member d.unique known2)) (synthesized env fresh))
    in
    let known3 = V.foldl (\h (d : Def) -> H.insert d.unique True h) known2 more in
    externsFrom env byUnique known3 more (V.append acc more)

-- Constant `u`, named `name`, as the declarations of another unit say it.
fun externOf (env : Env) (byUnique : HashMap Int Def) (u : Int) (name : String) : [Def] =
  if u == primId env "runSt" then
    [Def { kind = "extern", name, unique = u, ty = runStType, term = None }]
  else
    (match H.lookup u byUnique with
     | Just (d : Def) -> [{ d | kind = "extern" }]
     | None ->
         (match M.map snd (H.lookup u env.implKeys) with
          | Just (i : ImplDef) ->
              [Def {
                 kind = "extern",
                 name,
                 unique = u,
                 ty = schemeType env [] i.scheme,
                 term = None
               }]
          | None ->
              if u >= synthetic and M.isNone (H.lookup u env.schemes) then
                synthesized
                  env
                  [Def { kind = "", name, unique = 0 - 1, ty = Core.Opaque u name, term = None }]
              else
                (match H.lookup u env.schemes with
                 | Just sc ->
                     [Def {
                        kind = "extern",
                        name,
                        unique = u,
                        ty = schemeType env [] sc,
                        term = None
                      }]
                 | None -> [])))

fun emptyTypes () : TypeEnv =
  TypeEnv {
    ctors = [],
    variants = [],
    fields = [],
    effects = [],
    aliases = [],
    shapes = [],
    methods = [],
    assocOf = [],
    impls = []
  }

-- What `mine` says of types that none of `theirs` says: what inference
-- tells the units after this one holds what it was told as well.
fun ownTypes (theirs : [TypeEnv]) (mine : TypeEnv) : TypeEnv =
  let told =
    \(f : TypeEnv -> [String]) ->
      V.foldl (\h (t : TypeEnv) -> V.foldl (\g k -> H.insert k True g) h (f t)) H.empty theirs
  in
  let fresh = \known k -> M.isNone (H.lookup k known) in
  let variants = told (\(t : TypeEnv) -> V.map (\(e : Entry [VariantSig]) -> e.key) t.variants) in
  let ctors = told (\(t : TypeEnv) -> V.map (\(e : Entry Scheme) -> e.key) t.ctors) in
  let effects = told (\(t : TypeEnv) -> V.map (\(e : Entry EffectInfo) -> e.key) t.effects) in
  let aliases = told (\(t : TypeEnv) -> V.map (\(e : Entry AliasDef) -> e.key) t.aliases) in
  let shapes = told (\(t : TypeEnv) -> V.map (\(e : Entry TraitShape) -> e.key) t.shapes) in
  let methods = told (\(t : TypeEnv) -> V.map (\(e : Entry Scheme) -> e.key) t.methods) in
  let impls = told (\(t : TypeEnv) -> V.map (\(e : Entry ImplDef) -> e.key) t.impls) in
  {
    mine | variants = V.filter (\(e : Entry [VariantSig]) -> fresh variants e.key) mine.variants,
    ctors = V.filter (\(e : Entry Scheme) -> fresh ctors e.key) mine.ctors,
    effects = V.filter (\(e : Entry EffectInfo) -> fresh effects e.key) mine.effects,
    aliases = V.filter (\(e : Entry AliasDef) -> fresh aliases e.key) mine.aliases,
    shapes = V.filter (\(e : Entry TraitShape) -> fresh shapes e.key) mine.shapes,
    methods = V.filter (\(e : Entry Scheme) -> fresh methods e.key) mine.methods,
    impls = V.filter (\(e : Entry ImplDef) -> fresh impls e.key) mine.impls
  }

-- An arena with nothing in it, for the declarations no module's tables are
-- read for.
fun newEmptyArena () : TypedArena =
  runSt (\() ->
    match TypedProgram (freezeTyped (newTypedBuilder ())) 0 with
    | TypedProgram a _ -> a)

-- --- what it comes to --------------------------------------------------------

-- Each construct written as a goal, by its kind; each name written with no
-- binder of its own, by what it is; and each match no arm of holds.
fun tally (c : Core) (acc : ([String], [String])) : ([String], [String]) =
  let goals =
    collectNodes c (\x ->
      match x with
      | Core.Runtime (Note.Goal g) _ ->
          if S.startsWith "unmapped:" g then [("u", S.drop g 9)]
          else if g == "no-match" then [("u", "(no-match)")]
          else []
      | Core.Opaque u name -> if u == 0 - 1 then [("n", encodedKind name)] else []
      | _ -> [])
  in V.foldl
       (\a g ->
         if fst g == "u" then (V.pushBack (fst a) (snd g), snd a)
         else (fst a, V.pushBack (snd a) (snd g)))
       acc
       goals

-- The name of a data type or constructor the translation made: a tuple's
-- or a record's.
fun madeName (name : String) : Bool = S.startsWith "#rec{" name or S.startsWith "Tuple" name

fun encodedKind (name : String) : String =
  if S.startsWith "Tuple" name then "tuple"
  else if S.startsWith "#array" name then "array-literal"
  else if S.startsWith "#super." name then "required-trait-field"
  else "name:${name}"

-- A name of no binder is counted as one, and by its name too.
fun kindOfName (k : String) : String = if S.startsWith "name:" k then "type-or-constructor" else k

fun nameOnly (k : String) : [String] = if S.startsWith "name:" k then [S.drop k 5] else []

-- How many of each, most first.
@pub fun counted (kinds : [String]) : [(String, Int)] =
  sortOn
    (\x -> (0 - snd x, fst x))
    (H.toVec (V.foldl (\h k -> H.insert k (M.unwrapOr 0 (H.lookup k h) + 1) h) H.empty kinds))

@pub fun countsText (cs : [(String, Int)]) : String =
  if V.isEmpty cs then "none" else S.join ", " (V.map (\x -> "${fst x} ${show (snd x)}") cs)

-- A goal shown as the kind it stands for, `?kind`.
fun goalsShown (c : Core) : Core =
  transform c 0 (\x d ->
    match x with
    | Core.Runtime (Note.Goal g) Core.Error ->
        Just (Core.Opaque (0 - 1) ("?" ++ (if S.startsWith "unmapped:" g then S.drop g 9 else g)))
    | _ -> None)

-- The kinds of what was not said in a declaration, each once.
@pub fun unsaidIn (d : Def) : [String] =
  let all =
    tally
      d.ty
      (match d.term with
       | Just t -> tally t ([], [])
       | None -> ([], []))
  in V.filter (\k -> k != "(no-match)") (fst all)

-- What `MEADOWBOOT_STRATA` writes of package `pkg`: what was not said, and
-- what was said with names of no binder, counted; what the checker said
-- of the declarations, counted (`verdicts`, a line for each, and their
-- summary); then each declaration, its type, its definition, and what the
-- checker said of it.
@pub fun dumped (pkg : String) (t : Translated) (summary : [String]) (verdicts : [String])
    : String =
  let defs = t.defs in
  let both =
    V.foldl
      (\acc (d : Def) -> tally d.ty (match d.term with | Just x -> tally x acc | None -> acc))
      ([], [])
      defs
  in
  let unsaid = V.filter (\k -> k != "(no-match)") (fst both) in
  let noMatches = V.len (V.filter (\k -> k == "(no-match)") (fst both)) in
  let made =
    V.filter (\(d : Def) -> d.unique >= synthetic and (d.kind == "builtin" or madeName d.name)) defs
  in
  let header =
    V.concat [
      [
        "-- Strata's core for ${pkg}, from MeadowBoot's typed tree (docs/2LTT.md, L1)",
        "-- declarations: ${show (V.len defs)}, of them made by the translation: ${show (V.len made)}",
        "-- unmapped: ${countsText (counted unsaid)}",
        "-- leaves of case trees with no arm left: ${show noMatches}",
        "-- names without a binder: ${countsText (counted (V.map kindOfName (snd both)))}",
        "-- of them, by name: ${countsText (V.take (counted (V.concatMap nameOnly (snd both))) 12)}",
        "-- declarations of other units read: ${show (V.len t.externs)}"
      ],
      V.map (\l -> "-- ${l}") summary
    ]
  in
  let lines =
    V.map
      (\k ->
        match V.get defs k with
        | Just (d : Def) ->
            "${d.kind} ${d.name} : ${shown False (goalsShown d.ty)}"
              ++ (match d.term with
               | Just x -> "\n  = ${shown False (goalsShown x)}"
               | None -> "")
              ++ (match V.get verdicts k with
               | Just v -> "\n  -- ${v}"
               | None -> "")
        | None -> "")
      (V.range 0 (V.len defs))
  in S.join "\n" (V.append header lines) ++ "\n"
