-- --- tests ---------------------------------------------------------------------------

use Std.Test (assertEq)

@test fun everyPrimitiveIsWrittenAsTheRustCompilerWritesIt () =
  let wrong =
    V.concatMap
      (\x ->
        match x with
        | (n, Just s, shown) ->
            (if showScheme s == shown then [] else ["${n}: ${showScheme s}, not ${shown}"])
        | _ -> [])
      prims
  in assertEq wrong [] "each as it is written there"
