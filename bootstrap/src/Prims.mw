    ("stringCompare", Just (Scheme { quant = [Effect, Effect], preds = [], ty = (Fun [(Con "String" [])] (Fun [(Con "String" [])] (Con "Int" []) (Bound 0)) (Bound 1)), lacks = [] }), "String -> String -> Int") ]

-- The scheme of the primitive `name`, if it has one.
@pub fun primScheme (name : String) : Maybe Scheme =
  match V.find (\x -> match x with | (n, _, _) -> n == name) prims with
  | Just (_, s, _) -> s
  | None -> None

