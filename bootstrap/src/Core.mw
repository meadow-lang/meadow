-- Core: what a program compiles to before any back end sees it --
-- `meadow_core`'s `Term`, as Lingua languages (`lang!`), a program of one
-- tables and a node a row of them. There are two:
--
-- `Core` is typed, as `meadow_core` is: every term and pattern holds its
-- type, and a function its parameter's. `Elab` makes it of a typed program,
-- and it is what is lowered to Cut.
--
-- `Erased` is `Core` with its types gone, which is what the CEK machine runs
-- and what the Rust compiler writes of its own for that machine, in
-- `CoreText`: a grammar Lingua makes the parser of (`syntax!`), the language
-- that grammar implies, `Printed` (`lang!`), and a pass from it to `Erased`,
-- `read` (`pass!`), which makes numbers of the numerals and text of the
-- quoted strings. `erase` takes `Core` to it.

use Scythe (lexer!)
use Lingua (syntax!, lang!, pass!)
use Std.Macro (toDatum)
use MeadowBoot.Types
use MeadowBoot.Types.Type.*
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.St (runSt)
use Lingua.Lang (spanMeta)
use Std.String as S
use Std.Char as C
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*

-- --- what the Rust compiler writes -------------------------------------------
--
-- A word says what each thing is, and it comes first: `lam 3 var 3` is a
-- function of binder 3 answering it. A list is in brackets. Numbers are
-- numbers -- a float is its bits -- and names and text are quoted, with
-- `\xNN` for a control byte, a backslash or a quote, so that neither holds
-- one.

@derive(Lexer)
data Word
  = @regex("[ \t\r\n]+") Space
  | @token("[") Open
  | @token("]") Close
  | @token("program") Program
  | @token("defs") Defs
  | @token("fields") Fields
  | @token("var") Var
  | @token("lam") Lam
  | @token("app") App
  | @token("let") Let
  | @token("letrec") LetRec
  | @token("if") If
  | @token("tuple") Tuple
  | @token("array") Array
  | @token("proj") Proj
  | @token("record") Record
  | @token("sel") Sel
  | @token("extend") Extend
  | @token("ctor") Ctor
  | @token("prim") Prim
  | @token("case") Case
  | @token("when") When
  | @token("perform") Perform
  | @token("handle") Handle
  | @token("return") Return
  | @token("join") Join
  | @token("jump") Jump
  | @token("error") Error
  | @token("const") Const
  | @token("int") Int
  | @token("bigint") BigInt
  | @token("f64") F64
  | @token("f32") F32
  | @token("word") Word
  | @token("str") Str
  | @token("char") Char
  | @token("true") True
  | @token("false") False
  | @token("unit") Unit
  | @token("wild") Wild
  | @token("pvar") PVar
  | @token("pas") PAs
  | @token("plit") PLit
  | @token("ptuple") PTuple
  | @token("parray") PArray
  | @token("pctor") PCtor
  | @token("precord") PRecord
  | @regex("-?[0-9]+") Number
  | @regex("\"[^\"]*\"") Quoted

syntax! {
  pub CoreText
  lexer Word
  trivia { Space }
  tokens {
    "[" = Open, "]" = Close, "program" = Program, "defs" = Defs, "fields" = Fields, "var" = Var,
    "lam" = Lam, "app" = App, "let" = Let, "letrec" = LetRec, "if" = If, "tuple" = Tuple,
    "array" = Array, "proj" = Proj, "record" = Record, "sel" = Sel, "extend" = Extend,
    "ctor" = Ctor, "prim" = Prim, "case" = Case, "when" = When, "perform" = Perform,
    "handle" = Handle, "return" = Return, "join" = Join, "jump" = Jump, "error" = Error,
    "const" = Const, "int" = Int, "bigint" = BigInt, "f64" = F64, "f32" = F32, "word" = Word,
    "str" = Str, "char" = Char, "true" = True, "false" = False, "unit" = Unit, "wild" = Wild,
    "pvar" = PVar, "pas" = PAs, "plit" = PLit, "ptuple" = PTuple, "parray" = PArray,
    "pctor" = PCtor, "precord" = PRecord, "number" = Number, "string" = Quoted
  }
  grammar {
    File = "program" entry:"number" "defs" defs:Def* "fields" named:Named*
    Def = id:"number" body:Term
    Named = name:"string" "[" labels:"string"* "]"

    Term = Var | Lam | App | Let | LetRec | If | Tuple | Array | Proj | Record | Sel | Extend
      | Ctor | Prim | Case | Perform | Handle | Join | Jump | Ill | Const
    Var = "var" id:"number"
    Lam = "lam" param:"number" body:Term
    App = "app" func:Term arg:Term
    Let = "let" id:"number" value:Term body:Term
    LetRec = "letrec" "[" binds:Bind* "]" body:Term
    Bind = id:"number" value:Term
    If = "if" cond:Term yes:Term no:Term
    Tuple = "tuple" "[" items:Term* "]"
    Array = "array" "[" items:Term* "]"
    Proj = "proj" tuple:Term index:"number"
    Record = "record" "[" fields:Field* "]"
    Field = label:"string" value:Term
    Sel = "sel" target:Term label:"string"
    Extend = "extend" target:Term label:"string" value:Term
    Ctor = "ctor" name:"string" "[" args:Term* "]"
    Prim = "prim" op:"string" "[" args:Term* "]"
    Case = "case" scrutinee:Term "[" arms:Arm* "]"
    Arm = pat:Pat guard:Guard? body:Term
    Guard = "when" cond:Term
    Perform = "perform" eff:"string" op:"string" arg:Term
    Handle = "handle" body:Term "[" clauses:Clause* "]" ("return" retId:"number" ret:Term)?
    Clause = eff:"string" op:"string" param:"number" resume:"number" body:Term
    Join = "join" id:"number" "[" params:"number"* "]" rhs:Term body:Term
    Jump = "jump" id:"number" "[" args:Term* "]"
    Ill = "error"
    Const = "const" lit:Lit

    Lit = LInt | LBig | LF64 | LF32 | LWord | LStr | LChar | LBool | LUnit
    LInt = "int" value:"number"
    LBig = "bigint" value:"number"
    LF64 = "f64" bits:"number"
    LF32 = "f32" bits:"number"
    LWord = "word" ty:"string" bits:"number"
    LStr = "str" text:"string"
    LChar = "char" code:"number"
    LBool = value:("true" | "false")
    LUnit = "unit"

    Pat = PWild | PVar | PAs | PLit | PTuple | PArray | PCtor | PRecord
    PWild = "wild"
    PVar = "pvar" id:"number"
    PAs = "pas" id:"number" pat:Pat
    PLit = "plit" lit:Lit
    PTuple = "ptuple" "[" items:Pat* "]"
    PArray = "parray" "[" items:Pat* "]"
    PCtor = "pctor" name:"string" "[" args:Pat* "]"
    PRecord = "precord" "[" fields:PField* "]"
    PField = label:"string" pat:Pat
  }
}

-- The language the grammar implies: every number and name still its text.
lang! { Printed from CoreText }

-- --- the language ------------------------------------------------------------

-- Erased core: a binder is a number, a name or a text is itself, and a
-- literal is its value.
@pub(pkg) lang! {
  pub Erased extends Printed
  File + File { entry : Int, defs : [Def], named : [Named] }
  Def + Def { id : Int, body : Term }
  Named + Named { name : String, labels : [String] }
  Term + Var { id : Int }
  Term + Lam { param : Int, body : Term }
  Term + Let { id : Int, value : Term, body : Term }
  Bind + Bind { id : Int, value : Term }
  Term + Proj { tuple : Term, index : Int }
  Field + Field { label : String, value : Term }
  Term + Sel { target : Term, label : String }
  Term + Extend { target : Term, label : String, value : Term }
  Term + Ctor { name : String, args : [Term] }
  Term + Prim { op : String, args : [Term] }
  Term + Perform { eff : String, op : String, arg : Term }
  Term + Handle { body : Term, clauses : [Clause], retId : Maybe Int, ret : Maybe Term }
  Clause + Clause { eff : String, op : String, param : Int, resume : Int, body : Term }
  Term + Join { id : Int, params : [Int], rhs : Term, body : Term }
  Term + Jump { id : Int, args : [Term] }
  Lit + LInt { value : Int }
  Lit + LBig { value : Int }
  Lit + LF64 { value : Float }
  Lit + LF32 { value : Float }
  Lit + LWord { ty : String, bits : Int }
  Lit + LStr { text : String }
  Lit + LChar { code : Int }
  Lit + LBool { value : Bool }
  Pat + PVar { id : Int }
  Pat + PAs { id : Int, pat : Pat }
  Pat + PCtor { name : String, args : [Pat] }
  PField + PField { label : String, pat : Pat }
  Arm + Arm { pat : Pat, guard : Maybe Term, body : Term }
}

-- A type of inference's, as a node's field.
type Ty = Type

-- Core as `meadow_core` has it, before its types are erased: every term and
-- pattern with its type, a function with its parameter's, and each data
-- type declared: its name, how many types it takes, and its constructors
-- with their fields' types -- a type it takes written `Bound`, by its place
-- -- and each effect, with what each of its operations takes and answers.
-- A value generic in its type says so, `TyLam`, naming the variables its
-- types are written with, and a mention of one says the types it is at,
-- `TyApp`: how a value of a variable's type is represented is the type's to
-- say, at run time. A value generic in a number's type says that beside
-- them, `nums`, and a mention the number types it is at: nothing at run time
-- depends on those but what a literal is, so they are gone -- the value
-- copied for each number type it is used at, `Inline.numbered` -- before
-- anything is lowered. A unit names its package, and what its definitions
-- mention of another's -- `Extern`: the binder it has here, the symbol it
-- is, how many types it is generic in, and how many arguments it is a
-- function of where it is written as one.
-- What `Elab` makes of a program, and what is lowered to Cut, which needs to
-- know how each value is represented.
@pub(pkg) lang! {
  pub Core extends Erased with reflect
  DataCtor + DataCtor { name : String, fields : [Ty] }
  Data + Data { name : String, arity : Int, ctors : [DataCtor] }
  Op + Op { name : String, arg : Ty, result : Ty }
  Effect + Effect { name : String, ops : [Op] }
  Extern + Extern { id : Int, symbol : String, types : Int, arity : Int }
  File - File
  File
    + File {
      package : String,
      entry : Int,
      defs : [Def],
      named : [Named],
      datas : [Data],
      effects : [Effect],
      externs : [Extern]
    }
  Clause - Clause
  Clause
    + Clause { eff : String, op : String, param : Int, paramTy : Ty, resume : Int, body : Term }
  Term - Lam
  Term + Lam { param : Int, paramTy : Ty, body : Term }
  Term + TyLam { vars : [Int], nums : [Int], body : Term }
  Term + TyApp { func : Term, tys : [Ty], nums : [Ty] }
  Term * { ty : Ty }
  Pat * { ty : Ty }
}

-- A program is kept in a unit's interface, which is compared and printed:
-- two are the same when what is written of them is, and one prints as
-- nothing much.
impl PartialEq CoreProgram {
  fun (==) a b = toDatum a == toDatum b
}

impl Debug CoreProgram {
  fun debug p = "<core>"
}

-- The types taken off: what the CEK machine runs.
pass! {
  pub erase : Core -> Erased
    | File { entry, defs, named } -> File { entry, defs, named }
    | Var { id } -> Var { id }
    | Lam { param, body } -> Lam { param, body }
    | TyLam { body } -> body
    | TyApp { func } -> func
    | App { func, arg } -> App { func, arg }
    | Let { id, value, body } -> Let { id, value, body }
    | LetRec { binds, body } -> LetRec { binds, body }
    | If { cond, yes, no } -> If { cond, yes, no }
    | Tuple { items } -> Tuple { items }
    | Array { items } -> Array { items }
    | Proj { tuple, index } -> Proj { tuple, index }
    | Record { fields } -> Record { fields }
    | Sel { target, label } -> Sel { target, label }
    | Extend { target, label, value } -> Extend { target, label, value }
    | Ctor { name, args } -> Ctor { name, args }
    | Prim { op, args } -> Prim { op, args }
    | Case { scrutinee, arms } -> Case { scrutinee, arms }
    | Perform { eff, op, arg } -> Perform { eff, op, arg }
    | Handle { body, clauses, retId, ret } -> Handle { body, clauses, retId, ret }
    | Clause { eff, op, param, resume, body } -> Clause { eff, op, param, resume, body }
    | Join { id, params, rhs, body } -> Join { id, params, rhs, body }
    | Jump { id, args } -> Jump { id, args }
    | Ill {} -> Ill {}
    | Const { lit } -> Const { lit }
    | PWild {} -> PWild {}
    | PVar { id } -> PVar { id }
    | PAs { id, pat } -> PAs { id, pat }
    | PLit { lit } -> PLit { lit }
    | PTuple { items } -> PTuple { items }
    | PArray { items } -> PArray { items }
    | PCtor { name, args } -> PCtor { name, args }
    | PRecord { fields } -> PRecord { fields }
}

-- The types taken off, and every binder what `re` makes it: what `erase`
-- does for one unit of several that are to be one program.
pass! {
  relink : Core -> Erased with re from Def, Named
    | File { entry, defs, named } -> File { entry = re entry, defs, named }
    | Def { id, body } -> Def { id = re id, body }
    | Var { id } -> Var { id = re id }
    | Lam { param, body } -> Lam { param = re param, body }
    | TyLam { body } -> body
    | TyApp { func } -> func
    | App { func, arg } -> App { func, arg }
    | Let { id, value, body } -> Let { id = re id, value, body }
    | LetRec { binds, body } -> LetRec { binds, body }
    | Bind { id, value } -> Bind { id = re id, value }
    | If { cond, yes, no } -> If { cond, yes, no }
    | Tuple { items } -> Tuple { items }
    | Array { items } -> Array { items }
    | Proj { tuple, index } -> Proj { tuple, index }
    | Record { fields } -> Record { fields }
    | Sel { target, label } -> Sel { target, label }
    | Extend { target, label, value } -> Extend { target, label, value }
    | Ctor { name, args } -> Ctor { name, args }
    | Prim { op, args } -> Prim { op, args }
    | Case { scrutinee, arms } -> Case { scrutinee, arms }
    | Perform { eff, op, arg } -> Perform { eff, op, arg }
    | Handle { body, clauses, retId, ret } -> Handle { body, clauses, retId = M.map re retId, ret }
    | Clause { eff, op, param, resume, body } ->
        Clause { eff, op, param = re param, resume = re resume, body }
    | Join { id, params, rhs, body } -> Join { id = re id, params = V.map re params, rhs, body }
    | Jump { id, args } -> Jump { id = re id, args }
    | Ill {} -> Ill {}
    | Const { lit } -> Const { lit }
    | PWild {} -> PWild {}
    | PVar { id } -> PVar { id = re id }
    | PAs { id, pat } -> PAs { id = re id, pat }
    | PLit { lit } -> PLit { lit }
    | PTuple { items } -> PTuple { items }
    | PArray { items } -> PArray { items }
    | PCtor { name, args } -> PCtor { name, args }
    | PRecord { fields } -> PRecord { fields }
}

-- A definition's symbol: its package, and its binder -- an `impl`'s
-- dictionary's is below every other (`Elab.defSymbol`).
fun symbolOf (pkg : String) (id : Int) : String =
  if id < 0 then "meadow:${pkg}/impl${show (0 - id)}" else "meadow:${pkg}/d${show id}"

-- Several units, each a program of core that names what it mentions of
-- another by symbol, as one program the CEK machine runs: every binder made
-- one no other unit has, and a mention of another unit's definition that
-- definition. With it, where each definition is, by its symbol.
@pub fun linkedUnits (units : [CoreProgram]) : (ErasedProgram, HashMap String Int) =
  let many = V.len units + 1 in
  let global = \u id -> if id >= 0 then id * many + u else id * many - u in
  let parts =
    \u ->
      (match V.get units u with
       | Just (CoreProgram a file) -> Just (a, file)
       | None -> None)
  in
  let table =
    V.foldl
      (\h u ->
        match parts u with
        | Just (a, file) ->
            (let pkg = coreFilePackage a file in
             V.foldl
               (\h2 d -> H.insert (symbolOf pkg (coreDefId a d)) (global u (coreDefId a d)) h2)
               h
               (coreFileDefs a file))
        | None -> h)
      H.empty
      (V.range 0 (V.len units))
  in runSt (\() ->
       let out = newErasedBuilder () in
       let made =
         V.map
           (\u ->
             match parts u with
             | Just (a, file) ->
                 (let theirs =
                    V.foldl
                      (\h e ->
                        match H.lookup (coreExternSymbol a e) table with
                        | Just g -> H.insert (coreExternId a e) g h
                        | None -> h)
                      H.empty
                      (coreFileExterns a file)
                  in
                  let re = \id -> M.unwrapOr (global u id) (H.lookup id theirs) in
                  (
                    V.map (\d -> relinkDef a out re d) (coreFileDefs a file),
                    V.map (\n -> relinkNamed a out re n) (coreFileNamed a file)
                  ))
             | None -> ([], []))
           (V.range 0 (V.len units))
       in
       let root =
         newErasedFile out (spanMeta 0 0) (0 - 1) (V.concatMap fst made) (V.concatMap snd made)
       in (ErasedProgram (freezeErased out) root, table))

-- What one unit of several is written with where they are made one program
-- of core: the binder each definition of another unit it mentions has there,
-- the binder each of its own names has been given so far, and the next to
-- give -- upwards for a name, downwards for an `impl`'s dictionary, which is
-- below every other.
record Joining s = {
  theirs : HashMap Int Int,
  names : StRef s (HashMap Int Int),
  next : StRef s Int,
  below : StRef s Int
}

-- The binder `id` has in the program the units are made.
fun joined (j : Joining s) (id : Int) =
  match H.lookup id j.theirs with
  | Just there -> there
  | None ->
      (let names = stGetRef j.names in
       match H.lookup id names with
       | Just n -> n
       | None ->
           if id < 0 then
             (let n = stGetRef j.below - 1 in
              let u = stSetRef j.below n in
              let w = stSetRef j.names (H.insert id n names) in
              n)
           else
             (let n = stGetRef j.next in
              let u = stSetRef j.next (n + 1) in
              let w = stSetRef j.names (H.insert id n names) in
              n))

-- A unit written again with every binder what `joined` makes it, and its
-- types as they were: `relink`, for a program that is to be made better and
-- lowered rather than run.
pass! {
  rejoin : Core -> Core with j from Def, Named, Data, Effect, Extern
    | Def { id, body } -> Def { id = joined j id, body }
    | Var { id, ty } -> Var { id = joined j id, ty }
    | Lam { param, paramTy, body, ty } -> Lam { param = joined j param, paramTy, body, ty }
    | Let { id, value, body, ty } -> Let { id = joined j id, value, body, ty }
    | Bind { id, value } -> Bind { id = joined j id, value }
    | Clause { eff, op, param, paramTy, resume, body } ->
        Clause { eff, op, param = joined j param, paramTy, resume = joined j resume, body }
    | Handle { body, clauses, retId, ret, ty } ->
        Handle { body, clauses, retId = M.map (\x -> joined j x) retId, ret, ty }
    | Join { id, params, rhs, body, ty } ->
        Join { id = joined j id, params = V.map (\x -> joined j x) params, rhs, body, ty }
    | Jump { id, args, ty } -> Jump { id = joined j id, args, ty }
    | PVar { id, ty } -> PVar { id = joined j id, ty }
    | PAs { id, pat, ty } -> PAs { id = joined j id, pat, ty }
    | Extern { id, symbol, types, arity } -> Extern { id = joined j id, symbol, types, arity }
}

-- Several units as one program of core, package `pkg`'s: `linkedUnits` with
-- the types kept, for a program that is optimised as one. Every binder is
-- one no other unit has, numbered from nothing so that none is where a later
-- pass makes its own; a mention of another unit's definition is that
-- definition; and a type, a constructor's fields or an effect that several
-- units declare is declared once. What no unit defines is still named by
-- its symbol. With it, the binder each definition has, by the symbol it had.
@pub fun joinedUnits (pkg : String) (units : [CoreProgram]) : (CoreProgram, HashMap String Int) =
  let parts =
    \u ->
      (match V.get units u with
       | Just (CoreProgram a file) -> Just (a, file)
       | None -> None)
  in runSt (\() ->
       let out = newCoreBuilder () in
       let next = stNewRef 0 in
       let below = stNewRef 0 in
       -- Every unit's definitions numbered first: one unit mentions another's.
       let numbered =
         V.map
           (\u ->
             let names = stNewRef H.empty in
             let own = Joining { theirs = H.empty, names, next, below } in
             (
               names,
               match parts u with
               | Just (a, file) ->
                   V.map
                     (\d ->
                       (
                         symbolOf (coreFilePackage a file) (coreDefId a d),
                         joined own (coreDefId a d)
                       ))
                     (coreFileDefs a file)
               | None -> []
             ))
           (V.range 0 (V.len units))
       in
       let table = H.fromVec (V.concatMap snd numbered) in
       let made =
         V.map
           (\u ->
             match (parts u, V.get numbered u) with
             | (Just (a, file), Just (names, _)) ->
                 (let externs = coreFileExterns a file in
                  let theirs =
                    V.foldl
                      (\h e ->
                        match H.lookup (coreExternSymbol a e) table with
                        | Just there -> H.insert (coreExternId a e) there h
                        | None -> h)
                      H.empty
                      externs
                  in
                  let j = Joining { theirs, names, next, below } in
                  (
                    V.map (\d -> rejoinDef a out j d) (coreFileDefs a file),
                    V.map (\n -> (coreNamedName a n, rejoinNamed a out j n)) (coreFileNamed a file),
                    V.map (\d -> (coreDataName a d, rejoinData a out j d)) (coreFileDatas a file),
                    V.map
                      (\e -> (coreEffectName a e, rejoinEffect a out j e))
                      (coreFileEffects a file),
                    V.concatMap
                      (\e ->
                        if M.isSome (H.lookup (coreExternSymbol a e) table) then []
                        else [rejoinExtern a out j e])
                      externs
                  ))
             | _ -> ([], [], [], [], []))
           (V.range 0 (V.len units))
       in
       let root =
         newCoreFile
           out
           (spanMeta 0 0)
           pkg
           (0 - 1)
           (V.concatMap (\m -> match m with | (defs, _, _, _, _) -> defs) made)
           (once (V.concatMap (\m -> match m with | (_, named, _, _, _) -> named) made))
           (once (V.concatMap (\m -> match m with | (_, _, datas, _, _) -> datas) made))
           (once (V.concatMap (\m -> match m with | (_, _, _, effects, _) -> effects) made))
           (V.concatMap (\m -> match m with | (_, _, _, _, externs) -> externs) made)
       in (CoreProgram (freezeCore out) root, table))

-- Each of `named` whose name none before it has.
fun once (named : [(String, a)]) : [a] =
  snd
    (V.foldl
       (\acc x ->
         match acc with
         | (seen, kept) ->
             if M.isSome (H.lookup (fst x) seen) then acc
             else (H.insert (fst x) True seen, V.pushBack kept (snd x)))
       (H.empty, [])
       named)

-- Each numeral a number, each quoted string its text, each float's bits the
-- float; everything else is as it was.
pass! {
  read : Printed -> Erased
    | File { entry, defs, named } -> File { entry = number entry, defs, named }
    | Def { id, body } -> Def { id = number id, body }
    | Named { name, labels } -> Named { name = unquoted name, labels = V.map unquoted labels }
    | Var { id } -> Var { id = number id }
    | Lam { param, body } -> Lam { param = number param, body }
    | Let { id, value, body } -> Let { id = number id, value, body }
    | Bind { id, value } -> Bind { id = number id, value }
    | Proj { tuple, index } -> Proj { tuple, index = number index }
    | Field { label, value } -> Field { label = unquoted label, value }
    | Sel { target, label } -> Sel { target, label = unquoted label }
    | Extend { target, label, value } -> Extend { target, label = unquoted label, value }
    | Ctor { name, args } -> Ctor { name = unquoted name, args }
    | Prim { op, args } -> Prim { op = unquoted op, args }
    | Perform { eff, op, arg } -> Perform { eff = unquoted eff, op = unquoted op, arg }
    | Handle { body, clauses, retId, ret } ->
        Handle { body, clauses, retId = M.map number retId, ret }
    | Clause { eff, op, param, resume, body } ->
        Clause {
          eff = unquoted eff,
          op = unquoted op,
          param = number param,
          resume = number resume,
          body
        }
    | Join { id, params, rhs, body } ->
        Join { id = number id, params = V.map number params, rhs, body }
    | Jump { id, args } -> Jump { id = number id, args }
    | LInt { value } -> LInt { value = number value }
    | LBig { value } -> LBig { value = number value }
    | LF64 { bits } -> LF64 { value = f64Of (number bits) }
    | LF32 { bits } -> LF32 { value = f32Of (number bits) }
    | LWord { ty, bits } -> LWord { ty = unquoted ty, bits = number bits }
    | LStr { text } -> LStr { text = unquoted text }
    | LChar { code } -> LChar { code = number code }
    | LBool { value } -> LBool { value = value == "true" }
    | PVar { id } -> PVar { id = number id }
    | PAs { id, pat } -> PAs { id = number id, pat }
    | PCtor { name, args } -> PCtor { name = unquoted name, args }
    | PField { label, pat } -> PField { label = unquoted label, pat }
    | Arm { pat, guard, body } -> Arm { pat, guard = M.map (\g -> erasedGuardCond g) guard, body }
}

-- The program `input` writes, or what is wrong with it.
@pub fun program (input : String) : Result String ErasedProgram =
  match parseCoreText input with
  | (g, []) ->
      (match printedFromCoreText g with
       | Just p -> Ok (read p)
       | None -> Err "the program is not all there")
  | (_, errs) ->
      (match V.get errs 0 with
       | Just (at, why) -> Err "${why}, at byte ${show at}"
       | None -> Err "it does not parse")

-- --- reading the text --------------------------------------------------------

fun number (s : String) : Int = M.unwrapOr 0 (S.toInt s)

-- A quoted string's text: its quotes off, and each `\xNN` the byte it names.
fun unquoted (s : String) : String = unescaped (stringSlice s 1 (stringByteLength s - 1)) 0 0 ""

fun unescaped (s : String) (run : Int) (i : Int) (acc : String) : String =
  if i >= stringByteLength s then acc ++ stringSlice s run i
  else if toInt (stringByteAt s i) == 92 then
    let code = hex (toInt (stringByteAt s (i + 2))) * 16 + hex (toInt (stringByteAt s (i + 3))) in
    unescaped s (i + 4) (i + 4) (acc ++ stringSlice s run i ++ C.toString (C.fromCode code))
  else unescaped s run (i + 1) acc

fun hex (b : Int) : Int = if b >= 65 then b - 55 else b - 48

-- The `Float` whose bits are `bits`. Nothing gives a float of its bits, so it
-- is worked out: the mantissa, a whole number, scaled by twos -- which is
-- exact, as long as what it comes to is a float, and it is one.
fun f64Of (bits : Int) : Float =
  let exponent = bitAnd (bits >>> 52) 2047 in
  let fraction = bitAnd bits 4503599627370495 in
  let magnitude =
    if exponent == 2047 then (if fraction == 0 then 1.0 / 0.0 else 0.0 / 0.0)
    else if exponent == 0 then scaled (toFloat fraction) (0 - 1074)
    else scaled (toFloat (fraction + 4503599627370496)) (exponent - 1075)
  in if bits < 0 then magnitude * (0.0 - 1.0) else magnitude

-- The `Float32` whose bits are `bits`, as a `Float`, which holds it exactly.
fun f32Of (bits : Int) : Float =
  let exponent = bitAnd (bits >>> 23) 255 in
  let fraction = bitAnd bits 8388607 in
  let magnitude =
    if exponent == 255 then (if fraction == 0 then 1.0 / 0.0 else 0.0 / 0.0)
    else if exponent == 0 then scaled (toFloat fraction) (0 - 149)
    else scaled (toFloat (fraction + 8388608)) (exponent - 150)
  in if bitAnd bits 2147483648 != 0 then magnitude * (0.0 - 1.0) else magnitude

fun scaled (x : Float) (e : Int) : Float =
  if e > 0 then scaled (x * 2.0) (e - 1) else if e < 0 then scaled (x * 0.5) (e + 1) else x
