-- Unit: Meadow's packages, as Lingua's units (`Lingua.Make`).
--
-- A unit is a directory with a `Meadow.toml`, and its sources the `.mw` files
-- under its `src/`. What it depends on is what its manifest's
-- `[dependencies]` name -- a `path`, from the unit, or a `git` repository,
-- which the Rust `meadow` has fetched into its cache at the commit the root
-- unit's `Meadow.lock` pins, asked to by `Main.resolvedFor` before a build
-- reads any of this -- and the standard library, which every unit but the
-- standard library itself depends on, and whose sources are where
-- `MEADOWBOOT_STD` says.
--
-- The manifests are read as far as `meadow` writes them: sections, `key =
-- "text"`, and inline tables of those, `Name = { path = "../x" }`.

use Std.Fs (
  Fs, FileMeta, readToString, readBytes, writeString, rename, removeFile, readDir, isDir, exists,
  metadata
)
use Std.Process (Process, getEnv, setEnv, currentExe, currentPid)
use Std.Path as Path
use Std.Collections.Vector as V
use Std.String as S
use Std.Sort (sort)
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Std.Result as Res

-- `path` without Windows' `\\?\`, which asks for a path to be taken exactly as
-- written and which nothing here needs.
@pub fun plain (path : String) : String =
  if S.startsWith "\\\\?\\" path then S.drop path 4 else path

-- `path` from the root of the file system, and normalised: the one way a
-- unit is written, whoever names it. A relative path is from where the shell
-- says it is, when it says.
@pub fun absolute (path : String) : String ! { Process | e } =
  let p = plain path in
  if Path.isAbsolute p then Path.normalize p
  else
    match getEnv "PWD" with
    | Just here -> Path.normalize (Path.join (plain (fromShell here)) p)
    | None -> Path.normalize p

-- A path as a POSIX shell on Windows writes it, `/c/Users`, as Windows does:
-- `C:/Users`.
fun fromShell (p : String) : String =
  if stringByteLength p >= 3 and S.startsWith "/" p and stringSlice p 2 3 == "/" then
    S.join "" [S.toUpper (stringSlice p 1 2), ":", stringSlice p 2 (stringByteLength p)]
  else p

-- The unit `file` is in: the nearest directory above it with a `Meadow.toml`.
@pub fun packageOf (file : String) : Maybe String ! { Fs, Process | e } =
  let rec up dir =
    match dir with
    | None -> None
    | Just d ->
        if exists (Path.join d "Meadow.toml") then Just (Path.normalize d) else up (Path.parent d)
  in up (Path.parent (absolute file))

-- A unit's sources: every `.mw` file under its `src/`.
@pub fun sourcesOf (dir : String) : [String] ! { Fs | e } = under (Path.join dir "src")

-- What a unit is compiled from: its manifest, which names its package, and
-- its sources.
@pub fun unitFilesOf (dir : String) : [String] ! { Fs, Process | e } =
  V.concat [[manifestOf dir], sourcesOf dir, expansionsOf dir, precompiledOf dir]

-- The standard library compiled ahead of time, for the unit that is the
-- standard library, if there is one (`Compiler.precompiledFor`): where
-- `MEADOWBOOT_PRECOMPILED_STD` says, or `Std.mwstd` beside its sources, as a
-- release lays them out. Which compiler is reading it is said here, where the
-- program's own file may be looked at, as `MEADOWBOOT_SELF` (`selfKey`),
-- which is what the file is named by.
fun precompiledOf (dir : String) : [String] ! { Fs, Process | e } =
  match stdDir () with
  | Just s if Path.normalize (absolute dir) == Path.normalize s ->
      let p =
        (match getEnv "MEADOWBOOT_PRECOMPILED_STD" with
         -- Said to be nothing, there is none: what `meadow __precompile-std`
         -- builds with.
         | Just given -> if S.isEmpty given then "" else absolute given
         | None -> M.unwrapOr "" (M.map (\up -> Path.join up "Std.mwstd") (Path.parent s)))
      in if S.isEmpty p or not (exists p) or isDir p then []
         else (let u = selfKey () in [Path.normalize p])
  | _ -> []

-- This program, as `meadow __precompile-std` names what it wrote by: its
-- size and a hash of its bytes, so that two compilers are told apart by what
-- they are, and a copy of one is still it. Where the program cannot be read
-- it is nothing, which names no precompiled library. It is also said as
-- `MEADOWBOOT_SELF`, for the compile to read (`Compiler.precompiledFor`).
--
-- Reading and hashing the program takes a second or two, which a prompt
-- cannot wait for each time it starts, so it is done once for each build of
-- the program: what it came to is kept with the program's path, size and
-- the time it was last written -- in a file in the temporary directory, for
-- the runs after this one, and in the environment, for this run and the
-- runs it starts. Either is taken only while the program is still that.
@pub fun selfKey () : String ! { Fs, Process | e } =
  let exe = currentExe () in
  let key =
    (match metadata exe with
     | Err _ -> ""
     | Ok (m : FileMeta) ->
         let stamp = "${exe}|${show m.len}|${show m.modified}" in
         let k =
           (match (getEnv "MEADOWBOOT_SELF_STAMP", getEnv "MEADOWBOOT_SELF") with
            | (Just was, Just k) if was == stamp and not (S.isEmpty k) -> k
            | _ ->
                let kept = selfKeyFile exe in
                let said =
                  (match readToString kept with
                   | Ok t -> S.lines t
                   | Err _ -> [])
                in if V.getOr "" said 0 == stamp and not (S.isEmpty (V.getOr "" said 1)) then
                     V.getOr "" said 1
                   else hashedSelf exe stamp m.len kept)
         in
         let u = setEnv ("MEADOWBOOT_SELF_STAMP", stamp) in
         k)
  in
  let u = setEnv ("MEADOWBOOT_SELF", key) in
  key

-- The program at `exe` hashed -- as hexadecimal text, which the runtime
-- hashes many times faster than an array -- and what it came to kept at
-- `kept` for the next run: written beside it and moved there, so that no run
-- reads it half written.
fun hashedSelf (exe : String) (stamp : String) (len : Int) (kept : String)
    : String ! { Fs, Process | e } =
  match readBytes exe with
  | Err _ -> ""
  | Ok bytes ->
      let k = "${show len}-${show (hash (bytesToHex bytes))}" in
      let part = "${kept}.${show (currentPid ())}" in
      let w =
        (match writeString (part, "${stamp}\n${k}\n") with
         | Ok _ ->
             (match rename (part, kept) with
              | Ok _ -> ()
              | Err _ -> (let r = removeFile part in ()))
         | Err _ -> ())
      in k

-- Where what the program at `exe` hashes to is kept: a file in the
-- temporary directory, named by where the program is.
fun selfKeyFile (exe : String) : String ! { Process | e } =
  let tmp =
    M.unwrapOr (M.unwrapOr (M.unwrapOr "/tmp" (getEnv "TMPDIR")) (getEnv "TMP")) (getEnv "TEMP")
  in Path.join tmp "meadowboot-self-${show (hash exe)}.key"

-- What the Rust compiler's macros expanded to in the unit at `dir`, if that
-- was written down: `Pkg.json` where `MEADOWBOOT_EXPANSIONS` says. MeadowBoot
-- takes a procedural macro's expansion from there, as it takes core.
fun expansionsOf (dir : String) : [String] ! { Fs, Process | e } =
  match (getEnv "MEADOWBOOT_EXPANSIONS", readToString (manifestOf dir)) with
  | (Just exps, Ok text) ->
      let p = Path.normalize (Path.join (absolute exps) "${packageName text}.json") in
      if exists p then [p] else []
  | _ -> []

@pub fun manifestOf (dir : String) : String = Path.normalize (Path.join dir "Meadow.toml")

-- The name a manifest gives its package.
-- The names a manifest's `text` gives the units it depends on, in the order
-- it lists them: what a `use` knows each by, which is not always what the
-- package calls itself -- `Anstyle = { git = "…/MeadowAnstyle" }` is a
-- package named `Bloom`.
@pub fun dependencyNames (text : String) : [String] =
  V.map
    (\(e : Entry) -> e.key)
    (V.filter (\(e : Entry) -> e.section == "dependencies") (readToml text))

@pub fun packageName (text : String) : String =
  match V.find (\(e : Entry) -> e.section == "package" and e.key == "name") (readToml text) with
  | Just e ->
      (match e.value with
       | Text t -> t
       | Other t -> t
       | Table _ -> "")
  | None -> ""

fun under (dir : String) : [String] ! { Fs | e } =
  match readDir dir with
  | Err _ -> []
  | Ok names ->
      V.concatMap
        (\n ->
          let p = Path.join dir n in
          if isDir p then (if n == "target" then [] else under p)
          else if S.endsWith ".mw" n then [Path.normalize p]
          else [])
        (sort names)

-- The units `dir` depends on, read off its manifest `text`, in a build of the
-- unit at `root`: its dependencies, then the standard library.
@pub fun dependenciesOf (root : String) (dir : String) (text : String)
    : Result String [String] ! { Fs, Process | e } =
  -- A root with a lock says so to the builds this one starts, of the programs
  -- that serve its dependencies' macros, so that they pin what it pins.
  let locks = lockDirOf root in
  let said = (if M.isSome (lockOf locks) then setEnv ("MEADOWBOOT_LOCK", locks) else ()) in
  let manifest = readToml text in
  let std = stdDir () in
  let named = V.filter (\(e : Entry) -> e.section == "dependencies") manifest in
  let found =
    V.foldl
      (\acc e ->
        match acc with
        | Err why -> Err why
        | Ok ds ->
            (match locate root dir e with
             | Ok d -> Ok (V.pushBack ds d)
             | Err why -> Err why))
      (Ok [])
      named
  in match (found, std) with
     | (Err why, _) -> Err why
     | (Ok ds, Just s) -> Ok (if absolute dir == s then ds else V.pushBack ds s)
     | (Ok ds, None) -> Ok ds

-- Where the standard library's sources are: where `MEADOWBOOT_STD` says, or
-- `lib/Std` beside this program, as a release of it lays them out.
@pub fun stdDir () : Maybe String ! { Fs, Process | e } =
  match getEnv "MEADOWBOOT_STD" with
  | Just s -> Just (absolute s)
  | None ->
      (match Path.parent (currentExe ()) with
       | Just dir ->
           (let beside = Path.join dir "lib/Std" in
            if isDir beside then Just (absolute beside) else None)
       | None -> None)

-- The Rust compiler's `meadow`, as a program, for what MeadowBoot hands it
-- (`Main.backEnd`) and the formatter the language server runs: where
-- `MEADOW` says; `meadow-rust` beside this program, which is what an
-- installed release names it, MeadowBoot being `meadow` there; `meadow`
-- beside this program, as a release's archive and a checkout's bundle have
-- it, unless that is this program; and otherwise the one on the path --
-- `meadow-rust` where this program is itself called `meadow`, so that
-- MeadowBoot never hands a command to itself.
@pub fun rustMeadow () : String ! { Fs, Process | e } =
  match getEnv "MEADOW" with
  | Just m -> m
  | None ->
      let self = currentExe () in
      let itself = Path.fileStem self == "meadow" in
      let onPath = if itself then "meadow-rust" else "meadow" in
      match Path.parent self with
      | None -> onPath
      | Just dir ->
          (match rustFallback () with
           | Just renamed -> renamed
           | None ->
               let beside = Path.join dir "meadow${exeSuffix self}" in
               if not itself and exists beside then beside else onPath)

-- The Rust front end an installed release ships beside MeadowBoot, as
-- `meadow-rust`, for the one release that carries both: a command
-- MeadowBoot cannot do in full yet is handed to it whole
-- (`Main.handedWhole`). Nothing where `MEADOW` names a `meadow` to use
-- instead, and nothing in a checkout, which has none.
@pub fun rustFallback () : Maybe String ! { Fs, Process | e } =
  if M.isSome (getEnv "MEADOW") then None
  else
    let self = currentExe () in
    match Path.parent self with
    | None -> None
    | Just dir ->
        let renamed = Path.join dir "meadow-rust${exeSuffix self}" in
        if exists renamed then Just renamed else None

-- What a program's file name ends with on this system, as `path`, a
-- program, has it: `.exe` on Windows, nothing elsewhere.
fun exeSuffix (path : String) : String =
  if S.endsWith ".exe" path or S.endsWith ".EXE" path then ".exe" else ""

-- Whether a build of the unit at `root` has a git dependency: one its
-- manifest names, or one that a unit it reaches by `path` names. Only such
-- a build has anything to fetch or to pin, which the back end does for it
-- (`Main.resolvedFor`) before anything here reads where a dependency is; a
-- build of path dependencies alone asks nothing of it. A dependency taken
-- from the workspace, `{ workspace = true }`, may be either, and is taken
-- for one that may need fetching.
@pub fun fetches (root : String) : Bool ! { Fs, Process | e } = fetchesFrom [absolute root] []

-- `fetches`, of the units `todo` and those they reach by `path`, but for
-- those already looked at, `seen`.
fun fetchesFrom (todo : [String]) (seen : [String]) : Bool ! { Fs, Process | e } =
  match V.get todo 0 with
  | None -> False
  | Just d ->
      if V.elem d seen then fetchesFrom (V.drop todo 1) seen
      else
        match readToString (manifestOf d) with
        | Err _ -> fetchesFrom (V.drop todo 1) (V.pushBack seen d)
        | Ok text ->
            let named = V.filter (\(e : Entry) -> e.section == "dependencies") (readToml text) in
            if V.any (\(e : Entry) -> mayFetch e.value) named then True
            else
              fetchesFrom
                (V.append (V.drop todo 1) (V.concatMap (\(e : Entry) -> pathFrom d e.value) named))
                (V.pushBack seen d)

-- Whether a dependency written `v` may be a git repository's.
fun mayFetch (v : TomlValue) : Bool = M.isSome (field "git" v) or M.isSome (field "workspace" v)

-- The directory of a `path` dependency written `v` in the unit at `dir`,
-- if it is one: `{ path = "../x" }`, or `"../x"` as it was once spelt.
fun pathFrom (dir : String) (v : TomlValue) : [String] =
  match v with
  | Text p -> [Path.normalize (Path.join dir p)]
  | _ -> M.unwrapOr [] (M.map (\p -> [Path.normalize (Path.join dir p)]) (field "path" v))

-- Where dependency `e` of the unit at `dir` is.
fun locate (root : String) (dir : String) (e : Entry) : Result String String ! { Fs, Process | f } =
  match (field "path" e.value, field "git" e.value) with
  | (Just p, _) -> Ok (Path.normalize (Path.join dir p))
  | (_, Just url) ->
      (match pinned root dir e.key with
       | Just rev ->
           (match checkout url rev with
            -- The package is the directory `subdir` names, where one is named.
            | Ok d ->
                Ok
                  (M.unwrapOr
                     d
                     (M.map (\s -> Path.normalize (Path.join d s)) (field "subdir" e.value)))
            | Err why -> Err why)
       | None -> Err "`${e.key}` is not in `Meadow.lock`: run `meadow build` once to fetch it")
  | _ -> Err "`${e.key}` is neither a `path` nor a `git` dependency"

-- The `Meadow.lock` of the unit at `dir`, where it has one.
fun lockOf (dir : String) : Maybe String ! { Fs | e } =
  -- Under the name it had before, where one is still spelt so.
  match (match readToString (Path.join dir "Meadow.lock") with
   | Ok text -> Ok text
   | Err _ -> readToString (Path.join dir "meadow.lock")) with
  | Ok text -> Just text
  | Err _ -> None

-- Where the `Meadow.lock` of a build of the unit at `root` is, as `meadow`
-- keeps it (`lock::dir_for`): beside the manifest of the workspace the unit
-- is in, where it is in one, which every member's build shares; and
-- otherwise beside the unit's own.
fun lockDirOf (root : String) : String ! { Fs, Process | e } =
  lockDirFrom (Just (absolute root)) root

fun lockDirFrom (dir : Maybe String) (root : String) : String ! { Fs | e } =
  match dir with
  | None -> root
  | Just d ->
      (match readToString (Path.join d "Meadow.toml") with
       | Ok text -> if declaresWorkspace text then d else lockDirFrom (Path.parent d) root
       | Err _ -> lockDirFrom (Path.parent d) root)

-- The commit `Meadow.lock` pins package `name` at: the root's; then that of
-- the build that started this one, `MEADOWBOOT_LOCK`, for the program that
-- serves a dependency's macros, whose root has no lock; or the unit's.
fun pinned (root : String) (dir : String) (name : String) : Maybe String ! { Fs, Process | e } =
  let inLock =
    \d ->
      M.andThen
        (\text ->
          M.andThen
            (\(p : Entry) -> field "rev" p.value)
            (V.find
               (\(p : Entry) -> p.section == "package" and field "name" p.value == Just name)
               (tables (readToml text))))
        (lockOf d)
  in match inLock (lockDirOf root) with
     | Just rev -> Just rev
     | None ->
         (match M.andThen inLock (getEnv "MEADOWBOOT_LOCK") with
          | Just rev -> Just rev
          | None -> inLock dir)

-- Where `meadow` checked out commit `rev` of `url`: `git/checkouts/<name>-<hash
-- of the url>/<rev>` under its home. The directory holding `rev` whose name
-- starts with the repository's is it: a commit's name is unique.
fun checkout (url : String) (rev : String) : Result String String ! { Fs, Process | e } =
  match home () with
  | None -> Err "no home directory to find `meadow`'s git checkouts in"
  | Just h ->
      let root = Path.joinAll [h, "git", "checkouts"] in
      let name = repoName url in
      let dirs = (match readDir root with | Ok ns -> ns | Err _ -> []) in
      match V.find
        (\d -> S.startsWith (name ++ "-") d and isDir (Path.joinAll [root, d, rev]))
        (sort dirs) with
      | Just d -> Ok (Path.normalize (Path.joinAll [root, d, rev]))
      | None -> Err "${url} at ${rev} has not been fetched: run `meadow build` once"

-- `meadow`'s home: `MEADOW_HOME`, or `.meadow` in the user's.
fun home () : Maybe String ! { Process | e } =
  match getEnv "MEADOW_HOME" with
  | Just h -> Just h
  | None ->
      (match getEnv "USERPROFILE" with
       | Just u -> Just (Path.join u ".meadow")
       | None -> M.map (\u -> Path.join u ".meadow") (getEnv "HOME"))

-- The repository's name, as `meadow` names its checkouts: the URL's last
-- segment, without `.git`, each character not a letter, digit, `-` or `_` a
-- `-`.
@pub fun repoName (url : String) : String =
  let trimmed = strip "/" (strip ".git" (strip "/" url)) in
  let segs =
    V.filter (\x -> not (S.isEmpty x)) (V.concatMap (\x -> S.split ":" x) (S.split "/" trimmed))
  in
  let last = M.unwrapOr "repo" (V.get segs (V.len segs - 1)) in
  S.join
    ""
    (V.map
       (\i ->
         let c = stringSlice last i (i + 1) in
         if safe c then c else "-")
       (V.range 0 (stringByteLength last)))

fun strip (suffix : String) (s : String) : String =
  if S.endsWith suffix s then stringSlice s 0 (stringByteLength s - stringByteLength suffix) else s

fun safe (c : String) : Bool =
  let b = toInt (stringByteAt c 0) in
  (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 95

-- --- the manifests -----------------------------------------------------------

-- A value: text, a table of texts, or anything else, as written.
@pub data TomlValue
  = Text String
  | Table [(String, String)]
  | Other String

use TomlValue.*

-- A key's value, in the section it is in: `[dependencies]`, or the `n`th
-- `[[package]]` (-1 in a section that is not one of several).
@pub record Entry = {
  section : String,
  index : Int,
  key : String,
  value : TomlValue
}

-- What `key` says in an inline table, or a section of them.
fun field (key : String) (v : TomlValue) : Maybe String =
  match v with
  | Table kvs -> M.map snd (V.find (\kv -> fst kv == key) kvs)
  | _ -> None

-- Each `[[section]]`, its keys as one table.
fun tables (es : [Entry]) : [Entry] =
  let indices =
    V.foldl
      (\acc (e : Entry) ->
        if e.index >= 0 and not (V.any (\x -> fst x == e.section and snd x == e.index) acc) then
          V.pushBack acc (e.section, e.index)
        else acc)
      []
      es
  in V.map
       (\si ->
         let kvs =
           V.concatMap
             (\(e : Entry) ->
               if e.section == fst si and e.index == snd si then
                 (match e.value with
                  | Text t -> [(e.key, t)]
                  | Other t -> [(e.key, t)]
                  | Table _ -> [])
               else [])
             es
         in Entry { section = fst si, index = snd si, key = "", value = Table kvs })
       indices

-- The entries of a manifest, as far as `meadow` writes them.
@pub fun readToml (text : String) : [Entry] =
  match V.foldl
    (\acc raw ->
      match acc with
      | (section, index, es) ->
          let l = S.trim (uncommented raw) in
          if S.isEmpty l then acc
          else if S.startsWith "[[" l then
            (let n = S.trim (stringSlice l 2 (stringByteLength l - 2)) in (n, countOf n es, es))
          else if S.startsWith "[" l then
            (S.trim (stringSlice l 1 (stringByteLength l - 1)), 0 - 1, es)
          else
            (match S.indexOf "=" l with
             | Just at ->
                 (
                   section,
                   index,
                   V.pushBack
                     es
                     (Entry {
                        section,
                        index,
                        key = unquoted (S.trim (stringSlice l 0 at)),
                        value = valueOf (S.trim (stringSlice l (at + 1) (stringByteLength l)))
                      })
                 )
             | None -> acc))
    ("", 0 - 1, [])
    (S.lines text) with
  | (_, _, es) -> es

-- How many `[[n]]` tables were before: the next one's index. One with no
-- keys yet counts, which `readToml` places by the index it gives it.
fun countOf (n : String) (es : [Entry]) : Int =
  V.len
    (V.foldl
       (\acc (e : Entry) ->
         if e.section == n and not (V.elem e.index acc) then V.pushBack acc e.index else acc)
       []
       es)

-- A line without its comment -- a `#` outside quotes.
fun uncommented (l : String) : String =
  let n = stringByteLength l in
  let rec go i quoted =
    if i >= n then l
    else
      (let b = toInt (stringByteAt l i) in
       if b == 34 then go (i + 1) (not quoted)
       else if b == 35 and not quoted then stringSlice l 0 i
       else go (i + 1) quoted)
  in go 0 False

fun valueOf (v : String) : TomlValue =
  if S.startsWith "{" v and S.endsWith "}" v then
    Table
      (V.concatMap
         (\part ->
           match S.indexOf "=" part with
           | Just at ->
               [(
                 unquoted (S.trim (stringSlice part 0 at)),
                 unquoted (S.trim (stringSlice part (at + 1) (stringByteLength part)))
               )]
           | None -> [])
         (S.split "," (stringSlice v 1 (stringByteLength v - 1))))
  else if S.startsWith "\"" v then Text (unquoted v)
  else Other v

fun unquoted (s : String) : String =
  if stringByteLength s >= 2 and S.startsWith "\"" s and S.endsWith "\"" s then
    stringSlice s 1 (stringByteLength s - 1)
  else s

-- --- profiles ------------------------------------------------------------------

-- What a manifest's `[profile.<name>]` says, as `meadow` reads it
-- (`buildtools/meadow/src/package.rs`, `parse_manifest`): each setting a
-- build of that profile takes over the profile's own, and the command line
-- over that. A value that is not one the setting takes says nothing, as an
-- unknown key does: a manifest written for a later `meadow` still builds.
@pub record ProfileSays = {
  -- `opt-level`: 0, 1 or 2.
  opt : Maybe Int,
  -- `strictness`: `strict` or `lenient`.
  strictness : Maybe String,
  -- `backend`, or `aot = true` or `jit = true`: how Glade runs the program.
  backend : Maybe String,
  -- `runtime`: `glade` or `silo`.
  runtime : Maybe String,
  -- `threads`, as `-j` says.
  threads : Maybe Int,
  -- `nursery`, as `--nursery` writes it, read where it is used.
  nursery : Maybe String,
  -- `leaks = true`, as `--leaks`.
  leaks : Maybe Bool,
  -- `target`, as `--target` says.
  target : Maybe String,
  -- `cycles`: how a Silo program finds its cycles, `trial` or `tracing`.
  cycles : Maybe String,
  -- `cfg`: flags for `@cfg(…)` to hold of, with commas between.
  cfg : Maybe String,
  -- `prune = false`, as `--no-prune`.
  prune : Maybe Bool,
  -- `profile = true`: a run is sampled, and its folded stacks written beside
  -- the build.
  profile : Maybe Bool
}

@pub def nothingSaid : ProfileSays =
  ProfileSays {
    opt = None, strictness = None, backend = None, runtime = None, threads = None, nursery = None,
    leaks = None, target = None, cycles = None, cfg = None, prune = None, profile = None
  }

-- What the manifest `text` says of profile `name`.
@pub fun profileIn (text : String) (name : String) : ProfileSays =
  V.foldl
    (\p (e : Entry) ->
      if e.section != "profile.${name}" then p
      else
        match e.value with
        | Text v -> profileSaid p e.key v
        | Other v -> profileSaid p e.key v
        | Table _ -> p)
    nothingSaid
    (readToml text)

-- `p`, with `key = v` read into it. A later line says it again over an
-- earlier one, even with a value it does not take.
fun profileSaid (p : ProfileSays) (key : String) (v : String) : ProfileSays =
  if key == "opt-level" or key == "opt_level" then { p | opt = optLevelOf v }
  else if key == "strictness" then
    { p | strictness = if V.elem (S.trim v) ["strict", "lenient"] then Just (S.trim v) else None }
  else if key == "backend" then
    {
      p
        | backend =
          if v == "native" then Just "aot"
          else if V.elem v ["vm", "jit", "aot"] then Just v
          else None
    }
  else if key == "aot" and v == "true" then { p | backend = Just "aot" }
  else if key == "jit" and v == "true" then { p | backend = Just "jit" }
  else if key == "runtime" then
    { p | runtime = if v == "glade" or v == "silo" then Just v else None }
  else if key == "threads" then
    {
      p
        | threads =
          match S.toInt v with
          | Just n -> if n > 0 then Just n else None
          | None -> None
    }
  else if key == "nursery" then { p | nursery = Just v }
  else if key == "leaks" then { p | leaks = boolOf v }
  else if key == "target" then { p | target = Just v }
  else if key == "cycles" then
    { p | cycles = if v == "trial" or v == "tracing" then Just v else None }
  else if key == "cfg" then { p | cfg = Just v }
  else if key == "prune" then { p | prune = boolOf v }
  else if key == "profile" then { p | profile = boolOf v }
  else p

-- An optimisation level as `-O` takes one: `2`, `O2`, `o2`.
fun optLevelOf (v : String) : Maybe Int =
  let rec bare t = if S.startsWith "O" t or S.startsWith "o" t then bare (S.drop t 1) else t in
  match bare (S.trim v) with
  | "0" -> Just 0
  | "1" -> Just 1
  | "2" -> Just 2
  | _ -> None

fun boolOf (v : String) : Maybe Bool =
  if v == "true" then Just True else if v == "false" then Just False else None

-- The manifest whose profiles a build of the package at `root` takes: its
-- workspace's, where it is in one -- every member builds with the same
-- profiles -- unless the workspace leaves it out, and otherwise its own.
-- The workspace is the nearest directory at or above the package whose
-- manifest has a `[workspace]`.
@pub fun profileManifest (root : String) : Maybe String ! { Fs, Process | e } =
  let own = Res.toMaybe (readToString (Path.join root "Meadow.toml")) in
  let rec up dir =
    match dir with
    | None -> own
    | Just d ->
        (match readToString (Path.join d "Meadow.toml") with
         | Ok text ->
             (if not (declaresWorkspace text) then up (Path.parent d)
              else if leftOut (absolute d) (absolute root) text then own
              else Just text)
         | Err _ -> up (Path.parent d))
  in up (Just root)

fun declaresWorkspace (text : String) : Bool =
  V.any
    (\l ->
      V.elem (S.trim (uncommented l)) [
        "[workspace]",
        "[workspace.package]",
        "[workspace.dependencies]"
      ])
    (S.lines text)

-- Whether the workspace at `ws`, whose manifest is `text`, leaves the
-- package at `pkg` out: its `exclude` names it, or a directory it is under.
fun leftOut (ws : String) (pkg : String) (text : String) : Bool =
  pkg != ws
    and V.any
      (\(e : Entry) ->
        e.section == "workspace"
          and e.key == "exclude"
          and V.any
            (\x ->
              let dir = Path.normalize (Path.join ws x) in
              pkg == dir or S.startsWith (dir ++ "/") pkg)
            (texts e.value))
      (readToml text)

-- The texts of an array written on one line, `["a", "b"]`.
fun texts (v : TomlValue) : [String] =
  match v with
  | Other t ->
      if S.startsWith "[" t and S.endsWith "]" t then
        V.concatMap
          (\x -> (let u = unquoted (S.trim x) in if S.isEmpty u then [] else [u]))
          (S.split "," (stringSlice t 1 (stringByteLength t - 1)))
      else []
  | _ -> []

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun aManifestsDependenciesAreItsInlineTables () =
  let es =
    readToml
      "[package]\nname = \"MeadowBoot\"\n\n[dependencies]\nLingua = { path = \"../../Lingua\" }\nScythe = { git = \"https://github.com/meadow-lang/Scythe.git\", branch = \"master\" } # fetched\n"
  in assertEq
       (V.map
          (\(e : Entry) -> (e.key, field "path" e.value, field "git" e.value))
          (V.filter (\(e : Entry) -> e.section == "dependencies") es))
       [
         ("Lingua", Just "../../Lingua", None),
         ("Scythe", None, Just "https://github.com/meadow-lang/Scythe.git")
       ]
       "a path and a git repository"

@test fun aLockPinsEachPackage () =
  let es =
    readToml
      "version = 1\n\n[[package]]\nname = \"Nettle\"\nrev = \"b59e\"\n\n[[package]]\nname = \"Scythe\"\nrev = \"36e7\"\n"
  in assertEq
       (V.map (\(t : Entry) -> (field "name" t.value, field "rev" t.value)) (tables es))
       [(Just "Nettle", Just "b59e"), (Just "Scythe", Just "36e7")]
       "one table each"

@test fun aCheckoutIsNamedForItsRepository () =
  let a =
    assertEq (repoName "https://github.com/meadow-lang/Scythe.git") "Scythe" "without `.git`"
  in assertEq (repoName "https://github.com/someone/meadow-json/") "meadow-json" "without the slash"

@test fun aProfileSaysWhatItsSectionSays () =
  let p =
    profileIn
      "[package]\nname = \"P\"\n\n[profile.debug]\nruntime = \"glade\"\n\n[profile.release]\nruntime = \"silo\" # native\nopt-level = 1\nthreads = 4\nprune = false\ncfg = \"fast, feature=gpu\"\naot = true\nstrictness = \"lenient\"\n"
      "release"
  in
  let a = assertEq p.runtime (Just "silo") "runtime" in
  let b = assertEq p.opt (Just 1) "opt-level" in
  let c = assertEq p.threads (Just 4) "threads" in
  let d = assertEq p.prune (Just False) "prune" in
  let e = assertEq p.cfg (Just "fast, feature=gpu") "cfg" in
  let f = assertEq p.backend (Just "aot") "aot" in
  let g = assertEq p.strictness (Just "lenient") "strictness" in
  let other = profileIn "[profile.release]\nopt-level = \"O2\"\n" "debug" in
  let h = assertEq other.opt None "another profile's" in
  let o = profileIn "[profile.release]\nopt-level = \"O2\"\n" "release" in
  assertEq o.opt (Just 2) "`O2`"

@test fun aValueASettingDoesNotTakeSaysNothing () =
  let p =
    profileIn
      "[profile.debug]\nopt-level = 2\nopt-level = 7\nruntime = \"llvm\"\nthreads = 0\n"
      "debug"
  in
  let a = assertEq p.opt None "the last says it" in
  let b = assertEq p.runtime None "no such runtime" in
  assertEq p.threads None "no threads"
