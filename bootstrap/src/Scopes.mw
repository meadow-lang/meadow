-- Scopes: what each module of a unit can name -- as `meadow-rename` and
-- `meadow-compiler`'s units work it out -- and what the unit exports to the
-- units after it.
--
-- A module sees, below what it binds itself, two layers. The module layer is
-- its own top-level names and what its `use`s bring, in that order: a name is
-- the first of them to have it. The base is what every module of the unit
-- shares: the primitives, then the prelude -- the standard library's root
-- module, what it re-exports, and the operators and traits every program
-- has -- the last of them to have a name. Nothing else is in scope: a
-- sibling's names, and a dependency's, arrive only through a `use`, types as
-- much as values; and a constructor is written under its type, `Expr.Int`,
-- unless a `use` of the type or the prelude brings it bare.

use MeadowBoot.Ast
use MeadowBoot.Rename
use MeadowBoot.Types (Scheme)
use Lingua.Lang (Meta, metaStart, metaEnd, spanMeta)
use Lingua.Table (Table, enter, entry, tabled)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Macro (Reflect)

-- How far a declaration is seen: its module and those inside it; its
-- parent's too; its package; anyone depending on it.
@derive(Debug, PartialEq, Reflect)
@pub data Vis = Private | Super | InPkg | Exported

use Vis.*

-- What a module declares, or re-exports: a name; what it is -- `v` a value,
-- `t` a type, `c` a constructor; its binder; how far it is seen; and what it
-- belongs to -- a constructor's type, an operation's effect, a method's
-- trait -- or, for a type, what kind it is: `data`, `record`, `effect`,
-- `alias`, `trait` or `assoc`.
@derive(Debug, PartialEq)
-- And whether it is a re-export, `@pub use`: a constructor a package's root
-- re-exports is what a bare `use` of the package brings bare. And, for a
-- constructor with named fields -- a record's, or a variant's `{ … }` --
-- their names: what picks one of several constructors of one name. And, for
-- a type or a constructor, its canonical name: the fully qualified path that
-- makes it the one it is (`qualified`).
@pub record Item = {
  name : String,
  kind : String,
  id : Int,
  vis : Vis,
  owner : String,
  flat : Bool,
  fields : Maybe [String],
  canon : String
}

-- What a unit tells the units after it of each name it exports: the module
-- it is in, its name and kind, where it was declared, how far it is seen
-- (`@pub`: `Exported`), and what it belongs to.
@derive(Reflect, Debug, PartialEq)
-- And, once inference has said, its scheme -- and, before that, its binder
-- in the unit that declares it.
@pub record Export = {
  module : [String],
  name : String,
  kind : String,
  site : String,
  vis : Vis,
  owner : String,
  flat : Bool,
  fields : Maybe [String],
  canon : String,
  binder : Int,
  scheme : Maybe Scheme
}

-- One module of a unit: where it is in the unit, its file as a dump names
-- it, and its syntax.
@pub record Source = {
  path : [String],
  file : String,
  ast : AstProgram
}

-- A module, declared: its source, what it declares, and its `use`s -- each
-- with how far it re-exports what it brings.
record ModFrame = {
  src : Source,
  items : [Item],
  uses : [(Int, Vis)]
}

fun framePath (f : ModFrame) : [String] = f.src.path

-- A unit being renamed: its package's name, whether it is the standard
-- library, whether any of its declarations mentions visibility -- a unit
-- that never does has none, and everything is seen everywhere -- its
-- modules, and what its dependencies export, by the name it knows each by.
record UnitCx = {
  pkg : String,
  isStd : Bool,
  anyVis : Bool,
  frames : [ModFrame],
  deps : [Dep]
}

-- A dependency: the name a `use` knows it by, what it exports -- each with the
-- module it is in -- and whether it says what it exports at all.
record Dep = {
  name : String,
  items : [([String], Item)],
  anyVis : Bool
}

-- --- declarations ------------------------------------------------------------

-- A declaration's attributes and the declaration under them.
fun peel (a : AstArena) (d : AstDecl) : ([AstAttr], AstDecl) =
  if kindAstDecl a d == AstDeclKind.Attributed then
    (let inner = peel a (astDeclAttributedDecl a d) in
     (V.append (astDeclAttributedAttrs a d) (fst inner), snd inner))
  else ([], d)

fun nameText (a : AstArena) (n : AstName) : String = astNameText a n

-- How far attributes say a declaration is seen, and whether they say.
fun visOf (a : AstArena) (attrs : [AstAttr]) : Maybe Vis =
  V.foldl
    (\acc at ->
      if nameText a (astAttrName a at) != "pub" then acc
      else
        (match V.map (nameText a) (astAttrArgs a at) with
         | [] -> Just Exported
         | args ->
             if V.elem "pkg" args then Just InPkg
             else if V.elem "super" args then Just Super
             else Just Exported))
    None
    attrs

-- The declarations of a module, each with its attributes. What a `@cfg`
-- switches off is not among them: lowering left it out (`Lower`).
@pub fun declsOf (src : Source) : [([AstAttr], AstDecl)] =
  match src.ast with
  | AstProgram a root -> V.map (peel a) (astModuleDecls a root)

-- What a `use` says, as far as macros go: the module it names, whether it
-- picks values out -- by name, or all of them with `.*` -- the macros it
-- picks, each `name!`, and what it calls the module.
@pub record Using = {
  path : [String],
  selects : Bool,
  macros : [String],
  alias : Maybe String
}

-- Each `use` of a module that holds here.
@pub fun usesOf (src : Source) : [Using] =
  match src.ast with
  | AstProgram a root ->
      V.concatMap
        (\x ->
          let d = snd x in
          if kindAstDecl a d == AstDeclKind.Use then
            [Using {
               path = V.map (nameText a) (astDeclUsePath a d),
               selects = astDeclUseGlob a d or not (V.isEmpty (astDeclUseNames a d)),
               macros = V.map (nameText a) (astDeclUseMacros a d),
               alias = M.map (nameText a) (astDeclUseAlias a d)
             }]
          else [])
        (declsOf src)

-- The functions a module marks `@macro`: what a unit that depends on its
-- package may call as macros.
@pub fun macroFuns (src : Source) : [String] =
  match src.ast with
  | AstProgram a root ->
      V.concatMap
        (\x ->
          let d = snd x in
          if V.any (\at -> nameText a (astAttrName a at) == "macro") (fst x)
            and kindAstDecl a d == AstDeclKind.Bind
            and kindAstBind a (astDeclBindBind a d) == AstBindKind.Fun then
            [nameText a (astBindFunName a (astDeclBindBind a d))]
          else [])
        (declsOf src)

-- Whether a module says how far anything of its is seen.
@pub fun saysVis (src : Source) : Bool =
  match src.ast with
  | AstProgram a root -> V.any (\x -> M.isSome (visOf a (fst x))) (declsOf src)

fun siteIn (src : Source) (m : Meta) : String = "${src.file}@${show (metaStart m)}"

-- A binder for name `n` of the module's.
fun binderOf (src : Source) (a : AstArena) (n : AstName) (kind : String)
    : Int ! { Table Binder | e } =
  declareBinderTo (nameText a n) kind (siteIn src (metaAstName a n)) (metaEnd (metaAstName a n))

-- What a module of package `pkg` declares, and its `use`s.
fun frameOf (pkg : String) (src : Source) : (ModFrame, Bool) ! { Table Binder | e } =
  match src.ast with
  | AstProgram a root ->
      let decls = declsOf src in
      let said = V.any (\x -> M.isSome (visOf a (fst x))) decls in
      let items =
        V.map
          (canonical pkg src.path)
          (V.concatMap (\x -> declItems src a (M.unwrapOr Private (visOf a (fst x))) (snd x)) decls)
      in
      let uses =
        V.concatMap
          (\x ->
            if kindAstDecl a (snd x) == AstDeclKind.Use then
              [(snd x, M.unwrapOr Private (visOf a (fst x)))]
            else [])
          decls
      in (ModFrame { src, items, uses }, said)

fun item (name : String) (kind : String) (id : Int) (vis : Vis) (owner : String) : Item =
  Item { name, kind, id, vis, owner, flat = False, fields = None, canon = "" }

-- `i`, declared in module `path` of package `pkg`, with its canonical name:
-- a type's its qualified path, a constructor's its type's and its own.
fun canonical (pkg : String) (path : [String]) (i : Item) : Item =
  if i.kind == "t" then { i | canon = qualified pkg path i.name }
  else if i.kind == "c" then { i | canon = qualified pkg path i.owner ++ "." ++ i.name }
  else i

-- A type's canonical name, `meadow-rename`'s `qualify_in`: its path as the
-- source writes one, `pkg.Mod.Sub.Name`, `pkg.Name` at the root -- but the
-- names the language itself knows.
@pub fun qualified (pkg : String) (path : [String]) (name : String) : String =
  if V.elem name languageNames then name else S.join "." (V.concat [[pkg], path, [name]])

-- The types and effects the language itself knows, which no package's path
-- qualifies (`meadow-rename`'s `LANGUAGE_NAMES`).
@pub def languageNames : [String] =
  [
    "Int", "BigInt", "Float", "String", "Char", "Bool", "Int64", "Int32", "Int16", "Int8", "UInt64",
    "UInt32", "UInt16", "UInt8", "Float64", "Float32", "Unit", "List", "Array", "Ref", "StRef",
    "StArray", "Compact", "Task", "Channel", "TVar", "Vector", "VNode", "Maybe", "Result",
    "FileMeta", "Thread", "Console", "Fs", "Process", "Random", "Time", "Test", "Mut", "Stm", "St",
    "Eff"
  ]

-- The names of fields `fs`.
fun fieldNames (a : AstArena) (fs : [AstField]) : [String] =
  V.map (\f -> nameText a (astFieldName a f)) fs

fun declItems (src : Source) (a : AstArena) (vis : Vis) (d : AstDecl)
    : [Item] ! { Table Binder | e } =
  let k = kindAstDecl a d in
  let one = \n kind owner -> item (nameText a n) kind (binderOf src a n kind) vis owner in
  if k == AstDeclKind.Bind then
    (let b = astDeclBindBind a d in
     if kindAstBind a b == AstBindKind.Fun then [one (astBindFunName a b) "v" ""]
     else V.map (\n -> one n "v" "") (patNames a (astBindPatPat a b)))
  else if k == AstDeclKind.Data then
    (let ty = nameText a (astDeclDataName a d) in
     V.pushFront
       (V.map
          (\v ->
            {
              (one (astVariantName a v) "c" ty)
                | fields =
                  if astVariantNamed a v then Just (fieldNames a (astVariantFields a v)) else None
            })
          (astDeclDataVariants a d))
       (one (astDeclDataName a d) "t" "data"))
  else if k == AstDeclKind.Record then
    (let n = astDeclRecordName a d in
     -- A record's one constructor is named as its type is, and declared
     -- nowhere an editor looks: a use of it goes nowhere.
     [
       one n "t" "record",
       {
         (item (nameText a n) "c" (declareBinder (nameText a n) "c" "-") vis (nameText a n))
           | fields = Just (fieldNames a (astDeclRecordFields a d))
       }
     ])
  else if k == AstDeclKind.Effect then
    (let e = nameText a (astDeclEffectName a d) in
     V.pushFront
       (V.map (\f -> one (astFieldName a f) "v" ("op:" ++ e)) (astDeclEffectOps a d))
       (one (astDeclEffectName a d) "t" "effect"))
  else if k == AstDeclKind.Alias then [one (astDeclAliasName a d) "t" "alias"]
  else if k == AstDeclKind.EffectAlias then [one (astDeclEffectAliasName a d) "t" "effectAlias"]
  else if k == AstDeclKind.Trait then
    (let t = nameText a (astDeclTraitName a d) in
     V.concat [
       [one (astDeclTraitName a d) "t" "trait"],
       V.map (\x -> one (astAssocName a x) "t" ("assoc:" ++ t)) (astDeclTraitAssocs a d),
       V.map (\x -> one (astAssocName a x) "t" ("assocEffect:" ++ t)) (astDeclTraitEffects a d),
       V.map (\s -> one (astMethodSigName a s) "v" t) (astDeclTraitSigs a d)
     ])
  else []

-- The names a pattern binds, as written.
fun patNames (a : AstArena) (p : AstPat) : [AstName] =
  let k = kindAstPat a p in
  if k == AstPatKind.Var then [astPatVarName a p]
  else if k == AstPatKind.As then V.pushFront (patNames a (astPatAsPat a p)) (astPatAsName a p)
  else if k == AstPatKind.Ann then patNames a (astPatAnnPat a p)
  else if k == AstPatKind.Cons then V.concatMap (patNames a) (astPatConsArgs a p)
  else if k == AstPatKind.QualCons then V.concatMap (patNames a) (astPatQualConsArgs a p)
  else if k == AstPatKind.Tuple then V.concatMap (patNames a) (astPatTupleItems a p)
  else if k == AstPatKind.Array then V.concatMap (patNames a) (astPatArrayItems a p)
  else if k == AstPatKind.Vector then V.concatMap (patNames a) (astPatVectorItems a p)
  else if k == AstPatKind.List then V.concatMap (patNames a) (astPatListItems a p)
  else if k == AstPatKind.Record then
    V.concatMap (\f -> patNames a (astPatFieldPat a f)) (astPatRecordFields a p)
  else if k == AstPatKind.View then patNames a (astPatViewPat a p)
  else []

fun isCapital (s : String) : Bool =
  not (S.isEmpty s)
    and S.toUpper (stringSlice s 0 1) == stringSlice s 0 1
    and S.toLower (stringSlice s 0 1) != stringSlice s 0 1

-- Whether value `value` is part of pattern synonym `name`: its builder `$bP`,
-- or a matcher `$m2P` (`meadow_rename::part_of_synonym`).
fun partOfSynonym (value : String) (name : String) : Bool =
  if S.startsWith "$b" value then stringSlice value 2 (stringByteLength value) == name
  else if S.startsWith "$m" value then
    let rest = stringSlice value 2 (stringByteLength value) in
    let digits =
      V.len
        (V.takeWhile
           (\i -> (let ch = stringSlice rest i (i + 1) in ch >= "0" and ch <= "9"))
           (V.range 0 (stringByteLength rest)))
    in digits > 0 and stringSlice rest digits (stringByteLength rest) == name
  else False

-- --- visibility --------------------------------------------------------------

-- Whether module `from` of the unit sees what module `owner` declares `vis`.
fun reaches (cx : UnitCx) (vis : Vis) (owner : [String]) (from : [String]) : Bool =
  if not cx.anyVis then True
  else
    match vis with
    | Exported -> True
    | InPkg -> True
    | Super -> startsWith (V.take owner (max 0 (V.len owner - 1))) from
    | Private -> startsWith owner from

fun startsWith (prefix : [String]) (xs : [String]) : Bool =
  V.len xs >= V.len prefix and V.take xs (V.len prefix) == prefix

