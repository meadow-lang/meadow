fun dotted (path : [String]) : String = S.join "." path

-- --- a module's scope --------------------------------------------------------

-- What a module's `use`s bring, in the order they bring it: values, and the
-- types, constructors and qualified modules it may write; and what it
-- re-exports with `@pub use`.
-- And each name a `use` wrote that is a use of something: where, and of
-- what.
record Layers = {
  values : [(String, Int)],
  types : [(String, Int)],
  ctors : [(String, Int)],
  quals : [(String, HashMap String Int)],
  reexports : [Item],
  refs : [(Meta, Int)]
}

def noLayers : Layers =
  Layers { values = [], types = [], ctors = [], quals = [], reexports = [], refs = [] }

fun withRefs (acc : Layers) (refs : [(Meta, Int)]) : Layers =
  { acc | refs = V.append acc.refs refs }

-- What `items` bring into a module, as a `use` that is re-exported `vis`
-- does -- and what that re-exports, if anything.
fun bring (acc : Layers) (vis : Vis) (items : [Item]) : Layers =
  let values = V.filter (\(i : Item) -> i.kind == "v") items in
  let types = V.filter (\(i : Item) -> i.kind == "t") items in
  let ctors = V.filter (\(i : Item) -> i.kind == "c") items in
  {
    acc | values = V.append acc.values (V.map (\(i : Item) -> (i.name, i.id)) values),
    types = V.append acc.types (V.map (\(i : Item) -> (i.name, i.id)) types),
    ctors = V.append acc.ctors (V.map (\(i : Item) -> (i.name, i.id)) ctors),
    reexports =
      if vis == Private then acc.reexports
      else V.append acc.reexports (V.map (\(i : Item) -> { i | vis = vis, flat = True }) items)
  }

-- A type's constructors, from what declares it.
fun ctorsOfType (items : [Item]) (ty : String) : [Item] =
  V.filter (\(i : Item) -> i.kind == "c" and i.owner == ty) items

-- The constructor named as its type is, which comes with the type.
fun structCtor (items : [Item]) (ty : String) : [Item] =
  V.filter (\(i : Item) -> i.name == ty) (ctorsOfType items ty)

-- What naming type `t` brings: the type; its constructor named like it; a
-- trait's associated types and methods; an effect's operations.
fun withType (items : [Item]) (t : Item) : [Item] =
  V.concat [
    [t],
    structCtor items t.name,
    (if t.owner == "trait" then V.filter (\(i : Item) -> i.kind == "v" and i.owner == t.name) items
     else []),
    (if t.owner == "effect" then
       V.filter (\(i : Item) -> i.kind == "v" and i.owner == "op:" ++ t.name) items
     else []),
    (if t.owner == "trait" then
       V.filter (\(i : Item) -> i.kind == "t" and i.owner == "assoc:" ++ t.name) items
     else [])
  ]

-- A module's items by kind and owner -- `c:Shape` the constructors of
-- `Shape` -- each kept in the order it is among them: what `withTypeIn`
-- finds a type's own by, where `withType` reads every item for each.
fun owned (items : [Item]) : HashMap String [Item] =
  V.foldl
    (\h (i : Item) ->
      (let key = "${i.kind}:${i.owner}" in
       H.insert key (V.pushBack (M.unwrapOr [] (H.lookup key h)) i) h))
    H.empty
    items

-- `withType`, of a module whose items are `by` kind and owner.
fun withTypeIn (by : HashMap String [Item]) (t : Item) : [Item] =
  let of = \key -> M.unwrapOr [] (H.lookup key by) in
  V.concat [
    [t],
    V.filter (\(i : Item) -> i.name == t.name) (of "c:${t.name}"),
    (if t.owner == "trait" then of "v:${t.name}" else []),
    (if t.owner == "effect" then of "v:op:${t.name}" else []),
    (if t.owner == "trait" then of "t:assoc:${t.name}" else [])
  ]

-- `use Ty`, `use Ty (C, D)`, `use Ty.*` for a type among `items`: the type
-- alone, the constructors named, or all of them. A dependency's type comes
-- with its constructors named (`dep`) as naming it would.
fun useType
    (acc : Layers)
    (vis : Vis)
    (items : [Item])
    (t : Item)
    (at : Meta)
    (names : [(String, Meta)])
    (glob : Bool)
    (dep : Bool)
    : Layers =
  let ctors = ctorsOfType items t.name in
  let named =
    if glob then ctors else V.filter (\(c : Item) -> V.any (\n -> fst n == c.name) names) ctors
  in
  let alone = not glob and V.isEmpty names in
  let base = if alone or dep then withType items t else [] in
  let refs =
    V.concatMap
      (\n -> V.concatMap (\(c : Item) -> if c.name == fst n then [(snd n, c.id)] else []) ctors)
      names
  in withRefs (bring acc vis (V.append base named)) (V.pushFront refs (at, t.id))

-- What module `path` of the unit lets module `from` see.
fun siblingItems (cx : UnitCx) (path : [String]) (from : [String]) : [Item] =
  V.concatMap
    (\(f : ModFrame) ->
      if framePath f == path then V.filter (\(i : Item) -> reaches cx i.vis path from) f.items
      else [])
    cx.frames

fun hasSibling (cx : UnitCx) (path : [String]) : Bool =
  V.any (\(f : ModFrame) -> framePath f == path) cx.frames

-- What dependency `d` exports from module `path`.
fun depItems (d : Dep) (path : [String]) : [Item] = V.concatMap (depItem d path) d.items

fun depItem (d : Dep) (path : [String]) (x : ([String], Item)) : [Item] =
  match x with
  | (at, (i : Item)) -> if at == path and (not d.anyVis or i.vis == Exported) then [i] else []

-- Where `x` is in `xs`, or past the end.
fun indexIn (x : String) (xs : [String]) : Int =
  V.foldl
    (\acc i -> if acc == V.len xs and V.get xs i == Just x then i else acc)
    (V.len xs)
    (V.range 0 (V.len xs))

fun depHas (d : Dep) (path : [String]) : Bool = V.any (\x -> fst x == path) d.items

fun valuesMap (items : [Item]) : HashMap String Int =
  V.foldl (\m (i : Item) -> if i.kind == "v" then H.insert i.name i.id m else m) H.empty items

-- What a bare `use` of a module with `items` brings: its values, its types
-- with what each brings, and -- at a package's root -- the constructors it
-- re-exports.
fun bareUse (items : [Item]) (root : Bool) : [Item] =
  let by = owned items in
  V.concat [
    V.filter (\(i : Item) -> i.kind == "v") items,
    V.concatMap (withTypeIn by) (V.filter (\(i : Item) -> i.kind == "t") items),
    (if root then V.filter (\(i : Item) -> i.kind == "c" and i.flat) items else [])
  ]

-- `names` of a module's `items`: each value, type -- with what it brings --
-- or constructor re-exported flat.
fun namedIn (items : [Item]) (names : [String]) : [Item] =
  V.concatMap
    (\n ->
      V.concat [
        V.filter (\(i : Item) -> i.kind == "v" and (i.name == n or partOfSynonym i.name n)) items,
        V.concatMap
          (withType items)
          (V.filter (\(i : Item) -> i.name == n and i.kind == "t") items),
        V.filter (\(i : Item) -> i.name == n and i.kind == "c") items
      ])
    names

-- Each name a `use` list wrote, as a use of what it names there: a value if
-- it is one, and otherwise a type.
fun namedRefs (items : [Item]) (names : [(String, Meta)]) : [(Meta, Int)] =
  V.concatMap
    (\n ->
      match V.find (\(i : Item) -> i.name == fst n and i.kind == "v") items with
      | Just i -> [(snd n, i.id)]
      | None ->
          -- A pattern synonym is its matcher and builder, and is itself a use
          -- of neither.
          if V.any (\(i : Item) -> i.kind == "v" and partOfSynonym i.name (fst n)) items then []
          else
            (match V.find (\(i : Item) -> i.name == fst n and i.kind == "t") items with
             | Just t -> [(snd n, t.id)]
             -- A capital nothing declares: an effect the language has, named.
             | None -> (if isCapital (fst n) then [(snd n, 0 - 1)] else [])))
    names

-- One `use` of module `m`, on top of what the ones before it brought.
fun applyUse (cx : UnitCx) (m : ModFrame) (acc : Layers) (one : (AstDecl, Vis)) : Layers =
  match m.src.ast with
  | AstProgram a _ ->
      let u = fst one in
      let vis = snd one in
      let segs = V.map (nameText a) (astDeclUsePath a u) in
      let written = V.map (\n -> (nameText a n, metaAstName a n)) (astDeclUseNames a u) in
      let names = V.map fst written in
      let lastAt =
        M.unwrapOr
          (metaAstModule a 0)
          (M.map (metaAstName a) (V.get (astDeclUsePath a u) (V.len segs - 1)))
      in
      let glob = astDeclUseGlob a u in
      let alias = M.map (nameText a) (astDeclUseAlias a u) in
      let here = framePath m in
      let last = V.getOr "" segs (V.len segs - 1) in
      let owner = V.take segs (V.len segs - 1) in
      let local = if V.getOr "" segs 0 == cx.pkg then V.drop segs 1 else segs in
      let localOwner = V.take local (max 0 (V.len local - 1)) in
      let typeIn = \items -> V.find (\(i : Item) -> i.kind == "t" and i.name == last) items in
      let moduleUse =
        \items ->
          -- A bare `use` brings no constructor bare but a type's own-named one,
          -- and, of a package's root, what it re-exports.
          let root = V.len segs == 1 and V.getOr "" segs 0 != cx.pkg in
          (match alias with
           | Just q ->
               (let qualified = { acc | quals = V.pushBack acc.quals (q, valuesMap items) } in
                if V.isEmpty names then qualified
                else withRefs (bring qualified vis (namedIn items names)) (namedRefs items written))
           | None ->
               if V.isEmpty names then bring acc vis (bareUse items root)
               else withRefs (bring acc vis (namedIn items names)) (namedRefs items written))
      in
      -- `use Ty ...` for a type this very module declares.
      match (if V.len segs == 1 then typeIn m.items else None) with
      | Just t -> useType acc vis m.items t lastAt written glob False
      | None ->
          if (not (V.isEmpty local) or V.getOr "" segs 0 == cx.pkg) and hasSibling cx local then
            moduleUse (siblingItems cx local here)
          else
            (match (if V.isEmpty local then None else typeIn (siblingItems cx localOwner here)) with
             | Just t ->
                 useType acc vis (siblingItems cx localOwner here) t lastAt written glob cx.isStd
             | None ->
                 (match V.find (\(d : Dep) -> d.name == V.getOr "" segs 0) cx.deps with
                  | None -> acc
                  | Just d ->
                      let path = V.drop segs 1 in
                      if depHas d path then moduleUse (depItems d path)
                      else
                        (let items = depItems d (V.drop owner 1) in
                         match typeIn items with
                         | Just t -> useType acc vis items t lastAt written glob True
                         | None -> acc)))

-- The base every module of the unit shares: the primitives, then the
-- prelude. For a module of the standard library, the modules before it whose
-- names are every later one's (`flatModules`); for any other unit, what the
-- standard library exports at its root.
fun baseOf (cx : UnitCx) (prims : [(String, Int)]) (m : ModFrame) : Layers =
  let start = { noLayers | values = prims } in
  if cx.isStd then
    let before = V.take stdOrder (indexIn (moduleName m) stdOrder) in
    V.foldl
      (\acc f ->
        if V.elem f before then
          bring
            acc
            Private
            (V.filter
               (\(i : Item) -> i.vis == Exported or not cx.anyVis)
               (siblingItems cx (S.split "." f) (framePath m)))
        else acc)
      start
      flatModules
  else
    match V.find (\(d : Dep) -> d.name == "Std") cx.deps with
    | Just std -> bring start Private (bareUse (depItems std []) True)
    | None -> start

-- A module of the standard library by the name `stdOrder` has it.
fun moduleName (m : ModFrame) : String =
  if V.isEmpty (framePath m) then (if S.endsWith "Prelude.mw" m.src.file then "Prelude" else "Lib")
  else dotted (framePath m)

-- What every module of a unit shares: the primitives, what stands for a name
-- nothing declares -- an unknown value, a built-in type or constructor -- and
-- every constructor of every type the unit knows, by its type.
record Shared = {
  prims : [(String, Int)],
  unknown : Int,
  builtinType : Int,
  builtinCtor : Int,
  typeCtors : HashMap Int (HashMap String Int),
  stdTypes : HashMap String Int,
  bools : HashMap String Int,
  builtinTypes : [(String, Int)],
  builtinCtors : [(String, Int)],
  traitAssocs : HashMap Int (HashMap String Int),
  vectorEmpty : Int,
  ctorFields : HashMap Int [String]
}

fun lastWins (xs : [(String, a)]) : HashMap String a =
  V.foldl (\h x -> H.insert (fst x) (snd x) h) H.empty xs

fun firstWins (xs : [(String, a)]) : HashMap String a =
  V.foldl
    (\h x -> if M.isSome (H.lookup (fst x) h) then h else H.insert (fst x) (snd x) h)
    H.empty
    xs

-- Each constructor name's meanings: every distinct one `brought` has, in
-- order, or else the one `base` has.
fun candidates (base : HashMap String Int) (brought : [(String, Int)]) : HashMap String [Int] =
  let own =
    V.foldl
      (\h x ->
        (let cs = M.unwrapOr [] (H.lookup (fst x) h) in
         if V.elem (snd x) cs then h else H.insert (fst x) (V.pushBack cs (snd x)) h))
      H.empty
      brought
  in V.foldl
       (\h kv -> if M.isSome (H.lookup (fst kv) h) then h else H.insert (fst kv) [snd kv] h)
       own
       (H.toVec base)

-- What module `m` can name: the base, its own declarations, and its `use`s --
-- and what it re-exports.
fun scopeOf (cx : UnitCx) (sh : Shared) (m : ModFrame) : (Scope, [Item], [(Meta, Int)]) =
  let base = baseOf cx sh.prims m in
  let own =
    bring
      noLayers
      Private
      (V.concat [
         V.filter (\(i : Item) -> i.kind != "c") m.items,
         V.concatMap
           (\(t : Item) -> if t.kind == "t" then structCtor m.items t.name else [])
           m.items
       ])
  in
  let used = V.foldl (applyUse cx m) own m.uses in
  let firstFirst =
    V.foldl
      (\h x -> H.insert (fst x) (V.pushBack (M.unwrapOr [] (H.lookup (fst x) h)) (snd x)) h)
      H.empty
      used.values
  in
  let scope =
    Scope {
      file = m.src.file,
      top = valuesMap m.items,
      values = firstFirst,
      base = lastWins base.values,
      quals = lastWins used.quals,
      types = lastWins (V.concat [sh.builtinTypes, base.types, used.types]),
      -- A constructor written bare is every one of its name the module's
      -- own declarations and its `use`s bring, in order -- several are an
      -- overload -- or else the first of the base's, the language's own
      -- first.
      ctors = candidates (firstWins (V.append sh.builtinCtors base.ctors)) used.ctors,
      ctorFields = sh.ctorFields,
      typeCtors = sh.typeCtors,
      stdTypes = sh.stdTypes,
      unknown = sh.unknown,
      builtinType = sh.builtinType,
      builtinCtor = sh.builtinCtor,
      bools = sh.bools,
      traitAssocs = sh.traitAssocs,
      vectorEmpty = sh.vectorEmpty
    }
  in (scope, used.reexports, used.refs)

-- --- a unit ------------------------------------------------------------------

-- What a unit is renamed with: each dependency by the name a `use` knows it
-- by, with what it exports and whether it says what it exports at all.
@pub record DepExports = {
  name : String,
  exports : [Export],
  anyVis : Bool
}

-- What renaming a unit made: each module's program, what each binder is --
-- its uses among it -- what the unit exports, and whether it says. And what
-- inference reads beside the programs: each module's file, path and
-- declarations; the declarations its dependencies export, each with the
-- binder it has here; and each primitive's binder.
@pub record Renamed = {
  programs : [(String, HirProgram)],
  binders : [Binder],
  exports : [Export],
  anyVis : Bool,
  modules : [Declared],
  depItems : [Item],
  prims : [(String, Int)]
}

-- A module's file as a dump names it, its path in its unit, and what it
-- declares.
@pub record Declared = {
  file : String,
  path : [String],
  items : [Item]
}

-- Rename unit `pkg` -- the standard library when `isStd` -- its modules
-- `sources`, against what its dependencies export.
@pub fun renameUnit (pkg : String) (isStd : Bool) (sources : [Source]) (deps : [DepExports])
    : Renamed =
  match tabled (\() -> renaming pkg isStd sources deps) with
  | ((programs, exports, anyVis, modules, depItems, prims), binders) ->
      Renamed {
        programs,
        binders,
        exports = V.map (\(e : Export) -> { e | site = siteOfId binders e.site }) exports,
        anyVis,
        modules,
        depItems,
        prims
      }

-- An export's site, while renaming: its binder's id, which is read back as
-- where the binder was declared once the table is done.
fun siteOfId (binders : [Binder]) (id : String) : String =
  match M.andThen (\i -> V.get binders i) (S.toInt id) with
  | Just (b : Binder) -> b.site
  | None -> "-"

fun renaming (pkg : String) (isStd : Bool) (sources : [Source]) (deps : [DepExports]) =
  let unknown = declareBinder "?" "v" "?" in
  let builtinType = declareBinder "" "t" "-" in
  let builtinCtor = declareBinder "" "c" "-" in
  let prims = V.map (\n -> (n, declareBinder n "v" "-")) primNames in
  let declared = V.map (frameOf pkg) sources in
  let frames = V.map fst declared in
  let anyVis = V.any snd declared in
  let depCx =
    V.map
      (\(d : DepExports) -> Dep { name = d.name, items = depItemsOf d.exports, anyVis = d.anyVis })
      deps
  in
  let cx = UnitCx { pkg, isStd, anyVis, frames, deps = depCx } in
  -- Every constructor of every type the unit knows, by its type: its own
  -- modules', each type with the constructors declared beside it, and its
  -- dependencies'.
  let groups =
    V.append
      (V.map (\(f : ModFrame) -> f.items) frames)
      (V.concatMap (\(d : Dep) -> V.map (\x -> [snd x]) d.items) depCx)
  in
  let depCtors = V.concatMap (\(d : Dep) -> V.map snd d.items) depCx in
  let typeCtors =
    V.foldl
      (\h (items : [Item]) ->
        V.foldl
          (\g (t : Item) ->
            if t.kind != "t" then g
            else
              let pool = if V.len items == 1 then depCtors else items in
              H.insert
                t.id
                (V.foldl
                   (\c (k : Item) -> H.insert k.name k.id c)
                   H.empty
                   (ctorsOfType pool t.name))
                g)
          h
          items)
      H.empty
      groups
  in
  -- The standard library's types, by name, wherever in it they are: what a
  -- type's name means where a built-in derive wrote it, whether or not the
  -- module names that type itself.
  let stdTypes =
    V.foldl
      (\h (t : Item) ->
        if t.kind == "t" and M.isNone (H.lookup t.name h) then H.insert t.name t.id h else h)
      H.empty
      (if isStd then V.concatMap (\(f : ModFrame) -> f.items) frames
       else V.concatMap (\(d : Dep) -> if d.name == "Std" then V.map snd d.items else []) depCx)
  in
  -- `and` and `or` are `Bool`'s constructors, whatever is in scope.
  let allItems =
    V.append
      (V.concatMap (\(f : ModFrame) -> f.items) frames)
      (V.concatMap (\(d : Dep) -> V.map snd d.items) depCx)
  in
  -- A unit built with no standard library has none of the constructors
  -- every module has without asking, and they would all be the one binder
  -- that stands for what is not there. Lowering has to tell them apart, so
  -- such a unit has a binder for each; one with the library has its own.
  let spare =
    if V.any (\(i : Item) -> i.kind == "c" and i.owner == "Bool") allItems then []
    else V.map (\n -> (n, declareBinder n "c" "-")) ["Nil", "Cons", "True", "False"]
  in
  let spareOf = \n -> M.unwrapOr builtinCtor (M.map snd (V.find (\x -> fst x == n) spare)) in
  let bools =
    V.foldl
      (\h (c : Item) -> if c.kind == "c" and c.owner == "Bool" then H.insert c.name c.id h else h)
      (V.foldl
         (\h x -> if fst x == "True" or fst x == "False" then H.insert (fst x) (snd x) h else h)
         H.empty
         spare)
      allItems
  in
  -- The types and constructors every module has without asking: the
  -- standard library's, where it declares them.
  let typeNamed =
    \n ->
      M.unwrapOr
        builtinType
        (M.map
           (\(i : Item) -> i.id)
           (V.find (\(i : Item) -> i.kind == "t" and i.name == n) allItems))
  in
  let ctorNamed =
    \o n ->
      M.unwrapOr
        (spareOf n)
        (M.map
           (\(i : Item) -> i.id)
           (V.find (\(i : Item) -> i.kind == "c" and i.owner == o and i.name == n) allItems))
  in
  let builtinTypes = V.map (\n -> (n, typeNamed n)) builtinTyconNames in
  let builtinCtors =
    V.map (\oc -> (snd oc, ctorNamed (fst oc) (snd oc))) [
      ("List", "Nil"),
      ("List", "Cons"),
      ("Bool", "True"),
      ("Bool", "False")
    ]
  in
  -- Every trait's associated types, by the trait: what an `impl`'s `type`
  -- is, whatever is in scope.
  let traitAssocs =
    V.foldl
      (\h (t : Item) ->
        if t.kind == "t" and t.owner == "trait" then
          H.insert
            t.id
            (V.foldl
               (\g (x : Item) ->
                 if x.kind == "t" and x.owner == "assoc:" ++ t.name then H.insert x.name x.id g
                 else g)
               H.empty
               allItems)
            h
        else h)
      H.empty
      allItems
  in
  let ctorFields =
    V.foldl
      (\h (c : Item) ->
        match c.fields with
        | Just fs -> (if c.kind == "c" then H.insert c.id fs h else h)
        | None -> h)
      H.empty
      allItems
  in
  let sh =
    Shared {
      prims,
      unknown,
      builtinType,
      builtinCtor,
      typeCtors,
      stdTypes,
      bools,
      builtinTypes,
      builtinCtors,
      traitAssocs,
      vectorEmpty = ctorNamed "Vector" "Empty",
      ctorFields
    }
  in
  let done =
    V.map
      (\(f : ModFrame) ->
        (match scopeOf cx sh f with
         | (sc, re, refs) ->
             (let u =
                V.foldl
                  (\z r -> useOf f.src.file (if snd r < 0 then builtinType else snd r) (fst r))
                  ()
                  refs
              in (f, sc, re))))
      frames
  in
  let programs = V.map (\x -> match x with | (f, sc, _) -> renameSource sc f) done in
  let exports =
    V.concatMap
      (\x ->
        match x with
        | (f, _, re) ->
            V.map
              (\(i : Item) ->
                Export {
                  module = framePath f,
                  name = i.name,
                  kind = i.kind,
                  site = show i.id,
                  vis = i.vis,
                  owner = i.owner,
                  flat = i.flat,
                  fields = i.fields,
                  canon = i.canon,
                  binder = i.id,
                  scheme = None
                })
              (V.append f.items re))
      done
  in
  -- The standard library's operators, `display`, `debug` and comparison are
  -- at its root too: every program has them unqualified.
  let flat =
    if isStd then
      V.concatMap
        (\(e : Export) ->
          if V.elem (dotted e.module) flatModules and e.vis == Exported then [{ e | module = [] }]
          else [])
        exports
    else []
  in
  let modules =
    V.map
      (\(f : ModFrame) -> Declared { file = f.src.file, path = framePath f, items = f.items })
      frames
  in (programs, V.append exports flat, anyVis, modules, depCtors, prims)

-- A dependency's exports as items, each with the module it is in: one binder
-- for each thing exported, however many places export it -- a module and the
-- package's root both -- as one `VarId` is in the Rust compiler.
fun depItemsOf (exports : [Export]) : [([String], Item)] ! { Table Binder | e } =
  fst
    (V.foldl
       (\acc (e : Export) ->
         match acc with
         | (items, seen) ->
             let key = "${e.kind}|${e.name}|${e.site}|${e.canon}" in
             let id =
               (match H.lookup key seen with
                | Just x -> x
                | None -> declareBinder e.name e.kind e.site)
             in (
                  V.pushBack items (
                    e.module,
                    {
                      (item e.name e.kind id e.vis e.owner) | flat = e.flat,
                      fields = e.fields,
                      canon = e.canon
                    }
                  ),
                  H.insert key id seen
                ))
       ([], H.empty)
       exports)

fun renameSource (sc : Scope) (f : ModFrame) = (f.src.file, rename (envOf sc) f.src.ast)
