-- Groups: the order a unit's top-level bindings are inferred in --
-- `meadow_scc`, step for step.
--
-- Inference wants each binding after everything it mentions, and bindings
-- that mention one another together. So the bindings are a graph -- an edge
-- from a binding to each top-level binding its body mentions -- and each of
-- its strongly connected components, found by Tarjan's algorithm, is a group,
-- in the order the algorithm closes them: after every group it points at.
-- The Rust compiler works this out three times -- the modules of a unit in
-- order, each module's bindings in order, and the whole unit's bindings as
-- one graph walked in those two orders -- and ties are broken by where the
-- walk starts, so all three are done here as there.

use MeadowBoot.Rename
use Std.Collections.Vector as V
use Std.Sort (sort)
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.Maybe as M
use Std.Maybe.Maybe.*

-- A top-level binding of a module: the binding, and the names it binds.
@pub record Binding = {
  bind : HirBind,
  binds : [Int]
}

-- A group: its members, each a module's place and a binding's place among
-- that module's, and whether any of them mentions the group.
@pub record Group = {
  members : [(Int, Int)],
  recursive : Bool
}

-- The top-level bindings of module `a`, in the order written.
@pub fun bindingsOf (a : HirArena) (decls : [HirDecl]) : [Binding] =
  V.concatMap
    (\d ->
      match bindOf a d with
      | Just b -> [Binding { bind = b, binds = boundBy a b }]
      | None -> [])
    decls

fun bindOf (a : HirArena) (d : HirDecl) : Maybe HirBind =
  match viewHirDecl a d with
  | HirDeclView.Bind r -> Just r.bind
  | HirDeclView.Attributed r -> bindOf a r.decl
  | _ -> None

-- Every name binding `b` binds, in the order written.
@pub fun boundBy (a : HirArena) (b : HirBind) : [Int] =
  match viewHirBind a b with
  | HirBindView.Fun r -> [r.id]
  | HirBindView.Pat r -> patVars a r.pat

@pub fun patVars (a : HirArena) (p : HirPat) : [Int] =
  match viewHirPat a p with
  | HirPatView.Var r -> [r.id]
  | HirPatView.Ann r -> patVars a r.pat
  | HirPatView.As r -> V.pushFront (patVars a r.pat) r.id
  | HirPatView.Tuple r -> V.concatMap (patVars a) r.items
  | HirPatView.List r -> V.concatMap (patVars a) r.items
  | HirPatView.Array r -> V.concatMap (patVars a) r.items
  | HirPatView.Vector r -> V.concatMap (patVars a) r.items
  | HirPatView.Cons r -> V.concatMap (patVars a) r.args
  | HirPatView.Record r -> V.concatMap (\f -> patVars a (hirPatFieldPat a f)) r.fields
  | HirPatView.View r -> patVars a r.pat
  | _ -> []

-- --- mentions ----------------------------------------------------------------

-- The slots `owner` gives the top-level bindings binding `b` mentions, after
-- `out`: every name its body is made of, and each meaning an overloaded one
-- could have (`overloads`, by the name's own binder).
@pub fun mentions
    (a : HirArena)
    (owner : HashMap Int Int)
    (overloads : HashMap Int [Int])
    (b : HirBind)
    (out : [Int])
    : [Int] =
  match viewHirBind a b with
  | HirBindView.Fun r ->
      exprMentions
        a
        owner
        overloads
        r.body
        (V.foldl (\acc p -> patMentions a owner overloads p acc) out r.params)
  | HirBindView.Pat r ->
      exprMentions a owner overloads r.value (patMentions a owner overloads r.pat out)

fun patMentions (a : HirArena) owner overloads (p : HirPat) (out : [Int]) : [Int] =
  match viewHirPat a p with
  | HirPatView.View r ->
      patMentions a owner overloads r.pat (exprMentions a owner overloads r.fn out)
  | HirPatView.Ann r -> patMentions a owner overloads r.pat out
  | HirPatView.As r -> patMentions a owner overloads r.pat out
  | HirPatView.Tuple r -> V.foldl (\acc q -> patMentions a owner overloads q acc) out r.items
  | HirPatView.Array r -> V.foldl (\acc q -> patMentions a owner overloads q acc) out r.items
  | HirPatView.Vector r -> V.foldl (\acc q -> patMentions a owner overloads q acc) out r.items
  | HirPatView.List r -> V.foldl (\acc q -> patMentions a owner overloads q acc) out r.items
  | HirPatView.Cons r -> V.foldl (\acc q -> patMentions a owner overloads q acc) out r.args
  | HirPatView.Record r ->
      V.foldl (\acc f -> patMentions a owner overloads (hirPatFieldPat a f) acc) out r.fields
  | _ -> out

fun exprMentions (a : HirArena) owner overloads (e : HirExpr) (out : [Int]) : [Int] =
  let each = \acc xs -> V.foldl (\o x -> exprMentions a owner overloads x o) acc xs in
  match viewHirExpr a e with
  | HirExprView.Var r ->
      let id = hirRefId a r.ref in
      let direct =
        (match H.lookup id owner with
         | Just slot -> V.pushBack out slot
         | None -> out)
      in V.foldl
           (\acc c ->
             match H.lookup c owner with
             | Just slot -> V.pushBack acc slot
             | None -> acc)
           direct
           (V.append (hirRefAlts a r.ref) (M.unwrapOr [] (H.lookup id overloads)))
  | HirExprView.Lam r ->
      exprMentions
        a
        owner
        overloads
        r.body
        (V.foldl (\acc p -> patMentions a owner overloads p acc) out r.params)
  | HirExprView.App r -> each (exprMentions a owner overloads r.func out) r.args
  | HirExprView.Let r ->
      exprMentions
        a
        owner
        overloads
        r.body
        (V.foldl (\acc b -> mentions a owner overloads b acc) out r.binds)
  | HirExprView.If r ->
      exprMentions
        a
        owner
        overloads
        r.no
        (exprMentions a owner overloads r.yes (exprMentions a owner overloads r.cond out))
  | HirExprView.Match r ->
      V.foldl
        (\acc arm ->
          let withPat = patMentions a owner overloads (hirArmPat a arm) acc in
          let withGuard =
            (match hirArmGuard a arm with
             | Just g -> exprMentions a owner overloads g withPat
             | None -> withPat)
          in exprMentions a owner overloads (hirArmBody a arm) withGuard)
        (exprMentions a owner overloads r.scrutinee out)
        r.arms
  | HirExprView.Tuple r -> each out r.items
  | HirExprView.Array r -> each out r.items
  | HirExprView.List r -> each out r.items
  | HirExprView.Cons r -> each out r.args
  | HirExprView.Record r ->
      let fields =
        V.foldl (\acc f -> exprMentions a owner overloads (hirExprFieldValue a f) acc) out r.fields
      in (match r.base with
          | Just b -> exprMentions a owner overloads b fields
          | None -> fields)
  | HirExprView.Proj r -> exprMentions a owner overloads r.target out
  | HirExprView.Update r ->
      V.foldl
        (\acc f -> exprMentions a owner overloads (hirExprFieldValue a f) acc)
        (exprMentions a owner overloads r.base out)
        r.fields
  | HirExprView.Handle r ->
      let body = exprMentions a owner overloads r.body out in
      let arms =
        V.foldl
          (\acc h ->
            exprMentions
              a
              owner
              overloads
              (hirHArmBody a h)
              (patMentions a owner overloads (hirHArmParam a h) acc))
          body
          r.arms
      in (match r.ret with
          | Just x ->
              exprMentions
                a
                owner
                overloads
                (hirRetBody a x)
                (patMentions a owner overloads (hirRetPat a x) arms)
          | None -> arms)
  | _ -> out

-- --- Tarjan ------------------------------------------------------------------

-- The strongly connected components of the graph `edges`, each after every
-- component it points at, rooted in order so independent nodes keep theirs;
-- a component's members in the order they were first reached.
@pub fun scc (edges : [[Int]]) : [[Int]] =
  runSt (\() ->
    let n = V.len edges in
    let index = stNewArray n (0 - 1) in
    let low = stNewArray n 0 in
    let onStack = stNewArray n False in
    let stack = stNewRef [] in
    let next = stNewRef 0 in
    let out = stNewRef [] in
    let t = Tarjan { edges, index, low, onStack, stack, next, out } in
    let u = V.foldl (\w v -> if stGetArray index v < 0 then visit t v else ()) () (V.range 0 n) in
    stGetRef out)

record Tarjan s = {
  edges : [[Int]],
  index : StArray s Int,
  low : StArray s Int,
  onStack : StArray s Bool,
  stack : StRef s [Int],
  next : StRef s Int,
  out : StRef s [[Int]]
}

fun visit (t : Tarjan s) (v : Int) : () ! { St s | e } =
  let at = stGetRef t.next in
  let a = stSetArray t.index v at in
  let b = stSetArray t.low v at in
  let c = stSetRef t.next (at + 1) in
  let d = stSetRef t.stack (V.pushBack (stGetRef t.stack) v) in
  let f = stSetArray t.onStack v True in
  let g =
    V.foldl
      (\u w ->
        if stGetArray t.index w < 0 then
          (let x = visit t w in stSetArray t.low v (min (stGetArray t.low v) (stGetArray t.low w)))
        else if stGetArray t.onStack w then
          stSetArray t.low v (min (stGetArray t.low v) (stGetArray t.index w))
        else ())
      ()
      (V.getOr [] t.edges v)
  in if stGetArray t.low v == stGetArray t.index v then
       stSetRef t.out (V.pushBack (stGetRef t.out) (V.reverse (popTo t v [])))
     else ()

-- Pop the stack down to `v`, each off it, innermost first.
fun popTo (t : Tarjan s) (v : Int) (acc : [Int]) : [Int] ! { St s | e } =
  let st = stGetRef t.stack in
  match V.last st with
  | None -> acc
  | Just w ->
      let a = stSetRef t.stack (V.take st (V.len st - 1)) in
      let b = stSetArray t.onStack w False in
      if w == v then V.pushBack acc w else popTo t v (V.pushBack acc w)

-- --- the three orders --------------------------------------------------------

-- The modules of a unit in dependency order: the result's `k`th is the
-- module to place `k`th. `modules` are each module's tables and its
-- top-level bindings.
@pub fun moduleOrder (modules : [(HirArena, [Binding])]) (overloads : HashMap Int [Int]) : [Int] =
  let owner =
    V.foldl
      (\h m ->
        V.foldl
          (\g (b : Binding) -> V.foldl (\f v -> H.insert v m f) g b.binds)
          h
          (bindsOf modules m))
      H.empty
      (V.range 0 (V.len modules))
  in
  let edges =
    V.map
      (\m -> sortedDistinct (V.filter (\d -> d != m) (moduleMentions modules owner overloads m)))
      (V.range 0 (V.len modules))
  in V.concat (scc edges)

fun bindsOf (modules : [(HirArena, [Binding])]) (m : Int) : [Binding] =
  match V.get modules m with | Just (_, bs) -> bs | None -> []

fun moduleMentions (modules : [(HirArena, [Binding])]) owner overloads (m : Int) : [Int] =
  match V.get modules m with
  | Just (a, bs) -> V.foldl (\acc (b : Binding) -> mentions a owner overloads b.bind acc) [] bs
  | None -> []

-- A module's bindings in dependency order, and its groups, each member a
-- place in that order.
@pub fun groupModule (a : HirArena) (binds : [Binding]) (overloads : HashMap Int [Int])
    : ([Binding], [Group]) =
  let owner =
    V.foldl
      (\h slot -> V.foldl (\g v -> H.insert v slot g) h (V.getOr noBinding binds slot).binds)
      H.empty
      (V.range 0 (V.len binds))
  in
  let edges =
    V.map (\(b : Binding) -> sortedDistinct (mentions a owner overloads b.bind [])) binds
  in
  let comps = scc edges in
  let ordered = V.concatMap (\comp -> V.map (\s -> V.getOr noBinding binds s) comp) comps in
  let starts =
    V.foldl (\acc comp -> V.pushBack acc (V.getOr 0 acc (V.len acc - 1) + V.len comp)) [0] comps
  in
  let groups =
    V.map
      (\i ->
        let comp = V.getOr [] comps i in
        Group {
          members = V.map (\k -> (0, V.getOr 0 starts i + k)) (V.range 0 (V.len comp)),
          recursive = recursiveComp edges comp
        })
      (V.range 0 (V.len comps))
  in (ordered, groups)

-- The whole unit's bindings as one graph: `modules` each module's tables and
-- bindings, in the order `groupModule` left them; a member is a module's
-- place and a binding's.
@pub fun unitGroups (modules : [(HirArena, [Binding])]) (overloads : HashMap Int [Int]) : [Group] =
  let at =
    V.concatMap
      (\m -> V.map (\i -> (m, i)) (V.range 0 (V.len (bindsOf modules m))))
      (V.range 0 (V.len modules))
  in
  let bindAt = \p -> V.getOr noBinding (bindsOf modules (fst p)) (snd p) in
  let owner =
    V.foldl
      (\h slot -> V.foldl (\g v -> H.insert v slot g) h (bindAt (V.getOr (0, 0) at slot)).binds)
      H.empty
      (V.range 0 (V.len at))
  in
  let edges = V.map (\p -> sortedDistinct (bindMentions modules owner overloads p (bindAt p))) at in
  V.map
    (\comp ->
      Group {
        members = V.map (\s -> V.getOr (0, 0) at s) comp,
        recursive = recursiveComp edges comp
      })
    (scc edges)

fun bindMentions (modules : [(HirArena, [Binding])]) owner overloads (p : (Int, Int)) (b : Binding)
    : [Int] =
  match V.get modules (fst p) with
  | Just (a, _) -> mentions a owner overloads b.bind []
  | None -> []

fun recursiveComp (edges : [[Int]]) (comp : [Int]) : Bool =
  V.len comp > 1
    or (match V.get comp 0 with
     | Just s -> V.elem s (V.getOr [] edges s)
     | None -> False)

fun sortedDistinct (xs : [Int]) : [Int] =
  -- Sorted, so one that is there already is the last put there.
  V.foldl
    (\acc x -> if V.get acc (V.len acc - 1) == Just x then acc else V.pushBack acc x)
    []
    (sort xs)

def noBinding : Binding = Binding { bind = 0 - 1, binds = [] }

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun independentNodesKeepTheirOrder () =
  assertEq (scc [[], [], []]) [[0], [1], [2]] "as written"

@test fun aDependencyComesFirst () =
  assertEq (scc [[1], []]) [[1], [0]] "`1` before what mentions it"

@test fun aCycleIsOneComponent () =
  assertEq (scc [[1], [0], [0]]) [[0, 1], [2]] "the pair, then what needs it"

@test fun aChainComesOutDeepestFirst () =
  assertEq (scc [[1], [2], []]) [[2], [1], [0]] "the end first"

@test fun separateCyclesStaySeparate () =
  assertEq (scc [[1, 2], [0], [3], [2]]) [[2, 3], [0, 1]] "each its own"

-- What holds of every graph, checked on a hundred made up: each node is in
-- one component and no more, and a node's component is no earlier than the
-- component of anything it mentions -- what it depends on comes first.
@test fun everyNodeIsInOneComponentAfterWhatItMentions () =
  forAll graph (\edges ->
    let found = scc edges in
    let u =
      assertEq (sort (V.concat found)) (V.range 0 (V.len edges)) "each node once, of ${show found}"
    in V.foldl
         (\w from ->
           V.foldl
             (\w2 to ->
               assertTrue
                 (componentOf found to 0 <= componentOf found from 0)
                 "${show to} before ${show from}, which mentions it, in ${show found}")
             w
             (V.getOr [] edges from))
         u
         (V.range 0 (V.len edges)))

-- A graph of at most eight nodes, each mentioning at most four of them.
fun graph () =
  let n = between 0 9 in
  V.map (\node -> vector 4 (\() -> between 0 n)) (V.range 0 n)

-- Which of `found` node `x` is in.
fun componentOf (found : [[Int]]) (x : Int) (i : Int) : Int =
  match V.get found i with
  | None -> i
  | Just c -> if V.elem x c then i else componentOf found x (i + 1)

use Std.Test (assertTrue)
use Std.Test.Property (forAll, between, vector)
