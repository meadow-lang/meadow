-- StrataCheck: what `ToStrata` writes of a unit, checked by Strata's checker
-- of Core terms (`Strata.Check`, docs/2LTT.md, L1), under the `strata`
-- option.
--
-- What is MeadowBoot's own here is what the checker is given: the kernel's
-- state (`Tc`), with no front-end state of its own and declarations' names
-- for its places; the types of the unit's declarations and of those of
-- other units it reads, as `constants`; the definitions the types may see,
-- as `globals`; Meadow's own types, effects and operations, which no
-- package declares (`ToStrata`'s builtins), registered as Idyll's natives
-- are; and each data type's constructors. A declaration with a goal of the
-- translation's in it (`unmapped:<kind>`) is skipped, and the checker is
-- asked of the rest.

use Std.St (getRef, setRef)
use MeadowBoot.ToStrata (Def, Translated, unsaidIn, counted, countsText)
use Strata.Core (Core, Builtin)
use Strata.Hir (Icit)
use Strata.Value as Va
use Strata.Tc (Tc)
use Strata.Tc as T
use Strata.Ctx as X
use Strata.Eval (eval)
use Strata.Check (Checker, Verdict, checker, definition, verdictText)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.String as S

-- What the dump says of a declaration: what the checker said of it, or
-- that it was skipped, and for what.
data Said = Checked Verdict | Skipped [String]

-- A declaration checked, unless the translation left a goal in it.
fun declaration (cx : Checker s () String) (d : Def) : Said ! { St s | e } =
  let unsaid = unsaidIn d in
  if not (V.isEmpty unsaid) then Said.Skipped unsaid
  else
    let tc = cx.tc in
    let w = setRef tc.at d.name in
    Said.Checked (definition cx (X.empty ()) d.ty d.term)

-- Meadow's own types, effects and operations, which no package declares
-- (`ToStrata`'s builtins), as Idyll's natives are: each by its name and how
-- many erased arguments it takes first, and the types among them as data
-- the kernel knows the parameters of, each held positively.
fun natives (tc : Tc s () String) (defs : [Def]) : () ! { St s | e } =
  V.foldl
    (\acc (d : Def) ->
      if d.kind != "builtin" then acc
      else
        (let erased = implicits d.ty 0 in
         let w = setRef tc.nativeInfo (H.insert d.unique (d.name, erased) (getRef tc.nativeInfo)) in
         let w2 = setRef tc.nativeNames (H.insert d.name d.unique (getRef tc.nativeNames)) in
         match kindResult d.ty 0 with
         | Just n ->
             let w3 = setRef tc.natives (H.insert d.unique True (getRef tc.natives)) in
             let w4 = setRef tc.datas (H.insert d.unique (V.range 0 n) (getRef tc.datas)) in
             setRef
               tc.positive
               (H.insert d.unique (V.map (\i -> True) (V.range 0 n)) (getRef tc.positive))
         | None -> ()))
    ()
    defs

-- How many implicit binders a type starts with.
fun implicits (c : Core) (n : Int) : Int =
  match c with
  | Core.Pi _ Icit.Implicit _ _ _ cod -> implicits cod (n + 1)
  | _ -> n

-- How many parameters a type constructor's type takes, where it is one:
-- it ends in a universe or in `Effect`.
fun kindResult (c : Core) (n : Int) : Maybe Int =
  match c with
  | Core.Pi _ _ _ _ _ cod -> kindResult cod (n + 1)
  | Core.Type _ -> Just n
  | Core.LitTy Builtin.Effect -> Just n
  | _ -> None

-- Every declaration of a unit checked: what the dump says of them all,
-- counted, and a line for each of its own. A form the checker does not
-- check yet is counted with what was skipped.
@pub fun checkUnit (t : Translated) : ([String], [String]) =
  runSt (\() ->
    let tc = T.new () "" in
    let all = V.append t.defs t.externs in
    let w =
      setRef
        tc.constants
        (V.foldl
           (\h (d : Def) ->
             if d.unique == 0 - 1 then h else H.insert d.unique (eval tc (Va.emptyEnv ()) d.ty) h)
           H.empty
           all)
    in
    let w2 =
      setRef
        tc.globals
        (V.foldl (\h x -> H.insert (fst x) (eval tc (Va.emptyEnv ()) (snd x)) h) H.empty t.globals)
    in
    let w3 = natives tc all in
    let cx = checker tc (H.fromVec t.datas) in
    let said = V.map (\(d : Def) -> declaration cx d) t.defs in
    let accepted =
      V.len
        (V.filter
           (\v ->
             match v with
             | Said.Checked Verdict.Accepted -> True
             | _ -> False)
           said)
    in
    let rejected =
      V.concatMap
        (\v ->
          match v with
          | Said.Checked (Verdict.Rejected why _) -> [why]
          | _ -> [])
        said
    in
    let skipped =
      V.concatMap
        (\v ->
          match v with
          | Said.Skipped ks -> [V.getOr "" ks 0]
          | Said.Checked (Verdict.Unsupported form) -> ["not supported yet: ${form}"]
          | _ -> [])
        said
    in
    let summary =
      [
        "checked by Strata's kernel: accepted ${show accepted}, rejected ${show (V.len rejected)}, skipped ${show (V.len skipped)}",
        "rejected, by reason: ${countsText (counted rejected)}",
        "skipped, by the first thing not said: ${countsText (counted skipped)}"
      ]
    in
    let lines =
      V.map
        (\v ->
          match v with
          | Said.Checked verdict -> verdictText verdict
          | Said.Skipped ks -> "skipped: ${S.join ", " ks}")
        said
    in (summary, lines))
