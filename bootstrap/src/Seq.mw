-- Seq: `Core` lowered to Cut -- what `meadow-seq` is to the Rust compiler,
-- to the upper of the two IRs.
--
-- Lowering a term is saying where its value goes: `lower` carries the
-- consumer down the tree, and each case answers the statement that gives its
-- term's value to it. A term another needs the value of is lowered with a
-- consumer that names the value and goes on -- `μ̃ x: rep. s` -- which is
-- the whole of how evaluation order is said.
--
-- Every binder says how its value is represented, which is what `Core`'s
-- types are kept for: `repOf`.
--
-- A function is codata with one method, `apply`, of one argument, and a
-- top-level C.binding is a `val`: the closure, or the value. That is the
-- least there is to say, and enough to run; a `def` with every parameter at
-- once, for a function called with all it takes, is for later.
--
-- An effect performed is `perform`, and a handler `handle`: its resumption
-- is a function, as Cut has it, so a clause calls it as it would any other.
--
-- A definition generic in its type is a `def` of a descriptor for each
-- variable, answering the value at them, and a mention of one calls it with
-- the descriptors of the types it is at: how a value of a variable's type
-- is represented is what its descriptor says.
--
-- What is not lowered yet answers `error "unsupported: …"`: joins.

use Lingua (pass!)
use Lingua.Lang (Meta)
use MeadowBoot.Core
use MeadowBoot.Core (Core!)
use Cut as C
use Cut (Cut!, CutProgram, CutBuilder)
use MeadowBoot.Types
use MeadowBoot.Types.Type.*
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Sort (sortBy)
use Std.Maybe as M
use Std.Maybe.Maybe.*

-- --- what lowering carries ---------------------------------------------------

-- What `lower` carries is a record: `k`, where the value of the term being
-- lowered goes; `tops`, which binders are top-level definitions -- a mention
-- of one reads a `val`; and `lifted`, the definitions made of local
-- functions that call themselves.

-- How a value of type `t` is represented.
@pub fun repOf (t : Type) : String =
  match t with
  | Con name args ->
      if V.isEmpty args and stringByteLength name <= 7 then M.unwrapOr "ptr" (H.lookup name scalars)
      else "ptr"
  | _ -> "ptr"

-- The types that are not a pointer, each with what it is.
def scalars : HashMap String String =
  H.fromVec [
    ("Int", "i64"),
    ("Float", "f64"),
    ("Float32", "f32"),
    ("Bool", "bool"),
    ("Char", "char"),
    ("String", "str"),
    ("Unit", "unit"),
    ("Int8", "i8"),
    ("Int16", "i16"),
    ("Int32", "i32"),
    ("UInt8", "u8"),
    ("UInt16", "u16"),
    ("UInt32", "u32"),
    ("UInt64", "u64")
  ]

-- A type variable's name as a representation's: the variable an `impl`'s
-- dictionary is generic in is below every other, and spelt for what it is.
fun tname (v : Int) : String = if v < 0 then "tn${show (0 - v)}" else "t${show v}"

-- How a value of type `t` is represented where lowering is: one of a
-- variable's type however the variable's descriptor says, where a
-- definition around takes one for it.
fun repIn cx (t : Type) : String =
  match t with
  | Var v -> if V.elem v cx.tvars then "'${tname v}" else "ptr"
  | _ -> repOf t

-- The descriptor of each of `tys`, to hand a generic definition.
fun descsOf out cx (m : Meta) (tys : [Type]) = V.map (\t -> C.desc out m (repIn cx t)) tys

-- A value generic in its type, as the variables it is generic in and what
-- it is; anything else is generic in none.
fun peel src value =
  if kindCoreTerm src value == CoreTermKind.TyLam then
    (coreTermTyLamVars src value, coreTermTyLamBody src value)
  else ([], value)

-- The package what a program is entered and shown by is in: nothing a unit
-- declares.
def package : String = "meadow:boot/"

-- A definition's symbol, by its binder: an `impl`'s dictionary's binder is
-- below every other, and is spelt for what it is.
fun topSymbol (pkg : String) (id : Int) : String =
  if id < 0 then "meadow:${pkg}/impl${show (0 - id)}" else "meadow:${pkg}/d${show id}"

-- A primitive's name in Cut: `meadow_rt::Prim`'s, its first letter small. A
-- conversion to a sized integer is named for the type, as it is in source:
-- `ToWord(U8)` is `toUInt8`.
fun primName (op : String) : String =
  if stringByteLength op == 0 then op
  else if S.startsWith "ToWord(" op then
    (let width = stringSlice op 7 (stringByteLength op - 1) in
     if S.startsWith "U" width then "toUInt${S.drop width 1}" else "toInt${S.drop width 1}")
  else S.toLower (stringSlice op 0 1) ++ stringSlice op 1 (stringByteLength op)

-- --- the lowering ------------------------------------------------------------

pass! {
  lower : Core -> Cut with cx from Term, Lit
    | LInt { value } -> C.int out here value
    | LBig { value } -> C.int out here value
    | LF64 { value } -> C.float out here value
    | LF32 { value } -> C.float out here value
    | LWord { ty, bits } -> C.int out here bits
    | LStr { text } -> C.str out here text
    | LChar { code } -> C.char out here code
    | LBool { value } -> C.bool out here value
    | LUnit {} -> C.unit out here
    -- A literal of a sized integer is the number made that wide: Cut writes
    -- no literal of one.
    | Const { raw lit } ->
        (match viewCoreLit src lit with
         | CoreLitView.LWord w ->
             C.prim out here (primName "ToWord(${w.ty})") [C.int out here w.bits] [cx.k]
         -- A big integer is made of the number: Cut writes no literal of one
         -- either.
         | CoreLitView.LBig b -> C.prim out here (primName "ToBig") [C.int out here b.value] [cx.k]
         | _ -> C.give out here (lowerLit src out cx lit) cx.k)
    | Var { id } ->
        (match H.lookup id cx.gtops with
         | Just vars ->
             C.invoke
               out
               here
               (topSymbol cx.pkg id)
               (V.map (\v -> C.desc out here "ptr") vars)
               [cx.k]
         | None ->
             (match H.lookup id cx.ext with
              -- Another unit's: its symbol, asked for at no types in
              -- particular where nothing said which.
              | Just (symbol, n) ->
                  if n > 0 then
                    C.invoke
                      out
                      here
                      symbol
                      (V.map (\v -> C.desc out here "ptr") (V.range 0 n))
                      [cx.k]
                  else C.give out here (C.sym out here symbol) cx.k
              | None ->
                  if M.isSome (H.lookup id cx.tops) then
                    C.give out here (C.sym out here (topSymbol cx.pkg id)) cx.k
                  else if M.isSome (H.lookup id cx.recs) then
                    -- A local function that names itself, as a value: its
                    -- definition asked for it.
                    (match H.lookup id cx.locals with
                     | Just (symbol, outer, around) ->
                         C.invoke out here symbol (leading out cx here outer around) [cx.k]
                     | None -> C.unsupported out here "a local function nothing defines")
                  else C.give out here (C.var out here "v${show id}") cx.k))
    | TyLam { vars, raw body } -> lowerTerm src out cx body
    | TyApp { raw func, tys } -> instanced src out cx here func tys
    | Lam { param, paramTy, raw body } ->
        (let k = "k${show node}" in
         let inner = lowerTerm src out { cx | k = C.cont out here k } body in
         C.give out here (C.function out here "v${show param}" (repIn cx paramTy) k inner) cx.k)
    | App { raw func, raw arg } ->
        (match spine src func [arg] with
         | (head, args) ->
             (match known src out cx here head (V.len args) with
              | Just (symbol, lead, n) -> direct src out cx here node symbol lead n args
              | None ->
                  (let f = "f${show node}" in
                   let a = "a${show node}" in
                   let call = C.applied out here (C.var out here f) (C.var out here a) cx.k in
                   let given = named src out cx here a arg call in
                   named src out cx here f func given)))
    | Let { id, raw value, raw body } ->
        (if kindCoreTerm src value == CoreTermKind.TyLam and not (once src value) then
           genericLet src out cx here id value body
         else named src out cx here "v${show id}" value (lowerTerm src out cx body))
    | If { raw cond, raw yes, raw no } ->
        C.shared out cx.k here "j${show node}" (\k ->
          (let inner = { cx | k = k } in
           let c = "c${show node}" in
           named
             src
             out
             inner
             here
             c
             cond
             (C.branch
                out
                here
                "u${show node}"
                (C.var out here c)
                (lowerTerm src out inner no)
                (lowerTerm src out inner yes))))
    | Prim { op, raw args } ->
        (let names = V.map (\i -> "p${show node}_${show i}") (V.range 0 (V.len args)) in
         -- What it answers is named at its own representation, which a
         -- continuation alone does not say: one of an array's items is
         -- whatever the array holds.
         let x = "x${show node}" in
         -- A thread is started with how what it answers is represented: a
         -- task is a pointer, and says nothing of it.
         let answers =
           (match (op, tyCoreTerm src node) with
            | ("ThreadSpawn", Con "Task" tys) ->
                (if V.len tys == 1 then descsOf out cx here tys else [])
            | _ -> [])
         in
         let done =
           C.prim
             out
             here
             (primName op)
             (V.append answers (V.map (\n -> C.var out here n) names))
             [C.binding
                out
                here
                x
                (repIn cx (tyCoreTerm src node))
                (C.give out here (C.var out here x) cx.k)]
         in V.foldr
              (\pair rest -> named src out cx here (fst pair) (snd pair) rest)
              done
              (V.zip names args))
    | Tuple { raw items } ->
        (let names = V.map (\i -> "t${show node}_${show i}") (V.range 0 (V.len items)) in
         let done =
           C.give out here (C.tuple out here (V.map (\n -> C.var out here n) names)) cx.k
         in V.foldr
              (\pair rest -> named src out cx here (fst pair) (snd pair) rest)
              done
              (V.zip names items))
    | LetRec { raw binds, raw body } -> lifted src out cx here binds body
    | Array { raw items } ->
        (let names = V.map (\i -> "y${show node}_${show i}") (V.range 0 (V.len items)) in
         let done =
           C.give out here (C.array out here (V.map (\n -> C.var out here n) names)) cx.k
         in V.foldr
              (\pair rest -> named src out cx here (fst pair) (snd pair) rest)
              done
              (V.zip names items))
    | Proj { raw tuple, index } ->
        (match tyCoreTerm src tuple with
         | Tuple tys ->
             (let names = V.map (\i -> "q${show node}_${show i}") (V.range 0 (V.len tys)) in
              let whole = "q${show node}" in
              named
                src
                out
                cx
                here
                whole
                tuple
                (C.give
                   out
                   here
                   (C.var out here whole)
                   (C.caseOf
                      out
                      here
                      [C.arm
                         out
                         here
                         "#tuple"
                         (V.map
                            (\q -> C.param out here (fst q) (repIn cx (snd q)))
                            (V.zip names tys))
                         (C.give out here (C.var out here (V.getOr "" names index)) cx.k)])))
         | _ -> C.unsupported out here "an item of what is not known to be a tuple")
    | Record { raw fields } ->
        (let names = V.map (\i -> "r${show node}_${show i}") (V.range 0 (V.len fields)) in
         let done =
           C.give
             out
             here
             (C.recorded
                out
                here
                (V.map (\f -> coreFieldLabel src f) fields)
                (V.map (\n -> C.var out here n) names))
             cx.k
         in V.foldr
              (\pair rest -> named src out cx here (fst pair) (coreFieldValue src (snd pair)) rest)
              done
              (V.zip names fields))
    -- A field of a record, by its label; or of a declared type whose one
    -- constructor names its fields, by the field's place.
    | Sel { raw target, label } ->
        (let s = "s${show node}" in
         named
           src
           out
           cx
           here
           s
           target
           (match placeOf cx (tyCoreTerm src target) label with
            | Just (ctor, at, tys) ->
                (let fs = V.map (\i -> "s${show node}_${show i}") (V.range 0 (V.len tys)) in
                 C.give
                   out
                   here
                   (C.var out here s)
                   (C.caseOf
                      out
                      here
                      [C.arm
                         out
                         here
                         (symbolOf cx.pkgs ctor)
                         (V.map (\q -> C.param out here (fst q) (repIn cx (snd q))) (V.zip fs tys))
                         (C.give out here (C.var out here (V.getOr "" fs at)) cx.k)]))
            | None ->
                -- What is read is named at its own representation, which a
                -- continuation alone does not say.
                (let x = "x${show node}" in
                 C.selected
                   out
                   here
                   (C.var out here s)
                   label
                   (C.binding
                      out
                      here
                      x
                      (repIn cx (tyCoreTerm src node))
                      (C.give out here (C.var out here x) cx.k)))))
    | Extend { raw target, label, raw value } ->
        (let s = "s${show node}" in
         let v = "e${show node}" in
         named
           src
           out
           cx
           here
           s
           target
           (named
              src
              out
              cx
              here
              v
              value
              (match placeOf cx (tyCoreTerm src target) label with
               | Just (ctor, at, tys) ->
                   (let fs = V.map (\i -> "s${show node}_${show i}") (V.range 0 (V.len tys)) in
                    C.give
                      out
                      here
                      (C.var out here s)
                      (C.caseOf
                         out
                         here
                         [C.arm
                            out
                            here
                            (symbolOf cx.pkgs ctor)
                            (V.map
                               (\q -> C.param out here (fst q) (repIn cx (snd q)))
                               (V.zip fs tys))
                            (C.give
                               out
                               here
                               (C.con
                                  out
                                  here
                                  (symbolOf cx.pkgs ctor)
                                  (V.map
                                     (\i -> C.var out here (if i == at then v else V.getOr "" fs i))
                                     (V.range 0 (V.len fs))))
                               cx.k)]))
               | None -> C.extended out here (C.var out here s) label (C.var out here v) cx.k)))
    | Ctor { name, raw args } ->
        (let names = V.map (\i -> "x${show node}_${show i}") (V.range 0 (V.len args)) in
         let done =
           C.give
             out
             here
             (C.con out here (symbolOf cx.pkgs name) (V.map (\n -> C.var out here n) names))
             cx.k
         in V.foldr
              (\pair rest -> named src out cx here (fst pair) (snd pair) rest)
              done
              (V.zip names args))
    | Case { raw scrutinee, raw arms } ->
        C.shared out cx.k here "j${show node}" (\k ->
          (let inner = { cx | k = k } in
           let s = "s${show node}" in
           named
             src
             out
             inner
             here
             s
             scrutinee
             (armsFrom src out inner here s (repIn inner (tyCoreTerm src scrutinee)) arms 0)))
    | Perform { eff, op, raw arg } ->
        (let a = "a${show node}" in
         named
           src
           out
           cx
           here
           a
           arg
           -- What it is resumed with is named at its own representation:
           -- an effect that takes types declares none for what one of them
           -- stands for, and a continuation alone does not say.
           (C.performed
              out
              here
              (opSymbol eff op)
              [C.var out here a]
              (C.binding
                 out
                 here
                 "x${show node}"
                 (repIn cx (tyCoreTerm src node))
                 (C.give out here (C.var out here "x${show node}") cx.k))))
    | Handle { raw body, raw clauses, retId, raw ret } ->
        (let h = "h${show node}" in
         let b = "b${show node}" in
         let inner = { cx | k = C.cont out here h } in
         let answered = repIn cx (tyCoreTerm src body) in
         let (returned, after) =
           (match (retId, ret) with
            | (Just r, Just t) -> ("v${show r}", lowerTerm src out inner t)
            | _ -> ("r${show node}", C.give out here (C.var out here "r${show node}") inner.k))
         in C.handled
              out
              here
              (V.map
                 (\c ->
                   C.clause
                     out
                     here
                     (opSymbol (coreClauseEff src c) (coreClauseOp src c))
                     [C.param
                        out
                        here
                        "v${show (coreClauseParam src c)}"
                        (repIn cx (coreClauseParamTy src c))]
                     "v${show (coreClauseResume src c)}"
                     h
                     (lowerTerm src out inner (coreClauseBody src c)))
                 clauses)
              (C.param out here returned answered)
              h
              after
              b
              (lowerTerm src out { cx | k = C.cont out here b } body)
              cx.k)
    | Join { id, params, raw rhs, raw body } -> C.unsupported out here "a join"
    | Jump { id, raw args } -> C.unsupported out here "a jump"
    | Ill {} -> C.fail out here "this did not compile"
    | Bind { id, raw value } -> ()
    | Field { label, raw value } -> ()
    | Arm { raw pat, raw guard, raw body } -> ()
    | Clause { eff, op, param, paramTy, resume, raw body } -> ()
    | PWild {} -> ()
    | PVar { id } -> ()
    | PAs { id, raw pat } -> ()
    | PLit { raw lit } -> ()
    | PTuple { raw items } -> ()
    | PArray { raw items } -> ()
    | PCtor { name, raw args } -> ()
    | PRecord { raw fields } -> ()
    | PField { label, raw pat } -> ()
}

-- --- calls ------------------------------------------------------------------
--
-- A function written at the top with its parameters -- `fun f x y = e` -- is
-- two definitions: one of all its parameters at once, and the function as
-- a value, which takes them one at a time and calls that. A call that
-- gives a name of one all the arguments it is written with calls the first
-- directly, and makes no function on the way.

-- What is called, and its arguments in order: `f a b` is `f` and `a`, `b`.
fun spine src func (args : [CoreTerm]) =
  match viewCoreTerm src func with
  | CoreTermView.App r -> spine src r.func (V.pushFront args r.arg)
  | _ -> (func, args)

-- The definition of all its parameters `head` names, what it is given
-- before them -- a descriptor for each type it is asked for at, and for a
-- local one what it mentions from around it -- and how many parameters
-- that is: if it names one, and is given at least that many arguments.
fun known src out cx (m : Meta) head (given : Int) =
  let named =
    \id tys generic ->
      (match H.lookup id cx.arity with
       | Just (symbol, n, types) ->
           if n > 0 and given >= n and (types > 0) == generic then
             Just (symbol, descsOf out cx m tys, n)
           else None
       | None -> None)
  in match viewCoreTerm src head with
     | CoreTermView.Var r ->
         (match (H.lookup r.id cx.recs, H.lookup r.id cx.locals) with
          | (Just n, Just (symbol, outer, around)) ->
              if given >= n then Just (symbol, leading out cx m outer around, n) else None
          | _ -> named r.id [] False)
     | CoreTermView.TyApp r ->
         (match viewCoreTerm src r.func with
          | CoreTermView.Var v -> named v.id r.tys True
          | _ -> None)
     | _ -> None

-- The symbol of a function's definition of all its parameters, by the
-- symbol of the function.
fun directly (symbol : String) : String = "${symbol}f"

-- A call of the definition `symbol` of `n` parameters with the first `n` of
-- `args`, each named in turn, and what it answers applied to the rest one
-- at a time.
fun direct src out cx (m : Meta) node (symbol : String) lead (n : Int) args =
  let names = V.map (\i -> "a${show node}_${show i}") (V.range 0 (V.len args)) in
  let rest = V.drop names n in
  let after =
    V.foldr
      (\i k ->
        (let f = if i == 0 then "f${show node}" else "f${show node}_${show i}" in
         C.binding
           out
           m
           f
           "ptr"
           (C.applied out m (C.var out m f) (C.var out m (V.getOr "" rest i)) k)))
      cx.k
      (V.range 0 (V.len rest))
  in
  let call =
    C.invoke
      out
      m
      (directly symbol)
      (V.append lead (V.map (\x -> C.var out m x) (V.take names n)))
      [after]
  in V.foldr (\pair acc -> named src out cx m (fst pair) (snd pair) acc) call (V.zip names args)

-- A function of `params` as a value, given to `k`: one that takes them one
-- at a time from the `i`th on, and then calls the definition of them all,
-- `symbol`'s, which is given `lead` before them.
fun curried out cx (symbol : String) lead (params : [(Int, Type)]) (i : Int) k =
  if i >= V.len params then
    C.invoke
      out
      C.nowhere
      (directly symbol)
      (V.append lead (V.map (\p -> C.var out C.nowhere "v${show (fst p)}") params))
      [k]
  else
    (let p = V.getOr (0, Error) params i in
     let w = "w${show i}" in
     C.give
       out
       C.nowhere
       (C.function
          out
          C.nowhere
          "v${show (fst p)}"
          (repIn cx (snd p))
          w
          (curried out cx symbol lead params (i + 1) (C.cont out C.nowhere w)))
       k)

-- A function's parameters as it is written with them, each with its type,
-- and its body: `\x -> \y -> e` is `x`, `y` and `e`.
fun lams src term (params : [(Int, Type)]) =
  match viewCoreTerm src term with
  | CoreTermView.Lam r -> lams src r.body (V.pushBack params (r.param, r.paramTy))
  | _ -> (params, term)

-- `term` lowered so that its value is `name` in `rest`.
fun named src out cx (m : Meta) (name : String) term rest =
  lowerTerm src out { cx | k = C.binding out m name (repIn cx (tyCoreTerm src term)) rest } term

-- --- local recursion ---------------------------------------------------------
--
-- Cut has no function that names itself where it is made, so one is a
-- definition at the top: of what it mentions from around it, answering the
-- function. Called, the function asks that definition for itself again --
-- the name its body knows it by -- and goes on.

-- What a local definition is given before anything else: a descriptor for
-- each type variable in scope where it was written, and what it mentions
-- from around it.
fun leading out cx (m : Meta) (outer : [Int]) (around : [(Int, Type)]) =
  V.append
    (descsOf out cx m (V.map (\v -> Var v) outer))
    (V.map (\fv -> C.var out m "v${show (fst fv)}") around)

-- `let rec f = \x -> … and g = \y -> … in body`: a definition to each, of
-- what any of them mentions from around them.
fun lifted src out cx (m : Meta) binds body =
  if V.isEmpty binds then lowerTerm src out cx body
  else if V.any
    (\b -> kindCoreTerm src (snd (peel src (coreBindValue src b))) != CoreTermKind.Lam)
    binds then C.unsupported out m "a local value that names itself"
  else
    (let ids = V.map (\b -> coreBindId src b) binds in
     let around =
       captured cx (V.foldl (\seen b -> free src (coreBindValue src b) ids seen) [] binds)
     in
     let symbol = \id -> "meadow:${cx.pkg}/l${show id}" in
     -- One generic in its type takes its first parameter, and is asked for
     -- at each mention with the types it is at. Another has a definition of
     -- all its parameters, which a call with that many is a call of, and
     -- is asked for as a value only where it is mentioned as one.
     let plain = \b -> V.isEmpty (fst (peel src (coreBindValue src b))) in
     let within =
       {
         cx
           | locals =
             V.foldl
               (\h b -> H.insert (coreBindId src b) (symbol (coreBindId src b), cx.tvars, around) h)
               cx.locals
               binds,
         recs =
           V.foldl
             (\h b ->
               if plain b then
                 H.insert (coreBindId src b) (V.len (fst (lams src (coreBindValue src b) []))) h
               else h)
             cx.recs
             binds
       }
     in
     let taken = V.map (\fv -> C.param out m "v${show (fst fv)}" (repIn cx (snd fv))) around in
     let made =
       V.concatMap
         (\b ->
           (let (vars, value) = peel src (coreBindValue src b) in
            let name = symbol (coreBindId src b) in
            if plain b then
              (let (params, inner) = lams src value [] in
               [
                 C.genericDecl
                   out
                   m
                   (directly name)
                   (V.map tname within.tvars)
                   (V.append
                      taken
                      (V.map
                         (\p -> C.param out m "v${show (fst p)}" (repIn within (snd p)))
                         params))
                   [C.param out m "k" "ptr"]
                   (lowerTerm src out { within | k = C.cont out m "k" } inner),
                 C.genericDecl
                   out
                   m
                   name
                   (V.map tname within.tvars)
                   taken
                   [C.param out m "k" "ptr"]
                   (curried
                      out
                      within
                      name
                      (leading out within m cx.tvars around)
                      params
                      0
                      (C.cont out m "k"))
               ])
            else
              (let k = "k${show value}" in
               let inner = { within | tvars = V.append cx.tvars vars } in
               [C.genericDecl
                  out
                  m
                  name
                  (V.map tname inner.tvars)
                  taken
                  [C.param out m "k" "ptr"]
                  (C.give
                     out
                     m
                     (C.function
                        out
                        m
                        "v${show (coreTermLamParam src value)}"
                        (repIn inner (coreTermLamParamTy src value))
                        k
                        (lowerTerm
                           src
                           out
                           { inner | k = C.cont out m k }
                           (coreTermLamBody src value)))
                     (C.cont out m "k"))])))
         binds
     in
     let u = stSetRef cx.lifted (V.append (stGetRef cx.lifted) made) in
     lowerTerm src out within body)

-- Whether a value generic in its type is the same value at every type, and
-- so is made once where it is bound. It is no function. Where it is worked
-- out there is nothing of the types it is generic in to work on -- a pure
-- value of every type holds none: an empty map, `None`, a record of them --
-- so what a descriptor would say there is never asked, as long as no name
-- is bound at such a type itself. A function *inside* it is another matter:
-- it runs later, on what its caller has, and has to know what that is. So
-- nothing under a function in it may mention those types at all.
--
-- Made a definition and asked for at each mention, as a generic function
-- is, a value is worked out again each time: a table built once in the
-- source, built once for every use of it.
fun once src value : Bool =
  let (vars, inner) = peel src value in
  kindCoreTerm src inner != CoreTermKind.Lam and not (depends src inner vars False)

-- Whether a type mentions one of `vars`.
fun mentionsOf (t : Type) (vars : [Int]) : Bool =
  match t with
  | Var v -> V.elem v vars
  | Con _ args -> V.any (\x -> mentionsOf x vars) args
  | Fun params result eff -> V.any (\x -> mentionsOf x vars) params or mentionsOf result vars
  | Tuple items -> V.any (\x -> mentionsOf x vars) items
  | Record row -> mentionsOf row vars
  | RowExtend _ field rest -> mentionsOf field vars or mentionsOf rest vars
  | _ -> False

-- Whether a name of type `t` is one a descriptor of `vars` says something
-- of: one of them itself where the value is worked out, and anything that
-- mentions one `under` a function.
fun described (t : Type) (vars : [Int]) (under : Bool) : Bool =
  if under then mentionsOf t vars else (match t with | Var v -> V.elem v vars | _ -> False)

fun patDepends src p (vars : [Int]) (under : Bool) : Bool =
  match viewCorePat src p with
  | CorePatView.PVar r -> described r.ty vars under
  | CorePatView.PAs r -> described r.ty vars under or patDepends src r.pat vars under
  | CorePatView.PTuple r -> V.any (\q -> patDepends src q vars under) r.items
  | CorePatView.PArray r -> V.any (\q -> patDepends src q vars under) r.items
  | CorePatView.PCtor r -> V.any (\q -> patDepends src q vars under) r.args
  | CorePatView.PRecord r -> V.any (\f -> patDepends src (corePFieldPat src f) vars under) r.fields
  | _ -> False

-- Whether what `t` does depends on a descriptor of `vars`: `under` is
-- whether `t` is inside a function of the value.
fun depends src t (vars : [Int]) (under : Bool) : Bool =
  let any = \ts -> V.any (\u -> depends src u vars under) ts in
  match viewCoreTerm src t with
  | CoreTermView.Lam r -> mentionsOf r.paramTy vars or depends src r.body vars True
  | CoreTermView.TyLam r -> depends src r.body vars under
  | CoreTermView.TyApp r ->
      (under and V.any (\x -> mentionsOf x vars) r.tys) or depends src r.func vars under
  | CoreTermView.App r -> any [r.func, r.arg]
  | CoreTermView.Let r -> described (tyCoreTerm src r.value) vars under or any [r.value, r.body]
  | CoreTermView.LetRec _ -> True
  | CoreTermView.If r -> any [r.cond, r.yes, r.no]
  | CoreTermView.Tuple r -> any r.items
  | CoreTermView.Array r -> any r.items
  | CoreTermView.Proj r -> depends src r.tuple vars under
  | CoreTermView.Record r -> any (V.map (\f -> coreFieldValue src f) r.fields)
  | CoreTermView.Sel r -> depends src r.target vars under
  | CoreTermView.Extend r -> any [r.target, r.value]
  | CoreTermView.Ctor r -> any r.args
  | CoreTermView.Prim r -> any r.args
  | CoreTermView.Perform r -> depends src r.arg vars under
  | CoreTermView.Case r ->
      depends src r.scrutinee vars under
        or V.any
          (\arm ->
            patDepends src (coreArmPat src arm) vars under
              or (match coreArmGuard src arm with
               | Just g -> depends src g vars under
               | None -> False)
              or depends src (coreArmBody src arm) vars under)
          r.arms
  -- A handler, a join point, a function that names itself: left generic,
  -- which is always right.
  | CoreTermView.Handle _ -> True
  | CoreTermView.Join _ -> True
  | CoreTermView.Jump r -> any r.args
  | _ -> False

-- `let x = v in body`, `v` generic in its type: a definition at the top, of
-- a descriptor for each variable in scope and each of its own, and of what
-- it mentions from around it -- asked for at each mention, with the types
-- the mention is at.
fun genericLet src out cx (m : Meta) (id : Int) value body =
  let (vars, inner) = peel src value in
  let around = captured cx (free src inner [] []) in
  let symbol = "meadow:${cx.pkg}/g${show id}" in
  let all = V.append cx.tvars vars in
  let made =
    C.genericDecl
      out
      m
      symbol
      (V.map tname all)
      (V.map (\fv -> C.param out m "v${show (fst fv)}" (repIn cx (snd fv))) around)
      [C.param out m "k" "ptr"]
      (lowerTerm src out { cx | tvars = all, k = C.cont out m "k" } inner)
  in
  let u = stSetRef cx.lifted (V.pushBack (stGetRef cx.lifted) made) in
  lowerTerm src out { cx | locals = H.insert id (symbol, cx.tvars, around) cx.locals } body

-- `f [T, …]`: a generic definition asked for at types -- a top-level one
-- with their descriptors, a local one with those in scope where it was
-- written before them and what it mentions from around it after.
fun instanced src out cx (m : Meta) func (tys : [Type]) =
  match viewCoreTerm src func with
  | CoreTermView.Var r ->
      (match H.lookup r.id cx.locals with
       | Just (symbol, outer, around) ->
           C.invoke
             out
             m
             symbol
             (V.concat [
                descsOf out cx m (V.map (\v -> Var v) outer),
                descsOf out cx m tys,
                V.map (\fv -> C.var out m "v${show (fst fv)}") around
              ])
             [cx.k]
       | None ->
           if M.isSome (H.lookup r.id cx.gtops) then
             C.invoke out m (topSymbol cx.pkg r.id) (descsOf out cx m tys) [cx.k]
           else
             (match H.lookup r.id cx.ext with
              -- One that is generic in no type is asked for at none: a
              -- method's selector is written at its trait's types, and is
              -- one function for them all.
              | Just (symbol, n) ->
                  if n == 0 then lowerTerm src out cx func
                  else C.invoke out m symbol (descsOf out cx m tys) [cx.k]
              | None -> lowerTerm src out cx func))
  | _ -> lowerTerm src out cx func

-- Of the variables a term mentions, those a definition lifted out of where
-- it was written has to be given: not a top-level definition, and for a
-- local generic one what that was given.
fun captured cx (fvs : [(Int, Type)]) : [(Int, Type)] =
  V.foldl
    (\acc fv ->
      match H.lookup (fst fv) cx.locals with
      | Just (_, _, theirs) ->
          V.foldl (\a x -> if V.any (\s -> fst s == fst x) a then a else V.pushBack a x) acc theirs
      | None ->
          if M.isSome (H.lookup (fst fv) cx.tops) or V.any (\s -> fst s == fst fv) acc then acc
          else V.pushBack acc fv)
    []
    fvs

-- The variables `t` mentions and does not bind, each with its type, after
-- `seen`: what a function lifted out of where it was written has to be
-- given.
fun free (a : CoreArena) (t : CoreTerm) (bound : [Int]) (seen : [(Int, Type)]) : [(Int, Type)] =
  let each = \ts b acc -> V.foldl (\x u -> free a u b x) acc ts in
  match viewCoreTerm a t with
  | CoreTermView.Var r ->
      if V.elem r.id bound or V.any (\s -> fst s == r.id) seen then seen
      else V.pushBack seen (r.id, r.ty)
  | CoreTermView.Lam r -> free a r.body (V.pushBack bound r.param) seen
  | CoreTermView.TyLam r -> free a r.body bound seen
  | CoreTermView.TyApp r -> free a r.func bound seen
  | CoreTermView.App r -> free a r.arg bound (free a r.func bound seen)
  | CoreTermView.Let r -> free a r.body (V.pushBack bound r.id) (free a r.value bound seen)
  | CoreTermView.LetRec r ->
      let inner = V.append bound (V.map (\b -> coreBindId a b) r.binds) in
      free a r.body inner (each (V.map (\b -> coreBindValue a b) r.binds) inner seen)
  | CoreTermView.If r -> each [r.cond, r.yes, r.no] bound seen
  | CoreTermView.Tuple r -> each r.items bound seen
  | CoreTermView.Array r -> each r.items bound seen
  | CoreTermView.Proj r -> free a r.tuple bound seen
  | CoreTermView.Record r -> each (V.map (\f -> coreFieldValue a f) r.fields) bound seen
  | CoreTermView.Sel r -> free a r.target bound seen
  | CoreTermView.Extend r -> each [r.target, r.value] bound seen
  | CoreTermView.Ctor r -> each r.args bound seen
  | CoreTermView.Prim r -> each r.args bound seen
  | CoreTermView.Perform r -> free a r.arg bound seen
  | CoreTermView.Case r ->
      V.foldl
        (\acc arm ->
          (let inner = V.append bound (bindersOf a (coreArmPat a arm)) in
           let guarded =
             (match coreArmGuard a arm with
              | Just g -> free a g inner acc
              | None -> acc)
           in free a (coreArmBody a arm) inner guarded))
        (free a r.scrutinee bound seen)
        r.arms
  | CoreTermView.Handle r ->
      let body = free a r.body bound seen in
      let clauses =
        V.foldl
          (\acc c ->
            free
              a
              (coreClauseBody a c)
              (V.append bound [coreClauseParam a c, coreClauseResume a c])
              acc)
          body
          r.clauses
      in (match (r.retId, r.ret) with
          | (Just x, Just ret) -> free a ret (V.pushBack bound x) clauses
          | _ -> clauses)
  | CoreTermView.Join r -> free a r.body bound (free a r.rhs (V.append bound r.params) seen)
  | CoreTermView.Jump r -> each r.args bound seen
  | CoreTermView.Ill _ -> seen
  | CoreTermView.Const _ -> seen

-- The variables a pattern binds.
fun bindersOf (a : CoreArena) (p : CorePat) : [Int] =
  match viewCorePat a p with
  | CorePatView.PVar r -> [r.id]
  | CorePatView.PAs r -> V.pushBack (bindersOf a r.pat) r.id
  | CorePatView.PTuple r -> V.concatMap (bindersOf a) r.items
  | CorePatView.PArray r -> V.concatMap (bindersOf a) r.items
  | CorePatView.PCtor r -> V.concatMap (bindersOf a) r.args
  | CorePatView.PRecord r -> V.concatMap (\f -> bindersOf a (corePFieldPat a f)) r.fields
  | CorePatView.PWild _ -> []
  | CorePatView.PLit _ -> []

-- --- matching ----------------------------------------------------------------
--
-- A `case` of Cut takes one constructor apart and no more, so a pattern is
-- matched a layer at a time: what is under a constructor is named, and
-- matched in turn. An arm that does not match gives up -- `unit` to a
-- continuation the arm is built with the name of -- and the arms after it
-- are what that continuation does.

-- Arms `i` and after, of a match on the value named `s`. Arms that follow
-- one another and each take a different constructor apart are one `case`
-- of Cut, an arm of it each: a value is of one of them at most, so one that
-- gives up has only the arms after them all left to try.
fun armsFrom src out cx (m : Meta) (s : String) (sr : String) arms (i : Int) =
  match V.get arms i with
  | None -> C.fail out m "non-exhaustive pattern match"
  | Just arm ->
      let stop = distinct src arms i [] in
      let group =
        V.map (\j -> V.getOr arm arms j) (V.range i (if stop - i >= 2 then stop else i + 1))
      in
      let after = i + V.len group in
      let cased =
        \within (fail : String) rest ->
          C.give
            out
            m
            (C.var out m s)
            (C.caseOf
               out
               m
               (V.pushBack
                  (V.map
                     (\a ->
                       taken src out within m (coreArmPat src a) fail (\() ->
                         armBody src out within m a fail))
                     group)
                  (C.arm out m "_" [] rest)))
      in
      let seen = viewed src arms i [] None in
      -- Arms written with one view of the value -- a pattern synonym each,
      -- as a tree's nodes are matched -- ask the view once and are a `case`
      -- of what it answers; written out an arm at a time, each asked it
      -- again, twice.
      if not (V.isEmpty seen) then
        (match V.getOr (arm, 0, 0, 0, 0) seen 0 with
         | (_, x0, look, _, _) ->
             let w = "w${show arm}" in
             C.give
               out
               m
               (C.var out m s)
               (C.binding
                  out
                  m
                  "v${show x0}"
                  sr
                  (named
                     src
                     out
                     cx
                     m
                     w
                     look
                     (C.give
                        out
                        m
                        (C.var out m w)
                        (C.caseOf
                           out
                           m
                           (V.pushBack
                              (V.map
                                 (\one ->
                                   match one with
                                   | (_, x, _, q, b) ->
                                       taken src out cx m q "#never" (\() ->
                                         C.give
                                           out
                                           m
                                           (C.var out m s)
                                           (C.binding
                                              out
                                              m
                                              "v${show x}"
                                              sr
                                              (lowerTerm src out cx b))))
                                 seen)
                              (C.arm
                                 out
                                 m
                                 "_"
                                 []
                                 (armsFrom src out cx m s sr arms (i + V.len seen)))))))))
      -- Arms that cannot give up -- a constructor over names, and no guard --
      -- need nowhere to give up to: what comes after them is what the `case`
      -- does with any other constructor, written there.
      else if V.all (\a -> plain src a) group then
        cased cx "#never" (armsFrom src out cx m s sr arms after)
      else if sure src (coreArmPat src arm) and M.isNone (coreArmGuard src arm) then
        matched src out cx m s (coreArmPat src arm) "#never" (\() ->
          armBody src out cx m arm "#never")
      else
        -- Arms that may give up: the arms after them are a definition of
        -- their own (`joinFor`), which giving up calls -- a jump with what it
        -- needs, and nothing made to hold it.
        (let fail = "n${show arm}" in
         let within =
           { cx | joins = H.insert fail (joinFor src out cx m s sr arms after) cx.joins }
         in if stop - i >= 2 then cased within fail (gaveUp out within m fail)
            else
              matched src out within m s (coreArmPat src arm) fail (\() ->
                armBody src out within m arm fail))

-- The arms from `j` on as a definition: of what they mention from around
-- them and of the value matched, `s`, represented as `sr`. Its symbol and
-- what it is given before `s` -- or no symbol, where no arm is left and
-- giving up is the match failing.
fun joinFor src out cx (m : Meta) (s : String) (sr : String) arms (j : Int) =
  if j >= V.len arms then ("", [], s)
  else
    (let around =
       captured
         cx
         (V.foldl
            (\seen k ->
              (let arm = V.getOr 0 arms k in
               let bound = bindersOf src (coreArmPat src arm) in
               let guarded =
                 (match coreArmGuard src arm with
                  | Just g -> free src g bound seen
                  | None -> seen)
               in free src (coreArmBody src arm) bound guarded))
            []
            (V.range j (V.len arms)))
     in
     let symbol = "meadow:${cx.pkg}/j${show (V.getOr 0 arms j)}" in
     let made =
       C.genericDecl
         out
         m
         symbol
         (V.map tname cx.tvars)
         (V.pushBack
            (V.map (\fv -> C.param out m "v${show (fst fv)}" (repIn cx (snd fv))) around)
            (C.param out m s sr))
         [C.param out m "k" "ptr"]
         (armsFrom src out { cx | k = C.cont out m "k" } m s sr arms j)
     in
     let u = stSetRef cx.lifted (V.pushBack (stGetRef cx.lifted) made) in
     (symbol, around, s))

-- Giving up on an arm: the arms after it called, with what they need and
-- where the match's answer goes.
fun gaveUp out cx (m : Meta) (fail : String) =
  match H.lookup fail cx.joins with
  | Just (symbol, around, s) ->
      if S.isEmpty symbol then C.fail out m "non-exhaustive pattern match"
      else
        C.invoke out m symbol (V.pushBack (leading out cx m cx.tvars around) (C.var out m s)) [cx.k]
  | None -> C.gaveUp out m fail

-- The arms from `i` on that each see the value through one view -- what
-- `Elab` makes of a pattern that is a synonym: the value named, a guard that
-- asks the view and matches what it answers, and a body that asks it again
-- -- for as long as they ask the same view (`asked`, once one has), take apart a constructor of its
-- answer no arm before took, over names, and have no guard of their own.
-- Of each: the arm, the name it gives the value, the asking, the pattern
-- for what is answered, and the body under it.
fun viewed src arms (i : Int) (taken : [String]) (asked : Maybe Int) =
  match V.get arms i with
  | None -> []
  | Just arm ->
      (match (viewCorePat src (coreArmPat src arm), coreArmGuard src arm) with
       | (CorePatView.PVar pv, Just g) ->
           (match (viewCoreTerm src g, viewCoreTerm src (coreArmBody src arm)) with
            | (CoreTermView.Case held, CoreTermView.Case under) ->
                (match (V.get held.arms 0, V.get under.arms 0) with
                 | (Just first, Just only) ->
                     let q = coreArmPat src only in
                     let name =
                       (match viewCorePat src q with
                        | CorePatView.PCtor r ->
                            if V.all (\a -> sure src a) r.args then r.name else ""
                        | _ -> "")
                     in if S.isEmpty name
                          or V.elem name taken
                          or V.len held.arms != 2
                          or V.len under.arms != 1
                          or not (truth src (coreArmBody src first))
                          or viewOf src held.scrutinee != Just pv.id
                          or viewOf src under.scrutinee != Just pv.id
                          or M.isNone (viewFunction src held.scrutinee)
                          or (M.isSome asked and asked != viewFunction src held.scrutinee) then []
                        else
                          V.pushFront
                            (viewed
                               src
                               arms
                               (i + 1)
                               (V.pushBack taken name)
                               (viewFunction src held.scrutinee))
                            (arm, pv.id, held.scrutinee, q, coreArmBody src only)
                 | _ -> [])
            | _ -> [])
       | _ -> [])

-- The name a view is asked of, if `t` is a function given a name.
fun viewOf src t : Maybe Int =
  match viewCoreTerm src t with
  | CoreTermView.App r ->
      (match viewCoreTerm src r.arg with
       | CoreTermView.Var v -> Just v.id
       | _ -> None)
  | _ -> None

-- The function a view asks, by its binder, if it is a definition named.
fun viewFunction src t : Maybe Int =
  match viewCoreTerm src t with
  | CoreTermView.App r ->
      (match viewCoreTerm src r.func with
       | CoreTermView.Var v -> Just v.id
       | CoreTermView.TyApp ta ->
           (match viewCoreTerm src ta.func with
            | CoreTermView.Var v -> Just v.id
            | _ -> None)
       | _ -> None)
  | _ -> None

-- Whether `t` is `True` written out.
fun truth src t : Bool =
  match viewCoreTerm src t with
  | CoreTermView.Const r ->
      (match viewCoreLit src r.lit with
       | CoreLitView.LBool b -> b.value
       | _ -> False)
  | _ -> False

-- Whether a pattern matches whatever it is given: a name, or names put
-- together as a tuple or a record is.
fun sure src p : Bool =
  match viewCorePat src p with
  | CorePatView.PWild _ -> True
  | CorePatView.PVar _ -> True
  | CorePatView.PLit r -> kindCoreLit src r.lit == CoreLitKind.LUnit
  | CorePatView.PAs r -> sure src r.pat
  | CorePatView.PTuple r -> V.all (\q -> sure src q) r.items
  | CorePatView.PRecord r -> V.all (\f -> sure src (corePFieldPat src f)) r.fields
  | _ -> False

-- Whether an arm takes a constructor apart and nothing under it can fail
-- to match, with no guard to turn it down after.
fun plain src arm : Bool =
  M.isNone (coreArmGuard src arm)
    and (match viewCorePat src (coreArmPat src arm) with
     | CorePatView.PCtor r -> V.all (\q -> sure src q) r.args
     | _ -> False)

-- Where the arms from `i` on stop each taking apart a constructor none
-- before it in `seen` did.
fun distinct src arms (i : Int) (seen : [String]) : Int =
  match V.get arms i with
  | None -> i
  | Just arm ->
      (match viewCorePat src (coreArmPat src arm) with
       | CorePatView.PCtor r ->
           if V.elem r.name seen then i else distinct src arms (i + 1) (V.pushBack seen r.name)
       | _ -> i)

-- What an arm that matched does: its body, if its guard holds or it has
-- none, and giving up to `fail` otherwise.
fun armBody src out cx (m : Meta) arm (fail : String) =
  match coreArmGuard src arm with
  | None -> lowerTerm src out cx (coreArmBody src arm)
  | Just g ->
      (match asks src g (coreArmBody src arm) [] with
       | Just (views, rest, body) -> asked src out cx m arm views 0 rest body fail
       | None -> guarded src out cx m arm g (coreArmBody src arm) fail)

-- `body` if `g` holds, and giving up to `fail` if it does not.
fun guarded src out cx (m : Meta) arm g body (fail : String) =
  let name = "g${show arm}" in
  named
    src
    out
    cx
    m
    name
    g
    (C.branch
       out
       m
       "u${show arm}"
       (C.var out m name)
       (gaveUp out cx m fail)
       (lowerTerm src out cx body))

-- An arm with views in its pattern, as `Elab` writes it: a guard that asks
-- each view and matches what it answers, one under another, and a body that
-- asks them all again for what the patterns bind. Written out so, every view
-- of the arm that matched was asked twice -- a node of a tree read off its
-- children twice, for each node a pass looked at. If `g` and `b` are those
-- two, the views they ask, outermost first, each with the pattern for what
-- it answers; the guard the arm was written with, if it has one; and its
-- body. The two must ask the same function of the same name and match the
-- same pattern, binder for binder, all the way down.
fun asks src g b seen =
  match (viewCoreTerm src g, viewCoreTerm src b) with
  | (CoreTermView.Case held, CoreTermView.Case under) ->
      (match (V.get held.arms 0, V.get held.arms 1, V.get under.arms 0) with
       | (Just first, Just other, Just only) ->
           if V.len held.arms == 2
             and V.len under.arms == 1
             and M.isNone (coreArmGuard src first)
             and M.isNone (coreArmGuard src other)
             and M.isNone (coreArmGuard src only)
             and isWild src (coreArmPat src other)
             and falsehood src (coreArmBody src other)
             and M.isSome (viewOf src held.scrutinee)
             and viewOf src held.scrutinee == viewOf src under.scrutinee
             and (sameView src held.scrutinee under.scrutinee
                or not (V.isEmpty (bindersOf src (coreArmPat src only))))
             and samePat src (coreArmPat src first) (coreArmPat src only) then
             asks
               src
               (coreArmBody src first)
               (coreArmBody src only)
               (V.pushBack seen (under.scrutinee, coreArmPat src only))
           else settledAsks src g b seen
       | _ -> settledAsks src g b seen)
  | _ -> settledAsks src g b seen

-- Whether two askings name the same function to ask. Where the function is
-- written out instead -- a synonym's own, in the function that matches it
-- -- the patterns say: one that binds a name binds it in the guard and in
-- the body, which only the two halves of one view do.
fun sameView src g b : Bool =
  M.isSome (viewFunction src g) and viewFunction src g == viewFunction src b

-- What `asks` answers where the guard and the body stop asking alike: the
-- views so far, if there are any, with what is left of each.
fun settledAsks src g b seen =
  if V.isEmpty seen then None else Just (seen, if truth src g then None else Just g, b)

-- The views from `k` on asked once each, what each answers matched against
-- its pattern -- giving up to `fail` where it does not match -- and under
-- them all the arm's own guard, if it has one, and its body.
fun asked src out cx (m : Meta) arm views (k : Int) rest body (fail : String) =
  match V.get views k with
  | None ->
      (match rest with
       | Just g -> guarded src out cx m arm g body fail
       | None -> lowerTerm src out cx body)
  | Just (look, q) ->
      (let w = "w${show arm}_${show k}" in
       named
         src
         out
         cx
         m
         w
         look
         (matched src out cx m w q fail (\() ->
            asked src out cx m arm views (k + 1) rest body fail)))

-- Whether a pattern is the one that matches anything and binds nothing.
fun isWild src p : Bool =
  match viewCorePat src p with
  | CorePatView.PWild _ -> True
  | _ -> False

-- Whether `t` is `False` written out.
fun falsehood src t : Bool =
  match viewCoreTerm src t with
  | CoreTermView.Const r ->
      (match viewCoreLit src r.lit with
       | CoreLitView.LBool b -> not b.value
       | _ -> False)
  | _ -> False

-- Whether two patterns are the same pattern: the same shape, binding the
-- same names. One with a literal in it is taken for different, unless the
-- literal is `()`: nothing here tells two numbers apart.
fun samePat src p q : Bool =
  let all =
    \ps qs -> V.len ps == V.len qs and V.all (\x -> samePat src (fst x) (snd x)) (V.zip ps qs)
  in match (viewCorePat src p, viewCorePat src q) with
     | (CorePatView.PWild _, CorePatView.PWild _) -> True
     | (CorePatView.PVar a, CorePatView.PVar b) -> a.id == b.id
     | (CorePatView.PAs a, CorePatView.PAs b) -> a.id == b.id and samePat src a.pat b.pat
     | (CorePatView.PTuple a, CorePatView.PTuple b) -> all a.items b.items
     | (CorePatView.PArray a, CorePatView.PArray b) -> all a.items b.items
     | (CorePatView.PCtor a, CorePatView.PCtor b) -> a.name == b.name and all a.args b.args
     | (CorePatView.PLit a, CorePatView.PLit b) ->
         kindCoreLit src a.lit == CoreLitKind.LUnit and kindCoreLit src b.lit == CoreLitKind.LUnit
     | _ -> False

-- The arm of a `case` that takes apart the constructor `p` is a pattern
-- of: its fields named, and matched in turn.
fun taken src out cx (m : Meta) p (fail : String) success =
  let args = corePatPCtorArgs src p in
  let pairs = V.zip (V.map (\i -> "m${show p}_${show i}") (V.range 0 (V.len args))) args in
  C.arm
    out
    m
    (symbolOf cx.pkgs (corePatPCtorName src p))
    (V.map (\q -> C.param out m (fst q) (repIn cx (tyCorePat src (snd q)))) pairs)
    (matchedAll src out cx m pairs fail success)

-- The value named `x` matched against `p`: what `success` builds where it
-- matches, with what `p` binds bound, and giving up to `fail` where it does
-- not.
fun matched src out cx (m : Meta) (x : String) p (fail : String) success =
  let var = C.var out m x in
  -- The value's parts, each named, and matched in turn.
  let parts = \qs -> V.zip (V.map (\i -> "m${show p}_${show i}") (V.range 0 (V.len qs))) qs in
  let fields =
    \pairs -> V.map (\q -> C.param out m (fst q) (repIn cx (tyCorePat src (snd q)))) pairs
  in match viewCorePat src p with
     | CorePatView.PWild _ -> success ()
     | CorePatView.PVar r ->
         C.give out m var (C.binding out m "v${show r.id}" (repIn cx r.ty) (success ()))
     | CorePatView.PAs r ->
         C.give
           out
           m
           var
           (C.binding
              out
              m
              "v${show r.id}"
              (repIn cx r.ty)
              (matched src out cx m x r.pat fail success))
     | CorePatView.PLit r ->
         (match viewCoreLit src r.lit with
          | CoreLitView.LUnit _ -> success ()
          | CoreLitView.LBool b ->
              if b.value then C.branch out m "u${show p}" var (gaveUp out cx m fail) (success ())
              else C.branch out m "u${show p}" var (success ()) (gaveUp out cx m fail)
          | _ ->
              C.prim out m "eq" [var, lowerLit src out cx r.lit] [
                C.binding out m "u${show p}" "unit" (gaveUp out cx m fail),
                C.binding out m "u${show p}" "unit" (success ())
              ])
     | CorePatView.PTuple r ->
         let pairs = parts r.items in
         C.give
           out
           m
           var
           (C.caseOf
              out
              m
              [C.arm out m "#tuple" (fields pairs) (matchedAll src out cx m pairs fail success)])
     | CorePatView.PCtor r ->
         C.give
           out
           m
           var
           (C.caseOf out m [
              taken src out cx m p fail success,
              C.arm out m "_" [] (gaveUp out cx m fail)
            ])
     | CorePatView.PArray r ->
         let pairs = parts r.items in
         let len = "l${show p}" in
         let taken =
           V.foldr
             (\i acc ->
               (match V.get pairs i with
                | Just q ->
                    C.prim
                      out
                      m
                      "arrayGet"
                      [C.var out m x, C.int out m i]
                      [C.binding out m (fst q) (repIn cx (tyCorePat src (snd q))) acc]
                | None -> acc))
             (matchedAll src out cx m pairs fail success)
             (V.range 0 (V.len pairs))
         in C.prim
              out
              m
              "arrayLen"
              [var]
              [C.binding
                 out
                 m
                 len
                 "i64"
                 (C.prim out m "eq" [C.var out m len, C.int out m (V.len pairs)] [
                    C.binding out m "u${show p}" "unit" (gaveUp out cx m fail),
                    C.binding out m "u${show p}" "unit" taken
                  ])]
     -- A record's pattern: each field it names read, and matched in turn.
     | CorePatView.PRecord r ->
         let pairs =
           V.map
             (\i ->
               (
                 "m${show p}_${show i}",
                 corePFieldPat src (V.getOr 0 r.fields i),
                 corePFieldLabel src (V.getOr 0 r.fields i)
               ))
             (V.range 0 (V.len r.fields))
         in V.foldr
              (\q rest ->
                match q with
                | (name, sub, label) ->
                    C.selected
                      out
                      m
                      var
                      label
                      (C.binding out m name (repIn cx (tyCorePat src sub)) rest))
              (matchedAll
                 src
                 out
                 cx
                 m
                 (V.map (\q -> match q with | (name, sub, _) -> (name, sub)) pairs)
                 fail
                 success)
              pairs

-- Each named value matched against its pattern, in turn.
fun matchedAll src out cx (m : Meta) pairs (fail : String) success =
  match V.get pairs 0 with
  | None -> success ()
  | Just (name, q) ->
      matched src out cx m name q fail (\() ->
        matchedAll src out cx m (V.drop pairs 1) fail success)

-- --- names ---------------------------------------------------------------------

-- The symbol of the type or constructor core names `canon`: its package,
-- and then its path. The list every program has is the standard library's.
fun symbolOf (pkgs : [String]) (canon : String) : String =
  let segs = S.split "." canon in
  if V.len segs >= 2 and V.elem (V.getOr "" segs 0) pkgs then
    "meadow:${V.getOr "" segs 0}/${S.join "." (V.drop segs 1)}"
  else "meadow:Std/${canon}"

-- Where the field `label` is in a value of type `t`, if `t` is a declared
-- type with a constructor that names its fields: the constructor, the
-- field's place, and every field's type there.
fun placeOf cx (t : Type) (label : String) =
  match t with
  | Con name args ->
      (match dataNamed cx.dataIx name with
       | Just (_, _, ctors) ->
           V.get
             (V.concatMap
                (\c ->
                  match V.find (\f -> fst f == fst c) cx.fields with
                  | Just (_, labels) ->
                      (match V.find
                         (\i -> V.get labels i == Just label)
                         (V.range 0 (V.len labels)) with
                       | Just at -> [(fst c, at, V.map (given args) (snd c))]
                       | None -> [])
                  | None -> [])
                ctors)
             0
       | None -> None)
  | _ -> None

-- An effect's symbol, and an operation's: the effect's, and then its name.
fun effectSymbol (eff : String) : String = "meadow:${eff}"

fun opSymbol (eff : String) (op : String) : String = "${effectSymbol eff}.${op}"

-- A constructor's own name: the last of its path.
fun bare (canon : String) : String =
  let segs = S.split "." canon in
  V.getOr canon segs (V.len segs - 1)

-- --- a program ---------------------------------------------------------------

-- `p` as a program of Cut that answers its entry's value as text: its data
-- declared, a `val` to each definition -- the functions first, which read
-- nothing when they are made -- an entry that turns the value into the text
-- the CEK machine would display, and a definition that does that for each
-- type the entry's value is made of. A unit with no entry is its
-- declarations alone. `known` are the declared types of the units it
-- depends on, which it does not declare again, and `labelled` their
-- constructors' named fields.
@pub fun program
    (p : CoreProgram)
    (known : [(String, Int, [(String, [Type])])])
    (labelled : [(String, [String])])
    (packages : [String])
    : CutProgram =
  match lowered p known labelled packages False with
  | (cut, _, _) -> cut

-- The same, and its declarations in parts: what it declares of types and
-- effects, and then each definition's own -- with the definitions made of
-- its local functions -- under its symbol, with the symbols it mentions.
-- What a link keeps is the parts its entry reaches.
fun lowered
    (p : CoreProgram)
    (known : [(String, Int, [(String, [Type])])])
    (labelled : [(String, [String])])
    (packages : [String])
    (texts : Bool) =
  let a = coreArena p in
  let file = coreRoot p in
  let defs = coreFileDefs a file in
  let pkg = coreFilePackage a file in
  -- What it mentions of another unit's, by the binder it has here.
  let ext =
    V.foldl
      (\h x -> H.insert (coreExternId a x) (coreExternSymbol a x, coreExternTypes a x) h)
      H.empty
      (coreFileExterns a file)
  in
  -- Each function written with its parameters, its own and another unit's:
  -- its symbol, how many they are, and how many types it is generic in.
  let arity =
    V.foldl
      (\h x ->
        if coreExternArity a x > 0 then
          H.insert
            (coreExternId a x)
            (coreExternSymbol a x, coreExternArity a x, coreExternTypes a x)
            h
        else h)
      (V.foldl
         (\h d ->
           (let (vars, inner) = peel a (coreDefBody a d) in
            let n = V.len (fst (lams a inner [])) in
            if n > 0 then H.insert (coreDefId a d) (topSymbol pkg (coreDefId a d), n, V.len vars) h
            else h))
         H.empty
         defs)
      (coreFileExterns a file)
  in
  let tops =
    V.foldl
      (\h x -> H.insert (coreExternId a x) True h)
      (V.foldl (\h d -> H.insert (coreDefId a d) True h) H.empty defs)
      (coreFileExterns a file)
  in
  -- A definition generic in its type, with the variables it is generic in.
  let generics =
    V.foldl
      (\h d ->
        (let vars = fst (peel a (coreDefBody a d)) in
         if V.isEmpty vars then h else H.insert (coreDefId a d) vars h))
      H.empty
      defs
  in
  let isFun =
    \d ->
      kindCoreTerm a (coreDefBody a d) == CoreTermKind.Lam
        or M.isSome (H.lookup (coreDefId a d) generics)
  in
  -- A value is computed after the values it reads, whatever order they
  -- were written in.
  let values = V.filter (\d -> not (isFun d)) defs in
  -- What a value reads: the values it mentions, and those the functions it
  -- mentions do, which it may call.
  let mentions =
    H.fromVec (V.map (\d -> (coreDefId a d, V.map fst (free a (coreDefBody a d) [] []))) defs)
  in
  let isValue = V.foldl (\h v -> H.insert (coreDefId a v) True h) H.empty values in
  let byId = V.foldl (\h d -> H.insert (coreDefId a d) d h) H.empty defs in
  let ordered =
    V.append
      (V.filter isFun defs)
      (V.concatMap
         (\id -> match H.lookup id byId with | Just d -> [d] | None -> [])
         (inOrder mentions isValue (V.map (\d -> coreDefId a d) values) 0 [] H.empty []))
  in
  let own = V.filter (\d -> not (V.any (\k -> fst3 k == fst3 d) known)) (datasOf p) in
  let datas = V.append known own in
  -- Each constructor whose fields have names, with them.
  let fields = V.append labelled (namedOf p) in
  runSt (\() ->
    let out = C.builder () in
    let halt = C.halt out C.nowhere in
    let lifted = stNewRef [] in
    let declared =
      V.map
        (\d ->
          match d with
          | (name, arity, ctors) ->
              C.dataDecl
                out
                C.nowhere
                (symbolOf packages name)
                (V.map (\i -> "'a${show i}") (V.range 0 arity))
                (V.map
                   (\c -> C.ctorDecl out C.nowhere (bare (fst c)) (V.map fieldRep (snd c)))
                   ctors))
        own
    in
    let effects =
      V.map
        (\e ->
          C.effectDecl
            out
            C.nowhere
            (effectSymbol (coreEffectName a e))
            (V.map
               (\o ->
                 C.opDecl
                   out
                   C.nowhere
                   (coreOpName a o)
                   [fieldRep (coreOpArg a o)]
                   (fieldRep (coreOpResult a o)))
               (coreEffectOps a e)))
        (coreFileEffects a file)
    in
    let cx =
      {
        k = halt,
        tops,
        lifted,
        datas,
        dataIx = dataIndex datas,
        fields,
        tvars = [],
        gtops = generics,
        locals = H.empty,
        recs = H.empty,
        joins = H.empty,
        pkg,
        pkgs = packages,
        ext,
        arity
      }
    in
    -- A definition generic in its type is a `def` of the descriptors,
    -- answering the value at them; any other a `val`.
    let parts =
      V.map
        (\d ->
          -- Where each definition's text is all that is wanted, it is
          -- lowered into a place of its own and written out at once, and the
          -- place let go: a unit's Cut held whole until all of it was made
          -- was the most a compile ever held.
          (let mine = if texts then C.builder () else out in
           let stop = if texts then C.halt mine C.nowhere else halt in
           let kept = if texts then stNewRef [] else lifted in
           let (vars, inner) = peel a (coreDefBody a d) in
           let before = V.len (stGetRef kept) in
           let symbol = topSymbol pkg (coreDefId a d) in
           let within = { cx | tvars = vars, k = stop, lifted = kept } in
           let (params, body) = lams a inner [] in
           -- A function of parameters is a definition of them all at once,
           -- and the value that takes them one at a time is a call of it.
           let whole =
             if V.isEmpty params then []
             else
               [C.genericDecl
                  mine
                  C.nowhere
                  (directly symbol)
                  (V.map tname vars)
                  (V.map
                     (\p -> C.param mine C.nowhere "v${show (fst p)}" (repIn within (snd p)))
                     params)
                  [C.param mine C.nowhere "k" "ptr"]
                  (lowerTerm a mine { within | k = C.cont mine C.nowhere "k" } body)]
           in
           let value =
             \k ->
               if V.isEmpty params then lowerTerm a mine { within | k = k } inner
               else
                 curried
                   mine
                   within
                   symbol
                   (descsOf mine within C.nowhere (V.map (\v -> Var v) vars))
                   params
                   0
                   k
           in
           let made =
             if V.isEmpty vars then
               C.valDecl mine C.nowhere symbol (repOf (tyCoreTerm a inner)) (value stop)
             else
               C.genericDecl
                 mine
                 C.nowhere
                 symbol
                 (V.map tname vars)
                 []
                 [C.param mine C.nowhere "k" "ptr"]
                 (value (C.cont mine C.nowhere "k"))
           in
           let ds = V.concat [V.drop (stGetRef kept) before, whole, [made]] in
           (
             symbol,
             if texts then [] else ds,
             V.map
               (\id ->
                 match H.lookup id ext with
                 | Just (symbol, _) -> symbol
                 | None -> topSymbol pkg id)
               (M.unwrapOr [] (H.lookup (coreDefId a d) mentions)),
             if texts then C.textOf (C.finished mine (C.file mine C.nowhere "" "none" [])) ds
             else ""
           )))
        ordered
    in
    let vals = V.concatMap (\x -> match x with | (_, ds, _, _) -> ds) parts in
    let entry = coreFileEntry a file in
    let answerTy =
      M.unwrapOr
        Error
        (M.map (\d -> tyCoreTerm a (coreDefBody a d)) (V.find (\d -> coreDefId a d == entry) defs))
    in
    let sh =
      {
        out,
        datas,
        dataIx = dataIndex datas,
        pkgs = packages,
        wanted = stNewRef [],
        seen = stNewRef [],
        next = stNewRef 0
      }
    in
    let shown =
      entered out sh pkg entry answerTy (M.unwrapOr 0 (M.map V.len (H.lookup entry generics)))
    in
    let showers = showersOf sh [] in
    let root =
      if entry < 0 then C.file out C.nowhere "" "none" (V.concat [declared, effects, vals])
      else
        C.file
          out
          C.nowhere
          "${package}\"#entry\""
          (answering answerTy)
          (V.concat [declared, effects, vals, [shown], showers])
    in (C.finished out root, V.append declared effects, parts))

-- The definition a program is entered at: the value of definition `entry`
-- of package `pkg`, of type `answerTy` and generic in `types` types, turned
-- into the text the CEK machine would display -- a `main` run first, and
-- what it answers shown.
fun entered out sh (pkg : String) (entry : Int) (answerTy : Type) (types : Int) =
  C.defDecl
    out
    C.nowhere
    "${package}\"#entry\""
    []
    [C.param out C.nowhere "k" "ptr"]
    (if types > 0 then
       C.invoke
         out
         C.nowhere
         (topSymbol pkg entry)
         (V.map (\v -> C.desc out C.nowhere "ptr") (V.range 0 types))
         [C.binding
            out
            C.nowhere
            "r"
            (repOf answerTy)
            (shownTo sh (C.var out C.nowhere "r") answerTy (C.cont out C.nowhere "k"))]
     else
       (match mainOf answerTy with
        -- A `main` is run for what it does: what it answers is the
        -- program's, and nothing is shown of it.
        | Just result ->
            C.applied
              out
              C.nowhere
              (C.sym out C.nowhere (topSymbol pkg entry))
              (C.unit out C.nowhere)
              -- Whatever it answers is let go, and the program's answer is
              -- `unit`.
              (C.binding
                 out
                 C.nowhere
                 "r"
                 (repOf result)
                 (C.give out C.nowhere (C.unit out C.nowhere) (C.cont out C.nowhere "k")))
        | None ->
            shownTo
              sh
              (C.sym out C.nowhere (topSymbol pkg entry))
              answerTy
              (C.cont out C.nowhere "k")))

-- What goes around the declarations of a program's units to make it one:
-- before them, how it opens and the roles its types play; after them, the
-- definition it is entered at and what that shows a value with. `known`
-- are the types the units declare.
@pub fun around
    (pkg : String)
    (entry : Int)
    (answerTy : Type)
    (types : Int)
    (known : [(String, Int, [(String, [Type])])])
    (packages : [String])
    : (String, String) =
  let cut =
    runSt (\() ->
      let out = C.builder () in
      let sh =
        {
          out,
          datas = known,
          dataIx = dataIndex known,
          pkgs = packages,
          wanted = stNewRef [],
          seen = stNewRef [],
          next = stNewRef 0
        }
      in
      let shown = entered out sh pkg entry answerTy types in
      let showers = showersOf sh [] in
      C.finished
        out
        (C.file
           out
           C.nowhere
           "${package}\"#entry\""
           (answering answerTy)
           (V.pushFront showers shown)))
  in (C.header cut ++ roles known, C.body cut ++ C.showInt package)

fun fst3 (t : (a, b, c)) : a = match t with | (x, _, _) -> x

-- What becomes of a program's answer: a `main`'s is nothing to show, and
-- anything else is the text its entry made of it.
fun answering (t : Type) : String = if M.isSome (mainOf t) then "none" else "str"

-- What a function of `()` answers, if `t` is one: a program's `main`.
fun mainOf (t : Type) : Maybe Type =
  match t with
  | Fun params answered _ -> if params == [Con "Unit" []] then Just answered else None
  | _ -> None

-- The types a program of core declares: each one's name, how many types it
-- takes, and each constructor with its fields' types.
@pub fun datasOf (p : CoreProgram) : [(String, Int, [(String, [Type])])] =
  let a = coreArena p in
  V.map
    (\d ->
      (
        coreDataName a d,
        coreDataArity a d,
        V.map (\c -> (coreDataCtorName a c, coreDataCtorFields a c)) (coreDataCtors a d)
      ))
    (coreFileDatas a (coreRoot p))

-- The package a program of core is of.
@pub fun packageOf (p : CoreProgram) : String = coreFilePackage (coreArena p) (coreRoot p)

-- Each function a program of core writes with its parameters: its symbol,
-- and how many they are.
@pub fun aritiesOf (p : CoreProgram) : [(String, Int)] =
  let a = coreArena p in
  let file = coreRoot p in
  let pkg = coreFilePackage a file in
  V.concatMap
    (\d ->
      (let n = V.len (fst (lams a (snd (peel a (coreDefBody a d))) [])) in
       if n > 0 then [(topSymbol pkg (coreDefId a d), n)] else []))
    (coreFileDefs a file)

-- For each definition, how many of the names it binds are of a type
-- nothing describes -- a variable no definition around it is generic in --
-- and how many of a type that is an error: what is lowered as a pointer
-- for want of anything better, and is wrong where the value is not one.
@pub fun undescribed (p : CoreProgram) : [(String, Int, Int)] =
  let a = coreArena p in
  let file = coreRoot p in
  let pkg = coreFilePackage a file in
  V.concatMap
    (\d ->
      (let (vars, inner) = peel a (coreDefBody a d) in
       match loose a inner vars (0, 0) with
       | (v, e) -> if v + e > 0 then [(topSymbol pkg (coreDefId a d), v, e)] else []))
    (coreFileDefs a file)

-- One more name of type `t`, counted if nothing in `scope` describes it.
fun counted (scope : [Int]) (t : Type) (n : (Int, Int)) : (Int, Int) =
  match t with
  | Var v -> if V.elem v scope then n else (fst n + 1, snd n)
  | Bound _ -> (fst n + 1, snd n)
  | Error -> (fst n, snd n + 1)
  | _ -> n

fun loosePat (a : CoreArena) (p : CorePat) (scope : [Int]) (n : (Int, Int)) : (Int, Int) =
  match viewCorePat a p with
  | CorePatView.PVar r -> counted scope r.ty n
  | CorePatView.PAs r -> loosePat a r.pat scope (counted scope r.ty n)
  | CorePatView.PTuple r -> V.foldl (\x q -> loosePat a q scope x) n r.items
  | CorePatView.PArray r -> V.foldl (\x q -> loosePat a q scope x) n r.items
  | CorePatView.PCtor r -> V.foldl (\x q -> loosePat a q scope x) n r.args
  | CorePatView.PRecord r -> V.foldl (\x f -> loosePat a (corePFieldPat a f) scope x) n r.fields
  | CorePatView.PWild _ -> n
  | CorePatView.PLit _ -> n

fun loose (a : CoreArena) (t : CoreTerm) (scope : [Int]) (n : (Int, Int)) : (Int, Int) =
  let each = \ts acc -> V.foldl (\x u -> loose a u scope x) acc ts in
  match viewCoreTerm a t with
  | CoreTermView.Var _ -> n
  | CoreTermView.Lam r -> loose a r.body scope (counted scope r.paramTy n)
  | CoreTermView.TyLam r -> loose a r.body (V.append scope r.vars) n
  | CoreTermView.TyApp r -> loose a r.func scope n
  | CoreTermView.App r -> loose a r.arg scope (loose a r.func scope n)
  | CoreTermView.Let r ->
      loose a r.body scope (loose a r.value scope (counted scope (tyCoreTerm a r.value) n))
  | CoreTermView.LetRec r -> loose a r.body scope (each (V.map (\b -> coreBindValue a b) r.binds) n)
  | CoreTermView.If r -> each [r.cond, r.yes, r.no] n
  | CoreTermView.Tuple r -> each r.items n
  | CoreTermView.Array r -> each r.items n
  | CoreTermView.Proj r -> loose a r.tuple scope n
  | CoreTermView.Record r -> each (V.map (\f -> coreFieldValue a f) r.fields) n
  | CoreTermView.Sel r -> loose a r.target scope (counted scope r.ty n)
  | CoreTermView.Extend r -> each [r.target, r.value] n
  | CoreTermView.Ctor r -> each r.args n
  | CoreTermView.Prim r -> each r.args (counted scope r.ty n)
  | CoreTermView.Perform r -> loose a r.arg scope (counted scope r.ty n)
  | CoreTermView.Case r ->
      V.foldl
        (\acc arm ->
          (let bound = loosePat a (coreArmPat a arm) scope acc in
           let guarded =
             (match coreArmGuard a arm with
              | Just g -> loose a g scope bound
              | None -> bound)
           in loose a (coreArmBody a arm) scope guarded))
        (loose a r.scrutinee scope n)
        r.arms
  | CoreTermView.Handle r ->
      let body = loose a r.body scope n in
      let clauses =
        V.foldl
          (\acc c -> loose a (coreClauseBody a c) scope (counted scope (coreClauseParamTy a c) acc))
          body
          r.clauses
      in (match r.ret with
          | Just ret -> loose a ret scope clauses
          | None -> clauses)
  | CoreTermView.Join r -> loose a r.body scope (loose a r.rhs scope n)
  | CoreTermView.Jump r -> each r.args n
  | CoreTermView.Ill _ -> n
  | CoreTermView.Const _ -> n

-- Each constructor whose fields have names, with them.
@pub fun namedOf (p : CoreProgram) : [(String, [String])] =
  let a = coreArena p in
  V.map (\n -> (coreNamedName a n, coreNamedLabels a n)) (coreFileNamed a (coreRoot p))

-- The values among `roots` and what they reach, each after every value it
-- reads -- the values it mentions, and those the functions it mentions do,
-- which it may call -- whatever order they were written in. One walk of
-- what mentions what, a definition placed when everything it mentions has
-- been: `stack` is the definitions being walked, each with how many of its
-- mentions are done, and one met again while it is still on it -- two that
-- read each other -- is not waited for.
fun inOrder
    (mentions : HashMap Int [Int])
    (isValue : HashMap Int Bool)
    (roots : [Int])
    (r : Int)
    (stack : [(Int, Int)])
    (seen : HashMap Int Bool)
    (out : [Int])
    : [Int] =
  match V.get stack (V.len stack - 1) with
  | None ->
      (match V.get roots r with
       | None -> out
       | Just root ->
           if M.isSome (H.lookup root seen) then
             inOrder mentions isValue roots (r + 1) stack seen out
           else inOrder mentions isValue roots (r + 1) [(root, 0)] (H.insert root True seen) out)
  | Just (id, i) ->
      let rest = V.take stack (V.len stack - 1) in
      (match V.get (M.unwrapOr [] (H.lookup id mentions)) i with
       | None ->
           inOrder
             mentions
             isValue
             roots
             r
             rest
             seen
             (if M.isSome (H.lookup id isValue) then V.pushBack out id else out)
       | Just m ->
           let waiting = V.pushBack rest (id, i + 1) in
           if M.isSome (H.lookup m seen) or M.isNone (H.lookup m mentions) then
             inOrder mentions isValue roots r waiting seen out
           else
             inOrder
               mentions
               isValue
               roots
               r
               (V.pushBack waiting (m, 0))
               (H.insert m True seen)
               out)

-- How a field of a declared type is represented: one of the type's own
-- parameters as that parameter.
fun fieldRep (t : Type) : String = match t with | Bound i -> "'a${show i}" | _ -> repOf t

-- --- showing -------------------------------------------------------------------
--
-- A runtime turns nothing into text but text, so what the entry answers is
-- made text here, as the CEK machine displays a value: a definition to each
-- data type the value is made of, written when the type is first met.

fun freshName sh =
  let n = stGetRef sh.next in
  let u = stSetRef sh.next (n + 1) in
  "w${show n}"

-- A type as part of a name.
fun keyOf (t : Type) : String =
  match t with
  | Con name args -> if V.isEmpty args then name else "${name}<${S.join "," (V.map keyOf args)}>"
  | Tuple items -> "(${S.join "," (V.map keyOf items)})"
  | _ -> "?"

fun showSymbol (key : String) : String = "${package}\"#show:${key}\""

-- The declaration of the type core names `name`, if the program has one.
fun dataNamed (ix : HashMap String (String, Int, [(String, [Type])])) (name : String) =
  H.lookup name ix

-- Every declared type by each name core may have for it: the whole of its
-- name, and each end of that from a dot on -- the first so named, as the
-- types are listed.
fun dataIndex (datas : [(String, Int, [(String, [Type])])])
    : HashMap String (String, Int, [(String, [Type])]) =
  V.foldl
    (\h d ->
      match d with
      | (n, _, _) ->
          V.foldl (\g key -> if M.isSome (H.lookup key g) then g else H.insert key d g) h (ends n))
    H.empty
    datas

-- A dotted name and each end of it from a dot on: `A.B.C`, `B.C`, `C`.
fun ends (n : String) : [String] =
  let segs = S.split "." n in
  V.map (\k -> S.join "." (V.drop segs k)) (V.range 0 (V.len segs))

-- `t`, a field's type, with the types its declaration was given.
fun given (args : [Type]) (t : Type) : Type =
  match t with
  | Bound i -> V.getOr Error args i
  | Con name inner -> Con name (V.map (given args) inner)
  | other -> other

-- A record's row as its fields: each label and its type.
fun rowFields (row : Type) : [(String, Type)] =
  match row with
  | RowExtend label t rest -> V.pushFront (rowFields rest) (label, t)
  | _ -> []

-- The statement that gives `k` the text of `value`, a value of type `t`.
fun shownTo sh value (t : Type) k =
  let out = sh.out in
  let text = \s -> C.str out C.nowhere s in
  match t with
  | Con "Int" [] -> C.invoke out C.nowhere "${package}\"#showInt\"" [value] [k]
  | Con "Bool" [] ->
      C.shared out k C.nowhere (freshName sh) (\j ->
        C.branch
          out
          C.nowhere
          (freshName sh)
          value
          (C.give out C.nowhere (text "False") j)
          (C.give out C.nowhere (text "True") j))
  | Con "String" [] -> joinedTo out [text "\"", value, text "\""] k
  | Con "Unit" [] -> C.give out C.nowhere (text "()") k
  | Tuple items ->
      (let names = V.map (\i -> freshName sh) items in
       C.give
         out
         C.nowhere
         value
         (C.caseOf
            out
            C.nowhere
            [C.arm
               out
               C.nowhere
               "#tuple"
               (V.map (\q -> C.param out C.nowhere (fst q) (repOf (snd q))) (V.zip names items))
               (shownAll
                  sh
                  (V.map (\q -> (C.var out C.nowhere (fst q), snd q)) (V.zip names items))
                  []
                  "("
                  ", "
                  ")"
                  k)]))
  | Record row ->
      (let fields = sortBy (\x y -> compare (fst x) (fst y)) (rowFields row) in
       let names = V.map (\f -> freshName sh) fields in
       let texts = V.map (\f -> freshName sh) fields in
       let pieces =
         V.concat [
           [text (if V.isEmpty fields then "{" else "{ ")],
           V.concatMap
             (\i ->
               [
                 text
                   ((if i == 0 then "" else ", ") ++ fst (V.getOr ("", Error) fields i) ++ " = "),
                 C.var out C.nowhere (V.getOr "" texts i)
               ])
             (V.range 0 (V.len fields)),
           [text (if V.isEmpty fields then "}" else " }")]
         ]
       in
       -- Each field read, then each shown, then the pieces joined.
       let shown =
         V.foldr
           (\i rest ->
             shownTo
               sh
               (C.var out C.nowhere (V.getOr "" names i))
               (snd (V.getOr ("", Error) fields i))
               (C.binding out C.nowhere (V.getOr "" texts i) "str" rest))
           (joinedTo out pieces k)
           (V.range 0 (V.len fields))
       in V.foldr
            (\i rest ->
              C.selected
                out
                C.nowhere
                value
                (fst (V.getOr ("", Error) fields i))
                (C.binding
                   out
                   C.nowhere
                   (V.getOr "" names i)
                   (repOf (snd (V.getOr ("", Error) fields i)))
                   rest))
            shown
            (V.range 0 (V.len fields)))
  | Con "Array" _ -> wanting sh value t k
  -- The standard library's vector is the runtime's to show, which knows it
  -- by the part its constructors play: its elements, as the CEK machine
  -- shows them.
  | Con "Vector" _ -> C.prim out C.nowhere "show" [value] [k]
  | Con name args ->
      (match dataNamed sh.dataIx name with
       | Just _ ->
           (let key = keyOf t in
            let u =
              if V.elem key (stGetRef sh.seen) then ()
              else
                (let v = stSetRef sh.seen (V.pushBack (stGetRef sh.seen) key) in
                 stSetRef sh.wanted (V.pushBack (stGetRef sh.wanted) (key, t)))
            in C.invoke out C.nowhere (showSymbol key) [value] [k])
       | None -> C.prim out C.nowhere "show" [value] [k])
  -- Anything else is the runtime's to show: a number, a character.
  | _ -> C.prim out C.nowhere "show" [value] [k]

-- A call of the definition that shows a `t`, which is written if it has not
-- been asked for before.
fun wanting sh value (t : Type) k =
  let key = keyOf t in
  let u =
    if V.elem key (stGetRef sh.seen) then ()
    else
      (let v = stSetRef sh.seen (V.pushBack (stGetRef sh.seen) key) in
       stSetRef sh.wanted (V.pushBack (stGetRef sh.wanted) (key, t)))
  in C.invoke sh.out C.nowhere (showSymbol key) [value] [k]

-- `parts` joined into one string, to `k`.
fun joinedTo out parts k = C.prim out C.nowhere "concatStrings" [C.array out C.nowhere parts] [k]

-- Each of `parts` -- a value and its type -- made text, and the texts
-- between `opening` and `closing` with `sep` between them, to `k`.
fun shownAll sh parts texts (opening : String) (sep : String) (closing : String) k =
  let out = sh.out in
  let text = \s -> C.str out C.nowhere s in
  match V.get parts 0 with
  | None ->
      (let between =
         V.concatMap
           (\i ->
             if i == 0 then [V.getOr (text "") texts i] else [text sep, V.getOr (text "") texts i])
           (V.range 0 (V.len texts))
       in joinedTo out (V.concat [[text opening], between, [text closing]]) k)
  | Just (value, t) ->
      (let s = freshName sh in
       shownTo
         sh
         value
         t
         (C.binding
            out
            C.nowhere
            s
            "str"
            (shownAll
               sh
               (V.drop parts 1)
               (V.pushBack texts (C.var out C.nowhere s))
               opening
               sep
               closing
               k)))

-- The definitions that show each type wanted, and each those want in turn.
fun showersOf sh made =
  match V.get (stGetRef sh.wanted) 0 with
  | None -> made
  | Just (key, t) ->
      (let u = stSetRef sh.wanted (V.drop (stGetRef sh.wanted) 1) in
       showersOf sh (V.append made (shower sh key t)))

-- The definitions that show a value of the data type `t`: a list as its
-- items between brackets, anything else as its constructor and what it
-- holds.
fun shower sh (key : String) (t : Type) =
  let out = sh.out in
  let text = \s -> C.str out C.nowhere s in
  let k = C.cont out C.nowhere "k" in
  let x = C.var out C.nowhere "x" in
  let taking = [C.param out C.nowhere "x" "ptr"] in
  let to = [C.param out C.nowhere "k" "ptr"] in
  match t with
  | Con "Array" inner ->
      (let item = V.getOr Error inner 0 in
       let items = "${package}\"#items:${key}\"" in
       let v = \n -> C.var out C.nowhere n in
       let (n, e, shownE, j, rest) =
         (freshName sh, freshName sh, freshName sh, freshName sh, freshName sh)
       in
       let more =
         C.prim
           out
           C.nowhere
           "arrayGet"
           [x, v "i"]
           [C.binding
              out
              C.nowhere
              e
              (repOf item)
              (shownTo
                 sh
                 (v e)
                 item
                 (C.binding
                    out
                    C.nowhere
                    shownE
                    "str"
                    (C.prim
                       out
                       C.nowhere
                       "add"
                       [v "i", C.int out C.nowhere 1]
                       [C.binding
                          out
                          C.nowhere
                          j
                          "i64"
                          (C.invoke
                             out
                             C.nowhere
                             items
                             [x, v j, text ", "]
                             [C.binding
                                out
                                C.nowhere
                                rest
                                "str"
                                (joinedTo out [v "sep", v shownE, v rest] k)])])))]
       in
       let each =
         C.prim
           out
           C.nowhere
           "arrayLen"
           [x]
           [C.binding
              out
              C.nowhere
              n
              "i64"
              (C.prim out C.nowhere "lt" [v "i", v n] [
                 C.binding out C.nowhere (freshName sh) "unit" (C.give out C.nowhere (text "") k),
                 C.binding out C.nowhere (freshName sh) "unit" more
               ])]
       in
       let whole = freshName sh in
       [
         C.defDecl
           out
           C.nowhere
           items
           [
             C.param out C.nowhere "x" "ptr",
             C.param out C.nowhere "i" "i64",
             C.param out C.nowhere "sep" "str"
           ]
           to
           each,
         C.defDecl
           out
           C.nowhere
           (showSymbol key)
           taking
           to
           (C.invoke
              out
              C.nowhere
              items
              [x, C.int out C.nowhere 0, text ""]
              [C.binding out C.nowhere whole "str" (joinedTo out [text "#[", v whole, text "]"] k)])
       ])
  | Con "List" inner ->
      (let item = V.getOr Error inner 0 in
       let items = "${package}\"#items:${key}\"" in
       let h = freshName sh in
       let rest = freshName sh in
       let shownH = freshName sh in
       let shownRest = freshName sh in
       let each =
         C.give
           out
           C.nowhere
           x
           (C.caseOf out C.nowhere [
              C.arm
                out
                C.nowhere
                (symbolOf sh.pkgs "List.Nil")
                []
                (C.give out C.nowhere (text "") k),
              C.arm
                out
                C.nowhere
                (symbolOf sh.pkgs "List.Cons")
                [C.param out C.nowhere h (repOf item), C.param out C.nowhere rest "ptr"]
                (shownTo
                   sh
                   (C.var out C.nowhere h)
                   item
                   (C.binding
                      out
                      C.nowhere
                      shownH
                      "str"
                      (C.invoke
                         out
                         C.nowhere
                         items
                         [C.var out C.nowhere rest, text "; "]
                         [C.binding
                            out
                            C.nowhere
                            shownRest
                            "str"
                            (joinedTo
                               out
                               [
                                 C.var out C.nowhere "sep",
                                 C.var out C.nowhere shownH,
                                 C.var out C.nowhere shownRest
                               ]
                               k)])))
            ])
       in
       let whole = freshName sh in
       [
         C.defDecl
           out
           C.nowhere
           items
           [C.param out C.nowhere "x" "ptr", C.param out C.nowhere "sep" "str"]
           to
           each,
         C.defDecl
           out
           C.nowhere
           (showSymbol key)
           taking
           to
           (C.invoke
              out
              C.nowhere
              items
              [x, text ""]
              [C.binding
                 out
                 C.nowhere
                 whole
                 "str"
                 (joinedTo out [text "[", C.var out C.nowhere whole, text "]"] k)])
       ])
  | Con name args ->
      (match dataNamed sh.dataIx name with
       | Just (_, _, ctors) ->
           [C.defDecl
              out
              C.nowhere
              (showSymbol key)
              taking
              to
              (C.give
                 out
                 C.nowhere
                 x
                 (C.caseOf
                    out
                    C.nowhere
                    (V.map
                       (\c ->
                         (let fields = V.map (given args) (snd c) in
                          let names = V.map (\f -> freshName sh) fields in
                          let pairs = V.zip names fields in
                          C.arm
                            out
                            C.nowhere
                            (symbolOf sh.pkgs (fst c))
                            (V.map (\q -> C.param out C.nowhere (fst q) (repOf (snd q))) pairs)
                            (if V.isEmpty fields then C.give out C.nowhere (text (bare (fst c))) k
                             else
                               shownAll
                                 sh
                                 (V.map (\q -> (C.var out C.nowhere (fst q), snd q)) pairs)
                                 []
                                 "${bare (fst c)}("
                                 ", "
                                 ")"
                                 k)))
                       ctors)))]
       | None -> [])
  | _ -> []

-- `p` as the text of a program of Cut: `program`'s, and the definitions its
-- entry shows a number with.
@pub fun written (p : CoreProgram) : String =
  writtenWith p [] [] [coreFilePackage (coreArena p) (coreRoot p)] ""

-- The same for a program of several units: `before` is the declarations of
-- the units it depends on, as `declarations` wrote them, and `known` and
-- `labelled` what they declare.
@pub fun writtenWith
    (p : CoreProgram)
    (known : [(String, Int, [(String, [Type])])])
    (labelled : [(String, [String])])
    (packages : [String])
    (before : String)
    : String =
  let cut = program p known labelled packages in
  C.header cut ++ roles (V.append known (datasOf p)) ++ before ++ C.body cut ++ C.showInt package

-- The constructor that plays each part a runtime builds or recognises a
-- value by (`meadow_rt::roles`), of those the program declares: an optional
-- value, a result, a list, the standard library's vector and its nodes, and
-- what a file's metadata is.
def played : [(String, String)] =
  [
    ("none", "Maybe.None"),
    ("some", "Maybe.Just"),
    ("ok", "Result.Ok"),
    ("err", "Result.Err"),
    ("nil", "List.Nil"),
    ("cons", "List.Cons"),
    ("vector-empty", "Vector.Empty"),
    ("vector-single", "Vector.Single"),
    ("vector-full", "Vector.Full"),
    ("vnode-leaf", "VNode.Leaf"),
    ("vnode-branch", "VNode.Branch"),
    ("false", "Bool.False"),
    ("file-meta", "FileMeta.FileMeta")
  ]

-- `roles { ... }` for the types `datas` declares.
fun roles (datas : [(String, Int, [(String, [Type])])]) : String =
  let declared =
    V.filter
      (\r ->
        V.any
          (\d ->
            match d with
            | (_, _, ctors) -> V.any (\c -> fst c == snd r) ctors)
          datas)
      played
  in if V.isEmpty declared then ""
     else
       "roles {\n"
         ++ S.join "" (V.map (\r -> "  ${fst r} = meadow:Std/${snd r}\n") declared)
         ++ "}\n\n"

-- A unit's declarations as text, to go before those of a unit that depends
-- on it: what is always part of a program it is in -- the operations a
-- runtime answers, its types, its effects -- and then each definition's
-- text under its symbol, with the symbols it mentions.
@pub fun declarations
    (p : CoreProgram)
    (known : [(String, Int, [(String, [Type])])])
    (labelled : [(String, [String])])
    (packages : [String])
    : (String, [(String, String, [String])]) =
  match lowered p known labelled packages True with
  | (cut, always, parts) ->
      (
        natives p ++ C.textOf cut always,
        V.map
          (\x ->
            match x with
            | (symbol, _, refs, text) -> (symbol, text, refs))
          parts
      )

-- The effects of the standard library's a runtime answers where no handler
-- does (`meadow_rt`'s native operations): each operation is the runtime's
-- of the same effect and name.
def answered : [String] =
  ["Std/Console", "Std/Fs", "Std/Process", "Std/Random", "Std/Time", "Std/Test"]

-- `native { ... }` for those of them a unit declares: every operation bound
-- to the runtime's.
fun natives (p : CoreProgram) : String =
  let a = coreArena p in
  let bound =
    V.concatMap
      (\e ->
        (let name = coreEffectName a e in
         if not (V.elem name answered) then []
         else
           V.map
             (\o ->
               "  ${opSymbol name (coreOpName a o)} = ${S.drop name (stringByteLength "Std/")}.${coreOpName a o}\n")
             (coreEffectOps a e)))
      (coreFileEffects a (coreRoot p))
  in if V.isEmpty bound then "" else "native {\n${S.join "" bound}}\n\n"
