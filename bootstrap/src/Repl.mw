-- The prompt's `:` lines, as the Rust prompt has them; `:quit` is the
-- prompt's own.
def sessionCommands =
  [
    ("help", "", "this", \s rest -> Reply.Said helpText),
    ("h", "", "this", \s rest -> Reply.Said helpText),
    ("?", "", "this", \s rest -> Reply.Said helpText),
    ("q", "", "quit", \s rest -> Reply.Leave ""),
    ("t", "<expr>", "type-check without evaluating", \s rest -> Reply.Entry ":t ${rest}"),
    (
      "module",
      "",
      "list what is defined, and what a later definition shadowed",
      \s rest -> Reply.Said (listed s)
    ),
    ("reset", "", "forget everything defined so far", \s rest -> Reply.Said (reset s)),
    ("jit", "", "switch machines", \s rest -> Reply.Said (switched s "jit")),
    ("vm", "", "switch machines", \s rest -> Reply.Said (switched s "vm")),
    ("cek", "", "switch machines", \s rest -> Reply.Said (switched s "cek")),
    (
      "time",
      "[<expr>]",
      "time every entry from now on, or stop; or just this entry",
      \s rest -> timeCommand s rest
    ),
    (
      "tour",
      "[<step>]",
      "a guided tour of the language, one step at a time",
      \s rest -> Reply.Said (tourCommand s rest)
    ),
    ("next", "", "the tour's next step", \s rest -> Reply.Said (nextStep s)),
    ("n", "", "the tour's next step", \s rest -> Reply.Said (nextStep s)),
    ("back", "", "the tour's step before", \s rest -> Reply.Said (backStep s)),
    ("b", "", "the tour's step before", \s rest -> Reply.Said (backStep s)),
    ("try", "", "put the step's next example on the prompt", \s rest -> tryStep s),
    ("ir", "[<which>] [<name>]", "an entry in the compiler's IRs", \s rest -> shownIr s rest)
  ]

fun switched (s : Session) (engine : String) =
  let u = setRef s.engine engine in
  "(evaluating with the ${engine})"

-- `:time`: timing every entry turned on or off; or, given an entry, that
-- entry timed (`speaking`).
fun timeCommand (s : Session) (rest : String) =
  if S.isEmpty rest then
    (let u = setRef s.timing (not (getRef s.timing)) in
     Reply.Said "(timing every entry: ${if getRef s.timing then "on" else "off"})")
  else Reply.Entry ":time ${rest}"

fun reset (s : Session) =
  let a = setRef s.kept [] in
  let b = setRef s.uses [] in
  let c = setRef s.line 1 in
  let d = setRef s.last None in
  "(reset)"

-- `:module`: everything defined so far, with its type, and those a later
-- definition of the same name shadowed.
fun listed (s : Session) =
  let all =
    V.concatMap
      (\(k : Kept) ->
        V.map
          (\(e : Export) -> (e.name, schemeOf e))
          (V.filter (\e -> isBinding e and seen k.interface e) k.exports))
      (getRef s.kept)
  in if V.isEmpty all then "(no bindings yet)"
     else
       let marked =
         V.map
           (\i ->
             match V.get all i with
             | Just (name, scheme) ->
                 (name, scheme, V.any (\x -> fst x == name) (V.drop all (i + 1)))
             | None -> ("", "", False))
           (V.range 0 (V.len all))
       in
       let shadowed = V.len (V.filter (\x -> match x with | (_, _, sh) -> sh) marked) in
       let lines =
         V.map
           (\x ->
             match x with
             | (name, scheme, sh) ->
                 if sh then "${name} : ${scheme}  (shadowed)" else "${name} : ${scheme}")
           marked
       in S.join
            "\n"
            (if shadowed == 0 then lines
             else
               V.append lines [
                 "",
                 "(${show shadowed} definition${if shadowed == 1 then " is" else "s are"} shadowed: a name defined again is a new one, and what was written before it goes on using the old)"
               ])

-- --- the tour ----------------------------------------------------------------------

fun sectionTitle (section : Int) : String = if section == 0 then "the basics" else "going further"

fun sectionNamed (word : String) : Maybe Int =
  if V.elem word ["basics", "basic", "1"] then Just 0
  else if V.elem word ["advanced", "more", "2"] then Just 1
  else None

fun sectionFirst (section : Int) : Maybe Int =
  V.find
    (\i -> M.map (\(st : Step) -> st.section) (V.get steps i) == Just section)
    (V.range 0 (V.len steps))

fun heading (at : Int) : String =
  "Step ${show (at + 1)} of ${show (V.len steps)} — ${M.unwrapOr "" (M.map (\(st : Step) -> st.title) (V.get steps at))}"

-- What the tour has to offer: its sections, and where each begins.
fun tourContents () : String =
  let parts =
    V.concatMap
      (\section ->
        let these =
          V.filter
            (\i -> M.map (\(st : Step) -> st.section) (V.get steps i) == Just section)
            (V.range 0 (V.len steps))
        in match V.get these 0 with
           | None -> []
           | Just first ->
               V.concat [
                 ["  ${padded (sectionTitle section) 14} ${show (V.len these)} steps, from :tour ${show (first + 1)}"],
                 V.map
                   (\i ->
                     "    ${padLeft (show (i + 1)) 3}. ${M.unwrapOr "" (M.map (\(st : Step) -> st.title) (V.get steps i))}")
                   these,
                 [""]
               ])
      [0, 1]
  in S.join
       "\n"
       (V.concat [
          ["", "  A tour of the language", ""],
          parts,
          ["  :next starts at the beginning; :tour advanced goes straight to the second part.", ""]
        ])

fun padLeft (s : String) (width : Int) : String = S.repeat " " (max 0 (width - S.charLength s)) ++ s

-- Step `at`, shown, and remembered as where the tour is.
fun showTour (s : Session) (at : Int) =
  match V.get steps at with
  | None -> ""
  | Just (step : Step) ->
      let a = setRef s.tour (Just at) in
      let b = setRef s.tried 0 in
      S.join
        "\n"
        (V.concat [
           ["", "  ${heading at}  (${sectionTitle step.section})", ""],
           V.map (\l -> if S.isEmpty l then "" else "  ${l}") step.text,
           [""],
           V.map
             (\i -> "  ${show (i + 1)}. ${V.getOr "" step.code i}")
             (V.range 0 (V.len step.code)),
           ["", "  :try puts the next of those on the prompt, :next moves on, :back goes back.", ""]
         ])

fun tourCommand (s : Session) (rest : String) =
  if S.isEmpty rest then
    (match getRef s.tour with
     | Just at -> showTour s at
     | None -> tourContents ())
  else if rest == "off" or rest == "end" then
    (let u = setRef s.tour None in "(the tour is over; everything you defined is still here)")
  else
    match (sectionNamed rest, S.toInt rest) with
    | (Just section, _) ->
        (match sectionFirst section with
         | Just at -> showTour s at
         | None -> "(that section has no steps)")
    | (_, Just n) -> if n >= 1 and n <= V.len steps then showTour s (n - 1) else tourContents ()
    | _ -> tourContents ()

fun sectionOf (at : Int) : Int = M.unwrapOr 0 (M.map (\(st : Step) -> st.section) (V.get steps at))

fun nextStep (s : Session) =
  match getRef s.tour with
  | Just at ->
      if at + 1 < V.len steps and sectionOf (at + 1) != sectionOf at then
        (let u = setRef s.tour None in
         "(that is ${sectionTitle (sectionOf at)}. `:tour advanced` carries on with ${sectionTitle (sectionOf (at + 1))}, and everything you defined is still here)")
      else if at + 1 < V.len steps then showTour s (at + 1)
      else (let u = setRef s.tour None in "(that was the last step; the tour is over)")
  | None -> showTour s 0

fun backStep (s : Session) =
  match getRef s.tour with
  | Just at -> if at > 0 then showTour s (at - 1) else showTour s 0
  | None -> showTour s 0

-- `:try`: the step's next example on the prompt, to be read, changed and
-- run -- round again after the last.
fun tryStep (s : Session) =
  match getRef s.tour with
  | None -> Reply.Said "(`:tour` first, and `:try` will offer what to type)"
  | Just at ->
      let code = M.unwrapOr [] (M.map (\(st : Step) -> st.code) (V.get steps at)) in
      match V.get code (getRef s.tried) with
      | Just line -> (let u = setRef s.tried (getRef s.tried + 1) in Reply.Edit line)
      | None ->
          (let u = setRef s.tried 1 in
           match V.get code 0 with
           | Just line -> Reply.Edit line
           | None -> Reply.Said "")

-- --- :ir --------------------------------------------------------------------------

-- `:ir`, `:ir name` or `:ir which name`: the last entry, or the definition
-- called `name`, in each IR, a page each in the order a program passes
-- through them -- or in the one asked for, printed as it is. As the Rust
-- prompt's (`Session::show_ir`), though the IRs are this compiler's: its
-- core, and its Cut and what the back end makes of that, which the back end
-- says (`meadow::ir::cut_pages`).
fun shownIr (s : Session) (rest : String) =
  let words = V.filter (\w -> not (S.isEmpty w)) (S.split " " (spacedOut rest)) in
  let first = V.getOr "" words 0 in
  -- `:ir which name`, or `:ir which` for the last entry's -- unless `which`
  -- is the name of something defined, which is what it then means.
  let (which, name) =
    if V.len words > 1 and V.elem first irForms then (Just first, S.join " " (V.drop words 1))
    else if V.elem first irForms and not (isDefined s first) then (Just first, "")
    else (None, S.trim rest)
  in
  let nothingYet =
    Reply.Said "(nothing to show yet: enter an expression or a definition, and `:ir` shows it)"
  in if S.isEmpty name then
       (match M.andThen (\l -> V.get (getRef s.kept) (snd l)) (getRef s.last) with
        | Just (k : Kept) ->
            (match lastValue k with
             | Just e ->
                 irShown
                   s
                   which
                   (M.unwrapOr "" (M.map fst (getRef s.last)))
                   (Shown {
                      pkg = k.pkg,
                      interface = k.interface,
                      entry = e,
                      symbols =
                        V.map (\x -> match x with | (symbol, _, _) -> symbol) (partsOf k.object),
                      kept = keptUpTo s k.pkg,
                      core = k.core,
                      binders = None
                    })
             | None -> nothingYet)
        | None -> nothingYet)
     else
       match definitionNamed s name with
       | Just shown -> irShown s which name shown
       | None -> Reply.Said "(nothing called `${name}` is defined)"

-- What `:ir` shows: definitions of package `pkg`, whose interface is
-- `interface` -- by their symbols, the last of them `entry` -- with the
-- entries before them, and the core they are in.
record Shown = {
  pkg : String,
  interface : Interface,
  entry : Export,
  symbols : [String],
  kept : [Kept],
  core : Maybe CoreProgram,
  binders : Maybe [Int]
}

-- The last value an entry defines: what was run of it.
fun lastValue (k : Kept) : Maybe Export =
  let values = V.filter (\(e : Export) -> isBinding e and S.isEmpty e.owner) k.exports in
  V.get values (V.len values - 1)

fun partsOf (o : Maybe Object) : [(String, String, [String])] =
  match o with | Just x -> snd x | None -> []

-- The entries kept up to and including the one of package `pkg`.
fun keptUpTo (s : Session) (pkg : String) =
  let all = getRef s.kept in
  match V.find
    (\i -> M.map (\(k : Kept) -> k.pkg) (V.get all i) == Just pkg)
    (V.range 0 (V.len all)) with
  | Just i -> V.take all (i + 1)
  | None -> all

-- The value called `name` that a mention of it now would mean: the newest
-- entry's of that name, or else the standard library's.
fun definitionNamed (s : Session) (name : String) =
  let named = \(e : Export) -> e.kind == "v" and S.isEmpty e.owner and e.name == name in
  let own = V.find (\(k : Kept) -> M.isSome (V.find named k.exports)) (V.reverse (getRef s.kept)) in
  match own with
  | Just (k : Kept) ->
      M.map
        (\(e : Export) ->
          Shown {
            pkg = k.pkg,
            interface = k.interface,
            entry = e,
            symbols = [defSymbol k.pkg e.binder],
            kept = keptUpTo s k.pkg,
            core = k.core,
            binders = Just [e.binder]
          })
        (V.find named (V.reverse k.exports))
  | None ->
      match s.std with
      | None -> None
      | Just (std : Interface) ->
          let candidates = V.filter named std.exports in
          let rooted = V.find (\(e : Export) -> V.isEmpty e.module) candidates in
          M.map
            (\(e : Export) ->
              Shown {
                pkg = "Std",
                interface = std,
                entry = e,
                symbols = [defSymbol "Std" e.binder],
                kept = [],
                core = None,
                binders = Just [e.binder]
              })
            (match rooted with
             | Just e -> Just e
             | None -> V.get candidates 0)

-- The pages of what `shown` is, titled `heading`: printed as they are when
-- one was asked for; else in a pane, where there is a terminal to draw it
-- on, and one after another, each under its title, where there is not.
fun irShown (s : Session) (which : Maybe String) (heading : String) (shown : Shown) =
  let pages = irPages s which shown in
  match which with
  | Just _ ->
      (let text = S.join "" (V.map snd pages) in
       Reply.Said
         (if S.endsWith "\n" text then stringSlice text 0 (stringByteLength text - 1) else text))
  | None ->
      if T.enterRaw () then (let u = T.leaveRaw () in Reply.Pages heading pages)
      else
        Reply.Said
          (S.trimEnd
             (S.join
                ""
                (V.map
                   (\p ->
                     "=== ${fst p} ===\n${snd p}${if S.endsWith "\n" (snd p) then "" else "\n"}")
                   pages)))

-- Each page of what `shown` is, or the one `which` asks for: its core, as
-- this compiler made it, and what the back end says of its Cut -- the Cut
-- itself, AxCut, Glade's bytecode and machine code, and LLVM's IR. Where
-- the back end cannot be had, there is only the core.
fun irPages (s : Session) (which : Maybe String) (shown : Shown) =
  let wanted = \form -> M.unwrapOr True (M.map (\w -> w == form) which) in
  let core = if wanted "core" then [("Core", corePage s shown)] else [] in
  if which == Just "core" then core else V.append core (backEndPages s which shown)

-- What the back end says of the Cut `shown` is in.
fun backEndPages (s : Session) (which : Maybe String) (shown : Shown) =
  match (hostOf s, libraryOf s) with
  | (Just h, Just lib) ->
      let objects =
        V.pushFront
          (V.concatMap (\(k : Kept) -> M.unwrapOr [] (M.map (\o -> [o]) k.object)) shown.kept)
          lib.object
      in
      let program = programOf lib objects shown.pkg shown.interface shown.entry shown.symbols in
      let own =
        V.concatMap
          (\o ->
            V.concatMap
              (\x ->
                match x with
                | (symbol, text, _) ->
                    if V.elem symbol shown.symbols then V.pushFront (declaredIn text) symbol
                    else [])
              (snd o))
          objects
      in
      let request =
        J.render
          (J.jObject [
             ("program", J.jString program),
             ("own", J.jArray (V.map J.jString own)),
             ("only", M.unwrapOr (J.jNull ()) (M.map J.jString which)),
             ("opt", J.jInt 1)
           ])
      in (match Res.andThen J.parse (Ffi.callString h.pages [Arg.String request]) with
          | Ok answer ->
              V.concatMap
                (\p ->
                  match (
                    M.andThen J.asString (J.index 0 p),
                    M.andThen J.asString (J.index 1 p)
                  ) with
                  | (Just title, Just text) -> [(title, text)]
                  | _ -> [])
                (M.unwrapOr [] (J.asArray answer))
          | Err why -> [("Cut", "-- the back end could not be asked: ${why}\n")])
  | _ -> []

-- The symbols the declarations of `text` declare: each line that starts
-- `def` or `val`, and the symbol after it.
fun declaredIn (text : String) : [String] =
  V.concatMap
    (\line ->
      let word =
        if S.startsWith "def " line or S.startsWith "val " line then S.drop line 4 else ""
      in
      let symbol = S.fromChars (V.takeWhile (\c -> c != ' ' and c != '(') (S.chars word)) in
      if S.isEmpty symbol then [] else [symbol])
    (S.lines text)

-- `:ir core`'s page: the definitions shown, as this compiler's core has
-- them.
fun corePage (s : Session) (shown : Shown) =
  let core = if shown.pkg == "Std" then stdCoreOf s else shown.core in
  match core with
  | Just c -> CoreShow.shownDefs c (M.unwrapOr (CoreShow.defIds c) shown.binders)
  | None -> "-- there is no core to show\n"

def irForms : [String] = ["core", "cut", "axcut", "bytecode", "native", "llvm"]

-- Whether a value called `name` is defined: by an entry, or by the
-- standard library.
fun isDefined (s : Session) (name : String) =
  V.any
    (\(k : Kept) -> V.any (\(e : Export) -> e.kind == "v" and e.name == name) k.exports)
    (getRef s.kept)
    or (match s.std with
     | Just (i : Interface) -> V.any (\(e : Export) -> e.kind == "v" and e.name == name) i.exports
     | None -> False)

@test fun aPartDeclaresItsDefinitionsAndValues () =
  assertEq
    (declaredIn
       "def meadow:repl:2/d4f (v: i64; k: ptr) =\n  <v | k>\n\nval meadow:repl:2/d4 : ptr =\n  <meadow:repl:2/d4f | halt>\n")
    ["meadow:repl:2/d4f", "meadow:repl:2/d4"]
    "each `def` and `val` at the margin, and nothing it mentions"
