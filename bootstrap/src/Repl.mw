-- What the prompt says when it starts: short, so that the name is still on
-- the screen when the prompt is. Everything else is `:help`'s.
def banner : String =
  S.join "\n" [
    "", logo, "", "  Welcome to the Meadow interactive environment!", "",
    "  :help commands and keys   :tour a tour   :q quit",
    "  Tab completes   Ctrl+F finds a declaration   Ctrl+J starts a new line", "", ""
  ]

-- The `:` commands, each as it is written and what it does.
def commandList : [(String, String)] =
  [
    (":q", "quit"),
    (":t <expr>", "type-check without evaluating"),
    (":module", "list what is defined, and what a later definition shadowed"),
    (":ir", "the last entry in every IR the compiler puts it in, a page each; Tab turns the page"),
    (":ir <name>", "a definition, the same way"),
    (
      ":ir <which> <name>",
      "one of them, printed as it is: core, cut, axcut, bytecode, native or llvm (with no name, the last entry's)"
    ),
    (":reset", "forget everything defined so far"),
    (":jit / :vm / :cek", "switch machines (the JIT is the default)"),
    (":time", "time every entry from now on, or stop"),
    (":time <expr>", "time just this entry"),
    (":tour", "a guided tour of the language, one step at a time"),
    (":next / :back", "move through it; `:try` puts its example on the prompt")
  ]

fun padded (s : String) (width : Int) : String = s ++ S.repeat " " (max 0 (width - S.charLength s))

-- `:help`: every command, and the keys, at the length the banner is not.
def helpText : String =
  S.join
    "\n"
    (V.concat [
       ["", "  ${padded ":help" 17}  this"],
       V.map (\c -> "  ${padded (fst c) 17}  ${snd c}") commandList,
       [
         "", "  Tab completes names — values, types, constructors and `use` paths,",
         "  each in the namespace the cursor is actually in.",
         "  Ctrl+F finds a declaration — by name, or by a type like [a] -> Int.",
         "  Multi-line: Alt+Enter / Ctrl+J insert a newline; an unfinished line (open bracket,",
         "  dangling operator, trailing `\\`, a signature, `| ...` arms) keeps reading.",
         "  End a multi-line entry with a blank line."
       ],
       (if hostOs == "macos" then
          [
            "  On macOS: Ctrl+J always works. Option+Return (Alt+Enter) does once the terminal",
            "  sends Option as Meta: Terminal > Settings > Profiles > Keyboard >",
            "  \"Use Option as Meta key\"; in iTerm2, Profiles > Keys > Left Option: Esc+;",
            "  in VS Code's terminal, the setting `terminal.integrated.macOptionIsMeta`.",
            "  Until then Option+Return is an ordinary Return, and enters what is typed."
          ]
        else []),
       [""]
     ])

