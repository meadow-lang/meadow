-- Std.Collections.Vector: a persistent RRB vector, in the style of Rust's `im`.
--
-- This is what `[1, 2, 3]` literal syntax builds. The design follows `im::Vector`:
--
--   * a small-vector repr (`Single`) while the whole vector fits in one chunk,
--   * a big repr (`Full`) with two-level front and back side buffers
--     (`outerF`/`innerF` ... `innerB`/`outerB`) around an RRB middle tree, giving
--     amortised O(1) push/pop at both ends,
--   * middle-tree branches that are *balanced* (radix indexing, `sizes = None`)
--     until a structural op relaxes them (`sizes = Just cumulative`), after which
--     indexing binary-walks the size table.
--
-- `append` / `splitAt` here are chunk-wise / rebuild-based rather than a
-- full structural concat-rebalance -- correct and sub-linear-ish, but not the
-- true O(log n) RRB merge. Everything else is the faithful structure.

use Std.Tuple (fst, snd)
-- `toStream` performs `yield`. An effect's operations are in scope from every
-- dependency whether or not they are `use`d, but naming it says where it lives.
use Std.Yield (yield)

-- --- tuning ----------------------------------------------------------------

@pub def vWidth : Int = 32
def vBits = 5
def vMask = 31

-- --- array helpers (local; `Array` has no map/fold primitives) -------------

fun vaLast xs = arrayGet xs (arrayLen xs - 1)
fun vaInit xs = arraySlice xs 0 (arrayLen xs - 1)
fun vaSetLast xs x = arraySet xs (arrayLen xs - 1) x

fun vaMap f xs =
  let n = arrayLen xs in
  let rec go i acc = if i >= n then acc else go (i + 1) (arrayPush acc (f (arrayGet xs i))) in
  go 0 #[]

fun vaFoldl f z xs =
  let n = arrayLen xs in
  let rec go i acc = if i >= n then acc else go (i + 1) (f acc (arrayGet xs i)) in
  go 0 z

fun vaFoldr f z xs =
  let rec go i acc = if i < 0 then acc else go (i - 1) (f (arrayGet xs i) acc) in
  go (arrayLen xs - 1) z

-- --- representation ------------------------------------------------------

-- A middle-tree node. `Branch None` is radix-balanced; `Branch (Just s)` is
-- relaxed and `s` holds cumulative child sizes.
use VNode.*
@derive(Debug, Display)
@pub data VNode a
  = Leaf (Array a)
  | Branch (Maybe (Array Int)) (Array (VNode a))

-- fields of Full: len, shift, outerF, innerF, mid, innerB, outerB
use Vector.*
@pub data Vector a
  = Empty
  | Single (Array a)
  | Full Int Int (Array a) (Array a) (VNode a) (Array a) (Array a)

def vEmptyNode = Branch None #[]

-- max elements a fully-balanced subtree rooted at `shift` can hold
fun vNodeCap shift = 1 << (shift + vBits)

fun vNodeLen shift node =
  match node with
  | Leaf xs -> arrayLen xs
  | Branch szs kids ->
      match szs with
      | Just s -> if arrayLen s == 0 then 0 else vaLast s
      | None ->
          if arrayLen kids == 0 then 0
          else (arrayLen kids - 1) * (1 << shift) + vNodeLen (shift - vBits) (vaLast kids)

-- cumulative size table for `kids` sitting at `shift` (children at shift - vBits)
fun vSizesOf shift kids =
  let n = arrayLen kids in
  let rec go i run acc =
    if i >= n then acc
    else
      let r2 = run + vNodeLen (shift - vBits) (arrayGet kids i) in
      go (i + 1) r2 (arrayPush acc r2)
  in go 0 0 #[]

-- --- indexing ----------------------------------------------------------

fun vNodeIndex shift node i =
  match node with
  | Leaf xs -> arrayGet xs i
  | Branch szs kids ->
      match szs with
      | None ->
          let slot = i >> shift in
          vNodeIndex (shift - vBits) (arrayGet kids slot) (i - (slot << shift))
      | Just s ->
          let rec find k = if arrayGet s k > i then k else find (k + 1) in
          let slot = find 0 in
          let sub = if slot == 0 then i else i - arrayGet s (slot - 1) in
          vNodeIndex (shift - vBits) (arrayGet kids slot) sub

fun vNodeUpdate shift node i x =
  match node with
  | Leaf xs -> Leaf (arraySet xs i x)
  | Branch szs kids ->
      match szs with
      | None ->
          let slot = i >> shift in
          let k2 = vNodeUpdate (shift - vBits) (arrayGet kids slot) (i - (slot << shift)) x in
          Branch None (arraySet kids slot k2)
      | Just s ->
          let rec find k = if arrayGet s k > i then k else find (k + 1) in
          let slot = find 0 in
          let sub = if slot == 0 then i else i - arrayGet s (slot - 1) in
          let k2 = vNodeUpdate (shift - vBits) (arrayGet kids slot) sub x in
          Branch (Just s) (arraySet kids slot k2)

-- --- bulk build ------------------------------------------------------

fun vLeavesOf xs =
  let n = arrayLen xs in
  let rec go i acc =
    if i >= n then acc
    else
      let j = if i + vWidth < n then i + vWidth else n in
      go j (arrayPush acc (Leaf (arraySlice xs i j)))
  in go 0 #[]

fun vGroup nodes =
  let n = arrayLen nodes in
  let rec go i acc =
    if i >= n then acc
    else
      let j = if i + vWidth < n then i + vWidth else n in
      go j (arrayPush acc (Branch None (arraySlice nodes i j)))
  in go 0 #[]

-- returns (shift, node); `xs` must be non-empty
fun vBuildTree xs =
  let ls = vLeavesOf xs in
  let rec up level nodes =
    if arrayLen nodes <= vWidth then (level, Branch None nodes)
    else up (level + vBits) (vGroup nodes)
  in up vBits ls

fun vNodeToArray node =
  match node with
  | Leaf xs -> xs
  | Branch szs kids -> vaFoldl (\acc k -> arrayConcat acc (vNodeToArray k)) #[] kids

-- --- walking a vector where it stands ----------------------------------
--
-- A fold or a search reads the five parts of a vector in turn, and the
-- middle tree leaf by leaf: nothing is copied to do it, where `toArray`
-- first is a copy of every element to read perhaps one.

fun vNodeFoldl f z node =
  match node with
  | Leaf xs -> vaFoldl f z xs
  | Branch szs kids -> vaFoldl (\acc k -> vNodeFoldl f acc k) z kids

fun vNodeFoldr f z node =
  match node with
  | Leaf xs -> vaFoldr f z xs
  | Branch szs kids -> vaFoldr (\k acc -> vNodeFoldr f acc k) z kids

-- The first element of `xs` that `keep` holds of.
fun vaFind keep xs =
  let i = vaIndex keep xs 0 (arrayLen xs) in
  if i < 0 then None else Just (arrayGet xs i)

fun vNodeFind keep node =
  match node with
  | Leaf xs -> vaFind keep xs
  | Branch szs kids -> vKidsFind keep kids 0

fun vKidsFind keep kids i =
  if i >= arrayLen kids then None
  else
    match vNodeFind keep (arrayGet kids i) with
    | Just x -> Just x
    | None -> vKidsFind keep kids (i + 1)

-- --- append a full chunk at the bottom-right --------------------------

fun vNewSpine shift chunk =
  if shift == 0 then Leaf chunk else Branch None #[vNewSpine (shift - vBits) chunk]

-- precondition: there is room for another `vWidth` chunk under `node`
fun vAppendChunk shift node chunk =
  match node with
  | Leaf _ -> node
  | Branch szs kids ->
      if shift == vBits then
        let kids2 = arrayPush kids (Leaf chunk) in
        match szs with
        | None -> Branch None kids2
        | Just _ -> Branch (Just (vSizesOf shift kids2)) kids2
      else
        let lst = vaLast kids in
        let room = vNodeLen (shift - vBits) lst + vWidth <= vNodeCap (shift - vBits) in
        if room then
          let kids2 = vaSetLast kids (vAppendChunk (shift - vBits) lst chunk) in
          match szs with
          | None -> Branch None kids2
          | Just _ -> Branch (Just (vSizesOf shift kids2)) kids2
        else
          let kids2 = arrayPush kids (vNewSpine (shift - vBits) chunk) in
          match szs with
          | None -> Branch None kids2
          | Just _ -> Branch (Just (vSizesOf shift kids2)) kids2

-- (newShift, newNode) -- grows the root when full
fun vPushChunkBack shift node chunk =
  if vNodeLen shift node + vWidth <= vNodeCap shift then (shift, vAppendChunk shift node chunk)
  else
    let root = Branch None #[node] in
    (shift + vBits, vAppendChunk (shift + vBits) root chunk)

-- remove the rightmost leaf; returns (chunk, newNode)
fun vPopChunkBack shift node =
  match node with
  | Leaf xs -> (xs, vEmptyNode)
  | Branch szs kids ->
      -- A relaxed node stays relaxed: its size table is what indexes it.
      let rebuilt =
        \kids2 ->
          match szs with
          | None -> Branch None kids2
          | Just _ -> Branch (Just (vSizesOf shift kids2)) kids2
      in if shift == vBits then
           let chunk = match vaLast kids with | Leaf xs -> xs | Branch _ _ -> #[] in
           (chunk, rebuilt (vaInit kids))
         else
           let (chunk, last2) = vPopChunkBack (shift - vBits) (vaLast kids) in
           if vNodeLen (shift - vBits) last2 == 0 then (chunk, rebuilt (vaInit kids))
           else (chunk, rebuilt (vaSetLast kids last2))

fun vShrinkRoot shift node =
  match node with
  | Leaf _ -> (shift, node)
  | Branch szs kids ->
      if shift > vBits then
        if arrayLen kids == 1 then vShrinkRoot (shift - vBits) (arrayGet kids 0) else (shift, node)
      else (shift, node)

-- --- symmetric: prepend a full chunk at the bottom-left --------------

fun vPrependChunk shift node chunk =
  match node with
  | Leaf _ -> node
  | Branch szs kids ->
      if shift == vBits then
        let kids2 = arrayConcat #[Leaf chunk] kids in
        Branch (Just (vSizesOf shift kids2)) kids2
      else
        let fst0 = arrayGet kids 0 in
        let room = vNodeLen (shift - vBits) fst0 + vWidth <= vNodeCap (shift - vBits) in
        if room then
          let kids2 = arraySet kids 0 (vPrependChunk (shift - vBits) fst0 chunk) in
          Branch (Just (vSizesOf shift kids2)) kids2
        else
          let kids2 = arrayConcat #[vNewSpine (shift - vBits) chunk] kids in
          Branch (Just (vSizesOf shift kids2)) kids2

fun vPushChunkFront shift node chunk =
  if vNodeLen shift node + vWidth <= vNodeCap shift then (shift, vPrependChunk shift node chunk)
  else
    let root = Branch None #[node] in
    (shift + vBits, vPrependChunk (shift + vBits) root chunk)

-- --- constructors -----------------------------------------------------

@pub def empty : [a] = Empty

@pub fun singleton (x : a) : [a] = Single #[x]

@pub fun fromArray (xs : #[a]) : [a] =
  let n = arrayLen xs in
  if n == 0 then Empty
  else if n <= vWidth then Single xs
  else
    -- Only whole chunks go into the tree, which indexes by radix on the
    -- understanding that every leaf but the last is full, and that the
    -- chunks pushed after it will be too. The rest waits at the back.
    let whole = n - n % vWidth in
    let (sh, tree) = vBuildTree (arraySlice xs 0 whole) in
    Full n sh #[] #[] tree #[] (arraySlice xs whole n)

-- --- observation ----------------------------------------------------

@pub fun len (v : [a]) : Int =
  match v with
  | Empty -> 0
  | Single xs -> arrayLen xs
  | Full len sh oF iF mid iB oB -> len

@pub fun isEmpty (v : [a]) : Bool = len v == 0

fun getU v i =
  match v with
  | Empty -> arrayGet #[] 0
  | Single xs -> arrayGet xs i
  | Full len sh oF iF mid iB oB ->
      let a = arrayLen oF in
      if i < a then arrayGet oF i
      else
        let i1 = i - a in
        let b = arrayLen iF in
        if i1 < b then arrayGet iF i1
        else
          let i2 = i1 - b in
          let m = vNodeLen sh mid in
          if i2 < m then vNodeIndex sh mid i2
          else
            let i3 = i2 - m in
            let c = arrayLen iB in
            if i3 < c then arrayGet iB i3 else arrayGet oB (i3 - c)

@pub fun get (v : [a]) (i : Int) : Maybe a =
  if i < 0 then None else if i >= len v then None else Just (getU v i)

@pub fun getOr (d : a) (v : [a]) (i : Int) : a =
  if i < 0 then d else if i >= len v then d else getU v i

@pub fun head (v : [a]) : Maybe a = get v 0

@pub fun last (v : [a]) : Maybe a = get v (len v - 1)

@pub fun set (v : [a]) (i : Int) (x : a) : [a] =
  if i < 0 then v
  else if i >= len v then v
  else
    match v with
    | Empty -> v
    | Single xs -> Single (arraySet xs i x)
    | Full len sh oF iF mid iB oB ->
        let a = arrayLen oF in
        if i < a then Full len sh (arraySet oF i x) iF mid iB oB
        else
          let i1 = i - a in
          let b = arrayLen iF in
          if i1 < b then Full len sh oF (arraySet iF i1 x) mid iB oB
          else
            let i2 = i1 - b in
            let m = vNodeLen sh mid in
            if i2 < m then Full len sh oF iF (vNodeUpdate sh mid i2 x) iB oB
            else
              let i3 = i2 - m in
              let c = arrayLen iB in
              if i3 < c then Full len sh oF iF mid (arraySet iB i3 x) oB
              else Full len sh oF iF mid iB (arraySet oB (i3 - c) x)

-- --- push / pop back ------------------------------------------------

@pub fun pushBack (v : [a]) (x : a) : [a] =
  match v with
  | Empty -> Single #[x]
  | Single xs ->
      if arrayLen xs < vWidth then Single (arrayPush xs x)
      else Full (vWidth + 1) vBits xs #[] vEmptyNode #[] #[x]
  | Full len sh oF iF mid iB oB ->
      if arrayLen oB < vWidth then Full (len + 1) sh oF iF mid iB (arrayPush oB x)
      else if arrayLen iB == 0 then Full (len + 1) sh oF iF mid oB #[x]
      else
        let (sh2, mid2) = vPushChunkBack sh mid iB in
        Full (len + 1) sh2 oF iF mid2 oB #[x]

fun vNormalize v =
  match v with
  | Single xs if arrayLen xs == 0 -> Empty
  | Full len _ _ _ _ _ _ if len == 0 -> Empty
  | Full len sh oF iF mid iB oB if len <= vWidth and vNodeLen sh mid == 0 ->
      Single (arrayConcat (arrayConcat (arrayConcat (arrayConcat oF iF) #[]) iB) oB)
  | Empty -> Empty
  | _ -> v

@pub fun popBack (v : [a]) : [a] =
  match v with
  | Empty -> Empty
  | Single xs -> vNormalize (Single (vaInit xs))
  | Full len sh oF iF mid iB oB ->
      if arrayLen oB > 0 then vNormalize (Full (len - 1) sh oF iF mid iB (vaInit oB))
      -- A buffer one short is no chunk: it moves to the outer slot, since
      -- whatever sits in an inner one is pushed into the tree whole.
      else if arrayLen iB > 0 then vNormalize (Full (len - 1) sh oF iF mid #[] (vaInit iB))
      else if vNodeLen sh mid > 0 then
        let (chunk, mid2) = vPopChunkBack sh mid in
        let (sh2, mid3) = vShrinkRoot sh mid2 in
        vNormalize (Full (len - 1) sh2 oF iF mid3 #[] (vaInit chunk))
      else if arrayLen iF > 0 then vNormalize (Full (len - 1) sh oF #[] mid #[] (vaInit iF))
      else vNormalize (Full (len - 1) sh (vaInit oF) #[] mid #[] #[])

-- --- push / pop front -----------------------------------------------

@pub fun pushFront (v : [a]) (x : a) : [a] =
  match v with
  | Empty -> Single #[x]
  | Single xs ->
      if arrayLen xs < vWidth then Single (arrayConcat #[x] xs)
      else Full (vWidth + 1) vBits #[x] #[] vEmptyNode #[] xs
  | Full len sh oF iF mid iB oB ->
      if arrayLen oF < vWidth then Full (len + 1) sh (arrayConcat #[x] oF) iF mid iB oB
      else if arrayLen iF == 0 then Full (len + 1) sh #[x] oF mid iB oB
      else
        let (sh2, mid2) = vPushChunkFront sh mid iF in
        Full (len + 1) sh2 #[x] oF mid2 iB oB

fun vPopChunkFront shift node =
  match node with
  | Leaf xs -> (xs, vEmptyNode)
  | Branch szs kids ->
      if shift == vBits then
        let chunk =
          match arrayGet kids 0 with
          | Leaf xs -> xs
          | Branch _ _ -> #[]
        in
        let rest = arraySlice kids 1 (arrayLen kids) in
        (chunk, Branch (Just (vSizesOf shift rest)) rest)
      else
        let (chunk, first2) = vPopChunkFront (shift - vBits) (arrayGet kids 0) in
        if vNodeLen (shift - vBits) first2 == 0 then
          let rest = arraySlice kids 1 (arrayLen kids) in
          (chunk, Branch (Just (vSizesOf shift rest)) rest)
        else
          let kids2 = arraySet kids 0 first2 in
          (chunk, Branch (Just (vSizesOf shift kids2)) kids2)

@pub fun popFront (v : [a]) : [a] =
  match v with
  | Empty -> Empty
  | Single xs -> vNormalize (Single (arraySlice xs 1 (arrayLen xs)))
  | Full len sh oF iF mid iB oB ->
      if arrayLen oF > 0 then
        vNormalize (Full (len - 1) sh (arraySlice oF 1 (arrayLen oF)) iF mid iB oB)
      else if arrayLen iF > 0 then
        vNormalize (Full (len - 1) sh (arraySlice iF 1 (arrayLen iF)) #[] mid iB oB)
      else if vNodeLen sh mid > 0 then
        let (chunk, mid2) = vPopChunkFront sh mid in
        let (sh2, mid3) = vShrinkRoot sh mid2 in
        vNormalize (Full (len - 1) sh2 (arraySlice chunk 1 (arrayLen chunk)) #[] mid3 iB oB)
      else if arrayLen iB > 0 then
        vNormalize (Full (len - 1) sh (arraySlice iB 1 (arrayLen iB)) #[] mid #[] oB)
      else vNormalize (Full (len - 1) sh (arraySlice oB 1 (arrayLen oB)) #[] mid #[] #[])

-- --- conversion ---------------------------------------------------

@pub fun toArray (v : [a]) : #[a] =
  match v with
  | Empty -> #[]
  | Single xs -> xs
  | Full len sh oF iF mid iB oB ->
      arrayConcat (arrayConcat (arrayConcat (arrayConcat oF iF) (vNodeToArray mid)) iB) oB

@pub fun fromList (xs : List a) : [a] =
  let rec go ys acc =
    match ys with
    | Nil -> acc
    | Cons h t -> go t (arrayPush acc h)
  in fromArray (go xs #[])

@pub fun toList (v : [a]) : List a =
  let xs = toArray v in
  let rec go i acc = if i < 0 then acc else go (i - 1) (Cons (arrayGet xs i) acc) in
  go (arrayLen xs - 1) Nil

-- --- bulk ops (chunk-wise / rebuild) ----------------------------------

@pub fun append (l : [a]) (r : [a]) : [a] =
  match l with
  | Empty -> r
  | Single _ -> foldl (\v x -> pushBack v x) l r
  | Full _ _ _ _ _ _ _ -> foldl (\v x -> pushBack v x) l r

@pub fun splitAt (v : [a]) (n : Int) : ([a], [a]) =
  let xs = toArray v in
  let k = if n < 0 then 0 else if n > arrayLen xs then arrayLen xs else n in
  (fromArray (arraySlice xs 0 k), fromArray (arraySlice xs k (arrayLen xs)))

@pub fun slice (v : [a]) (from : Int) (to : Int) : [a] =
  let xs = toArray v in fromArray (arraySlice xs from to)

-- All but the last is the common `take`, and all but the first the common
-- `drop` -- a stack popped, a list walked -- and each is what `popBack` and
-- `popFront` do without reading the rest.
@pub fun take (v : [a]) (n : Int) : [a] =
  let have = len v in
  if n >= have then v else if n == have - 1 and n >= 0 then popBack v else fst (splitAt v n)

@pub fun drop (v : [a]) (n : Int) : [a] =
  if n <= 0 then v else if n == 1 then popFront v else snd (splitAt v n)

@pub fun map (f : a -> b ! e) (v : [a]) : [b] ! e =
  match v with
  | Empty -> Empty
  | Single xs -> Single (vaMap f xs)
  | Full len sh oF iF mid iB oB ->
      let rec mapNode node =
        match node with
        | Leaf xs -> Leaf (vaMap f xs)
        | Branch szs kids -> Branch szs (vaMap mapNode kids)
      in Full len sh (vaMap f oF) (vaMap f iF) (mapNode mid) (vaMap f iB) (vaMap f oB)

@pub fun foldl (f : a -> b -> a ! e) (z : a) (v : [b]) : a ! e =
  match v with
  | Empty -> z
  | Single xs -> vaFoldl f z xs
  | Full len sh oF iF mid iB oB ->
      vaFoldl f (vaFoldl f (vNodeFoldl f (vaFoldl f (vaFoldl f z oF) iF) mid) iB) oB

@pub fun foldr (f : a -> b -> b ! e) (z : b) (v : [a]) : b ! e =
  match v with
  | Empty -> z
  | Single xs -> vaFoldr f z xs
  | Full len sh oF iF mid iB oB ->
      vaFoldr f (vaFoldr f (vNodeFoldr f (vaFoldr f (vaFoldr f z oB) iB) mid) iF) oF

@pub fun filter (keep : a -> Bool ! e) (v : [a]) : [a] ! e =
  fromArray (foldl (\acc x -> if keep x then arrayPush acc x else acc) #[] v)

@pub fun reverse (v : [a]) : [a] =
  v |> toArray |> vaFoldr (\x acc -> arrayPush acc x) #[] |> fromArray

@pub fun updateAt (v : [a]) (i : Int) (f : a -> a ! e) : [a] ! e =
  match get v i with | None -> v | Just x -> set v i (f x)

@pub fun forEach (f : a -> () ! e) (v : [a]) : () ! e = foldl (\u x -> f x) () v

-- The `[…]`-literal target: `[1, 2, 3]` desugars to `vecFromArray #[1, 2, 3]`.
@pub fun vecFromArray (xs : #[a]) : [a] = fromArray xs

-- --- derived helpers (the sequence API the prelude re-exports unqualified) ---

@pub fun length (v : [a]) : Int = len v

@pub fun nth (n : Int) (v : [a]) : Maybe a = get v n

@pub fun range (lo : n) (hi : n) : [n] =
  let rec go i acc = if i >= hi then acc else go (i + 1) (pushBack acc i) in
  go lo empty

@pub fun elem (x : a) (v : [a]) : Bool = any (\y -> x == y) v

@pub fun notElem (x : a) (v : [a]) : Bool = if elem x v then False else True

@pub fun sum (v : [n]) : n = foldl (\a x -> a + x) 0 v

@pub fun product (v : [n]) : n = foldl (\a x -> a * x) 1 v

@pub fun sumBy (f : a -> n ! e) (v : [a]) : n ! e = foldl (\a x -> a + f x) 0 v

@pub fun all (keep : a -> Bool ! e) (v : [a]) : Bool ! e =
  match find (\x -> if keep x then False else True) v with
  | Just _ -> False
  | None -> True

@pub fun any (keep : a -> Bool ! e) (v : [a]) : Bool ! e =
  match find keep v with | Just _ -> True | None -> False

-- The first element `keep` holds of: a search that stops where it finds,
-- and reads the vector where it stands.
@pub fun find (keep : a -> Bool ! e) (v : [a]) : Maybe a ! e =
  match v with
  | Empty -> None
  | Single xs -> vaFind keep xs
  | Full len sh oF iF mid iB oB ->
      match vaFind keep oF with
      | Just x -> Just x
      | None ->
          match vaFind keep iF with
          | Just x -> Just x
          | None ->
              match vNodeFind keep mid with
              | Just x -> Just x
              | None ->
                  match vaFind keep iB with
                  | Just x -> Just x
                  | None -> vaFind keep oB

-- Where in `xs` from `i` on, short of `n`, the first element `keep` holds of
-- is, or -1: a search that stops where it finds, which a fold cannot.
fun vaIndex (keep : a -> Bool ! e) (xs : #[a]) (i : Int) (n : Int) : Int ! e =
  if i >= n then 0 - 1 else if keep (arrayGet xs i) then i else vaIndex keep xs (i + 1) n

@pub fun concat (vs : [[a]]) : [a] = foldl (\acc v -> append acc v) empty vs

@pub fun concatMap (f : a -> [b] ! e) (v : [a]) : [b] ! e = v |> map f |> concat

-- `sep` between each two of `v`: `intersperse 0 [1, 2, 3]` is
-- `[1, 0, 2, 0, 3]`.
@pub fun intersperse (sep : a) (v : [a]) : [a] =
  foldl (\acc x -> if isEmpty acc then pushBack acc x else pushBack (pushBack acc sep) x) empty v

-- `sep` between each two of `vs`, and all of it one vector:
-- `intercalate [0] [[1, 2], [3]]` is `[1, 2, 0, 3]`.
@pub fun intercalate (sep : [a]) (vs : [[a]]) : [a] = concat (intersperse sep vs)

@pub fun replicate (n : n) (x : a) : [a] =
  let rec go k acc = if k <= 0 then acc else go (k - 1) (pushBack acc x) in
  go n empty

@pub fun takeWhile (keep : a -> Bool ! e) (v : [a]) : [a] ! e =
  fromArray
    (fst
       (vaFoldl
          (\p x ->
            match p with
            | (acc, live) ->
                if live then (if keep x then (arrayPush acc x, True) else (acc, False))
                else (acc, False))
          (#[], True)
          (toArray v)))

@pub fun dropWhile (keep : a -> Bool ! e) (v : [a]) : [a] ! e =
  fromArray
    (fst
       (vaFoldl
          (\p x ->
            match p with
            | (acc, dropping) ->
                if dropping then (if keep x then (acc, True) else (arrayPush acc x, False))
                else (arrayPush acc x, False))
          (#[], True)
          (toArray v)))

@pub fun partition (keep : a -> Bool ! e) (v : [a]) : ([a], [a]) ! e =
  (filter keep v, filter (\x -> if keep x then False else True) v)

@pub fun zipWith (f : a -> b -> c ! e) (a : [a]) (b : [b]) : [c] ! e =
  let xs = toArray a in
  let ys = toArray b in
  let n = if arrayLen xs < arrayLen ys then arrayLen xs else arrayLen ys in
  let rec go i acc =
    if i >= n then acc else go (i + 1) (pushBack acc (f (arrayGet xs i) (arrayGet ys i)))
  in go 0 empty

@pub fun zip (a : [a]) (b : [b]) : [(a, b)] = zipWith (\x y -> (x, y)) a b

@pub fun unzip (v : [(a, b)]) : ([a], [b]) = (map (\p -> fst p) v, map (\p -> snd p) v)

@pub fun maximum (v : [a]) : Maybe a =
  foldl
    (\acc x ->
      match acc with
      | None -> Just x
      | Just m -> if m < x then Just x else acc)
    None
    v

@pub fun minimum (v : [a]) : Maybe a =
  foldl
    (\acc x ->
      match acc with
      | None -> Just x
      | Just m -> if x < m then Just x else acc)
    None
    v

-- Yield every element, in order, for `Std.Stream`.
@pub fun toStream (v : [a]) : () ! { Yield a | e } = forEach (\x -> yield x) v

-- --- rendering ---------------------------------------------------------------

-- `[1, 2, 3]`, the way a vector is written, each element as `render` says.
fun renderWith render v =
  let items =
    foldl
      (\acc x ->
        match acc with
        | None -> Just (render x)
        | Just s -> Just (concatStrings #[s, ", ", render x]))
      None
      v
  in match items with
     | None -> "[]"
     | Just s -> concatStrings #["[", s, "]"]

impl Debug [a] where Debug a {
  fun debug v = renderWith debug v
}

impl Display [a] where Display a {
  fun display v = renderWith display v
}

-- --- comparing ---------------------------------------------------------------

-- By their elements, as an array is: two vectors of the same elements are equal
-- however they were built, and the first element that differs orders them.

impl PartialEq [a] where PartialEq a {
  fun (==) x y = toArray x == toArray y
}

impl Eq [a] where Eq a {}

impl PartialOrd [a] where PartialOrd a {
  fun partialCmp x y = partialCmp (toArray x) (toArray y)
}

impl Ord [a] where Ord a {
  fun compare x y = compare (toArray x) (toArray y)
}

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe.Maybe.*
use Std.Yield (Yield)

@test fun buildingAndObserving () =
  let a = assertEq (len empty) 0 "len of empty" in
  let b = assertTrue (isEmpty empty) "isEmpty" in
  let c = assertEq (len [1, 2, 3]) 3 "len" in
  let d = assertEq (toList [1, 2, 3]) [1; 2; 3] "toList" in
  assertEq (toArray [1, 2, 3]) #[1, 2, 3] "toArray"

@test fun indexedAccessIsBoundsChecked () =
  let a = assertEq (get [1, 2, 3] 1) (Just 2) "get" in
  let b = assertEq (get [1, 2, 3] 3) None "past the end" in
  let c = assertEq (get [1, 2, 3] (0 - 1)) None "before the start" in
  let d = assertEq (getOr 0 [1, 2, 3] 9) 0 "getOr" in
  let e = assertEq (head [1, 2]) (Just 1) "head" in
  let f = assertEq (last [1, 2]) (Just 2) "last" in
  assertEq (head empty) None "head of empty"

@test fun bothEndsPushAndPop () =
  let a = assertEq (toList (pushBack [1, 2] 3)) [1; 2; 3] "pushBack" in
  let b = assertEq (toList (pushFront [2, 3] 1)) [1; 2; 3] "pushFront" in
  let c = assertEq (toList (popBack [1, 2, 3])) [1; 2] "popBack" in
  assertEq (toList (popFront [1, 2, 3])) [2; 3] "popFront"

@test fun anEmptiedVectorIsTheEmptyVector () =
  -- `[]` is the `Empty` pattern, and the library keeps that the only shape an
  -- empty vector can take -- every path that empties one has to normalise.
  let a = assertTrue (isEmpty (popBack [1])) "popBack to empty" in
  let b = assertTrue (isEmpty (popFront [1])) "popFront to empty" in
  let c = assertTrue (isEmpty (drop [1, 2, 3] 3)) "drop everything" in
  let d = assertTrue (isEmpty (take [1, 2, 3] 0)) "take nothing" in
  assertTrue (isEmpty (filter (\x -> x > 9) [1, 2, 3])) "filter everything out"

@test fun sliceTakeDropAndSplit () =
  let a = assertEq (toList (slice [1, 2, 3, 4] 1 3)) [2; 3] "slice" in
  let b = assertEq (toList (take [1, 2, 3] 2)) [1; 2] "take" in
  let c = assertEq (toList (drop [1, 2, 3] 2)) [3;] "drop" in
  let (l, r) = splitAt [1, 2, 3] 1 in
  let d = assertEq (toList l) [1;] "splitAt left" in
  assertEq (toList r) [2; 3] "splitAt right"

@test fun mapFilterAndFolds () =
  let a = assertEq (toList (map (\n -> n * 2) [1, 2, 3])) [2; 4; 6] "map" in
  let b = assertEq (toList (filter (\n -> n > 1) [1, 2, 3])) [2; 3] "filter" in
  let c = assertEq (foldl (\acc n -> acc - n) 10 [1, 2]) 7 "foldl" in
  let d = assertEq (foldr (\n acc -> n - acc) 0 [1, 2]) (0 - 1) "foldr" in
  assertEq (toList (reverse [1, 2, 3])) [3; 2; 1] "reverse"

@test fun appendAndSet () =
  let a = assertEq (toList (append [1, 2] [3, 4])) [1; 2; 3; 4] "append" in
  let b = assertEq (toList (append empty [1, 2])) [1; 2] "append onto empty" in
  assertEq (toList (set [1, 2, 3] 1 9)) [1; 9; 3] "set"

@test fun aVectorSurvivesBeingGrownPastOneChunk () =
  -- 40 elements is more than `vWidth`, so this exercises the tree rather than
  -- the single-chunk representation.
  let big = foldl (\v n -> pushBack v n) empty (range 0 40) in
  let a = assertEq (len big) 40 "length after many pushes" in
  let b = assertEq (get big 0) (Just 0) "first" in
  let c = assertEq (get big 39) (Just 39) "last" in
  assertEq (toList (take big 3)) [0; 1; 2] "still indexable"

@test fun aLargeVectorIsWalkedWhereItStands () =
  -- 5,000 elements: every part of a vector, and a middle tree two levels deep.
  let n = 5000 in
  let big = pushFront (range 1 n) 0 in
  let a =
    assertEq (foldl (\acc x -> acc + x) 0 big) (n * (n - 1) / 2) "a left fold reads every element"
  in
  let b = assertEq (foldl (\acc x -> x) 0 big) (n - 1) "in order" in
  let c = assertEq (foldr (\x acc -> x) 0 big) 0 "and a right fold from the other end" in
  let d =
    assertEq (find (\x -> x >= 2500) big) (Just 2500) "a search finds the first, in the middle"
  in
  let e = assertEq (find (\x -> x == n - 1) big) (Just (n - 1)) "or at the very end" in
  let f = assertEq (find (\x -> x < 0) big) None "or nowhere" in
  let g = assertTrue (elem 4999 big and notElem n big) "elem" in
  let h = assertTrue (all (\x -> x >= 0) big and any (\x -> x == 3) big) "all and any" in
  let i = assertEq (len (filter (\x -> x % 2 == 0) big)) (n / 2) "filter" in
  -- Popped from the back until nothing is left, each element met once.
  let rec back v acc =
    if isEmpty v then acc else back (take v (len v - 1)) (acc + getOr 0 v (len v - 1))
  in
  let j = assertEq (back big 0) (n * (n - 1) / 2) "all but the last, over and over" in
  let rec front v acc = if isEmpty v then acc else front (drop v 1) (acc + getOr 0 v 0) in
  let k = assertEq (front big 0) (n * (n - 1) / 2) "all but the first, over and over" in
  assertEq
    (toList (append (take big 3) (drop big (n - 2))))
    [0; 1; 2; n - 2; n - 1]
    "and the ends agree"

@test fun theQueryHelpers () =
  let a = assertEq (sum [1, 2, 3]) 6 "sum" in
  let b = assertEq (product [2, 3]) 6 "product" in
  let c = assertTrue (all (\n -> n > 0) [1, 2]) "all" in
  let d = assertTrue (any (\n -> n > 1) [1, 2]) "any" in
  let e = assertEq (find (\n -> n > 1) [1, 2, 3]) (Just 2) "find" in
  let f = assertEq (find (\n -> n > 9) [1, 2]) None "find nothing" in
  let g = assertTrue (elem 2 [1, 2]) "elem" in
  let h = assertEq (maximum [1, 3, 2]) (Just 3) "maximum" in
  assertEq (minimum [3, 1, 2]) (Just 1) "minimum"

@test fun zipUnzipAndPartition () =
  let a = assertEq (toList (zip [1, 2] ["a", "b"])) [(1, "a"); (2, "b")] "zip" in
  let b = assertEq (toList (zipWith (\x y -> x + y) [1, 2] [10, 20])) [11; 22] "zipWith" in
  -- `zip` stops at the shorter side.
  let c = assertEq (len (zip [1, 2, 3] [1])) 1 "zip of unequal lengths" in
  let (evens, odds) = partition (\n -> n % 2 == 0) [1, 2, 3, 4] in
  let d = assertEq (toList evens) [2; 4] "partition kept" in
  assertEq (toList odds) [1; 3] "partition dropped"

@test fun rangeAndReplicate () =
  let a = assertEq (toList (range 1 4)) [1; 2; 3] "range is half-open" in
  let b = assertTrue (isEmpty (range 4 1)) "an empty range" in
  assertEq (toList (replicate 3 "x")) ["x"; "x"; "x"] "replicate"

@test fun takeWhileDropWhileAndConcat () =
  let a = assertEq (toList (takeWhile (\n -> n < 3) [1, 2, 3, 1])) [1; 2] "takeWhile stops" in
  let b = assertEq (toList (dropWhile (\n -> n < 3) [1, 2, 3, 1])) [3; 1] "dropWhile" in
  let c = assertEq (toList (concat [[1, 2], [3]])) [1; 2; 3] "concat" in
  assertEq (toList (concatMap (\n -> [n, n]) [1, 2])) [1; 1; 2; 2] "concatMap"

@test fun intersperseAndIntercalate () =
  let a = assertEq (toList (intersperse 0 [1, 2, 3])) [1; 0; 2; 0; 3] "between each two" in
  let b = assertEq (toList (intersperse 0 [7])) [7;] "one has nothing between" in
  let c = assertTrue (isEmpty (intersperse 0 empty)) "none is none" in
  let d =
    assertEq (toList (intercalate [0, 0] [[1, 2], [3], [4]])) [1; 2; 0; 0; 3; 0; 0; 4] "joined"
  in assertTrue (isEmpty (intercalate [0] empty)) "nothing to join"
