-- Std.Thread: green threads, each with a heap of its own, and channels between
-- them.
--
--   use Std.Thread as Thread
--
--   fun fib (n : Int) = if n < 2 then n else fib (n - 1) + fib (n - 2)
--
--   fun main () =
--     let a = Thread.spawn (\() -> fib 30) in
--     let b = Thread.spawn (\() -> fib 31) in
--     println (Thread.await a + Thread.await b)
--
-- A thread is cheap -- a small heap and a register file -- so a program can
-- have a great many. The runtime runs them on every core, moving each between
-- OS threads as it likes; a program never sees an OS thread. A thread that runs
-- for a long time without waiting is interrupted now and then so the others get
-- a turn.
--
-- Threads share nothing mutable. Each has its own heap, and a value reaches
-- another thread only as a copy: the function a thread is spawned with (and
-- everything it captures), a message sent on a channel, and the result `await`
-- hands back. Immutable data copies without anyone being able to tell, so
-- this is invisible until something mutable would cross -- a `Ref`, a
-- mutable array -- and that is refused at run time. So is a continuation.
--
-- To share a large value between threads cheaply, compact it: a `Compact` is
-- not copied when it crosses. Its region belongs to no thread, and every thread
-- that has it reads the same one.
--
-- What a thread may do is in its type. It starts with no handlers, so it may
-- perform only what the runtime itself answers -- `Console`, `Fs`, `Process`,
-- `Random`, `Time`, `Test`, `Mut` and `Thread` -- and any other effect it uses
-- has to be handled inside the thread. A `spawn` whose function would perform
-- one of the spawning thread's own effects is a type error, not a surprise
-- later.
--
-- The program ends when `main` does. Threads still running then are stopped. If
-- every thread is waiting -- on a channel nobody will send to, or on another
-- waiting thread -- that is a deadlock, and an error.
--
-- A failure in a thread fails that thread, and `await` fails with the same
-- message. Nothing else is affected.
--
-- A thread can be asked to stop, with `cancel`. Where it stops depends on what
-- it is doing:
--
-- * At an operation, softly. Its next operation the runtime answers -- one of
--   this module's, the wait of a transaction's `retry`, or one of `Console`,
--   `Fs`, `Net`, `Time`, `Random`, `Process`, `Log` or `Test` -- fails with
--   "cancelled", as a thread fails at a division by zero. A thread waiting in
--   one -- on a channel, on another thread, on a socket -- is woken to fail. A
--   worker loop that does any I/O stops at its next step, with nobody having
--   had to remember to check.
-- * At a preemption point, hard. A thread that performs nothing -- a pure
--   loop -- is ended where the runtime would have preempted it, a little
--   while after the cancel: long enough for one that was about to perform an
--   operation, or to ask, to stop there instead.
--
-- Either way `await` of it fails with "cancelled", and nothing of the thread's
-- own code runs after -- only its releases (see "cleanup" below), which is
-- where it says what to do on the way out. No handler -- `Std.Exn`'s `catch`
-- among them -- can catch the failure and carry on. That is safe because
-- threads share nothing mutable, so a thread stopped part way leaves nobody
-- else's state half made. And no code is ever cut short between two of its
-- operations in a way it could notice, so no cleanup has to guard against a
-- cancel arriving in the middle of it, and there is nothing to mask.
--
-- A thread that would rather stop on its own terms asks, with `cancelled`.
-- Told yes, it has taken the cancel on itself: it is no longer ended at a
-- preemption point, and may return what it has -- which is then what `await`
-- answers. Cancelling a thread that has finished changes nothing, and asking
-- twice is asking once.
--
-- A thread in `Time.sleep` waits on the runtime's timer, not on a core, so
-- it is woken by a cancel like any waiting thread, and a program may have
-- thousands of them asleep at once.
--
-- Two limits. An operation made in place -- a file read, a child process run
-- to its end -- runs to its end first; the thread fails at the operation
-- after. And a socket wait the thread is woken from carries on, on its own
-- I/O thread, until it ends; what it answers is dropped.

use Std.Collections.Vector as V
use Std.Collections.Vector (vecFromArray)
use Std.Either (Either)
use Std.Either.Either.*
use Std.Maybe.Maybe.*
use Std.Time (sleep)

-- Start running `f ()` on a thread of its own.
@pub fun spawn (f : () -> a ! e) : Task a ! { Thread | r } = threadSpawn f

-- Wait for a thread to finish, and take a copy of its result. If the thread
-- failed, so does this, with the same message. A thread may be awaited any
-- number of times, by any number of threads.
@pub fun await (t : Task a) : a ! { Thread | e } = threadAwait t

-- Let other threads run before this one carries on.
@pub fun yieldNow () : () ! { Thread | e } = threadYield ()

-- A new channel. Any thread holding it may send and receive; values come out in
-- the order they went in.
@pub fun newChannel () : Channel a ! { Thread | e } = channelNew ()

-- Send a copy of `x`. Never waits: a channel holds as many values as are sent.
@pub fun send (ch : Channel a) (x : a) : () ! { Thread | e } = channelSend ch x

-- The oldest value sent and not yet received, waiting for one if there is none.
-- Each value goes to exactly one receiver.
@pub fun receive (ch : Channel a) : a ! { Thread | e } = channelReceive ch

-- Ask a thread to stop: it fails with "cancelled" at its next operation the
-- runtime answers, at once if it is waiting in one, or soon after at a
-- preemption point if it performs none. Returns at once. A thread that has
-- finished is left as it was.
@pub fun cancel (t : Task a) : () ! { Thread | e } = threadCancel t

-- Whether this thread has been asked to stop. The one operation that does not
-- fail when it has; told yes, the thread is no longer ended at a preemption
-- point, so a long computation that asks can end early with what it has.
@pub fun cancelled () : Bool ! { Thread | e } = threadCancelled ()

-- --- built on those ----------------------------------------------------------

-- Run both at once, and both answers.
@pub fun both (f : () -> a ! e) (g : () -> b ! e) : (a, b) ! { Thread | r } =
  let a = spawn f in
  let b = spawn g in
  (await a, await b)

-- Wait for every thread, in order.
@pub fun awaitAll (ts : [Task a]) : [a] ! { Thread | e } = V.map (\t -> await t) ts

-- `map`, with each element on its own thread.
@pub fun parMap (f : a -> b ! e) (xs : [a]) : [b] ! { Thread | r } =
  xs |> V.map (\x -> spawn (\() -> f x)) |> awaitAll

-- --- cleanup -----------------------------------------------------------------
--
-- What a thread acquires, it can say how to release: a temporary file to
-- remove, a peer to tell, a lock file to delete. Each thread has a stack of
-- releases, and one runs at the first of:
--
-- * the `bracket` (or `finally`) that registered it ends, which also takes
--   back whatever was registered inside it and is still there;
-- * the thread ends, however it ends -- returning, failing, cancelled -- when
--   the runtime runs every release still on the stack before `await` sees
--   the end.
--
-- Always the newest first. A release performs only what the runtime answers,
-- as a spawned function does: on the way out of a failure no handler is left
-- to answer anything else, and the type says so. Run in place, at the end of
-- its bracket, it sees the handlers around it, of the runtime's effects; on
-- the way out, the runtime answers it.
--
-- A cancel waits for a release: its operations answer, and its waits are not
-- broken into, so cleanup is not cut short. In a cancelled thread a release
-- that runs on and on is still ended, a while later than other code, and the
-- next one runs. A release that fails ends only itself; a thread that had
-- succeeded then fails with what its release failed with.
--
-- A handler that drops the rest of a computation -- `Std.Exn`'s `toResult`,
-- when something is raised -- leaves the brackets inside it unfinished: what
-- they registered is released when the bracket around them ends, or the
-- thread does. So nothing outlives the bracket it was acquired in. Threads
-- still running when `main` returns stop with the program, and are not
-- unwound; to have theirs run, cancel and await them first.
--
-- `docs/CANCELLATION.md` has the reasons.

-- `act` on what `acquire` gives, and `release` of it afterwards: when `act`
-- returns, or when the thread ends without its having -- see above.
@pub fun bracket
    (acquire : () -> r ! { Thread | e })
    (release : r -> () ! x)
    (act : r -> a ! { Thread | e })
    : a ! { Thread | e } =
  let it = acquire () in
  let key = threadDefer (\() -> release it) in
  let out = act it in
  let _ = releaseFrom key False in
  out

-- `act`, and `release` afterwards, however `act` ends.
@pub fun finally (release : () -> () ! x) (act : () -> a ! { Thread | e }) : a ! { Thread | e } =
  bracket (\() -> ()) (\u -> release ()) (\u -> act ())

-- `release` at the end of the innermost `bracket` or `finally` around this,
-- or of the thread if there is none.
@pub fun defer (release : () -> () ! x) : () ! { Thread | e } = let _ = threadDefer release in ()

-- Take back, newest first, the releases registered since `key` that are still
-- there, and run each in place; `after` says one taken back has run.
fun releaseFrom (key : Int) (after : Bool) : () ! { Thread | e } =
  match threadTake key after with
  | Just release -> let _ = release () in releaseFrom key True
  | None -> ()

-- --- racing ------------------------------------------------------------------

-- `f` and `g`, each on a thread of its own: whichever ends first decides, its
-- answer as `Left` or `Right` -- or, if it failed, `race` fails as it did. The
-- other is cancelled, and `race` returns once it has run its releases. Since
-- they run on threads of their own, `f` and `g` may perform only what the
-- runtime answers, as for `spawn`.
@pub fun race (f : () -> a ! e) (g : () -> b ! e) : Either a b ! { Thread | r } =
  finally (\() -> ()) (\() ->
    let ended = newChannel () in
    let left = spawn (\() -> finally (\() -> send ended True) f) in
    let _ = defer (\() -> cancel left) in
    let right = spawn (\() -> finally (\() -> send ended False) g) in
    let _ = defer (\() -> cancel right) in
    let first = receive ended in
    let _ = if first then cancel right else cancel left in
    let _ = receive ended in
    if first then Left (await left) else Right (await right))

-- `Just` what `act` answers, or `None` if it has not answered within `ms`
-- milliseconds, when it is cancelled. As `race`, `act` runs on a thread of
-- its own, so it performs only what the runtime answers.
@pub fun timeout (ms : Int) (act : () -> a ! e) : Maybe a ! { Thread | r } =
  match race act (\() -> sleep ms) with
  | Left x -> Just x
  | Right _ -> None

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)
use Std.Exn (toResult, raise)

fun fib (n : Int) = if n < 2 then n else fib (n - 1) + fib (n - 2)

@test fun aThreadAnswersThroughAwait () =
  let t = spawn (\() -> fib 15) in
  assertEq (await t) 610 "fib 15"

@test fun awaitingTwiceGivesTheSameAnswer () =
  let t = spawn (\() -> [1, 2, 3]) in
  let a = await t in
  assertEq (await t) a "the result is kept"

@test fun bothRunsBoth () =
  assertEq (both (\() -> fib 10) (\() -> "done")) (55, "done") "two answers"

@test fun parMapKeepsTheOrder () =
  assertEq (parMap (\n -> n * n) [1, 2, 3, 4, 5]) [1, 4, 9, 16, 25] "in order"

@test fun aChannelDeliversInOrder () =
  let ch = newChannel () in
  let _ = send ch "a" in
  let _ = send ch "b" in
  let first = receive ch in
  assertEq (first, receive ch) ("a", "b") "first in, first out"

@test fun aReceiverWaitsForASender () =
  let ch = newChannel () in
  let reader = spawn (\() -> receive ch + receive ch) in
  let _ = yieldNow () in
  let _ = send ch (toInt 20) in
  let _ = send ch (toInt 22) in
  assertEq (await reader) 42 "sum of what arrived"

@test fun threadsTalkBothWays () =
  let requests = newChannel () in
  let replies = newChannel () in
  let server =
    spawn (\() ->
      let rec serve (k : Int) =
        if k == 0 then ()
        else
          let n = receive requests in
          let _ = send replies (n * 2) in
          serve (k - 1)
      in serve 3)
  in
  let ask n = let _ = send requests n in receive replies in
  let answers = [ask 1, ask 2, ask 3] in
  let _ = await server in
  assertEq answers [2, 4, 6] "each request answered"

@test fun manyThreads () =
  let ts = V.map (\i -> spawn (\() -> i + 1)) (V.range (toInt 0) 1000) in
  assertEq (V.foldl (\acc t -> acc + await t) 0 ts) 500500 "a thousand threads"

@test fun manySleepersAtOnce () =
  -- Asleep on the runtime's timer, not on the test's two workers: a tenth of
  -- a second in all, not ten.
  let ts = V.map (\i -> spawn (\() -> let _ = sleep 50 in i)) (V.range (toInt 0) 200) in
  assertEq (V.foldl (\acc t -> acc + await t) 0 ts) 19900 "every sleeper woke"

effect Tally {
  tally : Int -> ()
}

fun countUp (n : Int) = if n == 0 then () else let _ = tally n in countUp (n - 1)

@test fun cancellingAFinishedThreadChangesNothing () =
  let t = spawn (\() -> fib 10) in
  let first = await t in
  let _ = cancel t in
  let _ = cancel t in
  assertEq (first, await t) (55, 55) "the answer is kept"

@test fun aThreadThatAsksStopsWhenAsked () =
  let t =
    spawn (\() ->
      let rec spin (n : Int) = if cancelled () then n else spin (n + 1) in
      spin 0)
  in
  let _ = cancel t in
  assertTrue (await t >= 0) "it returned what it had"

@test fun nobodyIsCancelledUnasked () =
  let t = spawn (\() -> cancelled ()) in
  assertEq (await t, cancelled ()) (False, False) "neither thread was asked"

@test fun cancelledReceiversLeaveTheMessageAlone () =
  -- Every reader is cancelled, waiting or not yet started; none of them may
  -- take what is sent after, so it is still there for this thread.
  let gate = newChannel () in
  let readers = V.map (\i -> spawn (\() -> receive gate + i)) (V.range (toInt 0) 100) in
  let _ = V.forEach (\t -> cancel t) readers in
  let _ = send gate (toInt 42) in
  assertEq (receive gate) 42 "nobody else took it"

@test fun aThreadMayHandleItsOwnEffects () =
  -- `Tally` is not one the runtime answers, so the thread handles it itself,
  -- and its type is none the wiser.
  let t =
    spawn (\() ->
      let total = newRef (toInt 0) in
      let _ =
        handle countUp 4 with { tally n k -> let _ = setRef total (getRef total + n) in k () }
      in getRef total)
  in assertTrue (await t == 10) "handled inside the thread"

-- A note in a log of digits, newest last: what order releases ran in.
fun note (log : Ref Int) (n : Int) = setRef log (getRef log * 10 + n)

@test fun releasesRunNewestFirstWhenBracketsEnd () =
  let log = newRef (toInt 0) in
  let sum =
    bracket (\() -> 1) (\n -> note log n) (\a ->
      bracket (\() -> 2) (\n -> note log n) (\b -> let _ = defer (\() -> note log 3) in a + b))
  in assertEq (sum, getRef log) (3, 321) "inner first, the deferred one before both"

@test fun aReleaseRunsWhenItsThreadFails () =
  let told = newChannel () in
  let t =
    spawn (\() ->
      finally (\() -> send told "first") (\() ->
        finally (\() -> send told "second") (\() -> toInt 1 / toInt 0)))
  in
  let a = receive told in
  assertEq (a, receive told) ("second", "first") "both ran, newest first"

@test fun aReleaseRunsWhenItsThreadIsCancelled () =
  let told = newChannel () in
  let never = newChannel () in
  let t = spawn (\() -> finally (\() -> send told "released") (\() -> receive never + toInt 1)) in
  let _ = cancel t in
  assertEq (receive told) "released" "the cancelled thread ran its release"

@test fun aDroppedContinuationIsReleasedByTheBracketAroundIt () =
  -- `toResult` drops the rest of the inner bracket's `act`: its release runs
  -- when the outer one ends, before the outer's own.
  let log = newRef (toInt 0) in
  let _ =
    finally (\() -> note log 1) (\() ->
      let r = toResult (\() -> bracket (\() -> ()) (\u -> note log 2) (\u -> raise "dropped")) in
      note log 3)
  in assertEq (getRef log) 321 "the dropped one at the end of the one around it"

@test fun aFastActionIsNotTimedOut () =
  assertEq (timeout 60000 (\() -> fib 10)) (Just 55) "answered in time"

@test fun aSlowActionIsTimedOutAndStopped () =
  -- Asleep for an hour, unless the cancel wakes it.
  assertEq (timeout 20 (\() -> let _ = sleep 3600000 in toInt 1)) None "given up on, and woken"

@test fun raceAnswersWhicheverEndsFirst () =
  let gate = newChannel () in
  let r = race (\() -> receive gate) (\() -> "quick") in
  assertEq r (Right "quick") "the one that could end"
