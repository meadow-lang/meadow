-- Std.Test: assertions for `@test` functions.
--
-- Mark a test with `@test` and `meadow test` will call it with `()`:
--
--   use Std.Test (assertEq)
--
--   @test fun addition () = assertEq (2 + 2) 4 "2 + 2"
--
-- A failure is the `Test` effect, not a return value, so an assertion in a
-- helper five calls deep still stops the test and still names itself. With no
-- handler in the way the runner discharges `fail` for you; a `handle` takes
-- precedence, which is how `refute` below checks that something *does* fail.

-- This module depends on nothing, deliberately. It is compiled first so that
-- every other `Std` module can carry its own `@test` functions, which means it
-- cannot use `Std.String` for its messages -- hence `cat` below, built from the
-- string primitives, rather than `String.concat`.

@pub effect Test {
  -- Abandon the current test with this message. Never returns.
  fail : String -> (),
}

-- Checking a property on many values a generator makes, and on mutated
-- text: each needs more of the library than this module may.
@pub mod Property
@pub mod Fuzz

-- --- assertions --------------------------------------------------------------

@pub fun assert (cond : Bool) (msg : String) : () ! { Test | e } = if cond then () else fail msg

@pub fun refuteThat (cond : Bool) (msg : String) : () ! { Test | e } =
  if cond then fail (cat "expected false: " msg) else ()

-- Both equality and `show` are structural and work at any type, so this is the
-- assertion to reach for: the message names what was being checked and the
-- values speak for themselves.
@pub fun assertEq (actual : a) (expected : a) (msg : String) : () ! { Test | e } =
  if actual == expected then ()
  else fail (cat (cat (cat (cat msg ": expected ") (show expected)) ", got ") (show actual))

@pub fun assertNeq (actual : a) (unexpected : a) (msg : String) : () ! { Test | e } =
  if actual != unexpected then ()
  else fail (cat (cat msg ": expected anything but ") (show unexpected))

@pub fun assertTrue (actual : Bool) (msg : String) : () ! { Test | e } = assertEq actual True msg

@pub fun assertFalse (actual : Bool) (msg : String) : () ! { Test | e } = assertEq actual False msg

-- Fail unconditionally -- for the arm of a `match` that should be unreachable.
@pub fun failWith (msg : String) : () ! { Test | e } = fail msg

-- --- checking that something fails -------------------------------------------

-- Run `act` and report whether it failed an assertion. This is the one place the
-- `Test` effect is handled rather than left to the runner, and it is what lets
-- `Std.Test` test itself.
@pub fun didFail (act : () -> a ! { Test | e }) : Bool ! e =
  handle act () with { fail msg k -> True, return x -> False }

-- Run `act` and say whether it failed an assertion, and with what message:
-- `didFail`, for whoever goes on to say more about the failure -- a property
-- that names the value it failed on.
@pub fun failure (act : () -> a ! { Test | e }) : (Bool, String) ! e =
  handle act () with { fail msg k -> (True, msg), return x -> (False, "") }

-- `act` must fail; if it succeeds, *this* is the failure.
@pub fun assertFails (act : () -> a ! { Test, Test | e }) (msg : String) : () ! { Test | e } =
  assert (didFail act) (cat "expected a failure: " msg)

-- `String.concat`, spelled out from the primitives. `Std.String` is compiled
-- long after this module and cannot be reached from here.
fun cat a b = bytesToString (arrayConcat (stringToBytes a) (stringToBytes b))

-- --- tests -------------------------------------------------------------------
--
-- `Std.Test` can test itself because `didFail` handles the effect rather than
-- leaving it to the runner.

@test fun assertionsPassWhenTheyShould () =
  let a = assert True "assert" in
  let b = assertEq 1 1 "assertEq" in
  let c = assertNeq 1 2 "assertNeq" in
  let d = assertTrue True "assertTrue" in
  let e = assertFalse False "assertFalse" in
  refuteThat False "refuteThat"

@test fun assertionsFailWhenTheyShould () =
  let a = assertTrue (didFail (\u2 -> assert False "x")) "assert False" in
  let b = assertTrue (didFail (\u2 -> assertEq 1 2 "x")) "assertEq of different values" in
  let c = assertTrue (didFail (\u2 -> assertNeq 1 1 "x")) "assertNeq of equal values" in
  let d = assertTrue (didFail (\u2 -> assertTrue False "x")) "assertTrue False" in
  let e = assertTrue (didFail (\u2 -> failWith "x")) "failWith" in
  assertTrue (didFail (\u2 -> refuteThat True "x")) "refuteThat True"

@test fun didFailIsFalseForSomethingThatSucceeds () =
  assertFalse (didFail (\u2 -> assertEq 1 1 "fine")) "no failure"

@test fun equalityIsStructuralSoAssertEqWorksAtAnyType () =
  let a = assertEq "a" "a" "strings" in
  let b = assertEq (1, "a") (1, "a") "tuples" in
  let c = assertEq [1; 2] [1; 2] "lists" in
  -- No `Just` here: this module is compiled before `Std.Maybe`, deliberately,
  -- so that every module below can carry tests.
  let d = assertEq True True "booleans" in
  assertTrue (didFail (\u2 -> assertEq [1; 2] [1; 3] "x")) "and tells them apart"

@test fun aFailureUnwindsPastWhateverIsInBetween () =
  -- The point of using an effect rather than a return value: an assertion in a
  -- helper stops the test, it does not return a value the caller must check.
  let deep = \u2 -> 1 + (2 * inner ()) in
  assertTrue (didFail deep) "the failure came from three calls down"

fun inner () = let ignored = assertEq 1 2 "inner" in 0

@test fun assertFailsChecksThatSomethingFails () =
  assertFails (\u2 -> failWith "expected") "failWith should fail"
