-- Std.String: operations on `String`.
--
-- A `String` is UTF-8 text on the heap. Offsets and lengths are counted in
-- **bytes**, not characters: exact for ASCII, and byte-oriented above U+007F.
-- The primitives underneath -- `stringByteLength`, `stringByteAt`,
-- `stringSlice`, `stringIndexOf`, `concatStrings` -- read a string where it
-- is, so a length or a byte costs nothing and a slice costs what it takes.
-- A slice through the middle of a character comes out with U+FFFD in its
-- place, so `slice` and friends want offsets you got from `indexOf` or from a
-- parser, not ones you guessed.
--
-- `Std.String.Parse` builds parser combinators on top of this.
--
-- Note on ordering: every definition precedes its first use, because a forward
-- reference between top-level bindings currently loses all type information.

@pub mod Parse

use Std.Collections.Vector as V (vecFromArray)
use Std.St as St
use Std.Num.Int (min, max)
use Std.Maybe.Maybe.*
use Std.Ordering.Ordering.*

-- ---------------------------------------------------------------------------
-- Bytes in, bytes out
-- ---------------------------------------------------------------------------

-- The UTF-8 bytes of `s`.
@pub fun toBytes (s : String) : #[UInt8] = stringToBytes s

-- A string from UTF-8 `bytes`.
@pub fun fromBytes (bytes : #[UInt8]) : String = bytesToString bytes

-- How many *bytes* `s` occupies.
@pub fun byteLength (s : String) : Int = stringByteLength s

@pub fun isEmpty (s : String) : Bool = byteLength s == 0

-- ---------------------------------------------------------------------------
-- Building
-- ---------------------------------------------------------------------------

-- `a` followed by `b`.
@pub fun concat (a : String) (b : String) : String = concatStrings #[a, b]

-- `a ++ b` is `concat a b`. In the prelude, so it is in scope everywhere.
@pub def (++) : String -> String -> String = concat

-- Every string in `xs`, run together, in one allocation.
@pub fun concatAll (xs : [String]) : String = concatStrings (V.toArray xs)

fun joinLoop sep acc i xs =
  if i >= V.len xs then acc
  else
    let piece = V.getOr "" xs i in
    let next = if i == 0 then V.pushBack acc piece else V.pushBack (V.pushBack acc sep) piece in
    joinLoop sep next (i + 1) xs

-- Every string in `xs`, with `sep` between them.
@pub fun join (sep : String) (xs : [String]) : String =
  joinLoop sep V.empty 0 xs |> V.toArray |> concatStrings

-- The same, by the name a vector's and a list's have: `intercalate ", "
-- ["a", "b"]` is `"a, b"`. The prelude's.
@pub fun intercalate (sep : String) (xs : [String]) : String = join sep xs

fun repeatLoop acc s n = if n <= 0 then acc else repeatLoop (V.pushBack acc s) s (n - 1)

-- `s` repeated `n` times.
@pub fun repeat (s : String) (n : n) : String = repeatLoop V.empty s n |> V.toArray |> concatStrings

-- ---------------------------------------------------------------------------
-- Taking it apart
-- ---------------------------------------------------------------------------

-- The bytes of `s` from `from` up to (not including) `to`, clamped to the ends.
@pub fun slice (s : String) (from : Int) (to : Int) : String = stringSlice s from to

-- The first `n` bytes.
@pub fun take (s : String) (n : Int) : String = slice s 0 n

-- Everything after the first `n` bytes.
@pub fun drop (s : String) (n : Int) : String = slice s n (byteLength s)

-- The byte at `i`, if there is one.
@pub fun byteAt (s : String) (i : Int) : Maybe UInt8 =
  if i < 0 or i >= byteLength s then None else Just (stringByteAt s i)

-- ---------------------------------------------------------------------------
-- Searching
-- ---------------------------------------------------------------------------

-- The byte offset of the first `needle` in `s` at or after byte `from`, if it
-- is there.
@pub fun indexOfFrom (needle : String) (s : String) (from : Int) : Maybe Int =
  let i = stringIndexOf s needle from in
  if i < 0 then None else Just i

-- The byte offset of the first `needle` in `s`, if it is there. An empty needle
-- is found at 0.
@pub fun indexOf (needle : String) (s : String) : Maybe Int = indexOfFrom needle s 0

@pub fun contains (needle : String) (s : String) : Bool = stringIndexOf s needle 0 >= 0

@pub fun startsWith (prefix : String) (s : String) : Bool =
  let n = byteLength prefix in
  if n > byteLength s then False else slice s 0 n == prefix

@pub fun endsWith (suffix : String) (s : String) : Bool =
  let n = byteLength suffix in
  let m = byteLength s in
  if n > m then False else slice s (m - n) m == suffix

-- How many pieces `s` cuts into at `sep`, from byte `i`, counting `n` so far.
fun pieces s sep i n =
  let k = stringIndexOf s sep i in
  if k < 0 then n else pieces s sep (k + byteLength sep) (n + 1)

-- The pieces of `s` from byte `i`, into `out` from index `j`.
fun cutInto s sep i j out =
  let k = stringIndexOf s sep i in
  if k < 0 then St.set out j (slice s i (byteLength s))
  else
    let _ = St.set out j (slice s i k) in
    cutInto s sep (k + byteLength sep) (j + 1) out

-- `s` cut at every occurrence of `sep`. An empty `sep` yields `s` whole, since
-- splitting on nothing has no useful answer.
--
-- Two passes: count the pieces, then cut them into an array of exactly that
-- many and make the vector from it in one go -- rather than growing a vector
-- a piece at a time, which copied its tail for every piece.
@pub fun split (sep : String) (s : String) : [String] =
  if isEmpty sep then [s]
  else
    runSt (\() ->
      let out = St.newArray (pieces s sep 0 1) "" in
      let _ = cutInto s sep 0 0 out in
      V.fromArray (St.freeze out))

-- ---------------------------------------------------------------------------
-- Ordering
-- ---------------------------------------------------------------------------

-- How `a` sorts against `b`: byte by byte, which for UTF-8 is the order of the
-- characters' code points, and a prefix before what it prefixes. What
-- `Std.Sort.sortBy S.compare` and an ordered map keyed by names want.
@pub fun compare (a : String) (b : String) : Ordering =
  match stringCompare a b with
  | n if n < 0 -> Less
  | 0 -> Equal
  | _ -> Greater

@pub fun lessThan (a : String) (b : String) : Bool = stringCompare a b < 0

@pub fun lessOrEqual (a : String) (b : String) : Bool = stringCompare a b <= 0

@pub fun greaterThan (a : String) (b : String) : Bool = stringCompare a b > 0

@pub fun greaterOrEqual (a : String) (b : String) : Bool = stringCompare a b >= 0

-- The one that sorts first, and the one that sorts last.
@pub fun minOf (a : String) (b : String) : String = if stringCompare b a < 0 then b else a

@pub fun maxOf (a : String) (b : String) : String = if stringCompare b a > 0 then b else a

-- ---------------------------------------------------------------------------
-- Whitespace
-- ---------------------------------------------------------------------------

-- Space, tab, newline, carriage return.
@pub fun isSpaceByte (c : UInt8) = c == 32 or c == 9 or c == 10 or c == 13

fun startOfText s i =
  if i >= byteLength s then i
  else if isSpaceByte (stringByteAt s i) then startOfText s (i + 1)
  else i

fun endOfText s i =
  if i <= 0 then 0 else if isSpaceByte (stringByteAt s (i - 1)) then endOfText s (i - 1) else i

@pub fun trimStart (s : String) : String = slice s (startOfText s 0) (byteLength s)

@pub fun trimEnd (s : String) : String = slice s 0 (endOfText s (byteLength s))

@pub fun trim (s : String) : String = s |> trimStart |> trimEnd

-- `s` split on newlines. A trailing newline does not produce a final empty line.
@pub fun lines (s : String) : [String] =
  if isEmpty s then V.empty else s |> trimTrailingNewline |> split "\n"

fun trimTrailingNewline s = if endsWith "\n" s then take s (byteLength s - 1) else s

-- ---------------------------------------------------------------------------
-- ASCII case
-- ---------------------------------------------------------------------------

fun mapBytes f (b : #[UInt8]) i (acc : #[UInt8]) =
  if i >= arrayLen b then acc else mapBytes f b (i + 1) (arrayPush acc (f (arrayGetOr 0 b i)))

fun upperByte (c : UInt8) = if c >= 97 and c <= 122 then c - 32 else c

fun lowerByte (c : UInt8) = if c >= 65 and c <= 90 then c + 32 else c

-- ASCII letters only; anything else is left alone.
@pub fun toUpper (s : String) : String = bytesToString (mapBytes upperByte (stringToBytes s) 0 #[])

@pub fun toLower (s : String) : String = bytesToString (mapBytes lowerByte (stringToBytes s) 0 #[])

-- ---------------------------------------------------------------------------
-- Numbers
-- ---------------------------------------------------------------------------

fun reverseFrom (a : #[UInt8]) i (acc : #[UInt8]) =
  if i < 0 then acc else reverseFrom a (i - 1) (arrayPush acc (arrayGetOr 0 a i))

fun collectDigits n (acc : #[UInt8]) =
  if n == 0 then acc else collectDigits (n / 10) (arrayPush acc (toUInt8 (48 + n % 10)))

fun digitsToString n =
  let ds = collectDigits n #[] in
  bytesToString (reverseFrom ds (arrayLen ds - 1) #[])

-- `n` in base ten.
@pub fun fromInt (n : n) : String =
  if n == 0 then "0" else if n < 0 then concat "-" (digitsToString (0 - n)) else digitsToString n

@pub fun isDigitByte (c : UInt8) = c >= 48 and c <= 57

fun digitsFrom s i acc =
  if i >= byteLength s then Just acc
  else
    let c = stringByteAt s i in
    if isDigitByte c then digitsFrom s (i + 1) (acc * 10 + toInt64 (c - 48)) else None

-- `s` read as a base-ten integer, with an optional leading `-`. `None` unless
-- the whole string is digits.
@pub fun toInt (s : String) : Maybe Int =
  if byteLength s == 0 then None
  else if stringByteAt s 0 == 45 then negateParsed (digitsAfterSign s)
  else digitsFrom s 0 0

fun digitsAfterSign s = if byteLength s == 1 then None else digitsFrom s 1 0

fun negateParsed m = match m with | None -> None | Just n -> Just (0 - n)

-- --- characters --------------------------------------------------------------
--
-- Everything above counts bytes. These two are the bridge to `Std.Char`, which
-- counts Unicode scalars: `chars` decodes the UTF-8, `fromChars` encodes it.

@pub fun chars (s : String) : [Char] = V.fromArray (stringToChars s)

@pub fun fromChars (cs : [Char]) : String = charsToString (V.toArray cs)

-- The number of *characters*, which is `byteLength` only for ASCII.
@pub fun charLength (s : String) : Int = arrayLen (stringToChars s)

@pub fun charAt (s : String) (i : Int) : Maybe Char =
  let cs = stringToChars s in
  if i < 0 or i >= arrayLen cs then None else Just (arrayGet cs i)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

@test fun buildingStrings () =
  let a = assertEq (concat "foo" "bar") "foobar" "concat" in
  let b = assertEq (concat "" "x") "x" "concat onto nothing" in
  let c = assertEq (concatAll ["a", "b", "c"]) "abc" "concatAll" in
  let d = assertEq (join ", " ["a", "b"]) "a, b" "join" in
  let e = assertEq (join ", " ["only"]) "only" "one element gets no separator" in
  let f = assertEq (join ", " []) "" "nothing" in
  let i = assertEq (intercalate ", " ["a", "b", "c"]) "a, b, c" "intercalate" in
  let g = assertEq (repeat "ab" 3) "ababab" "repeat" in
  assertEq (repeat "ab" 0) "" "repeat none"

@test fun lengthIsInBytes () =
  let a = assertEq (byteLength "hello") 5 "ascii" in
  let b = assertTrue (isEmpty "") "isEmpty" in
  let c = assertFalse (isEmpty "x") "not empty" in
  -- Two bytes in UTF-8, and this module is honest about counting bytes.
  assertEq (byteLength "é") 2 "a multi-byte character"

@test fun sliceTakeAndDropClamp () =
  let a = assertEq (slice "hello" 1 3) "el" "slice" in
  let b = assertEq (take "hello" 2) "he" "take" in
  let c = assertEq (drop "hello" 2) "llo" "drop" in
  let d = assertEq (slice "hi" 0 99) "hi" "past the end" in
  let e = assertEq (slice "hi" 5 9) "" "wholly past the end" in
  assertEq (drop "hi" 99) "" "drop everything"

@test fun byteAtIsBoundsChecked () =
  let a = assertEq (byteAt "abc" 1) (Just 98) "in range" in
  let b = assertEq (byteAt "abc" 9) None "past the end" in
  assertEq (byteAt "abc" (0 - 1)) None "before the start"

@test fun searching () =
  let a = assertEq (indexOf "l" "hello") (Just 2) "first occurrence" in
  let b = assertEq (indexOf "lo" "hello") (Just 3) "a longer needle" in
  let c = assertEq (indexOf "z" "hello") None "absent" in
  let d = assertEq (indexOf "" "hello") (Just 0) "an empty needle is at the start" in
  let d2 = assertEq (indexOfFrom "l" "hello" 3) (Just 3) "from an offset" in
  let d3 = assertEq (indexOfFrom "l" "hello" 4) None "past the last" in
  let e = assertTrue (contains "ell" "hello") "contains" in
  let f = assertTrue (startsWith "he" "hello") "startsWith" in
  let g = assertFalse (startsWith "hello!" "hello") "a needle longer than the haystack" in
  assertTrue (endsWith "llo" "hello") "endsWith"

@test fun splittingAndLines () =
  let a = assertEq (split "," "a,b,c") ["a", "b", "c"] "split" in
  let b = assertEq (split "," "a,,b") ["a", "", "b"] "adjacent separators leave gaps" in
  let c = assertEq (split "," "a") ["a"] "no separator" in
  -- An empty separator has no sensible answer; the string comes back whole
  -- rather than looping forever.
  let d = assertEq (split "" "abc") ["abc"] "an empty separator" in
  let e = assertEq (lines "a\nb\nc") ["a", "b", "c"] "lines" in
  let f = assertEq (lines "a\nb\n") ["a", "b"] "one trailing newline is ignored" in
  assertEq (lines "") [] "no lines"

@test fun trimming () =
  let a = assertEq (trim "  hi  ") "hi" "trim" in
  let b = assertEq (trim "\t\nhi\r\n") "hi" "all the whitespace bytes" in
  let c = assertEq (trimStart "  hi  ") "hi  " "trimStart" in
  let d = assertEq (trimEnd "  hi  ") "  hi" "trimEnd" in
  assertEq (trim "   ") "" "all whitespace"

@test fun asciiCaseConversion () =
  let a = assertEq (toUpper "Hello, World!") "HELLO, WORLD!" "toUpper" in
  let b = assertEq (toLower "Hello, World!") "hello, world!" "toLower" in
  assertEq (toUpper "123") "123" "non-letters are left alone"

@test fun numbersInAndOut () =
  let a = assertEq (fromInt 0) "0" "zero" in
  let b = assertEq (fromInt 1234) "1234" "positive" in
  let c = assertEq (fromInt (0 - 42)) "-42" "negative" in
  let d = assertEq (toInt "1234") (Just 1234) "parse" in
  let e = assertEq (toInt "-42") (Just (0 - 42)) "parse a negative" in
  let f = assertEq (toInt "12x") None "trailing rubbish is rejected" in
  let g = assertEq (toInt "") None "empty" in
  let h = assertEq (toInt "-") None "a lone sign" in
  assertEq (toInt (fromInt 987654)) (Just 987654) "round trip"

@test fun charactersAreNotBytes () =
  let a = assertEq (charLength "héllo") 5 "five characters" in
  let b = assertEq (byteLength "héllo") 6 "six bytes -- `é` takes two" in
  let c = assertEq (charAt "héllo" 1) (Just 'é') "charAt" in
  let d = assertEq (charAt "hi" 9) None "past the end" in
  let e = assertEq (fromChars (chars "round trip é")) "round trip é" "round trip" in
  assertEq (chars "hi") ['h', 'i'] "chars"

@test fun stringsSortByteByByte () =
  let a = assertEq (compare "apple" "banana") Less "a before b" in
  let b = assertEq (compare "b" "apple") Greater "b after apple" in
  let c = assertEq (compare "same" "same") Equal "equal" in
  let d = assertTrue (lessThan "app" "apple") "a prefix sorts first" in
  let e = assertTrue (lessThan "" "a") "the empty string sorts first" in
  let f = assertTrue (lessThan "Zebra" "apple") "upper case before lower" in
  let g = assertTrue (lessThan "abcdefgh" "abcdefgi") "across a word" in
  let h = assertTrue (lessThan "abcdefgh" "abcdefgh\0") "a real zero byte after" in
  let i = assertTrue (lessThan "z" "é") "by code point" in
  let j = assertEq (minOf "pear" "fig") "fig" "minOf" in
  assertEq (maxOf "pear" "fig") "pear" "maxOf"

@test fun bytesRoundTrip () =
  let a = assertEq (fromBytes (toBytes "hello")) "hello" "round trip" in
  let b = assertEq (fromBytes #[0xff, 0x41]) "\u{FFFD}A" "what is not UTF-8 becomes U+FFFD" in
  assertEq (toBytes "abc") #[97, 98, 99] "toBytes"

@test fun slicingThroughACharacter () =
  let a = assertEq (slice "é" 0 1) "\u{FFFD}" "half a character" in
  let b = assertEq (byteAt "é" 1) (Just 169) "its second byte" in
  assertEq (slice "aéb" 1 3) "é" "a whole one"

@test fun longStringsAreCheapToTakeApart () =
  let big = repeat "abcdefgh" 100000 in
  let a = assertEq (byteLength big) 800000 "long" in
  let b = assertEq (slice big 799998 800000) "gh" "the end" in
  let c = assertEq (indexOfFrom "h" big 799990) (Just 799991) "found near the end" in
  assertEq (byteAt big 400003) (Just 100) "a byte in the middle"
