-- The Std prelude.
--
-- It defines nothing. Every name below is `@pub use`-re-exported from another
-- module, which is what makes it available *unqualified* in every package that
-- depends on `Std`. Anything not listed here is reached with a qualifier
-- (`Maybe.map`, `List.foldr`, `Set.insert`, …) or an explicit `use`.
--
-- The sequence API in scope by default is `Vector`'s -- `[1, 2, 3]` builds a
-- `Vector`, and bare `map` / `foldl` / `range` / … operate on it. For the linked
-- `List` (`::`, `[1; 2; 3]`) use `List.map` etc.

-- Constructors that stay unqualified everywhere.
--
-- A constructor's real name is `Type.Ctor`, and it is written bare only where
-- a `use M.Type.*` (or `use M.Type (Ctor)`) put it in scope. Re-exporting
-- these here does that for every dependent -- their functions still need
-- `Maybe.map` or a `use`, but `Just` / `None` / `Ok` / `Err` / `Less` reading as
-- themselves is worth more than the consistency. `True` / `False` / `Nil` /
-- `::` need no help: the language's own syntax depends on them, so they are
-- always in scope.
-- The types a program names without a `use`: the prelude's constructors'
-- types, the effects its functions perform, and what they answer. Nothing else
-- of the standard library's -- or of any package's -- is in scope until a
-- module asks for it.
@pub use Std.Maybe (Maybe)
@pub use Std.Result (Result)
@pub use Std.Ordering (Ordering)
@pub use Std.Collections.Vector (Vector)
@pub use Std.Console (Console)
@pub use Std.Fs (Fs, FileMeta)
@pub use Std.Process (Process)
@pub use Std.Eff (Eff)
@pub use Std.Maybe.Maybe.*
@pub use Std.Result.Result.*
@pub use Std.Ordering.Ordering.*

@pub use Std.Bool (not)

-- `"a" ++ "b"`: string concatenation, `Std.String.concat` by another name.
@pub use Std.String (++)

-- Strings joined with one between each two: `intercalate ", " names`.
@pub use Std.String (intercalate)

-- Printing is `Std.Console`'s `writeOutput` underneath -- `eprintln`'s is
-- `writeError`, to standard error -- so a handler can capture it; these are in
-- scope everywhere all the same.
@pub use Std.Console (print, println, eprintln)

@pub use Std.Ordering (isLess, isEqual, isGreater)

@pub use Std.Function (id, const, flip, compose, apply, twice)

@pub use Std.Tuple (fst, snd, pair, swap, mapFst, mapSnd)

@pub use Std.Num.Int (min, max, abs, signum, clamp, succ, pred, even, odd, gcd, lcm,)

@pub use Std.Num.Bits (
  lowMask, lowBits, bit, testBit, setBit, clearBit, flipBit, byteOf, fromBytes4, countLeadingZeros,
  countTrailingZeros, rotateLeft, rotateRight,
)

@pub use Std.Bytes (
  bytesEmpty, bytesLength, bytesIsEmpty, bytesGet, bytesGetOr, bytesSet, bytesPush, bytesPop,
  bytesSlice, bytesConcat, bytesGetU16LE, bytesGetU16BE, bytesGetU32LE, bytesGetU32BE,
  bytesSetU16LE, bytesSetU16BE, bytesSetU32LE, bytesSetU32BE,
)

@pub use Std.Fs (
  readToString, readBytes, writeString, writeBytes, appendString, removeFile, createDir,
  createDirAll, removeDir, removeDirAll, rename, copy, readDir, metadata, exists, isFile, isDir,
  readToStringOr, tryReadDir, existsAll,
)

@pub use Std.Process (
  command, withArg, withArgs, withCwd, withEnv, run, runInherit, outputStatus, outputStdout,
  outputStderr, succeeded, exit, currentPid, argv, getEnv, setEnv, removeEnv,
)

-- `Vector` is the default sequence.
@pub use Std.Collections.Vector (
  vecFromArray, empty, singleton, fromArray, fromList, toArray, toList, len, length, isEmpty, get,
  getOr, head, last, nth, set, pushBack, pushFront, popBack, popFront, append, splitAt, slice, take,
  drop, map, filter, foldl, foldr, reverse, updateAt, forEach, range, elem, notElem, sum, product,
  sumBy, all, any, find, concat, concatMap, replicate, takeWhile, dropWhile, partition, zip,
  zipWith, unzip, maximum, minimum,
)
