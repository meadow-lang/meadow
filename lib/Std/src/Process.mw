-- Std.Process: spawning subprocesses and process-level operations, modelled on
-- Rust's `std::process`.
--
-- Every operation runs in the `Process` effect. With no enclosing `handle` the
-- runtime does the real thing (spawns a child, reads `std::env`, …); a `handle`
-- can intercept it (handy for tests / sandboxing) -- see `Std.Fs` for the same
-- pattern.
--
-- A `Command` is the plain tuple `(program, args, cwd, envVars)` --
-- `String, Vector String, Maybe String, Vector (String, String)`. Build one with
-- `command` and `withArg` / `withArgs` / `withCwd` / `withEnv`.
--
-- An `Output` is `(status, stdout, stderr)` -- `Int, String, String`. `status`
-- is the child's exit code, or `-1` if it was killed by a signal.

use Std.Collections.Vector as V
use Std.Maybe.Maybe.*
use Std.Result (Result)
use Std.Collections.Vector (Vector)

@pub effect Process {
  -- Run to completion, capturing stdout/stderr.
  spawn
    : (String, Vector String, Maybe String, Vector (String, String)) ->
      Result String (Int, String, String),
  -- Run to completion, inheriting the parent's stdio; just the exit code.
  status : (String, Vector String, Maybe String, Vector (String, String)) -> Result String Int,
  -- Terminate the current process immediately with the given exit code.
  exit : Int -> (),
  currentPid : () -> Int,
  -- The path of the program running: what a build tool tells one compiler
  -- from another by. Empty when the platform cannot say.
  currentExe : () -> String,
  -- Whether standard input (0), output (1) or error (2) is a terminal rather
  -- than a file or a pipe: whether what is written there should be coloured.
  isTerminal : Int -> Bool,
  -- The process's command-line arguments (not including the program name).
  argv : () -> Vector String,
  getEnv : String -> Maybe String,
  setEnv : (String, String) -> (),
  removeEnv : String -> (),
  -- How many places in the program this thread has reached, counted from
  -- the first time it is asked or from the last asking with `True`, which
  -- forgets them and answers 0. Between those it only grows, and grows when
  -- the program gets somewhere it had not been: what `Std.Test.Fuzz` steers
  -- by. On the bytecode machine, which from the first asking interprets this
  -- thread and compiles none of it; a native program is always told 0.
  covered : Bool -> Int,
  -- Calling C: what `Std.Ffi` is written over, and where to look for how to
  -- use these. A library and a function are addresses; an argument is
  -- `(kind, integer, float, text)` and an answer `(integer, float, text)`.
  ffiOpen : String -> Result String Int,
  ffiSymbol : (Int, String) -> Result String Int,
  ffiCall : (Int, Int, Vector (Int, Int, Float, String)) -> Result String (Int, Float, String),
  ffiAlloc : Int -> Int,
  ffiFree : Int -> (),
  ffiWriteInts : (Int, Int, Vector Int) -> Result String (),
  ffiReadInts : (Int, Int, Bool, Int) -> Result String (Vector Int),
  ffiWriteFloats : (Int, Int, Vector Float) -> Result String (),
  ffiReadFloats : (Int, Int, Int) -> Result String (Vector Float),
  ffiReadText : (Int, Int) -> String,
  -- What the last call C made into this library failed with, once; empty
  -- when none did.
  ffiFailure : () -> String,
}

@pub fun command (program : a) : (a, [b], Maybe c, [d]) = (program, V.empty, None, V.empty)

@pub fun withArg (a : a) (cmd : (b, [a], c, d)) : (b, [a], c, d) =
  match cmd with
  | (p, xs, cwd, envs) -> (p, V.pushBack xs a, cwd, envs)

@pub fun withArgs (extra : [a]) (cmd : (b, [a], c, d)) : (b, [a], c, d) =
  match cmd with
  | (p, xs, cwd, envs) -> (p, V.append xs extra, cwd, envs)

@pub fun withCwd (dir : a) (cmd : (b, c, d, e)) : (b, c, Maybe a, e) =
  match cmd with
  | (p, xs, cwd, envs) -> (p, xs, Just dir, envs)

@pub fun withEnv (pair : a) (cmd : (b, c, d, [a])) : (b, c, d, [a]) =
  match cmd with
  | (p, xs, cwd, envs) -> (p, xs, cwd, V.pushBack envs pair)

-- Run `program` with `args` to completion, capturing its output.
@pub fun run (program : String) (args : [String])
    : Result String (Int, String, String) ! { Process | e } =
  command program |> withArgs args |> spawn

-- Run `program` with `args` to completion, inheriting stdio; just the exit code.
@pub fun runInherit (program : String) (args : [String]) : Result String Int ! { Process | e } =
  command program |> withArgs args |> status

@pub fun outputStatus (out : (a, b, c)) : a = match out with | (s, o, e) -> s

@pub fun outputStdout (out : (a, b, c)) : b = match out with | (s, o, e) -> o

@pub fun outputStderr (out : (a, b, c)) : c = match out with | (s, o, e) -> e

@pub fun succeeded (out : (n, a, b)) : Bool = outputStatus out == 0
