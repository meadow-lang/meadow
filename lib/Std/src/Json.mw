-- Std.Json: parse and render JSON.
--
--   use Std.Json as J
--
--   fun main () =
--     match J.parse "{\"a\": [1, 2, 3]}" with
--     | Ok v -> println (J.render v)
--     | Err e -> println e
--
-- The parser is built out of `Std.String.Parse`, over the characters of the
-- input, and follows RFC 8259 with one deliberate gap, noted at `stringLit`.
-- The renderer is the inverse for everything the parser accepts.

use Std.Bool (not)
use Std.String as S
use Std.String.Parse as P
use Std.String.Parse.Char as C
use Std.String.Parse.Lexer as L
use Std.Collections.Vector as V
use Std.Collections.Vector (vecFromArray)
use Std.Tuple (fst, snd, pair)
use Std.Maybe.Maybe.*
use Std.Maybe as M

-- --- the tree ----------------------------------------------------------------

-- Numbers are split into `Int` and `Float` rather than JSON's single number
-- type, because meadow's `Int` and `Float` are separate and silently widening
-- every integer to a float would lose precision no one asked to lose.
use Json.*
@derive(Debug, Display, PartialEq, PartialOrd)
@pub data Json
  = Null
  | Bool Bool
  | Int Int
  | Float Float
  | String String
  | Array [Json]
  | Object [(String, Json)]

-- --- constructing ------------------------------------------------------------

@pub fun jNull () : Json = Null

@pub fun jBool (b : Bool) : Json = Bool b

@pub fun jInt (n : Int) : Json = Int n

@pub fun jString (s : String) : Json = String s

@pub fun jArray (xs : [Json]) : Json = Array xs

@pub fun jObject (fields : [(String, Json)]) : Json = Object fields

-- --- inspecting --------------------------------------------------------------

@pub fun isNull (v : Json) : Bool = match v with | Null -> True | _ -> False

@pub fun asBool (v : Json) : Maybe Bool = match v with | Bool b -> Just b | _ -> None

@pub fun asInt (v : Json) : Maybe Int = match v with | Int n -> Just n | _ -> None

@pub fun asFloat (v : Json) : Maybe Float =
  match v with
  | Float x -> Just x
  | Int n -> Just (toFloat n)
  | _ -> None

@pub fun asString (v : Json) : Maybe String = match v with | String s -> Just s | _ -> None

@pub fun asArray (v : Json) : Maybe [Json] = match v with | Array xs -> Just xs | _ -> None

@pub fun asObject (v : Json) : Maybe [(String, Json)] =
  match v with | Object fs -> Just fs | _ -> None

-- The value at `key`, or `None` if this is not an object or has no such key.
@pub fun get (key : String) (v : Json) : Maybe Json =
  match v with
  | Object fields -> lookupField key fields
  | _ -> None

-- The element at `i`, or `None`.
@pub fun index (i : Int) (v : Json) : Maybe Json = match v with | Array xs -> V.get xs i | _ -> None

-- Follow a chain of object keys: `path ["a", "b"] v` is `v.a.b`.
@pub fun path (keys : [String]) (v : Json) : Maybe Json =
  V.foldl (\acc k -> maybeThen (\x -> get k x) acc) (Just v) keys

fun maybeThen f o = match o with | None -> None | Just x -> f x

fun lookupField key fields =
  if V.isEmpty fields then None
  else
    match V.get fields 0 with
    | None -> None
    | Just entry -> if fst entry == key then Just (snd entry) else lookupField key (V.drop fields 1)

-- --- parsing -----------------------------------------------------------------

-- `Ok` of the value, or `Err` of a message saying at which byte offset and
-- what went wrong there. `parseSpanned` gives the span of the text instead.
@pub fun parse (text : String) : Result String Json =
  match quick text with
  | Just v -> Ok v
  | None ->
      (match P.runParser document text with
       | Ok v -> Ok v
       | Err e -> Err (P.showError e))

-- `Ok` of the value, or `Err` of the span of the text the error is about and
-- what went wrong there, for whoever shows it to point at.
@pub fun parseSpanned (text : String) : Result ((Int, Int), String) Json =
  match quick text with
  | Just v -> Ok v
  | None -> P.parse document text

-- --- parsing, quickly --------------------------------------------------------
--
-- The grammar below, written with `Std.String.Parse`, is what JSON *is* here
-- and what says what is wrong with text that is not JSON. It is also a
-- closure a character, which on two megabytes is five seconds. So text is read
-- first by a scanner over its bytes, written as loops: a string with no
-- escape in it is one slice, an integer is its digits, and an array or an
-- object is pushed onto a vector as it goes.
--
-- The scanner answers only what the grammar would have answered. Wherever it
-- is not sure -- anything it does not expect, a number that is not a plain
-- integer of a size it can add up -- it gives up, on that number or on the
-- whole text, and the grammar is asked instead. So text that is not JSON is
-- still refused by the grammar, in the grammar's words.

-- A value and where it ended, or nothing the scanner will vouch for.
use Scan.*
data Scan = Got Json Int | Lost

-- A string's text and where it ended.
use Text.*
data Text = Read String Int | Unread

fun byteAt (s : String) (i : Int) : Int = toInt (stringByteAt s i)

-- Past spaces, tabs and line ends. Anything else the grammar calls a space
-- is left where it is, for the grammar.
fun skipSpace (s : String) (n : Int) (i : Int) : Int =
  if i < n then
    (let c = byteAt s i in
     if c == 32 or c == 10 or c == 13 or c == 9 then skipSpace s n (i + 1) else i)
  else i

fun quick (s : String) : Maybe Json =
  let n = stringByteLength s in
  match scanValue s n (skipSpace s n 0) with
  | Got v i -> if skipSpace s n i == n then Just v else None
  | Lost -> None

fun scanValue (s : String) (n : Int) (i : Int) : Scan =
  if i >= n then Lost
  else
    (let c = byteAt s i in
     if c == 34 then
       (match scanText s n (i + 1) (i + 1) V.empty with
        | Read text j -> Got (String text) j
        | Unread -> Lost)
     else if c == 123 then scanObject s n (skipSpace s n (i + 1))
     else if c == 91 then scanArray s n (skipSpace s n (i + 1))
     else if c == 45 or (c >= 48 and c <= 57) then scanNumber s n i
     else if c == 116 then scanWord s n i "true" (Bool True)
     else if c == 102 then scanWord s n i "false" (Bool False)
     else if c == 110 then scanWord s n i "null" Null
     else Lost)

fun scanWord (s : String) (n : Int) (i : Int) (word : String) (v : Json) : Scan =
  let j = i + stringByteLength word in
  if j <= n and stringSlice s i j == word then Got v j else Lost

-- The text of a string, from just past its opening quote. `from` is where
-- the piece being read began: the whole string, unless there was an escape,
-- and then what has come since it.
fun scanText (s : String) (n : Int) (from : Int) (i : Int) (pieces : [String]) : Text =
  if i >= n then Unread
  else
    (let c = byteAt s i in
     if c == 34 then
       (let piece = stringSlice s from i in
        Read (if V.len pieces == 0 then piece else S.concatAll (V.pushBack pieces piece)) (i + 1))
     else if c == 92 then
       (if i + 1 >= n then Unread
        else if byteAt s (i + 1) == 117 then
          -- `\uXXXX`: a character by its code, or two of them for one past
          -- `\uFFFF` -- a pair of surrogates. Half a pair is not read.
          (let hi = hex4 s n (i + 2) in
           if hi < 0 then Unread
           else if hi >= 55296 and hi <= 56319 then
             (let lo =
                if i + 7 < n and byteAt s (i + 6) == 92 and byteAt s (i + 7) == 117 then
                  hex4 s n (i + 8)
                else 0 - 1
              in if lo < 56320 or lo > 57343 then Unread
                 else
                   scanText
                     s
                     n
                     (i + 12)
                     (i + 12)
                     (V.pushBack
                        (V.pushBack pieces (stringSlice s from i))
                        (charsToString
                           #[charFromCode (65536 + (hi - 55296) * 1024 + (lo - 56320))])))
           else if hi >= 56320 and hi <= 57343 then Unread
           else
             scanText
               s
               n
               (i + 6)
               (i + 6)
               (V.pushBack
                  (V.pushBack pieces (stringSlice s from i))
                  (charsToString #[charFromCode hi])))
        else
          (match unescaped (byteAt s (i + 1)) with
           | Just e ->
               scanText
                 s
                 n
                 (i + 2)
                 (i + 2)
                 (V.pushBack (V.pushBack pieces (stringSlice s from i)) e)
           | None -> Unread))
     else scanText s n from (i + 1) pieces)

-- The number the four hex digits of `s` at `i` write, or -1.
fun hex4 (s : String) (n : Int) (i : Int) : Int =
  if i + 4 > n then 0 - 1
  else
    V.foldl
      (\acc k ->
        (let d = hexValue (byteAt s (i + k)) in if acc < 0 or d < 0 then 0 - 1 else acc * 16 + d))
      0
      [0, 1, 2, 3]

fun hexValue (c : Int) : Int =
  if c >= 48 and c <= 57 then c - 48
  else if c >= 97 and c <= 102 then c - 87
  else if c >= 65 and c <= 70 then c - 55
  else 0 - 1

-- What the character after a backslash stands for: the escapes of `escapes`.
fun unescaped (c : Int) : Maybe String =
  if c == 34 then Just "\""
  else if c == 92 then Just "\\"
  else if c == 47 then Just "/"
  else if c == 110 then Just "\n"
  else if c == 114 then Just "\r"
  else if c == 116 then Just "\t"
  else if c == 98 then Just (charsToString #[charFromCode 8])
  else if c == 102 then Just (charsToString #[charFromCode 12])
  else None

fun digitsEnd (s : String) (n : Int) (i : Int) : Int =
  if i < n and byteAt s i >= 48 and byteAt s i <= 57 then digitsEnd s n (i + 1) else i

fun digitsValue (s : String) (i : Int) (stop : Int) (acc : Int) : Int =
  if i == stop then acc else digitsValue s (i + 1) stop (acc * 10 + (byteAt s i - 48))

-- Whether `c` could go on a number: a fraction, an exponent, a sign.
fun numberMore (c : Int) : Bool = c == 46 or c == 101 or c == 69 or c == 43 or c == 45

fun numberEnd (s : String) (n : Int) (i : Int) : Int =
  if i < n and (numberMore (byteAt s i) or (byteAt s i >= 48 and byteAt s i <= 57)) then
    numberEnd s n (i + 1)
  else i

-- An integer of at most eighteen digits is added up here. Anything else that
-- starts as a number -- a fraction, an exponent, more digits than that -- is
-- handed to the grammar's `number`, by itself.
fun scanNumber (s : String) (n : Int) (i : Int) : Scan =
  let negative = byteAt s i == 45 in
  let start = if negative then i + 1 else i in
  let stop = digitsEnd s n start in
  if stop == start then Lost
  else if (stop < n and numberMore (byteAt s stop)) or stop - start > 18 then
    (let j = numberEnd s n i in
     match P.runParser (P.thenSkip number P.eof) (stringSlice s i j) with
     | Ok v -> Got v j
     | Err _ -> Lost)
  else (let v = digitsValue s start stop 0 in Got (Int (if negative then 0 - v else v)) stop)

-- From just past `[` and any space after it.
fun scanArray (s : String) (n : Int) (i : Int) : Scan =
  if i < n and byteAt s i == 93 then Got (Array V.empty) (i + 1) else scanItems s n i V.empty

fun scanItems (s : String) (n : Int) (i : Int) (acc : [Json]) : Scan =
  match scanValue s n i with
  | Lost -> Lost
  | Got v j ->
      (let k = skipSpace s n j in
       if k >= n then Lost
       else
         (let c = byteAt s k in
          if c == 44 then scanItems s n (skipSpace s n (k + 1)) (V.pushBack acc v)
          else if c == 93 then Got (Array (V.pushBack acc v)) (k + 1)
          else Lost))

-- From just past `{` and any space after it.
fun scanObject (s : String) (n : Int) (i : Int) : Scan =
  if i < n and byteAt s i == 125 then Got (Object V.empty) (i + 1) else scanMembers s n i V.empty

fun scanMembers (s : String) (n : Int) (i : Int) (acc : [(String, Json)]) : Scan =
  if i >= n or byteAt s i != 34 then Lost
  else
    (match scanText s n (i + 1) (i + 1) V.empty with
     | Unread -> Lost
     | Read key j ->
         (let k = skipSpace s n j in
          if k >= n or byteAt s k != 58 then Lost
          else
            (match scanValue s n (skipSpace s n (k + 1)) with
             | Lost -> Lost
             | Got v m ->
                 (let q = skipSpace s n m in
                  if q >= n then Lost
                  else
                    (let c = byteAt s q in
                     if c == 44 then
                       scanMembers s n (skipSpace s n (q + 1)) (V.pushBack acc (pair key v))
                     else if c == 125 then Got (Object (V.pushBack acc (pair key v))) (q + 1)
                     else Lost)))))

-- What sits between tokens: white space, and nothing else -- JSON has no
-- comments.
fun sc = L.space C.space1 P.empty P.empty

fun lexeme p = L.lexeme sc p

fun symbol text = L.symbol sc text

-- These refer to each other in a cycle, and meadow evaluates top-level
-- definitions eagerly -- so building any of them at load time would read another
-- that had not been built yet. `defer` delays construction until the parser is
-- actually run, which is what breaks the cycle in a strict language.
fun document = P.defer (\() -> P.thenSkip (P.skipThen sc value) P.eof)

fun values =
  [
    P.mapTo Null (C.string "null"),
    P.mapTo (Bool True) (C.string "true"),
    P.mapTo (Bool False) (C.string "false"),
    P.map String stringLit,
    array,
    object,
    number,
  ]

fun value = P.defer (\() -> lexeme (P.choice values))

fun array =
  let items = P.between (symbol "[") (C.char ']') (P.sepBy value (symbol ",")) in
  P.defer (\() -> items |> P.map Array |> P.label "an array")

fun object =
  let members = P.between (symbol "{") (C.char '}') (P.sepBy member (symbol ",")) in
  P.defer (\() -> members |> P.map Object |> P.label "an object")

fun member =
  P.defer (\() -> P.pure pair |> P.keep (lexeme stringLit) |> P.skip (symbol ":") |> P.keep value)

-- --- lexical -----------------------------------------------------------------

fun float negative = P.map (\x -> Float (if negative then 0.0 -. x else x)) L.float

fun integer negative = P.map (\n -> Int (if negative then 0 - n else n)) L.decimal

-- Numbers: an optional minus, digits, and an optional fraction and exponent.
-- One with neither is an `Int`; one with either is a `Float`.
fun number =
  let minus = P.option False (P.mapTo True (C.char '-')) in
  P.label "a number" (P.bind minus (\negative -> P.alt (float negative) (integer negative)))

-- Strings. `\uXXXX` is read by the scanner above (`scanText`); this, which a
-- string only reaches when that could not read it, has no rule for one.
fun stringLit =
  let chars = P.skipThen (C.char '"') (P.manyTill (P.alt escape plainChar) (C.char '"')) in
  chars |> P.map (\cs -> charsToString (V.toArray cs)) |> P.label "a string"

fun plainChar = P.satisfy (\c -> c != '"' and c != '\\')

fun escapes =
  [
    P.mapTo '"' (C.char '"'),
    P.mapTo '\\' (C.char '\\'),
    P.mapTo '/' (C.char '/'),
    P.mapTo (charFromCode 8) (C.char 'b'),
    P.mapTo (charFromCode 12) (C.char 'f'),
    P.mapTo '\n' (C.char 'n'),
    P.mapTo '\r' (C.char 'r'),
    P.mapTo '\t' (C.char 't'),
  ]

fun escape = P.choice escapes |> P.label "an escape" |> P.skipThen (C.char '\\')

-- --- rendering ---------------------------------------------------------------

-- Compact: no spaces, no newlines. `renderIndented` is below. A value's text
-- is gathered a piece at a time into one growing table and joined once, so
-- rendering takes time and room in the size of what it writes, whatever the
-- depth it is nested to and whichever runtime it is on.
@pub fun render (v : Json) : String =
  runSt (\() ->
    let out = pieces () in
    let u = emit out v in
    concatStrings (gathered out))

-- The pieces of a text being written: a table of them that doubles when it
-- is full, and how many it holds.
data Pieces s
  = Pieces (StRef s (StArray s String)) (StRef s Int)

fun pieces () : Pieces s ! { St s | e } = Pieces (stNewRef (stNewArray 64 "")) (stNewRef 0)

fun say (out : Pieces s) (x : String) : () ! { St s | e } =
  match out with
  | Pieces table count ->
      let t = stGetRef table in
      let n = stGetRef count in
      let room = if n < stArrayLen t then t else doubled table t n in
      let u = stSetArray room n x in
      stSetRef count (n + 1)

fun doubled table t (n : Int) =
  let bigger = stNewArray (2 * n) "" in
  let u = moved t bigger 0 n in
  let w = stSetRef table bigger in
  bigger

fun moved from to (i : Int) (n : Int) =
  if i >= n then () else (let u = stSetArray to i (stGetArray from i) in moved from to (i + 1) n)

fun gathered (out : Pieces s) : #[String] ! { St s | e } =
  match out with
  | Pieces table count -> arraySlice (stFreeze (stGetRef table)) 0 (stGetRef count)

fun emit (out : Pieces s) (v : Json) : () ! { St s | e } =
  match v with
  | Null -> say out "null"
  | Bool True -> say out "true"
  | Bool False -> say out "false"
  | Int n -> say out (show n)
  | Float x -> say out (showFloat x)
  | String s -> emitString out s
  | Array xs ->
      let a = say out "[" in
      let b = emitItems out (V.toArray xs) 0 in
      say out "]"
  | Object fs ->
      let a = say out "{" in
      let b = emitMembers out (V.toArray fs) 0 in
      say out "}"

fun emitItems (out : Pieces s) (xs : #[Json]) (i : Int) : () ! { St s | e } =
  if i >= arrayLen xs then ()
  else
    (let a = (if i > 0 then say out "," else ()) in
     let b = emit out (arrayGetOr Null xs i) in
     emitItems out xs (i + 1))

fun emitMembers (out : Pieces s) (fs : #[(String, Json)]) (i : Int) : () ! { St s | e } =
  if i >= arrayLen fs then ()
  else
    (match arrayGetOr ("", Null) fs i with
     | (name, value) ->
         let a = (if i > 0 then say out "," else ()) in
         let b = emitString out name in
         let c = say out ":" in
         let d = emit out value in
         emitMembers out fs (i + 1))

-- Two spaces per level, one element per line -- the shape `meadow fmt` uses for
-- meadow itself.
@pub fun renderIndented (v : Json) : String = renderAt 0 v

fun renderAt depth v =
  match v with
  | Array xs ->
      if V.isEmpty xs then "[]"
      else
        S.concatAll [
          "[\n",
          S.join ",\n" (V.map (\x -> S.concat (pad (depth + 1)) (renderAt (depth + 1) x)) xs),
          "\n",
          pad depth,
          "]",
        ]
  | Object fs ->
      if V.isEmpty fs then "{}"
      else
        S.concatAll [
          "{\n",
          S.join ",\n" (V.map (\f -> memberAt (depth + 1) f) fs),
          "\n",
          pad depth,
          "}",
        ]
  | _ -> render v

fun memberAt depth entry =
  S.concatAll [pad depth, quote (fst entry), ": ", renderAt depth (snd entry)]

fun pad depth = S.repeat "  " depth

-- --- escaping ----------------------------------------------------------------

@pub fun quote (s : String) : String =
  runSt (\() ->
    let out = pieces () in
    let u = emitString out s in
    concatStrings (gathered out))

-- `s` in its quotes: itself between them where nothing in it has to be
-- escaped, which is nearly always, and otherwise what lies between the
-- bytes that do, with each of those as its escape.
fun emitString (out : Pieces s) (text : String) : () ! { St s | e } =
  let a = say out "\"" in
  let b = emitFrom out text (stringByteLength text) 0 in
  say out "\""

fun emitFrom (out : Pieces s) (text : String) (n : Int) (from : Int) : () ! { St s | e } =
  let j = unsafeFrom text from n in
  let a =
    (if from == 0 and j >= n then say out text
     else if j > from then say out (stringSlice text from j)
     else ())
  in if j >= n then ()
     else (let b = say out (escapeOf (toInt (stringByteAt text j))) in emitFrom out text n (j + 1))

-- Where the first byte of `s` at or after `i` that has to be escaped is: a
-- quote, a backslash, or a control character, which no JSON string holds
-- raw.
fun unsafeFrom (s : String) (i : Int) (n : Int) : Int =
  if i >= n then n
  else
    (let b = toInt (stringByteAt s i) in
     if b == 34 or b == 92 or b < 32 then i else unsafeFrom s (i + 1) n)

fun escapeOf (c : Int) : String =
  if c == 34 then "\\\""
  else if c == 92 then "\\\\"
  else if c == 10 then "\\n"
  else if c == 13 then "\\r"
  else if c == 9 then "\\t"
  else if c == 8 then "\\b"
  else if c == 12 then "\\f"
  else "\\u00${hexDigit (c / 16)}${hexDigit (c % 16)}"

fun hexDigit (d : Int) : String = stringSlice "0123456789abcdef" d (d + 1)

-- Meadow has no float formatter, so this renders the integer part and a fixed
-- six fractional digits -- enough to round-trip the values this module's own
-- parser produces, and honest about being a placeholder.
fun showFloat x =
  let whole = floor x in
  let frac = x -. toFloat whole in
  let scaled = floor ((if frac <. 0.0 then 0.0 -. frac else frac) *. 1000000.0) in
  S.concatAll [S.fromInt whole, ".", padLeft 6 (S.fromInt scaled)]

fun padLeft width s = if S.byteLength s >= width then s else padLeft width (S.concat "0" s)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Result.Result.*

fun parsed text =
  match parse text with
  | Ok v -> v
  | Err e -> String (S.concat "parse failed: " e)

@test fun theAtomsParse () =
  let a = assertEq (parsed "null") Null "null" in
  let b = assertEq (parsed "true") (Bool True) "true" in
  let c = assertEq (parsed "false") (Bool False) "false" in
  let d = assertEq (parsed "42") (Int 42) "an integer" in
  let e = assertEq (parsed "-7") (Int (0 - 7)) "a negative integer" in
  assertEq (parsed "\"hi\"") (String "hi") "a string"

@test fun numbersSplitIntoIntAndFloat () =
  -- JSON has one number type; meadow has two, and widening every integer to a
  -- float would lose precision no one asked to lose.
  let a = assertEq (parsed "1") (Int 1) "no fraction means Int" in
  let b = assertEq (parsed "2e3") (Float 2000.0) "an exponent means Float" in
  let c = assertEq (parsed "-2.5E-1") (Float (0.0 -. 0.25)) "a signed exponent" in
  assertTrue (isFloat (parsed "1.5")) "a fraction means Float"

fun isFloat v = match v with | Float x -> True | _ -> False

@test fun anErrorPointsAtTheSpot () =
  let text = "{\"a\": [1, 2,\n  ]}" in
  let wanted =
    "expecting \"null\", \"true\", \"false\", a string, an array, an object, or a number"
  in
  let a =
    match parse text with
    | Ok _ -> assertTrue False "it should fail"
    | Err e ->
        assertEq e "at offset 15: unexpected \"]}\"; ${wanted}" "the offset, and what went wrong"
  in match parseSpanned text with
     | Ok _ -> assertTrue False "it should fail"
     | Err (at, message) ->
         let b = assertEq at (15, 17) "the span of what was found" in
         assertEq message "unexpected \"]}\"\n${wanted}\n" "what went wrong, in lines"

@test fun containersNestAndAreOrdered () =
  let a = assertEq (parsed "[]") (Array []) "an empty array" in
  let b = assertEq (parsed "[1,2]") (Array [Int 1, Int 2]) "an array" in
  let c = assertEq (parsed "{}") (Object []) "an empty object" in
  let d = assertEq (parsed "{\"a\":1}") (Object [("a", Int 1)]) "an object" in
  assertEq (parsed "[[1],[2]]") (Array [Array [Int 1], Array [Int 2]]) "nesting"

@test fun whitespaceIsIgnoredBetweenTokens () =
  assertEq (parsed "  { \"a\" : [ 1 , 2 ] }  ") (parsed "{\"a\":[1,2]}") "spaces do not matter"

-- Two layers of escaping meet here: the meadow literal, and the JSON text it
-- holds. `"\"a\\nb\""` is the six characters `"a\nb"` -- JSON for a newline.
@test fun stringEscapesAreDecoded () =
  let a = assertEq (parsed "\"a\\nb\"") (String "a\nb") "newline" in
  let b = assertEq (parsed "\"a\\tb\"") (String "a\tb") "tab" in
  let c = assertEq (parsed "\"a\\\"b\"") (String "a\"b") "an escaped quote" in
  assertEq (parsed "\"a\\\\b\"") (String "a\\b") "an escaped backslash"

@test fun malformedInputIsRejected () =
  let bad = \text -> match parse text with | Ok v -> False | Err e -> True in
  let a = assertTrue (bad "{oops}") "not JSON at all" in
  let b = assertTrue (bad "[1,") "cut off" in
  let c = assertTrue (bad "") "empty" in
  -- Trailing rubbish is rejected too: `document` ends with `eof`.
  assertTrue (bad "1 2") "two values"

-- What the scanner answers is what the grammar answers, and what it gives up
-- on the grammar still reads.
fun byGrammar (text : String) : Result String Json =
  match P.runParser document text with
  | Ok v -> Ok v
  | Err e -> Err (P.showError e)

@test fun theScannerAndTheGrammarAgree () =
  let texts =
    [
      "null", " true ", "false", "0", "-0", "007", "-12", "123456789012345678",
      "1234567890123456789012", "1.5", "-2.5E-1", "2e3", "1e+2", "\"\"", "\"héllo, wörld\"",
      "\"a\\nb\\t\\\"c\\\\d\\/e\\bf\\fg\\r\"", "[]", "[ ]", "[1]", "[1, [2, [3, []]], {}]", "{}",
      "{ }", "{\"a\":1}",
      " { \"k\" : [ 1 , 2.0 , \"x\" , null , true , { \"n\" : { } } ] , \"e\\n\" : -3 }\n",
      "\t[\r\n1\n]\n",
    ]
  in
  let same = V.all (\t -> parse t == byGrammar t and parseSpanned t == P.parse document t) texts in
  let quickly = V.all (\t -> M.isSome (quick t)) texts in
  let a = assertTrue same "the same value either way" in
  assertTrue quickly "and the scanner read each of them itself"

@test fun whatTheScannerGivesUpOnTheGrammarStillSays () =
  let texts =
    [
      "", " ", "[1,", "[1,]", "{\"a\"}", "{\"a\":}", "{a:1}", "tru", "truex", "nul", "1 2", "1.",
      "1e", "-", "--1", "\"open", "\"bad \\q escape\"", "\"\\ud800\"", "[1 2]", "{\"a\":1,}", "]",
      "1.5.2",
    ]
  in
  let unread = V.all (\t -> not (M.isSome (quick t))) texts in
  let same = V.all (\t -> parse t == byGrammar t) texts in
  let a = assertTrue unread "the scanner vouches for none of these" in
  assertTrue same "and each is whatever the grammar makes of it"

@test fun renderingIsCompactAndRoundTrips () =
  let a = assertEq (render Null) "null" "null" in
  let b = assertEq (render (Bool True)) "true" "true" in
  let c = assertEq (render (Int (0 - 7))) "-7" "a negative" in
  let d = assertEq (render (Array [Int 1, Int 2])) "[1,2]" "an array" in
  let e = assertEq (render (Object [("a", Int 1)])) "{\"a\":1}" "an object" in
  let text = "{\"a\":[1,2,3],\"b\":null,\"c\":\"x\"}" in
  assertEq (render (parsed text)) text "parse then render is the identity"

@test fun unicodeEscapesAreRead () =
  let a = assertEq (parsed "\"\\u0041\"") (String "A") "a letter by its code" in
  assertEq (parsed "\"\\ud83d\\ude00\"") (String "😀") "a pair of surrogates"

@test fun renderingEscapesControlCharacters () =
  let esc = S.fromBytes #[toUInt8 97, toUInt8 27, toUInt8 98] in
  let a = assertEq (render (String esc)) "\"a\\u001bb\"" "an escape character" in
  assertEq (parsed (render (String esc))) (String esc) "and it reads back"

@test fun renderingEscapesWhatItMust () =
  let a = assertEq (render (String "a\"b")) "\"a\\\"b\"" "a quote" in
  let b = assertEq (render (String "a\nb")) "\"a\\nb\"" "a newline" in
  let awkward = String "tricky \" \\ \n\t" in
  assertEq (parsed (render awkward)) awkward "everything that needs escaping round trips"

@test fun accessorsReachIntoTheTree () =
  let v = parsed "{\"n\":{\"deep\":true},\"xs\":[10,20]}" in
  let a = assertEq (path ["n", "deep"] v) (Just (Bool True)) "path" in
  let b = assertEq (path ["n", "missing"] v) None "a missing key" in
  let c = assertEq (get "n" v) (Just (Object [("deep", Bool True)])) "get" in
  let d = assertEq (index 1 (parsed "[10,20]")) (Just (Int 20)) "index" in
  assertEq (index 9 (parsed "[10]")) None "index past the end"

@test fun theTypedAccessors () =
  let a = assertEq (asInt (Int 1)) (Just 1) "asInt" in
  let b = assertEq (asInt (String "1")) None "asInt of the wrong shape" in
  let c = assertEq (asString (String "x")) (Just "x") "asString" in
  let d = assertEq (asBool (Bool True)) (Just True) "asBool" in
  let e = assertTrue (isNull Null) "isNull" in
  -- `asFloat` widens an integer, since a JSON `1` is a valid float to a caller
  -- that wants one.
  assertEq (asFloat (Int 2)) (Just 2.0) "asFloat widens an Int"

@test fun indentedRenderingNestsByTwo () =
  let a = assertEq (renderIndented (Array [])) "[]" "an empty array stays on one line" in
  let b = assertEq (renderIndented (Object [])) "{}" "and an empty object" in
  let c = assertEq (renderIndented (Array [Int 1])) "[\n  1\n]" "one element" in
  assertEq (renderIndented (Object [("a", Int 1)])) "{\n  \"a\": 1\n}" "one field"
