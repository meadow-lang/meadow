-- Std.Num: the number types, and what is shared between them.
--
-- Integers:
--
--   BigInt                    as large as memory allows; never overflows
--   Int (also Int64)          64-bit, signed
--   Int32  Int16  Int8        signed, fixed width
--   UInt64 UInt32 UInt16 UInt8 unsigned, fixed width
--
-- Floats: `Float` (also `Float64`) and `Float32`.
--
-- Every integer type shares `+ - * / % ^`, `< > <= >=`, `neg` and the bitwise
-- operators; both float types share `+. -. *. /.` and `<. >. <=. >=.`. The two
-- operands of one operator are always the same type -- a `UInt8` never meets an
-- `Int` without a conversion. A fixed-width type wraps on overflow.
--
-- A literal takes its type from where it is used, and a function using these
-- operators works at every type they do: `fun double n = n * 2` is
-- `forall n. n -> n`. A number nothing pins down is an `Int`, or a `Float`: a
-- machine word, which wraps past 2^63. Ask for a `BigInt` where a result has
-- to be exact past that -- `toBigInt 2 ^ 100` -- or an annotation.
--
-- Converting: `toInt`, `toBigInt`, `toInt8` … `toUInt64` from any integer type
-- (keeping the low bits between fixed widths, as Rust's `as` does, and checked
-- from a `BigInt`); `toFloat` from any integer; `toFloat32`, `toFloat64` and
-- `floor` between and from the floats.
--
-- `Std.Num.Int` has helpers that work on every integer type (`min`, `abs`,
-- `gcd`, …) and `Std.Num.Bits` the bit twiddling. This module holds the bounds
-- of each fixed-width type.

@pub mod Int
@pub mod Bits
@pub mod Float

@pub def minInt8 : Int8 = toInt8 (0 - 128)
@pub def maxInt8 : Int8 = toInt8 127
@pub def minInt16 : Int16 = toInt16 (0 - 32768)
@pub def maxInt16 : Int16 = toInt16 32767
@pub def minInt32 : Int32 = toInt32 (0 - 2147483648)
@pub def maxInt32 : Int32 = toInt32 2147483647
@pub def minInt : Int = toInt (0 - 9223372036854775807 - 1)
@pub def maxInt : Int = toInt 9223372036854775807

@pub def maxUInt8 : UInt8 = toUInt8 255
@pub def maxUInt16 : UInt16 = toUInt16 65535
@pub def maxUInt32 : UInt32 = toUInt32 4294967295
-- All 64 bits set: `Int`'s -1, kept as bits.
@pub def maxUInt64 : UInt64 = toUInt64 (toInt (0 - 1))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)

@test fun theBoundsAreTheBounds () =
  let a = assertEq (show maxUInt8) "255" "UInt8" in
  let b = assertEq (show minInt8) "-128" "Int8" in
  let c = assertEq (show maxUInt64) "18446744073709551615" "UInt64 prints unsigned" in
  let d = assertEq (show (maxInt32 + toInt32 1)) "-2147483648" "Int32 wraps" in
  let e = assertEq (maxUInt8 + 1) (toUInt8 0) "UInt8 wraps at the top" in
  assertTrue (maxUInt64 > toUInt64 0) "UInt64 compares unsigned"

@test fun literalsTakeTheirTypeFromUse () =
  let a = assertEq (toUInt8 250 + 10) (toUInt8 4) "10 is a UInt8 here" in
  let b = assertEq (toInt16 (0 - 1) * 2) (toInt16 (0 - 2)) "and an Int16 here" in
  let c =
    assertEq (show (toBigInt 2 ^ 100)) "1267650600228229401496703205376" "a BigInt where asked"
  in assertEq (2 ^ 63) (0 - 2 ^ 63) "and an Int, which wraps, where not"
