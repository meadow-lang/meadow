-- The tokens a procedural macro is given, and the tokens it answers with.
--
-- A procedural macro is an ordinary function, `[TokenTree] -> [TokenTree]`,
-- compiled like anything else and run by the compiler while it compiles
-- whoever calls it. There is no library to link against and no ABI: what
-- crosses is this type, built by the compiler from the call's argument and
-- read back from the answer.
--
-- A token is what the lexer produced, not what it meant. `Word` is any
-- identifier or keyword, `Punct` is everything else by the text it is written
-- with, and a bracketed run is a `Group` with what was inside it. That is the
-- whole language a macro sees: brackets balance, and nothing else is promised.
-- Each carries the `Loc` it was written at, and keeps it through what a macro
-- hands back: an error in the caller's code a macro passed through is reported
-- where the caller wrote it.
--
-- A macro writes code with `quote! { … $x … }`, or as text with `Code`, which
-- the compiler lexes where the call was. `Std.Macro.Parse` reads an argument
-- with `Std.String.Parse`'s combinators.

@pub mod Parse
@pub mod Serve

use Std.String as S
use Std.Collections.Vector as V
use Std.Collections.Vector (vecFromArray)
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Std.Tuple (fst, snd)
use TokenTree.*
use Delim.*
use Loc.*
use Outcome.*
use Wire.*

@derive(Debug, Display, PartialEq, Eq, PartialOrd, Ord)
@pub data Delim = Paren | Bracket | Brace

-- Where a token was written: from one byte of the calling file up to another.
-- A token a macro makes up was written nowhere, and stands where the call is.
@derive(Debug, Display, PartialEq, Eq, PartialOrd, Ord)
@pub data Loc = At Int Int | Nowhere

@derive(Debug, Display, PartialEq, PartialOrd)
@pub data TokenTree
  = Word String Loc
  | Punct String Loc
  | Str String Loc
  | Chr String Loc
  | Num Int Loc
  | Real Float Loc
  | Group Delim [TokenTree] Loc
  | Code String
  -- Not tokens at all: what is wrong, and where. A macro that is given
  -- something it cannot work with answers with this, and the compiler reports
  -- it at that place -- the token that was wrong, or the call if it is
  -- `Nowhere` -- rather than writing code that fails for a reason nobody can
  -- read.
  | Fail String Loc

-- Meadow written out as text, for the compiler to lex where the call was.
@pub fun code (text : String) : TokenTree = Code text

-- What a macro answers when it cannot do what it was asked: the whole answer,
-- since there is nothing else worth writing. Reported at the call.
@pub fun fail (why : String) : [TokenTree] = [Fail why Nowhere]

-- The same, reported at the token `t` -- the one that was wrong.
@pub fun failAt (why : String) (t : TokenTree) : [TokenTree] = [Fail why (spanOf t)]

-- Where a token was written.
@pub fun spanOf (t : TokenTree) : Loc =
  match t with
  | Word _ s -> s
  | Punct _ s -> s
  | Str _ s -> s
  | Chr _ s -> s
  | Num _ s -> s
  | Real _ s -> s
  | Group _ _ s -> s
  | Fail _ s -> s
  | Code _ -> Nowhere

-- The text of a token, as it would be written.
@pub fun text (t : TokenTree) : String =
  match t with
  | Word w _ -> w
  | Punct p _ -> p
  | Str s _ -> "\"${s}\""
  | Chr c _ -> "'${c}'"
  | Num n _ -> show n
  | Real r _ -> show r
  | Code c -> c
  | Fail why _ -> why
  | Group d ts _ -> "${opening d}${spaced ts}${closing d}"

-- Every token written out, separated by spaces: what a macro that reads its
-- argument as text starts from.
@pub fun spaced (ts : [TokenTree]) : String = S.join " " (V.map text ts)

@pub fun opening (d : Delim) : String =
  match d with
  | Paren -> "("
  | Bracket -> "["
  | Brace -> "{"

@pub fun closing (d : Delim) : String =
  match d with
  | Paren -> ")"
  | Bracket -> "]"
  | Brace -> "}"

-- Whether this is the word `w`.
@pub fun isWord (w : String) (t : TokenTree) : Bool = match t with | Word x _ -> x == w | _ -> False

-- Whether this is the punctuation `p`.
@pub fun isPunct (p : String) (t : TokenTree) : Bool =
  match t with | Punct x _ -> x == p | _ -> False

-- The trees inside a group, or none if it is not one.
@pub fun inside (t : TokenTree) : Maybe [TokenTree] =
  match t with | Group _ ts _ -> Just ts | _ -> None

-- The word a token is, or none.
@pub fun word (t : TokenTree) : Maybe String = match t with | Word w _ -> Just w | _ -> None

-- The string a token is, or none.
@pub fun string (t : TokenTree) : Maybe String = match t with | Str s _ -> Just s | _ -> None

-- `ts` split on the punctuation `p`, which is dropped.
--
-- What a macro's argument usually needs first: `a, b, c` as three runs of
-- tokens. Only the top level is split, so what is inside brackets is left as
-- it was written.
@pub fun splitOn (p : String) (ts : [TokenTree]) : [[TokenTree]] =
  splitting p (V.toList ts) V.empty V.empty

fun splitting p ts run acc =
  match ts with
  | Nil -> V.pushBack acc run
  | Cons t rest ->
      if isPunct p t then splitting p rest V.empty (V.pushBack acc run)
      else splitting p rest (V.pushBack run t) acc

-- --- quoting ---------------------------------------------------------------
--
-- `quote! { fun $name x = $body }` is the tokens written there, with each
-- `$name` -- or `$(an expression)` -- replaced by what it stands for, as
-- tokens. What is spliced keeps where it was written, so a macro that passes
-- the caller's code through leaves an error in it pointing at the caller's
-- line; what the quote wrote stands where the call is.
--
-- The quote is expanded where it is written, into a call of `quoted` with
-- `TokenTree`, `Delim` and `Loc` spelled out and each splice passed to
-- `toTokens`: `use Std.Macro (TokenTree, Delim, Loc, ToTokens, quoted)`.

-- What can be spliced into a quote, as the tokens that write it.
@pub trait ToTokens a {
  fun toTokens : a -> [TokenTree]
}

impl ToTokens TokenTree {
  fun toTokens t = [t]
}

impl ToTokens [a] where ToTokens a {
  fun toTokens xs = V.concatMap toTokens xs
}

impl ToTokens Int {
  fun toTokens n = [Num n Nowhere]
}

impl ToTokens Float {
  fun toTokens x = [Real x Nowhere]
}

impl ToTokens Bool {
  fun toTokens b = [Word (if b then "True" else "False") Nowhere]
}

-- A string is spliced as a string literal. A name is a `Word`: splice
-- `Word name Nowhere`.
impl ToTokens String {
  fun toTokens s = [Str s Nowhere]
}

-- The runs of tokens a quote was cut into, joined.
@pub fun quoted (parts : #[[TokenTree]]) : [TokenTree] = V.concat (vecFromArray parts)

-- --- compile-time bindings ---------------------------------------------------
--
-- Tokens in and tokens out is enough for `vec!`. It is not enough for an
-- embedded language, where one macro defines a grammar and another, later,
-- writes a pass over it: the second has to *know* what the first defined. So a
-- macro can leave a value behind under a name, and a later one can ask for it.
--
-- What is left behind is a `Datum`: data, with a shape anyone can read, and no
-- functions in it. It is stored in the package that defined it and read by
-- packages that depend on that one, so it has to mean the same thing to a
-- macro compiled long after -- which a value of some type of the defining
-- package's could not promise, and a `Datum` does. `Reflect` is how a macro
-- works with its own types on top of that.

@derive(Debug, Display, PartialEq)
@pub data Datum
  = Sym String
  | Str String
  | Int Int
  | Float Float
  | Bool Bool
  | List [Datum]
  -- Named fields, in the order they were written.
  | Rec [(String, Datum)]
  -- A constructor and what it was applied to: `Lam [Sym "x", …]`.
  | Tag String [Datum]
  -- Source, carried as tokens: what a macro that writes code later splices.
  | Code [TokenTree]

-- What a macro may ask of the compiler while it runs.
--
-- `lookup` answers the value a name stands for where the macro was *called*,
-- by the same rules as any other name there: the calling module's own, and
-- what it `use`s. A name that nothing has defined *yet* is not an answer of
-- `None`: the macro is set aside, the rest of the package is expanded, and it
-- is run again once something has. Only when nothing more can be defined is
-- `None` the answer -- so `None` means there is no such thing, not that it has
-- not been written yet.
--
-- `define` leaves a value for a later macro, under a name in the calling
-- module, visible as far as the call's own `@pub` says.
@pub effect Expand {
  lookup : String -> Maybe Datum,
  define : (String, Datum) -> (),
}

-- A type a macro can store and read back: to a `Datum`, and from one, saying
-- what was wrong when it is not one.
--
-- `@derive(Reflect)` writes it for a `data` or `record`: a constructor is a
-- `Tag` of its name and its fields, a record a `Rec` of its fields by name. The
-- code it writes names `Reflect` and `Datum`, so both have to be in scope where
-- it is derived: `use Std.Macro (Reflect, Datum)`.
@pub trait Reflect a {
  fun toDatum : a -> Datum
  fun fromDatum : Datum -> Result String a
}

impl Reflect Datum {
  fun toDatum d = d
  fun fromDatum d = Ok d
}

impl Reflect Int {
  fun toDatum n = Datum.Int n
  fun fromDatum d =
    match d with
    | Datum.Int n -> Ok n
    | other -> Err (expected "an Int" other)
}

impl Reflect Float {
  fun toDatum x = Datum.Float x
  fun fromDatum d =
    match d with
    | Datum.Float x -> Ok x
    | other -> Err (expected "a Float" other)
}

-- A `Float32` is held as the `Float` it widens to, and read back narrowed.
impl Reflect Float32 {
  fun toDatum x = Datum.Float (toFloat64 x)
  fun fromDatum d =
    match d with
    | Datum.Float x -> Ok (toFloat32 x)
    | other -> Err (expected "a Float32" other)
}

-- A `Char` is held as its code point, and read back only if that is one.
impl Reflect Char {
  fun toDatum c = Datum.Int (charCode c)
  fun fromDatum d =
    match d with
    | Datum.Int n if n >= 0 and n <= 1114111 and (n < 55296 or n > 57343) -> Ok (charFromCode n)
    | other -> Err (expected "a Char's code point" other)
}

-- Each fixed-width integer is held as the `Int` it is, and read back only if
-- it fits: a value out of range is wrong, not wrapped.
impl Reflect Int8 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toInt8 (within "an Int8" (0 - 128) 127 d)
}

impl Reflect Int16 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toInt16 (within "an Int16" (0 - 32768) 32767 d)
}

impl Reflect Int32 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toInt32 (within "an Int32" (0 - 2147483648) 2147483647 d)
}

impl Reflect UInt8 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toUInt8 (within "a UInt8" 0 255 d)
}

impl Reflect UInt16 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toUInt16 (within "a UInt16" 0 65535 d)
}

impl Reflect UInt32 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d = mapOk toUInt32 (within "a UInt32" 0 4294967295 d)
}

-- A `UInt64` past `Int`'s top is held as the negative `Int` of its bits.
impl Reflect UInt64 {
  fun toDatum n = Datum.Int (toInt n)
  fun fromDatum d =
    match d with
    | Datum.Int n -> Ok (toUInt64 n)
    | other -> Err (expected "a UInt64" other)
}

-- The `Int` `d` holds, if it is one from `lo` to `hi`.
fun within (what : String) (lo : Int) (hi : Int) (d : Datum) : Result String Int =
  match d with
  | Datum.Int n if n >= lo and n <= hi -> Ok n
  | Datum.Int n -> Err "expected ${what}, not ${show n}, which is out of its range"
  | other -> Err (expected what other)

fun mapOk (f : a -> b) (r : Result String a) : Result String b =
  match r with | Ok x -> Ok (f x) | Err e -> Err e

impl Reflect Bool {
  fun toDatum b = Datum.Bool b
  fun fromDatum d =
    match d with
    | Datum.Bool b -> Ok b
    | other -> Err (expected "a Bool" other)
}

impl Reflect String {
  fun toDatum s = Datum.Str s
  fun fromDatum d =
    match d with
    | Datum.Str s -> Ok s
    | Datum.Sym s -> Ok s
    | other -> Err (expected "a String" other)
}

impl Reflect [a] where Reflect a {
  fun toDatum xs = Datum.List (V.map toDatum xs)
  fun fromDatum d =
    match d with
    | Datum.List ds ->
        V.foldl
          (\acc x ->
            match acc with
            | Err e -> Err e
            | Ok got ->
                match fromDatum x with
                | Err e -> Err e
                | Ok y -> Ok (V.pushBack got y))
          (Ok V.empty)
          ds
    | other -> Err (expected "a list" other)
}

-- A tuple is a `List` of its parts, in order.
impl Reflect (a, b) where Reflect a, Reflect b {
  fun toDatum p = match p with | (x, y) -> Datum.List [toDatum x, toDatum y]
  fun fromDatum d =
    match d with
    | Datum.List ds if V.len ds == 2 ->
        (match (V.get ds 0, V.get ds 1) with
         | (Just dx, Just dy) ->
             (match (fromDatum dx, fromDatum dy) with
              | (Ok x, Ok y) -> Ok (x, y)
              | (Err e, _) -> Err e
              | (_, Err e) -> Err e)
         | _ -> Err (expected "a pair" d))
    | other -> Err (expected "a pair" other)
}

impl Reflect (a, b, c) where Reflect a, Reflect b, Reflect c {
  fun toDatum t =
    match t with
    | (x, y, z) -> Datum.List [toDatum x, toDatum y, toDatum z]
  fun fromDatum d =
    match d with
    | Datum.List ds if V.len ds == 3 ->
        (match (V.get ds 0, V.get ds 1, V.get ds 2) with
         | (Just dx, Just dy, Just dz) ->
             (match (fromDatum dx, fromDatum dy, fromDatum dz) with
              | (Ok x, Ok y, Ok z) -> Ok (x, y, z)
              | (Err e, _, _) -> Err e
              | (_, Err e, _) -> Err e
              | (_, _, Err e) -> Err e)
         | _ -> Err (expected "a triple" d))
    | other -> Err (expected "a triple" other)
}

impl Reflect (Maybe a) where Reflect a {
  fun toDatum m =
    match m with
    | Just x -> Datum.Tag "Just" [toDatum x]
    | None -> Datum.Tag "None" []
  fun fromDatum d =
    match d with
    | Datum.Tag "None" _ -> Ok None
    | Datum.Tag "Just" xs ->
        (match V.get xs 0 with
         | Just x ->
             (match fromDatum x with
              | Ok y -> Ok (Just y)
              | Err e -> Err e)
         | None -> Err "`Just` without what it holds")
    | other -> Err (expected "a Maybe" other)
}

-- A `Datum` as the source a `@compileTime def` reads it back from: what a
-- macro splices to write out a value it was left.
impl ToTokens Datum {
  fun toTokens d =
    match d with
    | Datum.Sym s -> [Word s Nowhere]
    | Datum.Str s -> [Str s Nowhere]
    | Datum.Int n -> [Num n Nowhere]
    | Datum.Float x -> [Real x Nowhere]
    | Datum.Bool b -> toTokens b
    | Datum.List ds -> [Group Bracket (commas (V.map toTokens ds)) Nowhere]
    | Datum.Rec fs ->
        [Group
           Brace
           (commas
              (V.map
                 (\p -> V.append [Word (fst p) Nowhere, Punct "=" Nowhere] (toTokens (snd p)))
                 fs))
           Nowhere]
    | Datum.Tag name ds ->
        V.pushFront (V.concatMap (\x -> [Group Paren (toTokens x) Nowhere]) ds) (Word name Nowhere)
    | Datum.Code ts -> ts
}

-- Runs of tokens with a comma between each.
fun commas (parts : [[TokenTree]]) : [TokenTree] =
  V.foldl
    (\acc part ->
      if V.isEmpty acc then part else V.append (V.pushBack acc (Punct "," Nowhere)) part)
    V.empty
    parts

-- What a `fromDatum` says when it was given the wrong thing.
@pub fun expected (what : String) (got : Datum) : String = "expected ${what}, not ${show got}"

-- The value `name` stands for, read as an `a`.
@pub fun lookupAs (name : String) : Result String a ! { Expand | e } =
  match lookup name with
  | Just d -> fromDatum d
  | None -> Err "nothing is defined as `${name}`"

-- Leave `x` for a later macro, under `name`.
@pub fun defineAs (name : String) (x : a) : () ! { Expand | e } = define (name, toDatum x)

-- The field `name` of a `Rec`'s fields: what a derived `fromDatum` reads a
-- record with.
@pub fun field (name : String) (fields : [(String, Datum)]) : Result String Datum =
  match V.find (\p -> fst p == name) fields with
  | Just p -> Ok (snd p)
  | None -> Err "no field `${name}`"

-- --- running a macro ---------------------------------------------------------
--
-- Everything below is the compiler's side of the bargain, and nothing a macro
-- calls: it is how a macro is run, and how what it did gets back.

-- How a run ended. `Answered` with the tokens, what it defined, and every name
-- it read -- which is what its answer depends on, beside its argument, and so
-- what it is cached on. `Waiting` when it asked for a name nothing has defined
-- yet: it is abandoned, and run again later.
@pub data Outcome
  = Answered [TokenTree] [(String, Datum)] [String]
  | Waiting String [String]

-- Run the macro `run` on `input`, answering its `lookup`s from `scope`.
--
-- `settled` is whether anything more can still be defined. Until it is, a
-- lookup of an unknown name abandons the run; after, it is answered `None`.
@pub fun expanding
    (settled : Bool)
    (scope : [(String, Datum)])
    (run : [TokenTree] -> [TokenTree] ! { Expand | e })
    (input : [TokenTree])
    : Wire ! e =
  wireOutcome
    (handle run input with {
       lookup name k ->
         match V.find (\p -> fst p == name) scope with
         | Just p -> reading name (k (Just (snd p)))
         | None -> if settled then reading name (k None) else Waiting name V.empty,
       define made k -> defining made (k ()),
       return ts -> Answered ts V.empty V.empty
     })

fun reading name o =
  match o with
  | Answered ts ds rs -> Answered ts ds (V.pushFront rs name)
  | Waiting n rs -> Waiting n (V.pushFront rs name)

fun defining made o =
  match o with
  | Answered ts ds rs -> Answered ts (V.pushFront ds made) rs
  | Waiting n rs -> Waiting n rs

-- What the compiler reads back: one tree of one type, built of arrays.
--
-- The compiler reads the answer as values, and an array is the one collection
-- it can read without knowing how a `Vector` is laid out. So the answer is
-- written into this before it crosses: a named node and its children, text,
-- and numbers.
@derive(Debug, PartialEq)
@pub data Wire
  = Node String #[Wire]
  | Text String
  | Whole Int
  | Frac Float

fun wireOutcome (o : Outcome) : Wire =
  match o with
  | Answered ts ds rs ->
      Node
        "Answered"
        #[
          wireTrees ts,
          Node "" (V.toArray (V.map (\p -> Node (fst p) #[wireDatum (snd p)]) ds)),
          Node "" (V.toArray (V.map (\r -> Text r) rs))
        ]
  | Waiting name rs -> Node "Waiting" #[Text name, Node "" (V.toArray (V.map (\r -> Text r) rs))]

fun wireTrees (ts : [TokenTree]) : Wire = Node "" (V.toArray (V.map wireTree ts))

fun wireTree (t : TokenTree) : Wire =
  match t with
  | Word w at -> Node "Word" #[Text w, wireSpan at]
  | Punct p at -> Node "Punct" #[Text p, wireSpan at]
  | Str s at -> Node "Str" #[Text s, wireSpan at]
  | Chr c at -> Node "Chr" #[Text c, wireSpan at]
  | Num n at -> Node "Num" #[Whole n, wireSpan at]
  | Real r at -> Node "Real" #[Frac r, wireSpan at]
  | Group d ts at -> Node "Group" #[Text (opening d), wireTrees ts, wireSpan at]
  | Code c -> Node "Code" #[Text c]
  | Fail why at -> Node "Fail" #[Text why, wireSpan at]

fun wireSpan (s : Loc) : Wire =
  match s with
  | At from to -> Node "At" #[Whole from, Whole to]
  | Nowhere -> Node "Nowhere" #[]

fun wireDatum (d : Datum) : Wire =
  match d with
  | Datum.Sym s -> Node "Sym" #[Text s]
  | Datum.Str s -> Node "Str" #[Text s]
  | Datum.Int n -> Node "Int" #[Whole n]
  | Datum.Float x -> Node "Float" #[Frac x]
  | Datum.Bool b -> Node "Bool" #[Whole (if b then 1 else 0)]
  | Datum.List ds -> Node "List" (V.toArray (V.map wireDatum ds))
  | Datum.Rec fs -> Node "Rec" (V.toArray (V.map (\p -> Node (fst p) #[wireDatum (snd p)]) fs))
  | Datum.Tag name ds -> Node "Tag" #[Text name, Node "" (V.toArray (V.map wireDatum ds))]
  | Datum.Code ts -> Node "Code" #[wireTrees ts]

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

@test fun charsAndFixedWidthNumbersGoThroughADatumAndBack () =
  let (c : Result String Char) = fromDatum (toDatum 'λ') in
  let a = assertEq c (Ok 'λ') "a Char" in
  let (x : Result String Float32) = fromDatum (toDatum (toFloat32 0.5)) in
  let b = assertEq x (Ok (toFloat32 0.5)) "a Float32" in
  let (i : Result String Int8) = fromDatum (toDatum (toInt8 (0 - 128))) in
  let e = assertEq i (Ok (toInt8 (0 - 128))) "an Int8 at its bottom" in
  let (u : Result String UInt64) = fromDatum (toDatum (toUInt64 (toInt (0 - 1)))) in
  let f = assertEq u (Ok (toUInt64 (toInt (0 - 1)))) "a UInt64 at its top" in
  let (big : Result String UInt8) = fromDatum (Datum.Int 256) in
  let g = assertFalse (isOk big) "256 is not a UInt8" in
  let (surrogate : Result String Char) = fromDatum (Datum.Int 55296) in
  assertFalse (isOk surrogate) "a surrogate is not a Char"

@test fun tuplesGoThroughADatumAndBack () =
  let (p : Result String [(Int, String)]) = fromDatum (toDatum [(1, "one"), (2, "two")]) in
  let a = assertEq p (Ok [(1, "one"), (2, "two")]) "a list of pairs" in
  let (t : Result String (Bool, Char, Float)) = fromDatum (toDatum (True, 'x', 1.5)) in
  let b = assertEq t (Ok (True, 'x', 1.5)) "a triple" in
  let (short : Result String (Int, Int)) = fromDatum (Datum.List [Datum.Int 1]) in
  assertFalse (isOk short) "one thing is not a pair"

fun isOk (r : Result String a) : Bool = match r with | Ok _ -> True | Err _ -> False

@test fun textWritesATokenBack () =
  let a = assertEq (text (Word "fun" Nowhere)) "fun" "a word" in
  let b = assertEq (text (Str "hi" Nowhere)) "\"hi\"" "a string keeps its quotes" in
  let c =
    assertEq
      (text (Group Paren [Num 1 Nowhere, Punct "+" Nowhere, Num 2 Nowhere] Nowhere))
      "(1 + 2)"
      "a group"
  in assertEq (text (Code "def x = 1")) "def x = 1" "code is itself"

@test fun splitOnCutsAtTheTopLevelOnly () =
  let ts =
    [
      Word "a" Nowhere,
      Punct "," Nowhere,
      Group Paren [Word "b" Nowhere, Punct "," Nowhere, Word "c" Nowhere] Nowhere
    ]
  in
  let parts = splitOn "," ts in
  let a = assertEq (V.len parts) 2 "two parts" in
  assertEq (V.map spaced parts) ["a", "(b , c)"] "the bracketed comma is left alone"

@test fun isWordAndIsPunctSayWhatATokenIs () =
  let a = assertTrue (isWord "data" (Word "data" Nowhere)) "a word" in
  let b = assertFalse (isWord "data" (Punct "data" Nowhere)) "not a word" in
  assertTrue (isPunct "->" (Punct "->" Nowhere)) "punctuation"
