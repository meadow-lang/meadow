{
  "$schema": "vscode://schemas/color-theme",
  "name": "Meadow Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#FCFCFA",
    "focusBorder": "#546ED8",
    "descriptionForeground": "#939293",
    "errorForeground": "#FF6188",
    "selection.background": "#546ED859",
