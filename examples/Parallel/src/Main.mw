-- Parallelism: using every core for work that splits.
--
--   meadow run examples/Parallel                    -- every core
--   MEADOW_THREADS=1 meadow run examples/Parallel   -- one, to compare
--
-- Concurrency is about waiting on several things; parallelism is about doing
-- several things at once to finish sooner. Meadow's threads give both, and
-- this example is the second: the same computation done in one piece and in
-- many, timed.
--
-- Two ideas carry it:
--
-- * **Split, spawn, sum.** `Thread.parMap` runs a function on a thread per
--   element. Give it chunks of work big enough to be worth a thread each --
--   one thread per number would spend its time on spawning, not counting.
-- * **Share big inputs by compacting them.** Handing a value to a thread copies
--   it into that thread's heap. A `Compact` is not copied: its region belongs to
--   no thread, and every thread reads the same one. Here eight threads read one
--   compacted table of primes without any of them copying it.

use Std.Thread as Thread
use Std.Time (timed, nanosToMillis, formatDuration)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Compact as C
use Std.Num.Int as I

-- --- counting primes ---------------------------------------------------------

fun isPrime (n : Int) =
  if n < 2 then False
  else
    let rec trial (d : Int) =
      if d * d > n then True else if n % d == 0 then False else trial (d + 1)
    in trial 2

-- How many primes in `[lo, hi)`.
fun countPrimes (lo : Int) (hi : Int) =
  let rec go (i : Int) (acc : Int) =
    if i >= hi then acc else go (i + 1) (if isPrime i then acc + 1 else acc)
  in go lo 0

-- `[lo, hi)` cut into `n` pieces of about the same size.
fun chunks (lo : Int) (hi : Int) (n : Int) =
  let size = (hi - lo + n - 1) / n in
  V.map (\i -> (lo + i * size, I.min hi (lo + (i + 1) * size))) (V.range 0 n)

fun countPrimesInParallel (lo : Int) (hi : Int) (pieces : Int) =
  V.foldl
    (\a b -> a + b)
    0
    (Thread.parMap (\c -> match c with | (a, b) -> countPrimes a b) (chunks lo hi pieces))

-- --- one table, many readers -------------------------------------------------

-- Every prime below `n`, by its position: the 1st prime is 2, the 2nd is 3.
fun primeTable (n : Int) =
  let rec go (i : Int) (k : Int) table =
    if i >= n then table
    else if isPrime i then go (i + 1) (k + 1) (H.insert k i table)
    else go (i + 1) k table
  in go 2 1 H.empty

-- Sum the primes at positions `[from, to)`, looking each up in the table.
fun sumAt table (from : Int) (to : Int) =
  let rec go (k : Int) (acc : Int) =
    if k >= to then acc else go (k + 1) (acc + H.getOr 0 k table)
  in go from 0

-- --- main --------------------------------------------------------------------

fun report label ns = println "${label}${formatDuration (nanosToMillis ns)}"

fun main () =
  let limit = toInt 400000 in
  let _ = println "== primes below ${limit}" in
  let (one, oneNs) = timed (\() -> countPrimes 0 limit) in
  let _ = report "one thread:     ${one} primes, " oneNs in
  let (many, manyNs) = timed (\() -> countPrimesInParallel 0 limit 32) in
  let _ = report "32 chunks:      ${many} primes, " manyNs in

  let _ = println "== eight threads reading one compacted table" in
  let table = C.make (primeTable 200000) in
  let size = H.size (C.get table) in
  let _ = println "${size} primes in a region of ${C.size table / 1024} KiB" in
  let pieces = chunks 1 (size + 1) 8 in
  let sums = Thread.parMap (\c -> match c with | (a, b) -> sumAt (C.get table) a b) pieces in
  let total = V.foldl (\a b -> a + b) 0 sums in
  println "sum of every prime below 200000: ${total}"

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun theSplitCountAgreesWithTheWholeOne () =
  assertEq (countPrimesInParallel 0 10000 7) (countPrimes 0 10000) "1229 either way"

@test fun chunksCoverTheRangeExactly () =
  assertEq (chunks 0 10 3) [(0, 4), (4, 8), (8, 10)] "no gaps, no overlap"

@test fun threadsReadTheSameCompactedTable () =
  let table = C.make (primeTable 1000) in
  let sums =
    Thread.parMap (\c -> match c with | (a, b) -> sumAt (C.get table) a b) (chunks 1 169 4)
  in assertEq (V.foldl (\a b -> a + b) 0 sums) 76127 "the primes below 1000 add up to 76127"
