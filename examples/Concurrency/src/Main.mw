-- Concurrency: green threads and the channels between them.
--
--   meadow run examples/Concurrency
--   meadow test examples/Concurrency
--
-- Three patterns, each small enough to read in one go:
--
-- * a **worker pool** -- a fixed number of threads taking jobs from one channel
--   and putting answers on another;
-- * a **pipeline** -- stages that each read from the one before and write to
--   the one after, so values flow through while every stage works at once;
-- * **fan-out, fan-in** -- a thread per piece of work, and `await` to gather.
--
-- Each thread has a heap of its own. What crosses a channel is a copy, so no two
-- threads ever share anything that can change, and nothing here needs a lock.

use Std.Thread as Thread
use Std.Collections.Vector as V
use Std.Maybe.Maybe.*

-- --- a worker pool -----------------------------------------------------------

-- Work worth doing on another thread: the number of steps the Collatz sequence
-- takes from `n` down to 1.
fun collatz (n : Int) = collatzSteps n 0

fun collatzSteps (x : Int) (steps : Int) =
  if x == 1 then steps
  else if x % 2 == 0 then collatzSteps (x / 2) (steps + 1)
  else collatzSteps (3 * x + 1) (steps + 1)

-- A worker: take a job, answer it, repeat until told to stop. `None` means stop.
fun worker jobs results =
  match Thread.receive jobs with
  | None -> ()
  | Just n ->
      let _ = Thread.send results (n, collatz n) in
      worker jobs results

-- Hand `work` to `size` workers and gather every answer.
fun pool (size : Int) work =
  let jobs = Thread.newChannel () in
  let results = Thread.newChannel () in
  let workers = V.map (\i -> Thread.spawn (\() -> worker jobs results)) (V.range 0 size) in
  let _ = V.forEach (\n -> Thread.send jobs (Just n)) work in
  -- One stop per worker, after the work: a channel keeps its order.
  let _ = V.forEach (\w -> Thread.send jobs None) workers in
  let answers = V.map (\i -> Thread.receive results) work in
  let _ = Thread.awaitAll workers in
  answers

-- The longest sequence among the answers.
fun longest answers =
  V.foldl
    (\best a ->
      match (best, a) with
      | ((bn, bs), (n, s)) -> if s > bs then (n, s) else (bn, bs))
    (0, 0)
    answers

fun describeLongest answers =
  match longest answers with
  | (n, steps) -> "longest: ${n} takes ${steps} steps"

fun describeFib t =
  match t with
  | (n, task) -> "fib ${n} = ${Thread.await task}"

-- --- a pipeline --------------------------------------------------------------

-- A stage: pass each value through `f` until the end marker, then pass that on.
fun stage f input output =
  match Thread.receive input with
  | None -> Thread.send output None
  | Just x ->
      let _ = Thread.send output (Just (f x)) in
      stage f input output

-- Chain a stage per function, and answer the channel the last one writes to.
fun pipeline fs input =
  V.foldl
    (\ch f ->
      let out = Thread.newChannel () in
      let _ = Thread.spawn (\() -> stage f ch out) in
      out)
    input
    fs

-- Read everything up to the end marker.
fun drain ch acc =
  match Thread.receive ch with
  | None -> acc
  | Just x -> drain ch (V.pushBack acc x)

-- --- fan-out, fan-in ---------------------------------------------------------

fun fib (n : Int) = if n < 2 then n else fib (n - 1) + fib (n - 2)

-- --- main --------------------------------------------------------------------

fun main () =
  let _ = println "== a worker pool of 4, over 1..10000" in
  let answers = pool 4 (V.range 1 10001) in
  let _ = println "answered ${V.len answers} jobs" in
  let _ = println (describeLongest answers) in

  let _ = println "== a pipeline: square, add one, halve" in
  let input = Thread.newChannel () in
  let output = pipeline [\x -> x * x, \x -> x + 1, \x -> x / 2] input in
  let _ = V.forEach (\x -> Thread.send input (Just x)) (V.range 0 10) in
  let _ = Thread.send input None in
  let _ = println (drain output V.empty) in

  let _ = println "== fan-out, fan-in: fib 20..27 on a thread each" in
  let tasks = V.map (\n -> (n, Thread.spawn (\() -> fib n))) (V.range 20 28) in
  V.forEach (\t -> println (describeFib t)) tasks

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun thePoolAnswersEveryJob () =
  let answers = pool 3 (V.range 1 101) in
  let _ = assertEq (V.len answers) 100 "one answer per job" in
  assertEq (longest answers) (97, 118) "97 is the slowest below 100"

@test fun thePipelineAppliesEveryStageInOrder () =
  let input = Thread.newChannel () in
  let output = pipeline [\x -> x + 1, \x -> x * 10] input in
  let _ = V.forEach (\x -> Thread.send input (Just x)) [1, 2, 3] in
  let _ = Thread.send input None in
  assertEq (drain output V.empty) [20, 30, 40] "(x + 1) * 10, in order"
