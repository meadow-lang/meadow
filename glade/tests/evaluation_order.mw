-- The order a program is evaluated in, seen through an effect: `at n v` is
-- `v`, once the handler has been told `n`, and `seen f` runs `f` and answers
-- what it was told, as the digits of one number. Each case numbers its
-- parts in the order they are written, so each answer counts up -- 12, 123,
-- 1234 -- unless the language says otherwise, as for a section, which is a
-- function and so runs each time it is applied. A part evaluated out of turn
-- shows in the digits. `docs/TUTORIAL.md` ("Evaluation order") says what
-- each case checks. Every engine runs this, and must answer the same.

effect Trace {
  see : Int -> ()
}

effect Ask {
  ask : Int -> Int
}

effect Fail {
  fail : Int -> Int
}

data Pair = Pair Int Int

use Pair.*

record Point = {
  x : Int,
  y : Int
}

fun at (n : Int) v = let u = see n in v

fun seen f =
  (handle f () with { see n k -> \acc -> (k ()) (acc * 10 + n), return x -> \acc -> acc }) 0

fun sub (a : Int) (b : Int) = a - b

fun views p =
  match p with
  | (at 1 (\n -> n) -> 0, at 9 (\n -> n) -> 0) -> 0
  | (at 2 (\n -> n) -> 5, at 3 (\n -> n) -> 6) -> 1
  | _ -> 2

def result =
  (
    -- An operator's operands, left to right.
    seen (\u -> at 1 10 - at 2 3 * at 3 2),
    -- The function, then its arguments; then the call.
    seen (\u -> (at 1 sub) (at 2 10) (at 3 3)),
    seen (\u -> at 3 (sub (at 1 10) (at 2 3))),
    seen (\u -> (sub (at 1 10)) (at 2 3)),
    -- Constructors, tuples and arrays: their parts in order.
    seen (\u -> Pair (at 1 1) (at 2 2)),
    seen (\u -> (at 1 1, at 2 2, at 3 3)),
    seen (\u -> #[at 1 1, at 2 2, at 3 3]),
    -- Fields in the order written: whatever order the type declares them
    -- in, and whether the record has a type or not.
    seen (\u -> Point { y = at 1 2, x = at 2 1 }),
    seen (\u -> { y = at 1 2, x = at 2 1 }),
    -- An update: the record, then the new values as written; an extension:
    -- the new fields, then the record.
    seen (\u -> { (at 1 (Point { x = 0, y = 0 })) | y = at 2 5, x = at 3 4 }),
    seen (\u -> { z = at 1 3 | at 2 { x = 1 } }),
    seen (\u -> (at 1 { a = 1 }).a + at 2 0),
    -- The holes of a string.
    seen (\u -> "${at 1 1}${at 2 2}"),
    -- A binding before the body, whether the body uses it or not.
    seen (\u ->
      let a = at 1 1 in
      let b = at 2 2 in
      let unused = at 3 3 in
      at 4 (b + a)),
    -- What is tested before the branch it chooses, and only that branch.
    seen (\u -> if at 1 True then at 2 1 else at 9 2),
    seen (\u ->
      match at 1 3 with
      | 1 -> at 9 0
      | n if at 2 False -> at 9 0
      | n if at 3 True -> at 4 n
      | _ -> at 9 0),
    -- Arms in order, each pattern left to right until it fails.
    seen (\u -> views (5, 6)),
    seen (\u -> (at 1 False and at 9 True) or (at 2 True or at 9 True)),
    -- A pipe is the application it stands for: the function first.
    seen (\u -> at 2 10 |> at 1 (\n -> n + 1)),
    seen (\u -> at 1 (\n -> n + 1) <| at 2 10),
    -- A section is a function: what is in it runs at each application.
    seen (\u ->
      let g = (at 2 1 + _) in
      let v = at 1 0 in
      g 0 + g 0),
    -- An operation's argument, the clause, the value it resumes with, the
    -- rest of the body, the return clause, and the clause after `k`.
    seen (\u ->
      handle at 1 0 + ask (at 2 1) + at 5 0 with {
        ask n k ->
          let a = see 3 in
          let r = k (at 4 n) in
          let b = see 7 in
          r,
        return v -> let a = see 6 in v
      }),
    -- The first operation that does not resume is the last: `fail 3` never
    -- happens.
    seen (\u -> handle at 1 0 + fail 2 + fail 3 with { fail n k -> at n 0 })
  )
