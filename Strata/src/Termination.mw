-- moved from Idyll front/ at 10ecf25
--
-- Termination checking, and what it buys: recursive definitions that
-- compute in types. `compiler/idyllic-typecheck/src/termination.rs`.
--
-- Once a recursive group is checked, its case trees are examined with the
-- size-change principle (Lee, Jones & Ben-Amram), as Agda does: each
-- recursive call is summarised by how its arguments relate to the caller's
-- parameters (smaller: a variable a split took out of the parameter; the
-- same; or unknown), and the group terminates if every way round a loop of
-- calls, composed with itself until nothing new appears, makes some
-- parameter smaller. That covers structural recursion on any argument,
-- mutual recursion, and lexicographic orders like Ackermann's.
--
-- A recursion on an `Int` has no constructor to take apart, so it is seen
-- to end by a measure, where a test bounds it: each `Int` parameter has
-- three, each a parameter of its own to the size-change test (`Slot`).
-- Counting down, `f (n - 1)` under a test that `n` is above a number,
-- makes `n` smaller; counting up, `f (i + 1)` under a test that `i` is
-- below a number, or below a parameter `n` passed on as it is, makes `n -
-- i` smaller. Up and down are measures apart: a loop that counts down and
-- then up again does not end. `f 0 = ..; f n = f (n - 1)` is not seen to
-- end, as it does not for a negative `n`. The measures are looked for only
-- when the group is not seen to end without them.
--
-- A group that terminates, at the top level, becomes transparent: its
-- members unfold in types when applied to enough arguments that their case
-- trees can choose (`Eval.unfold`), so `S n + m` computes to `S (n + m)`. A
-- group that may not terminate must say `! Div` where its calls get to, or
-- be vouched for with `@terminating`.

use Std.St (StRef, newRef, getRef, setRef)
use Strata.Core (Core, CaseAlt, Head, OpClause, Prim)
use Strata.Hir (Literal)
use Strata.Value (Value)
use Strata.Value as Va
use Strata.Tc (Tc)
use Strata.Tc as T
use Strata.Eval (eval, quote)
use Strata.Ctx (Ctx, Info)
use Strata.Ctx as X
use Std.Collections.Vector as V
use Std.Collections.HashMap as Hm
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*

-- How a call's argument relates to a parameter of the caller: unknown (0),
-- the same (1), or smaller (2), in that order.
fun unknown () : Int = 0

fun same () : Int = 1

fun smaller () : Int = 2

-- Through one call and then another.
fun andThen (a : Int) (b : Int) : Int = if a == 0 or b == 0 then 0 else if a == 1 and b == 1 then 1 else 2

-- A call: from which member, to which, and for each of the caller's
-- parameters and each of the callee's, how the argument relates to it.
-- With measures, each "parameter" is a `Slot`.
data Call = Call Int Int [[Int]]

-- What the size-change test compares, of a definition of `n` parameters:
-- the parameters themselves, and with measures each one counted down, each
-- counted up to a number, and each counted up to another, `Gap q p` being
-- `q - p` (`Checker::check_termination`'s `Slot`).
data Slot = Param Int | Down Int | Up Int | Gap Int Int

-- The most parameters a definition may have for its gaps to be measured.
fun mostGaps () : Int = 6

fun slots (n : Int) (measured : Bool) : Int =
  if not measured then n else if n <= mostGaps () then 3 * n + n * n else 3 * n

fun slot (i : Int) (n : Int) (measured : Bool) : Slot =
  if not measured or i < n then Slot.Param i
  else if i < 2 * n then Slot.Down (i - n)
  else if i < 3 * n then Slot.Up (i - 2 * n)
  else Slot.Gap ((i - 3 * n) / n) ((i - 3 * n) % n)

-- A variable (its level), or a number, in a comparison.
data Atom = Var Int | Number

fun isNumber (a : Atom) : Bool = match a with | Atom.Number -> True | _ -> False

-- What a branch knows, of a test it is under: `lo < hi`, or `lo <= hi`.
data Fact = Fact Atom Atom

fun keyOf (c : Call) : String =
  match c with
  | Call.Call f g m -> show f ++ ">" ++ show g ++ ":" ++ S.join "|" (V.map (\row -> S.join "," (V.map show row)) m)

fun compose (a : [[Int]]) (b : [[Int]]) (calleeParams : Int) : [[Int]] =
  V.map
    (\row ->
      V.map
        (\k -> V.foldl (\best rb -> match rb with | (r, bRow) -> (let x = andThen r (V.getOr 0 bRow k) in if x > best then x else best)) 0 (V.zip row b))
        (V.range 0 calleeParams))
    a

-- Whether every loop of calls makes something smaller: the calls closed
-- under composition, and each call of a member to itself that composing
-- with itself leaves alone must make one of its parameters smaller.
fun terminates (calls : [Call]) (arities : [Int]) : Bool =
  let all = closure calls (V.map keyOf calls) calls arities in
  V.all
    (\c ->
      match c with
      | Call.Call f g m ->
          if f != g then True
          else
            let square = compose m m (V.getOr 0 arities g) in
            keyOf (Call.Call f g square) != keyOf c
              or V.any (\i -> V.getOr 0 (V.getOr [] m i) i == 2) (V.range 0 (minOf (V.len m) (V.getOr 0 arities g))))
    all

fun minOf (a : Int) (b : Int) : Int = if a < b then a else b

fun closure (all : [Call]) (keys : [String]) (fresh : [Call]) (arities : [Int]) : [Call] =
  match V.last fresh with
  | None -> all
  | Just (Call.Call f g m) ->
      let rest = V.take fresh (V.len fresh - 1) in
      let after = V.concatMap (\c -> match c with | Call.Call g2 h m2 -> if g2 == g then [Call.Call f h (compose m m2 (V.getOr 0 arities h))] else []) all in
      let before = V.concatMap (\c -> match c with | Call.Call e h m0 -> if h == f then [Call.Call e g (compose m0 m (V.getOr 0 arities g))] else []) all in
      let (all2, keys2, fresh2) =
        V.foldl
          (\acc c ->
            match acc with
            | (a, ks, fr) -> if V.elem (keyOf c) ks then acc else (V.pushBack a c, V.pushBack ks (keyOf c), V.pushBack fr c))
          (all, keys, rest)
          (V.append after before)
      in
      closure all2 keys2 fresh2 arities

-- How many lambdas a term starts with, through the notes elaboration
-- leaves on them, and what is under them.
@pub fun lambdasOf (c : Core) : (Int, Core) =
  match c with
  | Core.Lam _ body -> (match lambdasOf body with | (n, inner) -> (n + 1, inner))
  | Core.Runtime _ (Core.Lam x body) -> lambdasOf (Core.Lam x body)
  | _ -> (0, c)

-- Up to `most` lambdas.
fun lambdas (c : Core) (most : Int) : (Int, Core) =
  match c with
  | Core.Lam _ body -> if most > 0 then (match lambdas body (most - 1) with | (n, inner) -> (n + 1, inner)) else (0, c)
  | _ -> (0, c)

-- How many arguments a recursive definition takes before its case tree.
@pub fun arity (c : Core) : Int = fst (lambdasOf c)

-- After a recursive group is checked: whether every loop of calls in it
-- makes something smaller, and if not, whether one of its calls counts an
-- `Int` down with nothing to stop it; if it ends, and it is not under a
-- binder, its members unfold from now on.
@pub fun checkTermination (tc : Tc s f p) (ctx : Ctx) (members : [(Int, Core)]) : (Bool, Bool) ! { St s | e } =
  let index = V.foldl (\m i -> match V.get members i with | Just (u, _) -> Hm.insert u i m | None -> m) Hm.empty (V.range 0 (V.len members)) in
  -- with metavariables solved and definitions inlined, so that calls made
  -- through them are seen
  let bodies = V.map (\mc -> match mc with | (_, core) -> quote tc ctx.lvl (eval tc ctx.env core)) members in
  let arities = V.map (\mc -> match mc with | (_, core) -> arity core) members in
  -- the parameters alone, and then, if a call counts, with measures
  let walked =
    \(measured : Bool) ->
      let calls = newRef [] in
      let counts = newRef False in
      let countedDown = newRef False in
      let w =
        V.foldl
          (\acc f ->
            let (n, inner) = lambdas (V.getOr Core.Error bodies f) (V.getOr 0 arities f) in
            let walk =
              Walk {
                base = ctx.lvl,
                origin = newRef (V.map (\p -> Just (p, same ())) (V.range 0 n)),
                splits = newRef [],
                facts = newRef [],
                measured,
                counts,
                countedDown,
                index,
                arities,
                from = f,
                calls
              }
            in
            term walk inner (ctx.lvl + n))
          ()
          (V.range 0 (V.len members))
      in
      (terminates (dedupe (getRef calls)) (V.map (\n -> slots n measured) arities), getRef counts, getRef countedDown)
  in
  let (plainly, counts, _) = walked False in
  let (ends, countedDown) =
    if plainly then (True, False)
    else if counts then (match walked True with | (e, _, d) -> (e, d))
    else (False, False)
  in
  if not ends then (False, countedDown)
  -- only a group with no enclosing variables: one nested under a binder is
  -- known by its binding site, so its instances could not be told apart
  else if V.any (\l -> X.infoAt ctx l == Just Info.Bound) (V.range 0 ctx.lvl) then (True, False)
  else
    let w2 =
      V.foldl
        (\acc mc ->
          match mc with
          | (u, core) ->
              (match lambdasOf core with
               | (k, body) -> setRef tc.transparent (Hm.insert u (ctx.env, k, body) (getRef tc.transparent))))
        ()
        members
    in
    (True, False)

-- The instances of a recursive group checked at the top level that do not
-- unfold already (`Checker::unfold_instances`): each unfolds where a
-- `case` reads a type or a superclass off it.
@pub fun unfoldInstances (tc : Tc s f p) (ctx : Ctx) (members : [(Int, Core)]) : () ! { St s | e } =
  if V.any (\l -> X.infoAt ctx l == Just Info.Bound) (V.range 0 ctx.lvl) then ()
  else
    V.foldl
      (\acc mc ->
        match mc with
        | (u, core) ->
            if V.elem u (getRef tc.hints) and not (Hm.member u (getRef tc.transparent)) then
              (match lambdasOf core with
               | (k, body) ->
                   let w = setRef tc.transparent (Hm.insert u (ctx.env, k, body) (getRef tc.transparent)) in
                   setRef tc.onCase (V.pushBack (getRef tc.onCase) u))
            else ())
      ()
      members

fun dedupe (calls : [Call]) : [Call] =
  match V.foldl (\acc c -> match acc with | (ks, cs) -> if V.elem (keyOf c) ks then acc else (V.pushBack ks (keyOf c), V.pushBack cs c)) ([], []) calls with
  | (_, cs) -> cs

-- Collecting a definition's calls to its group: the level of its first
-- parameter; for each variable from there, which parameter it came out of
-- and how it relates to it; the splits around (the constructor, the levels
-- its arguments were bound at, and where the variable split came from).
record Walk s = {
  base : Int,
  origin : StRef s [Maybe (Int, Int)],
  splits : StRef s [(Int, [Int], Maybe (Int, Int))],
  -- what the tests around here say (with measures); whether calls are
  -- summarised with measures; whether a call passes a parameter plus or
  -- minus a number; and whether one counts down with no test to stop it
  facts : StRef s [Fact],
  measured : Bool,
  counts : StRef s Bool,
  countedDown : StRef s Bool,
  index : HashMap Int Int,
  arities : [Int],
  from : Int,
  calls : StRef s [Call]
}

-- A term's head and its arguments.
fun spine (c : Core) (args : [Core]) : (Core, [Core]) =
  match c with
  | Core.App f a -> spine f (V.append [a] args)
  | _ -> (c, args)

fun originOf (w : Walk s) (c : Core) (lvl : Int) : Maybe (Int, Int) ! { St s | e } =
  match c with
  | Core.Var i _ ->
      let at = lvl - i - 1 - w.base in
      if at < 0 then None else M.andThen (\o -> o) (V.get (getRef w.origin) at)
  | _ ->
      -- a split variable, put back together
      (match spine c [] with
       | (Core.Opaque u _, args) ->
           V.foldl
             (\acc sp ->
               match sp with
               | (con, vars, origin) ->
                   let isSame =
                     con == u and V.len args == V.len vars
                       and V.all (\av -> match av with | (Core.Var i _, v) -> lvl - i - 1 == v | _ -> False) (V.zip args vars)
                   in
                   if isSame and M.isSome origin then origin else acc)
             None
             (getRef w.splits)
       | _ -> None)

-- The parameter a variable is, as it is.
fun paramOf (w : Walk s) (c : Core) (lvl : Int) : Maybe Int ! { St s | e } =
  match c with
  | Core.Runtime _ inner -> paramOf w inner lvl
  | Core.Var _ _ -> (match originOf w c lvl with | Just (p, r) -> if r == same () then Just p else None | None -> None)
  | _ -> None

-- A positive number, written.
fun numberOf (c : Core) : Maybe Int =
  match c with
  | Core.Lit (Literal.Int k) -> if k >= 1 then Just k else None
  | _ -> None

-- A parameter plus or minus a number: which, and by how much.
fun stepped (w : Walk s) (c : Core) (lvl : Int) : Maybe (Int, Int) ! { St s | e } =
  match c with
  | Core.Runtime _ inner -> stepped w inner lvl
  | Core.App (Core.App (Core.Prim Prim.IntSub) a) b ->
      (match (paramOf w a lvl, numberOf b) with
       | (Just p, Just k) -> Just (p, 0 - k)
       | _ -> None)
  | Core.App (Core.App (Core.Prim Prim.IntAdd) a) b ->
      (match (paramOf w a lvl, numberOf b, numberOf a, paramOf w b lvl) with
       | (Just p, Just k, _, _) -> Just (p, k)
       | (_, _, Just k, Just p) -> Just (p, k)
       | _ -> None)
  | _ -> None

-- The parameter a fact's variable is, as it is.
fun factParam (w : Walk s) (a : Atom) : Maybe Int ! { St s | e } =
  match a with
  | Atom.Var l ->
      if l < w.base then None
      else (match M.andThen (\o -> o) (V.get (getRef w.origin) (l - w.base)) with | Just (p, r) -> if r == same () then Just p else None | None -> None)
  | Atom.Number -> None

-- A variable or a number, in a comparison.
fun atomOf (c : Core) (lvl : Int) : Maybe Atom =
  match c with
  | Core.Runtime _ inner -> atomOf inner lvl
  | Core.Var i _ -> Just (Atom.Var (lvl - i - 1))
  | Core.Lit (Literal.Int _) -> Just Atom.Number
  | _ -> None

-- What a test says where it is true, and where it is false: `a < b`, or
-- else `b <= a`; `not t` (a `case` of `t` giving the other `Bool`) the
-- other way round.
fun condition (c : Core) (lvl : Int) : Maybe (Fact, Fact) =
  match c with
  | Core.Runtime _ inner -> condition inner lvl
  | Core.App (Core.App (Core.Prim Prim.IntLt) a) b ->
      (match (atomOf a lvl, atomOf b lvl) with
       | (Just x, Just y) -> Just (Fact.Fact x y, Fact.Fact y x)
       | _ -> None)
  | Core.Case s alts ->
      let gives =
        \(b : Bool) ->
          match V.find (\a -> match a with | CaseAlt.CaseAlt (Head.BoolLit v) _ _ _ -> v == b | _ -> False) alts with
          | Just (CaseAlt.CaseAlt _ _ _ (Core.Lit (Literal.Bool v))) -> Just v
          | _ -> None
      in
      (match (condition s lvl, gives True, gives False) with
       | (Just (yes, no), Just True, Just False) -> Just (yes, no)
       | (Just (yes, no), Just False, Just True) -> Just (no, yes)
       | _ -> None)
  | _ -> None

fun boundedBelow (w : Walk s) (p : Int) : Bool ! { St s | e } =
  V.any (\f -> match f with | Fact.Fact lo hi -> isNumber lo and factParam w hi == Just p) (getRef w.facts)

fun boundedAbove (w : Walk s) (p : Int) : Bool ! { St s | e } =
  V.any (\f -> match f with | Fact.Fact lo hi -> factParam w lo == Just p and isNumber hi) (getRef w.facts)

fun boundedBy (w : Walk s) (p : Int) (q : Int) : Bool ! { St s | e } =
  V.any (\f -> match f with | Fact.Fact lo hi -> factParam w lo == Just p and factParam w hi == Just q) (getRef w.facts)

-- How the callee's slot `to` relates to the caller's slot `from`, the
-- callee's arguments being `args`.
fun related (w : Walk s) (from : Slot) (to : Slot) (args : [Core]) (lvl : Int) : Int ! { St s | e } =
  let param = \j -> match V.get args j with | Just a -> paramOf w a lvl | None -> None in
  let step = \j -> match V.get args j with | Just a -> stepped w a lvl | None -> None in
  match (from, to) with
  | (Slot.Param p, Slot.Param j) ->
      (match M.andThen (\a -> originOf w a lvl) (V.get args j) with
       | Just (q, rel) -> if q == p then rel else unknown ()
       | None -> unknown ())
  | (Slot.Down p, Slot.Down j) ->
      if param j == Just p then same ()
      else (match step j with | Just (q, k) -> if q == p and k < 0 and boundedBelow w p then smaller () else unknown () | None -> unknown ())
  | (Slot.Up p, Slot.Up j) ->
      if param j == Just p then same ()
      else (match step j with | Just (q, k) -> if q == p and k > 0 and boundedAbove w p then smaller () else unknown () | None -> unknown ())
  | (Slot.Gap q p, Slot.Gap jq jp) ->
      if q == p or param jq != Just q then unknown ()
      else if param jp == Just p then same ()
      else (match step jp with | Just (r, k) -> if r == p and k > 0 and boundedBy w p q then smaller () else unknown () | None -> unknown ())
  | _ -> unknown ()

fun under (w : Walk s) (n : Int) (origin : Maybe (Int, Int)) (body : Core) (lvl : Int) =
  let before = getRef w.origin in
  let u = setRef w.origin (V.append before (V.replicate n origin)) in
  let u2 = term w body (lvl + n) in
  setRef w.origin before

fun term (w : Walk s) (c : Core) (lvl : Int) =
  match c with
  | Core.Lam _ body -> under w 1 None body lvl
  | Core.Pi _ _ g r dom cod ->
      let u = V.foldl (\acc x -> term w x lvl) () [g, r, dom] in
      under w 1 None cod lvl
  | Core.Let _ e body ->
      let u = term w e lvl in
      under w 1 (originOf w e lvl) body lvl
  -- what comes out of a split is smaller than what went in; and a branch
  -- of a test knows what the test said
  | Core.Case s alts ->
      let u = term w s lvl in
      let whole = originOf w s lvl in
      let o = M.map (\pr -> match pr with | (p, _) -> (p, smaller ())) whole in
      let test = if w.measured then condition s lvl else None in
      V.foldl
        (\acc alt ->
          match alt with
          | CaseAlt.CaseAlt (Head.Con con) _ vars body ->
              let before = getRef w.splits in
              let u2 = setRef w.splits (V.pushBack before (con, V.range lvl (lvl + V.len vars), whole)) in
              let u3 = under w (V.len vars) o body lvl in
              setRef w.splits before
          | CaseAlt.CaseAlt (Head.BoolLit b) _ vars body ->
              let known = getRef w.facts in
              let u2 =
                match test with
                | Just (yes, no) -> setRef w.facts (V.pushBack known (if b then yes else no))
                | None -> ()
              in
              let u3 = under w (V.len vars) o body lvl in
              setRef w.facts known)
        ()
        alts
  | Core.App _ _ -> call w c lvl
  | Core.Opaque _ _ -> call w c lvl
  | Core.Row ls ts -> V.foldl (\acc x -> term w x lvl) () (V.append ls ts)
  | Core.Handle b r ops ->
      let u = term w b lvl in
      let u2 = term w r lvl in
      V.foldl (\acc op -> match op with | OpClause.OpClause _ _ _ body -> term w body lvl) () ops
  | Core.BoxTy a b -> V.foldl (\acc x -> term w x lvl) () [a, b]
  | Core.Comp a b -> V.foldl (\acc x -> term w x lvl) () [a, b]
  | Core.GradeAdd a b -> V.foldl (\acc x -> term w x lvl) () [a, b]
  | Core.GradeMul a b -> V.foldl (\acc x -> term w x lvl) () [a, b]
  | Core.GradeRange a b -> V.foldl (\acc x -> term w x lvl) () [a, b]
  | Core.BoxIntro a -> term w a lvl
  | Core.Unbox a -> term w a lvl
  | Core.Runtime _ a -> term w a lvl
  | _ -> ()

-- An application: a call to the group, summarised, and its arguments
-- walked.
fun call (w : Walk s) (c : Core) (lvl : Int) =
  let (head, args) = spine c [] in
  let u =
    match head with
    | Core.Opaque fu _ ->
        (match Hm.lookup fu w.index with
         | Just to ->
             let n = V.getOr 0 w.arities w.from in
             let m = V.getOr 0 w.arities to in
             let matrix =
               V.map
                 (\r -> V.map (\c -> related w (slot r n w.measured) (slot c m w.measured) args lvl) (V.range 0 (slots m w.measured)))
                 (V.range 0 (slots n w.measured))
             in
             let u2 =
               V.foldl
                 (\acc j ->
                   match M.andThen (\a -> stepped w a lvl) (V.get args j) with
                   | Just (p, k) ->
                       let u3 = setRef w.counts True in
                       if k < 0 and w.measured and not (boundedBelow w p) then setRef w.countedDown True else ()
                   | None -> ())
                 ()
                 (V.range 0 m)
             in
             setRef w.calls (V.pushBack (getRef w.calls) (Call.Call w.from to matrix))
         | None -> ())
    | _ -> term w head lvl
  in
  V.foldl (\acc a -> term w a lvl) () args
