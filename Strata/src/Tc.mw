    front = front,
    metas = newRef [],
    constants = newRef Hm.empty,
    linearDatas = newRef Hm.empty,
    linearWants = newRef [],
    numberLits = newRef Hm.empty,
    through = newRef (\ctx lit ty -> Core.Error),
    instanced = newRef (\ctx lit ty -> False),
    globals = newRef Hm.empty,
    problems = newRef [],
    opened = newRef [],
    prunes = newRef [],
    inferred = newRef Hm.empty,
    joins = newRef [],
    inferSpine = newRef 0,
    spineHere = newRef 0,
    errors = newRef [],
    placed = newRef [],
    reported = newRef [],
    at = newRef nowhere,
    want = newRef (0 - 1),
    found = newRef None,
    binders = newRef [],
    holes = newRef [],
    goals = newRef [],
    postponed = newRef [],
    linear = newRef False,
    lets = newRef 0,
    localFrom = newRef 0,
    unsupported = newRef [],
    effects = newRef Hm.empty,
    ops = newRef Hm.empty,
    seqs = newRef Hm.empty,
    nativeNames = newRef Hm.empty,
    list = newRef (0 - 1),
    declared = newRef [],
    datas = newRef Hm.empty,
    ctors = newRef Hm.empty,
    nextKey = newRef 4611686018427387903,
    transparent = newRef Hm.empty,
    terminating = newRef [],
    recDefs = newRef [],
    localRecs = newRef [],
    recNames = newRef Hm.empty,
    nativeInfo = newRef Hm.empty,
    natives = newRef Hm.empty,
    positive = newRef Hm.empty,
    hints = newRef [],
